---
// The playground: write Nanyx, run it and share it, with the compiler running in the page. Its examples are the
// tour's runnable ones and those in the repository's `examples` directory (`site/playground-examples.mjs`), and its
// scripts are in `src/lib/playground`.
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import SearchDialog from "@/components/SearchDialog";
import { getAllPages } from "@/lib/nav";
import { defaultExample, repositoryExampleGroups, tourExampleGroups } from "../../site/playground-examples.mjs";
import "@/styles/playground.css";
import "@/styles/playground-shared.css";

const tourGroups = tourExampleGroups(
  import.meta.glob<string>("../content/tour/*.md", { query: "?raw", import: "default", eager: true }),
);
const groups = [...tourGroups, ...repositoryExampleGroups()];

const data = {
  groups,
  defaultExample: defaultExample(tourGroups),
};

const searchItems = (await getAllPages()).map(({ page, section }) => ({
  path: page.path,
  title: page.title,
  description: page.description,
  section: section.title,
}));
---

<Base
  title="Playground · Nanyx"
  description="Write Nanyx, run it and share it in the browser, with nothing to install."
  clientRouter={false}
>
  <div class="pg-root">
    <Header sidebar={false} />
    <main class="pg-main">
      <div class="pg-toolbar" role="toolbar" aria-label="Playground">
        <button type="button" class="pg-button pg-primary" data-run disabled title="Run (Ctrl+Enter)">Run</button>
        <button type="button" class="pg-button pg-primary" data-stop hidden>Stop</button>
        <select class="pg-select" data-examples aria-label="Examples">
          <option value="">Examples…</option>
          {
            groups.map((group) => (
              <optgroup label={group.title}>
                {group.examples.map((example) => (
                  <option value={example.id}>{example.readOnly ? `${example.title} (read-only)` : example.title}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
        <button type="button" class="pg-button" data-share>Share</button>
        <button type="button" class="pg-button" data-wat hidden aria-pressed="false" title="Show the WebAssembly text the code compiles to">WebAssembly</button>
        <span class="pg-read-only" data-read-only hidden></span>
        <span class="pg-status" data-status role="status">Loading the compiler…</span>
        <span class="pg-release" data-release></span>
      </div>
      <div class="pg-split" data-split>
        <section class="pg-editor" data-editor aria-label="Editor"></section>
        <div
          class="pg-divider-handle"
          data-divider
          role="separator"
          tabindex="0"
          aria-label="Resize the editor and the output"
          aria-valuemin="15"
          aria-valuemax="85"
          aria-valuenow="60"
        >
        </div>
        <section class="pg-output-pane" aria-label="Output">
          <div class="pg-output-header">
            <span data-output-title>Output</span>
            <button type="button" class="pg-link-button" data-clear>Clear</button>
          </div>
          <pre class="pg-output pg-wat" data-wat-pane hidden></pre>
          <div class="pg-output pg-terminal" data-output aria-live="polite">
            <div data-log></div>
            <label class="pg-input-line" data-input-line hidden>
              <span aria-hidden="true">›</span>
              <input
                type="text"
                autocomplete="off"
                spellcheck="false"
                aria-label="Input: Enter gives the line, Ctrl+D ends the input"
                placeholder="Enter gives the line, Ctrl+D ends the input"
              />
            </label>
          </div>
        </section>
      </div>
    </main>
    <SearchDialog client:idle items={searchItems} />
  </div>
  <script id="playground-data" type="application/json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
</Base>

<script>
  import "@/lib/playground/main";
</script>
