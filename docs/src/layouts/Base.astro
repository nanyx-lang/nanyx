---
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  /**
   * Whether the client router swaps the next page in. The playground turns it off: a page the router swaps in, or
   * swaps back in on Back, isn't cross-origin isolated, since the headers come with the page's own response.
   */
  clientRouter?: boolean;
}

const {
  title,
  description = "Nanyx is a type-safe, expressive language for building reliable software.",
  clientRouter = true,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const canonical = Astro.site ? new URL(pathname, Astro.site).href : pathname;
const ogImage = Astro.site ? new URL("/nanyx.svg", Astro.site).href : "/nanyx.svg";
---

<!doctype html>
<!-- The pages are prerendered; the client router swaps them in place so that navigating
     between them doesn't flash. "none" swaps at once rather than cross-fading. -->
<html lang="en" transition:animate="none">
  <head>
    {clientRouter && <ClientRouter />}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/nanyx.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nanyx" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      (function () {
        var media = window.matchMedia("(prefers-color-scheme: dark)");
        function apply(dark) {
          document.documentElement.classList.toggle("dark", dark);
        }
        apply(media.matches);
        media.addEventListener("change", function (event) {
          apply(event.matches);
        });
        // The client router replaces <html>'s attributes with the next page's, which
        // drops the class; put it back before the new page paints.
        document.addEventListener("astro:after-swap", function () {
          apply(media.matches);
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
