---
import { Menu, Search } from "lucide-react";
---

<!-- Kept across page swaps, with the sidebar, so the buttons' listeners stay bound. -->
<header class="docs-header" transition:persist>
  <div class="docs-header-inner">
    <button
      type="button"
      id="sidebar-toggle"
      class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
      aria-label="Toggle navigation"
      aria-controls="docs-sidebar"
    >
      <Menu className="h-5 w-5" />
    </button>

    <a href="/" class="docs-logo-link">
      <div class="docs-logo-mark">
        <img src="/nanyx.svg" alt="" width="32" height="32" />
      </div>
      <span class="docs-logo-text">Nanyx</span>
    </a>

    <button
      type="button"
      id="search-trigger"
      class="hidden md:flex items-center gap-2 h-9 px-3 text-sm text-muted-foreground border border-border rounded-lg hover:bg-accent transition-colors min-w-[220px]"
    >
      <Search className="h-3.5 w-3.5" />
      <span>Search docs...</span>
      <kbd class="ml-auto text-xs bg-muted px-1.5 py-0.5 rounded font-mono">⌘K</kbd>
    </button>

    <a
      href="https://github.com/nanyx-lang/nanyx"
      target="_blank"
      rel="noopener noreferrer"
      class="text-muted-foreground hover:text-foreground transition-colors"
      aria-label="Nanyx on GitHub"
    >
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
        ></path>
      </svg>
    </a>
  </div>
</header>

<script>
  document.getElementById("search-trigger")?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("nanyx:open-search"));
  });
</script>
