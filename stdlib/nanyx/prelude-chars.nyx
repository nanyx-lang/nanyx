@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- `char` is one Unicode scalar value, a code point from 0 to 0x10FFFF that isn't a surrogate. A string literal is a
-- `char` where one is expected, `def initial: char = "A"`. Two chars are equal, ordered and hashed by their code
-- points, with the compiler's own `Eq`, `Ord` and `Hash`.

--| The Unicode code point of `c`: `char.toInt("A")` is `65`, and `char.toInt("é")` is `233`.
export def char.toInt: char -> int = { c ->
  __nanyx_int_cast(c)
}

--| The char whose Unicode code point is `n`: `char.fromInt(233)` is `#some("é")`. A negative number, a
  surrogate (55296 to 57343, `0xD800` to `0xDFFF`) or a number past the last code point (1114111,
  `0x10FFFF`) gives `#invalidCodePoint`.
export def char.fromInt: int -> #some(char) | #invalidCodePoint = { n ->
  if n < 0 or n > 1114111 or n >= 55296 and n <= 57343
    then #invalidCodePoint
    else #some(__nanyx_from_int(n))
}

--| The UTF-8 continuation byte that holds the six bits of `codePoint` above its lowest `shift`.
def continuationByte: int, int -> string = { codePoint, shift ->
  __nanyx_string_from_byte(128 + codePoint // shift % 64)
}

--| `c` as a string of its own: its UTF-8 encoding, 1 to 4 bytes. `char.toString("é")` is `"é"`.
export def char.toString: char -> string = { c ->
  def codePoint = char.toInt(c)
  def lead = { first, shift -> __nanyx_string_from_byte(first + codePoint // shift) }
  def next = { shift -> continuationByte(codePoint, shift) }

  if codePoint < 128
    then __nanyx_string_from_byte(codePoint)
    else if codePoint < 2048
      then lead(192, 64) ++ next(1)
      else if codePoint < 65536
        then lead(224, 4096) ++ next(64) ++ next(1)
        else lead(240, 262144) ++ next(4096) ++ next(64) ++ next(1)
}

--| The char whose code point is 0, as Rust's `char` has.
export def char.default: char = "\u{0}"

--| Whether `c` is an ASCII digit, `0` to `9`.
export def char.isDigit: char -> bool = { c ->
  c >= "0" and c <= "9"
}

--| Whether `c` is an ASCII letter, `a` to `z` or `A` to `Z`.
export def char.isAsciiLetter: char -> bool = { c ->
  c >= "a" and c <= "z" or c >= "A" and c <= "Z"
}

--| Whether `c` is an ASCII upper-case letter, `A` to `Z`: `char.isAsciiUppercase("é")` is `false`.
export def char.isAsciiUppercase: char -> bool = { c ->
  c >= "A" and c <= "Z"
}

--| Whether `c` is an ASCII lower-case letter, `a` to `z`: `char.isAsciiLowercase("é")` is `false`.
export def char.isAsciiLowercase: char -> bool = { c ->
  c >= "a" and c <= "z"
}

--| Whether `c` is an ASCII letter or digit, `a` to `z`, `A` to `Z` or `0` to `9`.
export def char.isAsciiAlphanumeric: char -> bool = { c ->
  char.isAsciiLetter(c) or char.isDigit(c)
}

--| `c` upper-cased if it is an ASCII lower-case letter, else `c` as it is, as `string.uppercase` does
  each char: `char.uppercase("q")` is `"Q"`, and `char.uppercase("é")` is `"é"`.
export def char.uppercase: char -> char = { c ->
  if char.isAsciiLowercase(c) then __nanyx_from_int(char.toInt(c) - 32) else c
}

--| `c` lower-cased if it is an ASCII upper-case letter, else `c` as it is, as `string.lowercase` does
  each char: `char.lowercase("Q")` is `"q"`, and `char.lowercase("É")` is `"É"`.
export def char.lowercase: char -> char = { c ->
  if char.isAsciiUppercase(c) then __nanyx_from_int(char.toInt(c) + 32) else c
}

--| Whether `c` is a space, a tab, a line feed or a carriage return, the whitespace the string
  functions trim and split on.
export def char.isWhitespace: char -> bool = { c ->
  c == " " or c == "\t" or c == "\n" or c == "\r"
}
