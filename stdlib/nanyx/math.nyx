module math

-- nanyx/math: numeric utilities.
--
-- `abs`, `sign` and `pow` are generic over the `Num(a)` context, so they take an `int` or a `float`. `abs`,
-- `sign`, `min`, `max` and `clamp` compare through `Ord(a)`, so the last three take a value of any type that
-- has an order, a `string` among them. `sqrt`, `exp`, `ln`, `floor`, `ceil`, `round` and `truncate` take a
-- `float`. `exp` and `ln` are the prelude's `__floatExp` and `__floatLn`, which `float.pow` is written with;
-- the others are written over the compiler intrinsics `__nanyx_float_sqrt`, `__nanyx_float_floor`,
-- `__nanyx_float_ceil`, `__nanyx_float_trunc` and `__nanyx_float_to_int`. `pi` and `e` are constants.
--
-- Import it with `import nanyx/math as math` to call `math.abs(x)` as the docs do, or unqualified
-- to call `abs(x)`.

--| The ratio of a circle's circumference to its diameter, as near as a `float` holds it.
export def pi: float = 3.141592653589793

--| The base of the natural logarithm, as near as a `float` holds it, so `exp(1.0)` is `e`.
export def e: float = 2.718281828459045

--| `n` without its sign. A value that is neither below nor above `0` is `zero`, so `abs(-0.0)` is `0.0`.
export def abs: [Num(a) & Ord(a)] a -> a = { n ->
  if n < 0 then -n else if n > 0 then n else zero
}

--| `-1`, `0` or `1`, of the type of `n`, as `n` is below, neither below nor above, or above `zero`:
  `sign(-2.5)` is `-1.0` and `sign(-0.0)` is `0.0`.
export def sign: [Num(a) & Ord(a)] a -> a = { n ->
  match compare(n, zero)
    | #less -> -fromInt(1)
    | #greater -> fromInt(1)
    | #equal -> zero
}

--| The smaller of `a` and `b`.
export def min: [Ord(a)] a, a -> a = { a, b ->
  if a <= b then a else b
}

--| The larger of `a` and `b`.
export def max: [Ord(a)] a, a -> a = { a, b ->
  if a >= b then a else b
}

--| `n` moved into the range from `min` to `max`: `min` if it is below, `max` if it is above.
export def clamp: [Ord(a)] (a, min: a, max: a) -> a = { n, min, max ->
  if n < min then min else if n > max then max else n
}

--| `base ** exponent`: `base` multiplied by itself `exponent` times, for any number type. A negative
  exponent is `1 / base ** -exponent`, so on an `int` it truncates towards zero. For an exponent
  that is not a whole number, see [`float.pow`].
export def pow: [Num(a)] a, int -> a = { base, exponent ->
  base ** exponent
}

--| The square root of `x` (NaN when `x` is negative).
export def sqrt: float -> float = { x ->
  __nanyx_float_sqrt(x)
}

--| `e ** x`: `exp(0.0)` is `1.0` and `exp(1.0)` is `e`. It is infinity above about 709.8 and `0.0` below
  about -745.2.
export def exp: float -> float = { x ->
  __floatExp(x)
}

--| The natural logarithm of `x`, the power `e` is raised to to give `x`: `ln(e)` is `1.0` and `ln(1.0)` is
  `0.0`. It is minus infinity at zero, and NaN below it.
export def ln: float -> float = { x ->
  __floatLn(x)
}

-- The functions below give an `int`. A float that is NaN, infinite or out of the range of `int` stops the
-- program.

--| The largest whole number not above `x`: `floor(3.9)` is 3 and `floor(-3.1)` is -4.
export def floor: float -> int = { x ->
  __nanyx_float_to_int(__nanyx_float_floor(x))
}

--| The smallest whole number not below `x`: `ceil(3.1)` is 4 and `ceil(-3.9)` is -3.
export def ceil: float -> int = { x ->
  __nanyx_float_to_int(__nanyx_float_ceil(x))
}

--| The whole number nearest `x`, with halves rounded away from zero: `round(2.5)` is 3 and `round(-2.5)` is -3.
export def round: float -> int = { x ->
  def whole = __nanyx_float_trunc(x)

  if x - whole >= 0.5
    then __nanyx_float_to_int(whole + 1.0)
    else if whole - x >= 0.5 then __nanyx_float_to_int(whole - 1.0) else __nanyx_float_to_int(whole)
}

--| `x` with its fraction dropped, towards zero: `truncate(3.9)` is 3 and `truncate(-3.9)` is -3.
export def truncate: float -> int = { x ->
  __nanyx_float_to_int(__nanyx_float_trunc(x))
}
