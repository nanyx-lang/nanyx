@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- The compiler's own `Add` and `Num` of the sized integers, and their `compare`, `hash` and
-- `toString`, as `int` has them. Arithmetic that does not fit the type stops the program, and so
-- does `fromInt` of an `int` outside its range.

export def I8.zero: I8 = 0

export def I8.`+`: I8, I8 -> I8 = { x, y ->
  x + y
}

export def I8.`-`: I8, I8 -> I8 = { x, y ->
  x - y
}

export def I8.negate: I8 -> I8 = { n ->
  -n
}

export def I8.`*`: I8, I8 -> I8 = { x, y ->
  x * y
}

export def I8.`/`: I8, I8 -> I8 = { x, y ->
  x / y
}

export def I8.`%`: I8, I8 -> I8 = { x, y ->
  x % y
}

export def I8.fromInt: int -> I8 = { n ->
  __nanyx_from_int(n)
}

export def I8.compare: I8, I8 -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

export def I8.hash: I8 -> int = { x ->
  __hash(x)
}

export def I8.toString: I8 -> string = { n ->
  "{n}"
}

