-- The compiler's own `Add` and `Num` of `F32`, and its `compare`, `hash` and `toString`, as `float`
-- has them. `fromInt` gives the nearest `F32`.

export def F32.zero: F32 = 0.0

export def F32.`+`: F32, F32 -> F32 = { x, y ->
  x + y
}

export def F32.`-`: F32, F32 -> F32 = { x, y ->
  x - y
}

export def F32.negate: F32 -> F32 = { x ->
  -x
}

export def F32.`*`: F32, F32 -> F32 = { x, y ->
  x * y
}

export def F32.`/`: F32, F32 -> F32 = { x, y ->
  x / y
}

export def F32.`%`: F32, F32 -> F32 = { x, y ->
  x % y
}

export def F32.fromInt: int -> F32 = { n ->
  __nanyx_from_int(n)
}

export def F32.compare: F32, F32 -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

export def F32.hash: F32 -> int = { x ->
  __hash(x)
}

export def F32.toString: F32 -> string = { x ->
  "{x}"
}

-- Arithmetic that wraps around on purpose, as a hash or a checksum wants: each keeps the low bits
-- of the result, as many as the type has, where `+`, `-` and `*` stop the program.

--| `x` plus `y`, wrapping around past the largest or smallest `int`: `int.wrappingAdd(9_223_372_036_854_775_807, 1)`
  is the smallest `int`. Each integer type has its own, `I32.wrappingAdd` and the rest.
export def int.wrappingAdd: int, int -> int = { x, y ->
  __nanyx_wrapping_add(x, y)
}

--| `x` minus `y`, wrapping around as [`int.wrappingAdd`] does.
export def int.wrappingSub: int, int -> int = { x, y ->
  __nanyx_wrapping_sub(x, y)
}

--| `x` times `y`, wrapping around as [`int.wrappingAdd`] does.
export def int.wrappingMul: int, int -> int = { x, y ->
  __nanyx_wrapping_mul(x, y)
}

