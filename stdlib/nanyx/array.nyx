--| Arrays: immutable, fixed-length sequences with constant-time indexing.

  An `Array(a)` holds its elements in one block, so [`array.at`] reads any of them in the same time,
  where `at` on a list walks to it. Nothing about an array changes once it is made, so it needs no
  `Memory`. Write one as a literal, `Array[1, 2, 3]`, or make it from a list with [`array.fromList`],
  from its indices with [`array.init`], or filled with each slot's default with [`array.create`].

  Each function is attached to `array`, so it is in scope wherever arrays are, without an import, and is called as
  `array.length(xs)`, or as `xs \length` when `xs` is known to be an array. `==` compares two arrays
  element by element, and an array is written as a list is, `[10, 20, 30]`.

  The functions every ordered collection has are here with `list`'s names, argument order and
  meaning: [`array.filter`], [`array.find`], [`array.sort`], [`array.zip`] and the rest. Each that
  makes a new collection gives an array, read and written by index, with no list made on the way.
module array

import (
  nanyx/marray
  nanyx/mslice
)

--| An array of the elements of `xs`, in order.
export def array.fromList: list(a) -> array(a) = { xs ->
  __nanyx_array_of_list(xs)
}

--| An array of the elements of `s`, pulled now, in order: `(1..5) \Array.fromSeq` is
  `[1, 2, 3, 4, 5]`. It requires the contexts the sequence's steps do. An endless sequence never
  ends: cut it with [`seq.take`].
export def array.fromSeq: [c] ([c] seq(a)) -> array(a) = { s ->
  -- An array's length is fixed when it is made, so the elements are held, last first, until the
  -- sequence ends, then written into an array of their number from the back.
  def reversed = seq.fold(s, [], { acc, x -> [x, ...acc] })
  def count = list.length(reversed)
  writeBackFrom(__nanyx_array_new(count), count - 1, reversed)
}

--| An array of what `block` emits, through [`Emit`]: `Array.build { emit(1); if more then emit(2) }`.
  The same as `list.build(block) \array.fromList`.
export def array.build: [c] ([c, Emit(a)] () -> ()) -> array(a) = { block ->
  array.fromList(list.build(block))
}

-- `made`, a new array, once each of `reversed` is written into it, the first at `index` and each
-- after it one index before.
def writeBackFrom: array(a), int, list(a) -> array(a) = { made, index, reversed ->
  match reversed
    | [] -> made
    | [x, ...rest] ->
      __nanyx_array_write(made, index, x)
      writeBackFrom(made, index - 1, rest)
}

--| The elements of `xs`, in order, as a list.
export def array.toList: array(a) -> list(a) = { xs ->
  __nanyx_array_to_list(xs)
}

--| How many elements `xs` holds.
export def array.length: array(a) -> int = { xs ->
  __nanyx_array_length(xs)
}

--| An array of `count` elements, the one at each index `f` of it: `array.init(3, { i -> i * i })`
  is `[0, 1, 4]`. A `count` of 0 or less makes an empty array.
export def array.init: [c] int, ([c] int -> a) -> array(a) = { count, f ->
  fillFrom(__nanyx_array_new(count), 0, f)
}

--| An array of `count` elements, each the [`Default`] of its type: `array.create(3)` of ints is
  `[0, 0, 0]`. A `count` of 0 or less makes an empty array.
export def array.create: [Default(a)] int -> array(a) = { count ->
  fillWithDefaultFrom(__nanyx_array_new(count), 0)
}

--| An array of `f` of each element of `xs`, in order.
export def array.map: [c] array(a), ([c] a -> b) -> array(b) = { xs, f ->
  mapFrom(xs, __nanyx_array_new(__nanyx_array_length(xs)), 0, f)
}

-- `made`, a new array, once `f` of each of its indices from `index` on is written into it. Each
-- helper that fills a new array gives it back, so that its element type is the caller's.
def fillFrom: [c] array(a), int, ([c] int -> a) -> array(a) = { made, index, f ->
  if index < __nanyx_array_length(made) then
    __nanyx_array_write(made, index, f(index))
    fillFrom(made, index + 1, f)
  else made
}

-- `made`, a new array, once the default of its element type is written at each index from `index`
-- on.
def fillWithDefaultFrom: [Default(a)] array(a), int -> array(a) = { made, index ->
  if index < __nanyx_array_length(made) then
    __nanyx_array_write(made, index, default)
    fillWithDefaultFrom(made, index + 1)
  else made
}

-- `made`, a new array as long as `xs`, once `f` of each element of `xs` from `index` on is written
-- into it.
def mapFrom: [c] array(a), array(b), int, ([c] a -> b) -> array(b) = { xs, made, index, f ->
  if index < __nanyx_array_length(made) then
    __nanyx_array_write(made, index, f(__nanyx_array_get(xs, index)))
    mapFrom(xs, made, index + 1, f)
  else made
}

--| `step` applied to `initial` and the first element of `xs`, then to that and the second, and so
  on to the last: `array.fold(xs, 0, { total, x -> total + x })` adds them up.
export def array.fold: [c] array(a), b, ([c] b, a -> b) -> b = { xs, initial, step ->
  foldFrom(xs, 0, initial, step)
}

--| The elements of `xs` combined with `f`, in order, starting from the first: `Array[1, 2, 3, 4, 5]
  \array.reduce { * }` is `#some(120)`, and an empty array, having no first element, gives `#none`.
  To start from another value, use [`array.fold`].
export def array.reduce: [c] array(a), ([c] a, a -> a) -> #some(a) | #none = { xs, f ->
  if __nanyx_array_length(xs) == 0
    then #none
    else #some(foldFrom(xs, 1, __nanyx_array_get(xs, 0), f))
}

def foldFrom: [c] array(a), int, b, ([c] b, a -> b) -> b = { xs, index, acc, step ->
  if index >= __nanyx_array_length(xs)
    then acc
    else foldFrom(xs, index + 1, step(acc, __nanyx_array_get(xs, index)), step)
}

--| [`array.fold`] from the last element to the first, without copying `xs`:
  `array.foldBack(Array["a", "b", "c"], "", { acc, x -> acc ++ x })` is `"cba"`.
export def array.foldBack: [c] array(a), b, ([c] b, a -> b) -> b = { xs, initial, step ->
  foldBackFrom(xs, __nanyx_array_length(xs) - 1, initial, step)
}

-- `step` applied to `acc` and each element of `xs` from `index` down to the first.
def foldBackFrom: [c] array(a), int, b, ([c] b, a -> b) -> b = { xs, index, acc, step ->
  if index < 0
    then acc
    else foldBackFrom(xs, index - 1, step(acc, __nanyx_array_get(xs, index)), step)
}

--| [`array.fold`] that can stop part-way: `step` gives `#some(acc)` to go on to the next element,
  and anything else it gives ends the fold there and is its result, as it is. A fold that runs to the
  end gives `#some(acc)`. `step` isn't called again after it stops:
  `array.foldWhile(Array[1, 2, 3, 4, 5], 0, { total, x -> if total + x > 6 then #full(total) else
  #some(total + x) })` is `#full(6)`.
export def array.foldWhile
  : [c] array(a), b, ([c] b, a -> #some(b) | r) -> #some(b) | r
  = { xs, initial, step ->
    foldWhileFrom(xs, 0, initial, step)
  }

-- [`array.foldWhile`] of the elements of `xs` from `index` on.
def foldWhileFrom
  : [c] array(a), int, b, ([c] b, a -> #some(b) | r) -> #some(b) | r
  = { xs, index, acc, step ->
    if index >= __nanyx_array_length(xs) then #some(acc) else
      match step(acc, __nanyx_array_get(xs, index))
        | #some(next) -> foldWhileFrom(xs, index + 1, next, step)
        | r -> r
  }

--| Whether `xs` holds no elements.
export def array.isEmpty: array(a) -> bool = { xs ->
  __nanyx_array_length(xs) == 0
}

--| An array of the elements of `xs` that `keep` holds for, in order.
export def array.filter: [c] array(a), ([c] a -> bool) -> array(a) = { xs, keep ->
  -- Which elements are kept is held in an array of `bool`s, so that `keep` runs once on each and
  -- the array given back is made at its length.
  def kept = array.map(xs, keep)
  keptFrom(xs, kept, __nanyx_array_new(countKept(kept, 0, 0)), 0, 0)
}

-- `count`, and one more for each `true` in `kept` from `index` on.
def countKept: array(bool), int, int -> int = { kept, index, count ->
  if index >= __nanyx_array_length(kept)
    then count
    else countKept(kept, index + 1, if __nanyx_array_get(kept, index) then count + 1 else count)
}

-- `made`, once each element of `xs` from `index` on that `kept` marks is written into it, the
-- first at `at`.
def keptFrom: array(a), array(bool), array(a), int, int -> array(a) = { xs, kept, made, index, at ->
  if index >= __nanyx_array_length(xs)
    then made
    else if __nanyx_array_get(kept, index) then
      __nanyx_array_write(made, at, __nanyx_array_get(xs, index))
      keptFrom(xs, kept, made, index + 1, at + 1)
    else keptFrom(xs, kept, made, index + 1, at)
}

--| An array of the values `f` gives as `#some`, in order, leaving out the elements it gives `#skip`
  for: a `map` and a `filter` in one, which runs `f` once on each element.
export def array.filterMap: [c] array(a), ([c] a -> #some(b) | #skip) -> array(b) = { xs, f ->
  def results = array.map(xs, f)
  someFrom(results, __nanyx_array_new(countSome(results, 0, 0)), 0, 0)
}

-- `count`, and one more for each `#some` in `results` from `index` on.
def countSome: array(#some(b) | #skip), int, int -> int = { results, index, count ->
  if index >= __nanyx_array_length(results)
    then count
    else countSome(
      results
      index + 1
      if __nanyx_array_get(results, index) is #some(_) then count + 1 else count
    )
}

-- `made`, once the value of each `#some` in `results` from `index` on is written into it, the
-- first at `at`.
def someFrom
  : array(#some(b) | #skip), array(b), int, int -> array(b)
  = { results, made, index, at ->
    if index >= __nanyx_array_length(results) then made else
      match __nanyx_array_get(results, index)
        | #some(y) ->
          __nanyx_array_write(made, at, y)
          someFrom(results, made, index + 1, at + 1)
        | #skip -> someFrom(results, made, index + 1, at)
  }

--| An array of the values `f` emits for each element in turn, in the order it emits them, as
  [`list.select`] gives them: `f` calls [`Emit`]'s `emit` for each.
export def array.select: [c] array(a), ([c, Emit(b)] a -> ()) -> array(b) = { xs, f ->
  -- What `f` emits is written into a mutable array that doubles in length when it fills, and the
  -- array given back is made at the number emitted.
  memory {
    mut buffer = MArray.fromList([])
    mut count = 0

    use Emit(
      emit = { y ->
        if count == MArray.length(buffer) then (buffer := grown(buffer, count, y)) else ()
        ignore(MArray.set(buffer, count, y))
        count := count + 1
      }
    ) in eachFrom(xs, 0, f)

    array.init(
      count
      { index ->
        match MArray.at(buffer, index)
          | #some(y) -> y
          | #notFound -> crash("array.select read past what was emitted")
      }
    )
  }
}

-- `f` run on each element of `xs` from `index` on, in turn.
def eachFrom: [c] array(a), int, ([c] a -> ()) -> () = { xs, index, f ->
  if index < __nanyx_array_length(xs) then
    f(__nanyx_array_get(xs, index))
    eachFrom(xs, index + 1, f)
  else ()
}

-- A new mutable array twice as long as `buffer`, which is full with `count` elements, holding them
-- first and `filler` in each slot after them.
def grown: [Memory] MArray(a), int, a -> MArray(a) = { buffer, count, filler ->
  MArray.init(
    (if count < 4 then 4 else count * 2)
    { index ->
      match MArray.at(buffer, index)
        | #some(x) -> x
        | #notFound -> filler
    }
  )
}

--| The first value `f` yields, running it on the elements in turn, or `#notFound` when it yields
  none. A lambda with `yield` in it is a lazy sequence (see [`Yield`]), so this stops at the first
  yield: `f` runs on no element after the one it yields for.
export def array.selectOne
  : [c, d] array(a), ([c] a -> [d] seq(b)) -> #some(b) | #notFound
  = { xs, f ->
    def selected = xs \array.toSeq \seq.flatMap(f)

    match selected.next()
      | #next(y, _) -> #some(y)
      | #done -> #notFound
  }

-- The position of the first element of `xs` from `index` on that `matches` holds for.
def findIndexFrom
  : [c] array(a), int, ([c] a -> bool) -> #some(int) | #notFound
  = { xs, index, matches ->
    if index >= __nanyx_array_length(xs)
      then #notFound
      else if matches(__nanyx_array_get(xs, index))
        then #some(index)
        else findIndexFrom(xs, index + 1, matches)
  }

--| The first element `matches` holds for, or `#notFound`.
export def array.find: [c] array(a), ([c] a -> bool) -> #some(a) | #notFound = { xs, matches ->
  match findIndexFrom(xs, 0, matches)
    | #some(index) -> #some(__nanyx_array_get(xs, index))
    | #notFound -> #notFound
}

--| The position of the first element `matches` holds for, counting from 0, as [`array.at`] does,
  or `#notFound`.
export def array.findIndex
  : [c] array(a), ([c] a -> bool) -> #some(int) | #notFound
  = { xs, matches ->
    findIndexFrom(xs, 0, matches)
  }

--| Whether `test` holds for any element (so `false` for an empty array).
export def array.any: [c] array(a), ([c] a -> bool) -> bool = { xs, test ->
  findIndexFrom(xs, 0, test) is #some(_)
}

--| Whether `test` holds for every element (so `true` for an empty array).
export def array.all: [c] array(a), ([c] a -> bool) -> bool = { xs, test ->
  findIndexFrom(xs, 0, { x -> not test(x) }) is #notFound
}

--| Whether an element of `xs` is equal to `x`. Elements are compared with `==`, by their structure.
export def array.contains: [Eq(a)] array(a), a -> bool = { xs, x ->
  array.any(xs, { y -> y == x })
}

--| An array of the elements of `xs`, last first.
export def array.reverse: array(a) -> array(a) = { xs ->
  def last = __nanyx_array_length(xs) - 1
  array.init(last + 1, { index -> __nanyx_array_get(xs, last - index) })
}

--| An array of the elements of `xs` in the order `order` gives: `order(a, b)` says whether `a` comes
  before `b` (`#less`), after it (`#greater`), or either way (`#equal`), as `compare` does. The sort
  is stable: elements `order` finds equal keep their order. It is [`MArray.sortWith`]'s merge sort,
  on a copy of the elements.
export def array.sortWith
  : [c] array(a), ([c] a, a -> #less | #equal | #greater) -> array(a)
  = { xs, order ->
    memory {
      def sorted = MArray.fromArray(xs)
      MArray.sortWith(sorted, order)
      MArray.toArray(sorted)
    }
  }

--| An array of the elements of `xs` in ascending order of `key`. The sort is stable: elements with
  the same key keep their order.
export def array.sortBy: [Ord(b), c] array(a), ([c] a -> b) -> array(a) = { xs, key ->
  array.sortWith(xs, { x, y -> compare(key(x), key(y)) })
}

--| An array of the elements of `xs` in ascending order of their `Ord`. The sort is stable.
export def array.sort: [Ord(a)] array(a) -> array(a) = { xs ->
  array.sortWith(xs, compare)
}

-- `count` moved into the range from 0 to the length of `xs`.
def clampedCount: array(a), int -> int = { xs, count ->
  def length = __nanyx_array_length(xs)
  if count < 0 then 0 else if count > length then length else count
}

--| An array of the first `count` elements of `xs` (all of them when there are fewer).
export def array.take: array(a), int -> array(a) = { xs, count ->
  array.init(clampedCount(xs, count), { index -> __nanyx_array_get(xs, index) })
}

--| An array of the elements of `xs` after the first `count`.
export def array.skip: array(a), int -> array(a) = { xs, count ->
  def start = clampedCount(xs, count)
  array.init(__nanyx_array_length(xs) - start, { index -> __nanyx_array_get(xs, start + index) })
}

--| An array of pairs of the elements of `xs` and `ys` at the same position, as long as the shorter.
export def array.zip: array(a), array(b) -> array((a, b)) = { xs, ys ->
  array.init(
    clampedCount(xs, __nanyx_array_length(ys))
    { index -> (__nanyx_array_get(xs, index), __nanyx_array_get(ys, index)) }
  )
}

--| An array of the running totals of a fold: `initial`, then each value [`array.fold`] passes along,
  so the last is what the fold gives back, and it holds one more element than `xs`.
export def array.scan: [c] array(a), b, ([c] b, a -> b) -> array(b) = { xs, initial, step ->
  scanFrom(xs, __nanyx_array_new(__nanyx_array_length(xs) + 1), 0, initial, step)
}

-- `made`, a new array one longer than `xs`, once `state` is written at `index` and each value
-- `step` makes of it and the elements of `xs` from `index` on after it.
def scanFrom
  : [c] array(a), array(b), int, b, ([c] b, a -> b) -> array(b)
  = { xs, made, index, state, step ->
    __nanyx_array_write(made, index, state)

    if index < __nanyx_array_length(xs)
      then scanFrom(xs, made, index + 1, step(state, __nanyx_array_get(xs, index)), step)
      else made
  }
