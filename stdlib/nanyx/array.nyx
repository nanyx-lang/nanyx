--| Arrays: immutable, fixed-length sequences with constant-time indexing.

  An `Array(a)` holds its elements in one block, so [`array.at`] reads any of them in the same time,
  where `at` on a list walks to it. Nothing about an array changes once it is made, so it needs no
  `Memory`. Write one as a literal, `Array[1, 2, 3]`, or make it from a list with [`array.fromList`],
  from its indices with [`array.init`], or filled with each slot's default with [`array.create`].

  Each function is attached to `array`, so it is in scope wherever arrays are, without an import, and is called as
  `array.length(xs)`, or as `xs \length` when `xs` is known to be an array. `==` compares two arrays
  element by element, and an array is written as a list is, `[10, 20, 30]`.
module array

--| An array of the elements of `xs`, in order.
export def array.fromList: list(a) -> array(a) = { xs ->
  __nanyx_array_of_list(xs)
}

--| The elements of `xs`, in order, as a list.
export def array.toList: array(a) -> list(a) = { xs ->
  __nanyx_array_to_list(xs)
}

--| How many elements `xs` holds.
export def array.length: array(a) -> int = { xs ->
  __nanyx_array_length(xs)
}

--| An array of `count` elements, the one at each index `f` of it: `array.init(3, { i -> i * i })`
  is `[0, 1, 4]`. A `count` of 0 or less makes an empty array.
export def array.init: [c] int, ([c] int -> a) -> array(a) = { count, f ->
  fillFrom(__nanyx_array_new(count), 0, f)
}

--| An array of `count` elements, each the [`Default`] of its type: `array.create(3)` of ints is
  `[0, 0, 0]`. A `count` of 0 or less makes an empty array.
export def array.create: [Default(a)] int -> array(a) = { count ->
  fillWithDefaultFrom(__nanyx_array_new(count), 0)
}

--| An array of `f` of each element of `xs`, in order.
export def array.map: [c] array(a), ([c] a -> b) -> array(b) = { xs, f ->
  mapFrom(xs, __nanyx_array_new(__nanyx_array_length(xs)), 0, f)
}

-- `made`, a new array, once `f` of each of its indices from `index` on is written into it. Each
-- helper that fills a new array gives it back, so that its element type is the caller's.
def fillFrom: [c] array(a), int, ([c] int -> a) -> array(a) = { made, index, f ->
  if index < __nanyx_array_length(made) then
    __nanyx_array_write(made, index, f(index))
    fillFrom(made, index + 1, f)
  else made
}

-- `made`, a new array, once the default of its element type is written at each index from `index`
-- on.
def fillWithDefaultFrom: [Default(a)] array(a), int -> array(a) = { made, index ->
  if index < __nanyx_array_length(made) then
    __nanyx_array_write(made, index, default)
    fillWithDefaultFrom(made, index + 1)
  else made
}

-- `made`, a new array as long as `xs`, once `f` of each element of `xs` from `index` on is written
-- into it.
def mapFrom: [c] array(a), array(b), int, ([c] a -> b) -> array(b) = { xs, made, index, f ->
  if index < __nanyx_array_length(made) then
    __nanyx_array_write(made, index, f(__nanyx_array_get(xs, index)))
    mapFrom(xs, made, index + 1, f)
  else made
}

--| `step` applied to `initial` and the first element of `xs`, then to that and the second, and so
  on to the last: `array.fold(xs, 0, { total, x -> total + x })` adds them up.
export def array.fold: [c] array(a), b, ([c] b, a -> b) -> b = { xs, initial, step ->
  foldFrom(xs, 0, initial, step)
}

def foldFrom: [c] array(a), int, b, ([c] b, a -> b) -> b = { xs, index, acc, step ->
  if index >= __nanyx_array_length(xs)
    then acc
    else foldFrom(xs, index + 1, step(acc, __nanyx_array_get(xs, index)), step)
}
