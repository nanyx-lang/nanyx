--| Immutable stacks: last in, first out.

  A `Stack(a)` is a list read from one end: [`Stack.push`] puts a value on top and [`Stack.pop`]
  takes it off, each in constant time. Nothing about a stack changes once it is made: each of them
  gives back a new stack, which shares the rest of its values with the one it was made from, so the
  old one still holds what it held. For a stack that changes in place, see [`MStack`](mstack).

  Two stacks are `==` when they hold equal values in the same order, and a stack can be a map's key
  when its values can. [`Stack.toString`] writes one as `Stack[3, 2, 1]`, the top first.

  Each function is attached to `Stack`, so with `import nanyx/stack` it is called as
  `Stack.push(s, 5)`, or as `s \push(5)`. A literal makes one, the first value on top:
  `Stack[3, 2, 1]`, or `[3, 2, 1]` where a stack is expected.
module stack

export type Stack(a) = protected list(a)

--| The stack with nothing on it.
export def Stack.empty: Stack(a) = Stack([])

--| A stack holding `xs`, the first of them on top.
export def Stack.fromList: list(a) -> Stack(a) = { xs ->
  Stack(xs)
}

--| A stack holding `xs`, the first of them on top. What a literal builds a stack with,
  `Stack[3, 2, 1]`, or `[3, 2, 1]` where a stack is expected.
export def Stack.fromArray: Array(a) -> Stack(a) = { xs ->
  Stack(list.fromArray(xs))
}

--| A stack holding the elements of `s`, pulled now, the first of them on top. It requires the
  contexts the sequence's steps do.
export def Stack.fromSeq: [c] ([c] seq(a)) -> Stack(a) = { s ->
  Stack(seq.toList(s))
}

--| A stack of what `block` yields, the first on top. The same as `seq(block) \Stack.fromSeq`.
export def Stack.build: [c, d] ([c] () -> [d] seq(a)) -> Stack(a) = { block ->
  Stack.fromSeq(seq(block))
}

--| `stack` with `value` on top of it.
export def Stack.push: Stack(a), a -> Stack(a) = { Stack(items), value ->
  Stack([value, ...items])
}

--| The value on top of `stack` and the stack below it, or `#none` when it is empty.
export def Stack.pop: Stack(a) -> #some(a, Stack(a)) | #none = { Stack(items) ->
  match items
    | [] -> #none
    | [top, ...rest] -> #some(top, Stack(rest))
}

--| The value on top of `stack`, or `#none` when it is empty.
export def Stack.peek: Stack(a) -> #some(a) | #none = { Stack(items) ->
  match items
    | [] -> #none
    | [top, ..._] -> #some(top)
}

--| Whether `stack` has nothing on it.
export def Stack.isEmpty: Stack(a) -> bool = { Stack(items) ->
  list.isEmpty(items)
}

--| How many values are on `stack`. It counts them, so it takes time in proportion to how many
  there are.
export def Stack.length: Stack(a) -> int = { Stack(items) ->
  list.length(items)
}

--| The values on `stack`, the top one first, as a sequence. A stack is [`Iterable`] by it, so a
  `for` loop walks one.
export def Stack.toSeq: Stack(a) -> seq(a) = { Stack(items) -> list.toSeq(items) }

--| The values on `stack`, the top one first.
export def Stack.toList: Stack(a) -> list(a) = { Stack(items) -> items }

--| `stack` as its literal is written, the top first: `Stack[3, 2, 1]`, and `Stack[]` when it is
  empty.
export def Stack.toString: [ToString(a)] Stack(a) -> string = { Stack(items) ->
  "Stack{items}"
}

--| The elements of `s`, from the top, combined with `f`, in order, starting from the element type's
  [`Default`]: a stack of `1`, `2` and `3` reduced with `{ + }` is `6`. An empty one gives the
  default, so `reduce` never fails, unlike a `reduce` that starts from the first element. To start
  from another value, use [`list.fold`].
export def Stack.reduce: [Default(a), c] Stack(a), ([c] a, a -> a) -> a = { s, f ->
  list.reduce(Stack.toList(s), f)
}
