module prelude

-- nanyx/prelude: what every module sees without importing anything.
--
-- The compiler imports this module, unqualified, into every other module, the rest of the standard
-- library included. A module's own definitions and its explicit imports take precedence over the
-- names here, so a module can define its own `proc`.

-- Numbers ---------------------------------------------------------------------------------------

-- The value of the ASCII digit `b`, or -1 when `b` is not one.
def digitValue: int -> int = { b ->
  if b >= 48 and b <= 57 then b - 48 else -1
}

-- `acc` followed by the decimal digits of `s` from byte `i` on, or `#invalidInt` at the first byte
-- that is not a digit.
def parseDigits: string, int, int -> #some(int) | #invalidInt = { s, i, acc ->
  if i >= __nanyx_string_length(s)
    then #some(acc)
    else if digitValue(__nanyx_string_byte_at(s, i)) < 0
      then #invalidInt
      else parseDigits(s, i + 1, acc * 10 + digitValue(__nanyx_string_byte_at(s, i)))
}

-- The integer `s` writes in decimal, with an optional leading `-` or `+`, or `#invalidInt` for
-- anything else (an empty string, a sign alone, spaces, other characters). Overflow is not
-- detected.
export def Int.fromString: string -> #some(int) | #invalidInt = { s ->
  def first = __nanyx_string_byte_at(s, 0)
  def start = if first == 45 or first == 43 then 1 else 0

  if __nanyx_string_length(s) <= start
    then #invalidInt
    else if first == 45
      then Option.map(parseDigits(s, start, 0), { n -> 0 - n })
      else parseDigits(s, start, 0)
}

-- `n` as a float: `Int.toFloat(3)` is 3.0. Every `int` has an exact `float`. To go back, see
-- `floor`, `ceil`, `round` and `truncate` in `nanyx/math`.
export def Int.toFloat: int -> float = { n ->
  __nanyx_int_to_float(n)
}

-- Booleans --------------------------------------------------------------------------------------

-- The boolean `s` writes, `true` or `false` exactly as `Bool.toString` writes them, or
-- `#invalidBool` for anything else (other capitalisation, spaces, an empty string).
export def Bool.fromString: string -> #some(bool) | #invalidBool = { s ->
  if s == "true" then #some(true) else if s == "false" then #some(false) else #invalidBool
}

-- Equality --------------------------------------------------------------------------------------

-- How two values of type `a` are compared. `x == y` is read through it, and `x != y` is
-- `not (x == y)`. The compiler has its own for every type that holds no function, which compares
-- by structure: records field by field, lists element by element, tags by name and then payload.
-- Functions have no equality. A function that compares values of one of its type variables
-- requires it: `def same: [Eq(a)] a, a -> bool`.
export context Eq(a) = (`==`: (a, a) -> bool)

-- The `==` of the compiler's own `Eq`: what a function that requires `Eq(a)` is passed when it is
-- called with a type that has no `==` of its own.
export def __equals: a, a -> bool = { x, y ->
  x == y
}

-- What `xs == ys` calls on two lists whose elements have an `Eq` other than the compiler's own:
-- `==` on a `list($Email)`, or on a `list(a)` in a function that requires `Eq(a)`. The lists are
-- compared element by element through that `Eq`. `!=` is `not` of it.
export def __listEquals: [Eq(a)] list(a), list(a) -> bool = {
  | [], [] -> true
  | [x, ...xs], [y, ...ys] -> (if x == y then __listEquals(xs, ys) else false)
  | _, _ -> false
}

-- Whether the lists `xs` and `ys` hold equal elements in the same order, as `same` compares two
-- elements. The `==` the compiler derives for a list whose elements have an `==` of their own
-- calls it.
export def __listEqualsBy: list(a), list(a), (a, a -> bool) -> bool = { xs, ys, same ->
  match xs
    | [] -> __isEmpty(ys)
    | [x, ...restOfXs] ->
      match ys
        | [] -> false
        | [y, ...restOfYs] ->
          if same(x, y) then __listEqualsBy(restOfXs, restOfYs, same) else false
}

def __isEmpty: list(a) -> bool = { xs ->
  match xs
    | [] -> true
    | _ -> false
}

-- Arithmetic ------------------------------------------------------------------------------------

-- The values of type `a` that add and subtract. `x + y`, `x - y` and `-x` are read through it, and
-- so is `0` beside a value of type `a` in a function whose type requires it:
-- `def total: [Add(a)] list(a) -> a`. A type gets one by attaching the four members,
-- `def $Money.zero = ...`, `` def $Money.`+` = ... ``, and so on.
export context Add(a) = (
  zero: a
  `+`: (a, a) -> a
  `-`: (a, a) -> a
  negate: a -> a
)

-- The numbers of type `a`: `Add`'s members, and `x * y`, `x / y` and `x % y`. In a function whose
-- type requires it, any other integer literal beside a value of type `a` is `fromInt` of it, so
-- `def square: [Num(a)] a -> a = { x -> x * x }` and `{ x -> x * 2 }` work at `int` and `float`.
-- A function that requires `Num(a)` can call one that requires `Add(a)`: a `Num` has every member
-- an `Add` has. On an integer type `/` truncates and `%` takes the sign of `x`; on `float` they are
-- IEEE 754's.
export context Num(a) = (
  zero: a
  `+`: (a, a) -> a
  `-`: (a, a) -> a
  negate: a -> a
  `*`: (a, a) -> a
  `/`: (a, a) -> a
  `%`: (a, a) -> a
  fromInt: int -> a
)

-- The compiler's own `Add` and `Num` of `int` and `float`: the members attached to `Int` and
-- `Float`, which are what a function that requires one is passed. `+` on an `int` or a `float` is
-- the built-in operator, not a call.

-- The `int` that adds nothing.
export def Int.zero: int = 0

-- `x` plus `y`.
export def Int.`+`: int, int -> int = { x, y ->
  x + y
}

-- `x` minus `y`.
export def Int.`-`: int, int -> int = { x, y ->
  x - y
}

-- `n` with its sign changed.
export def Int.negate: int -> int = { n ->
  -n
}

-- `x` times `y`.
export def Int.`*`: int, int -> int = { x, y ->
  x * y
}

-- `x` divided by `y`, truncated towards zero: `7 / 2` is 3 and `-7 / 2` is -3.
export def Int.`/`: int, int -> int = { x, y ->
  x / y
}

-- The remainder of `x` divided by `y`, with the sign of `x`: `-7 % 2` is -1.
export def Int.`%`: int, int -> int = { x, y ->
  (x % y)
}

-- `n` itself.
export def Int.fromInt: int -> int = { n ->
  n
}

-- The `float` that adds nothing.
export def Float.zero: float = 0.0

-- `x` plus `y`.
export def Float.`+`: float, float -> float = { x, y ->
  x + y
}

-- `x` minus `y`.
export def Float.`-`: float, float -> float = { x, y ->
  x - y
}

-- `x` with its sign changed: `Float.negate(0.0)` is negative zero.
export def Float.negate: float -> float = { x ->
  -x
}

-- `x` times `y`.
export def Float.`*`: float, float -> float = { x, y ->
  x * y
}

-- `x` divided by `y`.
export def Float.`/`: float, float -> float = { x, y ->
  x / y
}

-- The remainder of `x` divided by `y`, truncated as C's `fmod` is: `7.5 % 2.0` is 1.5.
export def Float.`%`: float, float -> float = { x, y ->
  (x % y)
}

-- `n` as a float, as `Int.toFloat(n)` is.
export def Float.fromInt: int -> float = { n ->
  Int.toFloat(n)
}

-- Powers ----------------------------------------------------------------------------------------

-- `acc` times `base` to the power `exponent`, for an `exponent` of zero or more: by repeated
-- squaring, so it takes as many steps as `exponent` has bits.
def powOnto: [Num(a)] a, int, a -> a = { base, exponent, acc ->
  if exponent == 0
    then acc
    else powOnto(base * base, exponent / 2, if exponent % 2 == 0 then acc else acc * base)
}

-- What `base ** exponent` is: `base` multiplied by itself `exponent` times, so `2 ** 10` is 1024
-- and `x ** 0` is 1. A negative exponent is `1 / base ** -exponent`, so on an `int` it truncates
-- towards zero.
export def __pow: [Num(a)] a, int -> a = { base, exponent ->
  if exponent < 0
    then fromInt(1) / powOnto(base, -exponent, fromInt(1))
    else powOnto(base, exponent, fromInt(1))
}

-- `base ** exponent`, as a function that can be passed around.
export def pow: [Num(a)] a, int -> a = { base, exponent ->
  base ** exponent
}

-- `2 ** n` times `x`, for an `n` that is a whole number of any size.
def scaleByTwos: float, int -> float = { x, n ->
  if n >= 0 then x * 2.0 ** n else x / 2.0 ** -n
}

-- The sum of the series for `e ** r`, from the term `term` (which is `r ** k / k!`) on, with `sum`
-- the terms before it. Twenty terms are enough for any `r` of at most `ln(2) / 2`.
def expSeries: float, float, float, int -> float = { r, term, sum, k ->
  if k > 20 then sum else expSeries(r, term * r / Int.toFloat(k + 1), sum + term, k + 1)
}

-- `e ** z`, as `2 ** n * e ** r` with `r` of at most `ln(2) / 2`.
def floatExp: float -> float = { z ->
  if z != z
    then z
    else if z > 709.8
      then 1.0 / 0.0
      else if z < -745.2
        then 0.0
        else expAround(z, __nanyx_float_floor(z / 0.6931471805599453 + 0.5))
}

-- `e ** z`, for `n` the number of `ln(2)`s nearest `z`.
def expAround: float, float -> float = { z, n ->
  scaleByTwos(expSeries(z - n * 0.6931471805599453, 1.0, 0.0, 0), __nanyx_float_to_int(n))
}

-- The sum of the series for `atanh(t)`, from the term `term` (which is `t ** (2k + 1)`) on, with
-- `sum` the terms before it. Thirty terms are enough for any `t` below 1/3.
def atanhSeries: float, float, float, int -> float = { term, tt, sum, k ->
  if k > 30 then sum else atanhSeries(term * tt, tt, sum + term / Int.toFloat(2 * k + 1), k + 1)
}

-- The natural logarithm of `m * 2 ** k`, for an `m` above zero: `m` is moved into [1, 2) first.
def lnScaled: float, int -> float = { m, k ->
  if m >= 2.0
    then lnScaled(m / 2.0, k + 1)
    else if m < 1.0 then lnScaled(m * 2.0, k - 1) else lnOfReduced(m, k)
}

-- The natural logarithm of `m * 2 ** k`, for an `m` in [1, 2): `ln(m)` is `2 * atanh((m - 1) / (m + 1))`.
def lnOfReduced: float, int -> float = { m, k ->
  def t = (m - 1.0) / (m + 1.0)
  2.0 * atanhSeries(t, t * t, 0.0, 0) + Int.toFloat(k) * 0.6931471805599453
}

-- The natural logarithm of `x`: minus infinity at zero, and NaN below it.
def floatLn: float -> float = { x ->
  if x != x or x < 0.0
    then 0.0 / 0.0
    else if x == 0.0 then -1.0 / 0.0 else if x == 1.0 / 0.0 then x else lnScaled(x, 0)
}

-- `x` to the power `y`, which need not be a whole number: `Float.pow(2.0, 0.5)` is the square root
-- of 2. A whole `y` is `x ** y`, exactly; any other is `e ** (y * ln(x))`, so a negative `x` gives
-- NaN.
export def Float.pow: float, float -> float = { x, y ->
  def whole = __nanyx_float_trunc(y)

  if whole == y and y < 2147483648.0 and y > -2147483648.0
    then x ** __nanyx_float_to_int(whole)
    else floatExp(y * floatLn(x))
}

-- Ordering --------------------------------------------------------------------------------------

-- How two values of type `a` are put in order. `x < y`, `x <= y`, `x > y` and `x >= y` are read
-- through it, so the four cannot disagree. The compiler has its own for numbers, `bool` (`false`
-- first), `string` (by bytes, which is the order of code points), and tuples and lists of them
-- (position by position, and a list that is a prefix of another first). Records and tags have no
-- order: a nominal type gets one by attaching `compare`, and a list of records is sorted by a key
-- with `List.sortBy`. A function that orders values of one of its type variables requires it:
-- `def largest: [Ord(a)] list(a) -> ...`. `Ord` does not require `Eq`; a type that attaches both
-- should keep them consistent.
export context Ord(a) = (compare: (a, a) -> #less | #equal | #greater)

-- The `compare` of the compiler's own `Ord`: what a function that requires `Ord(a)` is passed when
-- it is called with a type that has no `compare` of its own. On floats it is a total order, with
-- NaN after every other float, while `<` and the others on floats follow IEEE 754.
export def __compare: a, a -> #less | #equal | #greater = { x, y ->
  def order = __nanyx_compare(x, y)

  if order < 0 then #less else if order > 0 then #greater else #equal
}

-- What `x < y` calls when it reads an `Ord` other than the compiler's own: one a function
-- requires, one loaded with `use`, or one built from an attached `compare`. `<=`, `>` and `>=`
-- call the three after it.
export def __less: [Ord(a)] a, a -> bool = { x, y ->
  match compare(x, y)
    | #less -> true
    | _ -> false
}

export def __lessOrEqual: [Ord(a)] a, a -> bool = { x, y ->
  match compare(x, y)
    | #greater -> false
    | _ -> true
}

export def __greater: [Ord(a)] a, a -> bool = { x, y ->
  match compare(x, y)
    | #greater -> true
    | _ -> false
}

export def __greaterOrEqual: [Ord(a)] a, a -> bool = { x, y ->
  match compare(x, y)
    | #less -> false
    | _ -> true
}

-- What `xs < ys` calls on two lists whose elements have an `Ord` other than the compiler's own:
-- `<` on a `list($Version)`, or on a `list(a)` in a function that requires `Ord(a)`. The lists are
-- ordered element by element through that `Ord`, and a list that is a prefix of the other comes
-- first. `<=`, `>` and `>=` call the three after it.
export def __listCompare: [Ord(a)] list(a), list(a) -> #less | #equal | #greater = {
  | [], [] -> #equal
  | [], _ -> #less
  | _, [] -> #greater
  | [x, ...xs], [y, ...ys] ->
    match compare(x, y)
      | #equal -> __listCompare(xs, ys)
      | #less -> #less
      | #greater -> #greater
}

export def __listLess: [Ord(a)] list(a), list(a) -> bool = { xs, ys ->
  match __listCompare(xs, ys)
    | #less -> true
    | _ -> false
}

export def __listLessOrEqual: [Ord(a)] list(a), list(a) -> bool = { xs, ys ->
  match __listCompare(xs, ys)
    | #greater -> false
    | _ -> true
}

export def __listGreater: [Ord(a)] list(a), list(a) -> bool = { xs, ys ->
  match __listCompare(xs, ys)
    | #greater -> true
    | _ -> false
}

export def __listGreaterOrEqual: [Ord(a)] list(a), list(a) -> bool = { xs, ys ->
  match __listCompare(xs, ys)
    | #less -> false
    | _ -> true
}

-- Each built-in type with an order has its order attached as `compare`, so it can be called and
-- passed around: `Float.compare` puts NaN after every other float. A built-in type's order is
-- always the compiler's own: `<` and `Ord` do not read these.
export def Int.compare: int, int -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

export def Float.compare: float, float -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

export def Bool.compare: bool, bool -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

export def String.compare: string, string -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

-- Hashing ---------------------------------------------------------------------------------------

-- How a value of type `a` is hashed: an `int` that is the same for any two values `==` finds equal,
-- so that a map can find a key by its hash. The compiler has its own for every type it has its own
-- `Eq` for, which hashes by structure. A nominal type that attaches its own `==` must attach a
-- `hash` that agrees with it, or it has none: `def $Email.hash = { e -> String.hash(lower(e)) }`
-- for an `==` that ignores case. A function that hashes values of one of its type variables
-- requires it: `def bucket: [Hash(a)] a, int -> int`.
export context Hash(a) = (hash: a -> int)

-- The `hash` of the compiler's own `Hash`: what a function that requires `Hash(a)` is passed when
-- it is called with a type that has no `hash` of its own.
export def __hash: a -> int = { x ->
  __nanyx_hash(x)
}

-- Each built-in type has its hash attached as `hash`, so that a type's own `hash` can be built from
-- its parts' hashes. A built-in type's hash is always the compiler's own: `Hash` does not read
-- these.
export def Int.hash: int -> int = { x ->
  __hash(x)
}

export def Float.hash: float -> int = { x ->
  __hash(x)
}

export def Bool.hash: bool -> int = { x ->
  __hash(x)
}

export def String.hash: string -> int = { s ->
  __hash(s)
}

-- Text ------------------------------------------------------------------------------------------

-- How a value of type `a` is written as text. A hole in a string, `"Total: {total}"`, is written
-- through it, so a type can be interpolated when it has one: a type gets one by attaching a
-- `toString`, `def Point.toString = { p -> "({p.x}, {p.y})" }`, and a block can load another with
-- `use`. The compiler has its own for `int`, `float`, `bool`, `string` and tags without a payload,
-- and derives one for a tag with a payload, a tuple, a record and a list from the `ToString` of
-- each part: `#some(3)`, `(1, two)`, `(x = 1, y = 2)`, `[1, 2, 3]`.
export context ToString(a) = (toString: a -> string)

-- What the compiler makes a hole in a string call: `"{x}"` is `"{__interpolate(x)}"`, so a hole
-- needs a `ToString` of its value's type, as a call to a function that requires one does.
export def __interpolate: [ToString(a)] a -> string = { value ->
  toString(value)
}

-- The `toString` of the compiler's own `ToString` of a tag without a payload: what a function
-- that requires `ToString(a)` is passed when it is called with one. It writes the tag's name.
export def __toString: a -> string = { value ->
  "{value}"
}

-- What the derived `toString` of a list calls: `xs` in square brackets, each element written by
-- `show`, with `, ` between them.
export def __listToString: list(a), (a -> string) -> string = { xs, show ->
  match xs
    | [] -> "[]"
    | [first, ...rest] -> "[{__listRestToString(rest, show, show(first))}]"
}

def __listRestToString: list(a), (a -> string), string -> string = { xs, show, text ->
  match xs
    | [] -> text
    | [first, ...rest] -> __listRestToString(rest, show, "{text}, {show(first)}")
}

-- Each built-in type has an attached `toString`, so a value can be turned into text by a function
-- that can be passed around, `scores \map(Int.toString)`, as well as by interpolation. Each one
-- writes the value as interpolation does, with the compiler's own `ToString` for the type.

-- `n` in decimal, with a leading `-` when it is negative.
export def Int.toString: int -> string = { n ->
  "{n}"
}

-- `x` in decimal.
export def Float.toString: float -> string = { x ->
  "{x}"
}

-- `true` or `false`.
export def Bool.toString: bool -> string = { b ->
  "{b}"
}

-- `s` itself.
export def String.toString: string -> string = { s -> s }

-- How a value of type `a` is read from text, with `e` for text that does not hold one: `Int.fromString`
-- gives back `#some(int) | #invalidInt`. A type gets one by attaching a `fromString`, as `int` and
-- `bool` do, so a function can read a value of whichever type it is called at:
-- `def readAll: [FromString(a, e)] list(string) -> list(#some(a) | e)`.
export context FromString(a, e) = (fromString: string -> #some(a) | e)

-- Results ---------------------------------------------------------------------------------------

-- A success carrying an `a`, or an error carrying an `e`.
export type Result(a, e) = #some(a) | #error(e)

-- `proc` is the result workflow: inside `proc { ... }`, `try x` continues with the payload of
-- `#some`, and gives back any `#error` as is without running the rest of the block, and
-- `return x` wraps the value in `#some`.
--
--   def total = proc {
--     def customer = try getCustomer(5)
--     def order = try getLastOrder(customer)
--     return order.total
--   }
--
-- A workflow builder is a record of keyword members. A block written after the builder's name
-- has each `try x` (and each `try x` nested inside an expression) turned into a call to the
-- builder's `try` member, with the rest of the block as its continuation, and each `return x`
-- into a call to its `return` member. A block that ends without `return` has `zero` as its
-- value, `#some()`, so a `proc` that is only run for what it does needs no `return`.
--
-- Every tag other than `#some` is a failure, not only `#error`, and the block collects them: a
-- `try` on a `#some(string) | #nil` and another on a `#some(int) | #notFound` make the block a
-- `#some(...) | #nil | #notFound`. (Two failures with the same tag must agree on its payload:
-- `#error(#a)` and `#error(#b)` do not combine into `#error(#a | #b)`.)
export def proc
  : (try: ((#some(a) | r), (a -> #some(b) | r)) -> #some(b) | r, return: a -> #some(a) | r, zero: #some() | r)
  = (
    try = {
      | #some(value), continue -> continue(value)
      | failure, _ -> failure
    }
    return = { value -> #some(value) }
    zero = #some()
  )

-- Applies `f` to a success, and leaves an error as it is.
export def Result.map: Result(a, e), (a -> b) -> Result(b, e) = {
  | #some(value), f -> #some(f(value))
  | #error(e), _ -> #error(e)
}

-- Applies `f` to an error, and leaves a success as it is.
export def Result.mapError: Result(a, e), (e -> f) -> Result(a, f) = {
  | #some(value), _ -> #some(value)
  | #error(e), f -> #error(f(e))
}

-- Continues with `f` on a success. The errors of both steps are kept.
export def Result.bind: Result(a, e), (a -> Result(b, e)) -> Result(b, e) = {
  | #some(value), f -> f(value)
  | #error(e), _ -> #error(e)
}

-- The success, or `fallback` for an error.
export def Result.defaultValue: Result(a, e), a -> a = {
  | #some(value), _ -> value
  | #error(_), fallback -> fallback
}

-- `f` applied to the success, or `default` for an error.
export def Result.mapOr: Result(a, e), b, (a -> b) -> b = {
  | #some(value), _, f -> f(value)
  | #error(_), default, _ -> default
}

-- The success as `#some`, or `#none` for an error.
export def Result.toOption: Result(a, e) -> #some(a) | #none = {
  | #some(value) -> #some(value)
  | #error(_) -> #none
}

-- The success as it is, or `f` applied to the error.
export def Result.orElse: Result(a, e), (e -> Result(a, f)) -> Result(a, f) = {
  | #some(value), _ -> #some(value)
  | #error(e), f -> f(e)
}

export def Result.isOk: Result(a, e) -> bool = {
  | #some(_) -> true
  | #error(_) -> false
}

export def Result.isError: Result(a, e) -> bool = {
  | #some(_) -> false
  | #error(_) -> true
}

-- Options ---------------------------------------------------------------------------------------
--
-- There is no `Option` type: any union with a `#some(a)` tag is option-like, and these helpers
-- keep every other tag as it is. `Option` is only the name they are attached to, so they are
-- called as `Option.map(x, f)` or `x \Option.map(f)`.

-- Applies `f` to the value of `#some`.
export def Option.map: (#some(a) | r), (a -> b) -> #some(b) | r = {
  | #some(value), f -> #some(f(value))
  | other, _ -> other
}

-- Continues with `f` on the value of `#some`. The other tags of both steps are kept.
export def Option.bind: (#some(a) | r), (a -> #some(b) | r) -> #some(b) | r = {
  | #some(value), f -> f(value)
  | other, _ -> other
}

-- The value of `#some`, or `fallback` for any other tag.
export def Option.defaultValue: (#some(a) | r), a -> a = {
  | #some(value), _ -> value
  | _, fallback -> fallback
}

export def Option.isSome: (#some(a) | r) -> bool = {
  | #some(_) -> true
  | _ -> false
}

export def Option.isNone: (#some(a) | r) -> bool = {
  | #some(_) -> false
  | _ -> true
}

-- The value of `#some` as a success, or `error` for any other tag.
export def Option.toResult: (#some(a) | r), e -> Result(a, e) = {
  | #some(value), _ -> #some(value)
  | _, error -> #error(error)
}

-- `f` applied to the value of `#some`, or `default` for any other tag.
export def Option.mapOr: (#some(a) | r), b, (a -> b) -> b = {
  | #some(value), _, f -> f(value)
  | _, default, _ -> default
}

-- The value of `#some` as a one-element list, or the empty list for any other tag.
export def Option.toList: (#some(a) | r) -> list(a) = {
  | #some(value) -> [value]
  | _ -> []
}

-- The values of the `#some`s in `options`, in order. The other tags are dropped.
export def Option.values: list(#some(a) | r) -> list(a) = { options ->
  def keep = {
    | acc, #some(value) -> [value, ...acc]
    | acc, _ -> acc
  }

  options \List.fold([], keep) \List.reverse
}

-- Lists -----------------------------------------------------------------------------------------
--
-- Attached to `List`, so they are called as `List.map(xs, f)`, or as `xs \map(f)` when `xs` is
-- known to be a list. Lists are immutable: every function gives back a new list.
--
-- Every function here that walks a list is stack-safe: it calls itself only in tail position, so it
-- works on a list of any length. Those that build a list build it in reverse and reverse it at the
-- end, until tail recursion modulo cons exists (see docs/src/content/work-in-progress/tail-calls.md).

-- `step` applied to `initial` and the first element, then to that result and the second, and so on.
export def List.fold: list(a), b, (b, a -> b) -> b = {
  | [], acc, _ -> acc
  | [x, ...rest], acc, step -> List.fold(rest, step(acc, x), step)
}

-- The elements in reverse order.
export def List.reverse: list(a) -> list(a) = { xs ->
  List.fold(xs, [], { acc, x -> [x, ...acc] })
}

-- The number of elements.
export def List.length: list(a) -> int = { xs ->
  List.fold(xs, 0, { count, _ -> count + 1 })
}

-- The elements added together: `[1, 2, 3] \List.sum` is 6, and the sum of no elements is `zero`.
export def List.sum: [Add(a)] list(a) -> a = { xs ->
  List.fold(xs, zero, { total, x -> total + x })
}

-- The first element, or `#emptyList`.
export def List.head: list(a) -> #some(a) | #emptyList = {
  | [] -> #emptyList
  | [x, ..._] -> #some(x)
}

-- `xs` reversed, in front of `tail`. It takes `xs` apart in a match arm that builds a cell of the same
-- size, so a list held only here has its cells rewritten in place rather than copied.
def reverseOnto: list(a), list(a) -> list(a) = {
  | [], tail -> tail
  | [x, ...rest], tail -> reverseOnto(rest, [x, ...tail])
}

-- `f` applied to each element of `xs`, last first, in front of `acc`.
def mapReversed: list(a), (a -> b), list(b) -> list(b) = {
  | [], _, acc -> acc
  | [x, ...rest], f, acc -> mapReversed(rest, f, [f(x), ...acc])
}

-- `f` applied to each element, in order. Stack-safe: it works on a list of any length.
export def List.map: list(a), (a -> b) -> list(b) = { xs, f ->
  reverseOnto(mapReversed(xs, f, []), [])
}

-- The elements of `xs` that `keep` holds for, last first, in front of `acc`.
def filterReversed: list(a), (a -> bool), list(a) -> list(a) = {
  | [], _, acc -> acc
  | [x, ...rest], keep, acc -> filterReversed(rest, keep, if keep(x) then [x, ...acc] else acc)
}

-- The elements `keep` holds for, in order. Stack-safe: it works on a list of any length.
export def List.filter: list(a), (a -> bool) -> list(a) = { xs, keep ->
  reverseOnto(filterReversed(xs, keep, []), [])
}

-- The first element `matches` holds for, or `#notFound`.
export def List.find: list(a), (a -> bool) -> #some(a) | #notFound = {
  | [], _ -> #notFound
  | [x, ...rest], matches -> if matches(x) then #some(x) else List.find(rest, matches)
}

-- Whether `test` holds for every element (so `true` for an empty list).
export def List.all: list(a), (a -> bool) -> bool = {
  | [], _ -> true
  | [x, ...rest], test -> if test(x) then List.all(rest, test) else false
}

-- Whether `test` holds for any element (so `false` for an empty list).
export def List.any: list(a), (a -> bool) -> bool = {
  | [], _ -> false
  | [x, ...rest], test -> if test(x) then true else List.any(rest, test)
}

-- `List.fold` from the last element to the first.
export def List.foldBack: list(a), b, (b, a -> b) -> b = { xs, initial, step ->
  List.fold(List.reverse(xs), initial, step)
}

-- `xs` with `x` added at the end. Not written `xs ++ [x]`, since `++` copies its left operand by
-- recursing once per element (#558).
export def List.append: list(a), a -> list(a) = { xs, x ->
  reverseOnto(reverseOnto(xs, []), [x])
}

-- The lists of `xss` joined end to end. Stack-safe: it works however long the lists are.
export def List.flatten: list(list(a)) -> list(a) = { xss ->
  reverseOnto(List.fold(xss, [], { acc, xs -> reverseOnto(xs, acc) }), [])
}

-- The first `count` elements of `xs`, last first, in front of `acc`.
def takeReversed: list(a), int, list(a) -> list(a) = {
  | [], _, acc -> acc
  | [x, ...rest], count, acc -> if count <= 0
    then acc
    else takeReversed(rest, count - 1, [x, ...acc])
}

-- The first `count` elements (all of them when there are fewer). Stack-safe: it works on a list of
-- any length.
export def List.take: list(a), int -> list(a) = { xs, count ->
  reverseOnto(takeReversed(xs, count, []), [])
}

-- The elements after the first `count`.
export def List.skip: list(a), int -> list(a) = {
  | [], _ -> []
  | [x, ...rest], count -> if count <= 0 then [x, ...rest] else List.skip(rest, count - 1)
}

-- Pairs of the elements of `xs` and `ys` at the same position, last first, in front of `acc`.
def zipReversed: list(a), list(b), list((a, b)) -> list((a, b)) = {
  | [x, ...xs], [y, ...ys], acc -> zipReversed(xs, ys, [(x, y), ...acc])
  | _, _, acc -> acc
}

-- Pairs of the elements at the same position, as long as the shorter list. Stack-safe: it works on
-- lists of any length.
export def List.zip: list(a), list(b) -> list((a, b)) = { xs, ys ->
  reverseOnto(zipReversed(xs, ys, []), [])
}

-- The elements without repeats, each kept where it first appears. Elements are compared with `==`,
-- by their structure, so this works for lists of anything but functions.
export def List.distinct: [Eq(a)] list(a) -> list(a) = { xs ->
  List.reverse(
    List.fold(xs, [], { seen, x -> if List.any(seen, { y -> y == x }) then seen else [x, ...seen] })
  )
}

-- `xs` and `ys`, each already in order of `key`, merged into one list in that order, after the
-- elements of `acc` (which holds the merged elements so far, last first). Of two elements with the
-- same key, the one from `xs` comes first.
def mergeBy: [Ord(b)] list(a), list(a), (a -> b), list(a) -> list(a) = {
  | [], ys, _, acc -> reverseOnto(acc, ys)
  | xs, [], _, acc -> reverseOnto(acc, xs)
  | [x, ...xs], [y, ...ys], key, acc -> if key(y) < key(x)
    then mergeBy([x, ...xs], ys, key, [y, ...acc])
    else mergeBy(xs, [y, ...ys], key, [x, ...acc])
}

-- `runs` with each pair of neighbouring runs merged into one, in order, after the reversed `acc`.
def mergePairs: [Ord(b)] list(list(a)), (a -> b), list(list(a)) -> list(list(a)) = {
  | [xs, ys, ...rest], key, acc -> mergePairs(rest, key, [mergeBy(xs, ys, key, []), ...acc])
  | rest, _, acc -> reverseOnto(acc, rest)
}

-- The elements of `runs`, each run already in order of `key`, merged into one list in that order.
def mergeRuns: [Ord(b)] list(list(a)), (a -> b) -> list(a) = {
  | [], _ -> []
  | [run], _ -> run
  | runs, key -> mergeRuns(mergePairs(runs, key, []), key)
}

-- The elements in ascending order of `key`. The sort is stable: elements with the same key keep
-- their order. A key can be of any type with an order: `List.sortBy(people, { p -> p.name })`.
-- Stack-safe: it works on a list of any length.
export def List.sortBy: [Ord(b)] list(a), (a -> b) -> list(a) = { xs, key ->
  mergeRuns(List.map(xs, { x -> [x] }), key)
}

-- The elements in ascending order. The sort is stable. Stack-safe: it works on a list of any length.
export def List.sort: [Ord(a)] list(a) -> list(a) = { xs ->
  List.sortBy(xs, { x -> x })
}

-- The least of `least` and the elements of `xs`, the first of them when several are least.
def leastOf: [Ord(a)] list(a), a -> a = {
  | [], least -> least
  | [x, ...rest], least -> leastOf(rest, if x < least then x else least)
}

-- The greatest of `greatest` and the elements of `xs`, the first of them when several are greatest.
def greatestOf: [Ord(a)] list(a), a -> a = {
  | [], greatest -> greatest
  | [x, ...rest], greatest -> greatestOf(rest, if x > greatest then x else greatest)
}

-- The least element, or `#emptyList`. Of several least elements, the first.
export def List.min: [Ord(a)] list(a) -> #some(a) | #emptyList = {
  | [] -> #emptyList
  | [x, ...rest] -> #some(leastOf(rest, x))
}

-- The greatest element, or `#emptyList`. Of several greatest elements, the first.
export def List.max: [Ord(a)] list(a) -> #some(a) | #emptyList = {
  | [] -> #emptyList
  | [x, ...rest] -> #some(greatestOf(rest, x))
}

-- The elements `step` gives from `state` on, last first, in front of `acc`.
def unfoldReversed: b, (b -> #some(a, b) | #done), list(a) -> list(a) = { state, step, acc ->
  match step(state)
    | #some(x, next) -> unfoldReversed(next, step, [x, ...acc])
    | #done -> acc
}

-- The elements `step` gives, starting from `state`: `#some(x, next)` gives `x` and carries on from
-- `next`, and `#done` ends the list. Stack-safe: it works however many elements `step` gives.
export def List.unfold: b, (b -> #some(a, b) | #done) -> list(a) = { state, step ->
  reverseOnto(unfoldReversed(state, step, []), [])
}

-- Maps ------------------------------------------------------------------------------------------
--
-- A `map(k, v)` holds one value for each of its keys. It is written `["a" => 1, "b" => 2]`, and
-- calling it looks a key up: `m("a")` is `Map.get(m, "a")`. Keys are compared with `==`, so a map
-- needs an `Eq` of its key type. Attached to `Map`, so they are called as `Map.insert(m, k, v)`, or
-- as `m \insert(k, v)` when `m` is known to be a map. Maps are immutable: every function gives back
-- a new map.
--
-- For now a map holds a list of its entries, each key once, in the order the keys were first added,
-- so a lookup walks the list (see docs/src/content/work-in-progress/maps-and-sets.md).

-- The value `entries` holds for `key`, or `#notFound`.
def findEntry: [Eq(k)] list((k, v)), k -> #some(v) | #notFound = {
  | [], _ -> #notFound
  | [(entryKey, value), ...rest], key -> if entryKey == key
    then #some(value)
    else findEntry(rest, key)
}

-- `entries` with `key` holding `value`: in its place if `entries` has it, else at the end. `acc`
-- holds the entries before, last first.
def insertEntry: [Eq(k)] list((k, v)), k, v, list((k, v)) -> list((k, v)) = {
  | [], key, value, acc -> reverseOnto(acc, [(key, value)])
  | [(entryKey, entryValue), ...rest], key, value, acc -> if entryKey == key
    then reverseOnto(acc, [(key, value), ...rest])
    else insertEntry(rest, key, value, [(entryKey, entryValue), ...acc])
}

-- `entries` without `key`. `acc` holds the entries before, last first.
def removeEntry: [Eq(k)] list((k, v)), k, list((k, v)) -> list((k, v)) = {
  | [], _, acc -> reverseOnto(acc, [])
  | [(entryKey, value), ...rest], key, acc -> if entryKey == key
    then reverseOnto(acc, rest)
    else removeEntry(rest, key, [(entryKey, value), ...acc])
}

-- `m` with each of `entries` inserted in turn.
def insertAll: [Eq(k)] map(k, v), list((k, v)) -> map(k, v) = {
  | m, [] -> m
  | m, [(key, value), ...rest] -> insertAll(Map.insert(m, key, value), rest)
}

-- The map with no keys. A map literal has at least one entry, since [] is the empty list.
export def Map.empty: map(k, v) = __nanyx_map_of_entries([])

-- What the compiler makes a map literal call: `["a" => 1, "b" => 2]` is
-- `__map([("a", 1), ("b", 2)])`. A key written twice holds the value written last.
export def __map: [Eq(k)] list((k, v)) -> map(k, v) = { entries ->
  insertAll(Map.empty, entries)
}

-- The map holding each of `entries`, in order: of two entries with the same key, the later wins.
export def Map.fromList: [Eq(k)] list((k, v)) -> map(k, v) = { entries ->
  insertAll(Map.empty, entries)
}

-- The entries of `m`, each a key and its value, in the order the keys were first added.
export def Map.toList: map(k, v) -> list((k, v)) = { m ->
  __nanyx_map_entries(m)
}

-- The value `m` holds for `key`, or `#notFound`. Calling the map, `m(key)`, is the same.
export def Map.get: [Eq(k)] map(k, v), k -> #some(v) | #notFound = { m, key ->
  findEntry(__nanyx_map_entries(m), key)
}

-- Whether `m` holds a value for `key`.
export def Map.containsKey: [Eq(k)] map(k, v), k -> bool = { m, key ->
  Option.isSome(findEntry(__nanyx_map_entries(m), key))
}

-- `m` with `key` holding `value`, in place of any value it held before.
export def Map.insert: [Eq(k)] map(k, v), k, v -> map(k, v) = { m, key, value ->
  __nanyx_map_of_entries(insertEntry(__nanyx_map_entries(m), key, value, []))
}

-- `m` without `key` or its value. A map that has no `key` is given back as it is.
export def Map.remove: [Eq(k)] map(k, v), k -> map(k, v) = { m, key ->
  __nanyx_map_of_entries(removeEntry(__nanyx_map_entries(m), key, []))
}

-- The number of keys.
export def Map.count: map(k, v) -> int = { m ->
  List.length(__nanyx_map_entries(m))
}

-- `groups` with the elements of `xs` added, each to the front of the group of its key.
def groupInto: [Eq(b)] list(a), (a -> b), map(b, list(a)) -> map(b, list(a)) = {
  | [], _, groups -> groups
  | [x, ...rest], key, groups ->
    def group = Option.defaultValue(Map.get(groups, key(x)), [])
    groupInto(rest, key, Map.insert(groups, key(x), [x, ...group]))
}

-- The elements of `xs` grouped by `key`: a map from each key to the elements that have it, in
-- order. The keys are in the order they first appear.
export def List.groupBy: [Eq(b)] list(a), (a -> b) -> map(b, list(a)) = { xs, key ->
  def groups = __nanyx_map_entries(groupInto(xs, key, Map.empty))
  __nanyx_map_of_entries(List.map(groups, { group -> (group.0, List.reverse(group.1)) }))
}
