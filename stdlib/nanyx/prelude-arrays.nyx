@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- Arrays ----------------------------------------------------------------------------------------

-- An array's functions are in `nanyx/array`. What the compiler derives for an array's `==` and
-- `toString` calls these, which every module can reach, and calling an array, `xs(i)`, calls
-- `array.at`.

--| The element of `xs` at `index`, counting from 0, or `#none` when `index` is negative or past the
  end. Calling the array, `xs(index)`, is the same.
export def array.at: array(a), int -> #some(a) | #none = { xs, index ->
  if index >= 0 and index < __nanyx_array_length(xs)
    then #some(__nanyx_array_get(xs, index))
    else #none
}

--| Whether the arrays `xs` and `ys` hold equal elements in the same order, as `same` compares two
  elements. The `==` the compiler derives for an array calls it.
export def __arrayEqualsBy: [c] array(a), array(a), ([c] a, a -> bool) -> bool = { xs, ys, same ->
  __listEqualsBy(__nanyx_array_to_list(xs), __nanyx_array_to_list(ys), same)
}

--| `xs` in square brackets, each element written by `show`, with `, ` between them, as a list is
  written. The `toString` the compiler derives for an array calls it.
export def __arrayToString: [c] array(a), ([c] a -> string) -> string = { xs, show ->
  __listToString(__nanyx_array_to_list(xs), show)
}

--| `xs` itself. What a literal builds an array with, `Array[1, 2]`, or `[1, 2]` where an array is
  expected.
export def array.fromArray: array(a) -> array(a) = { xs -> xs }

--| The elements of `xs`, in order. What a literal builds a list with where it is written
  `List[...]`.
export def list.fromArray: array(a) -> list(a) = { xs ->
  __nanyx_array_to_list(xs)
}

--| The array of the elements of `xs`, in order: what a collection literal's items are passed to
  its type's `fromArray` as (see `array.fromArray`).
export def __arrayOf: list(a) -> array(a) = { xs ->
  __nanyx_array_of_list(xs)
}

--| The elements of the array `xs`, which a collection literal spreads, `[...xs]`.
export def __spreadArray: array(a) -> list(a) = { xs ->
  __nanyx_array_to_list(xs)
}

--| The list `xs`, which a collection literal spreads, `[...xs]`.
export def __spreadList: list(a) -> list(a) = { xs -> xs }
