--| Slices: views of part of an array, which share its storage instead of copying it.

  A `Slice(a)` is a view of a run of an `Array(a)`'s elements: the array, where the run starts and
  how long it is. Making one with [`array.slice`], or a slice of a slice, copies nothing and takes
  the same time however long the run is. A slice holds the array it views, so the array stays
  alive as long as the slice is used, and [`Slice.toArray`] copies the run into an array of its
  own, which lets go of the larger one.

  Bounds clamp: `array.slice(xs, from, to)` is the elements from `from` up to but not including
  `to`, each bound moved into `0` to the length, and an empty slice when `to` is before `from`.
  Reading one element, [`Slice.at`], gives `#notFound` past the end, never a trap.

  A function that makes new elements, such as [`Slice.map`], [`Slice.filter`] or [`Slice.sort`],
  gives them in an `Array` of their own. [`Slice.take`] and [`Slice.skip`] give a slice of the same
  array, as [`Slice.slice`] does, and copy nothing.

  Each function is attached to `Slice`, so with `import nanyx/slice` it is called as
  `Slice.length(s)`, or as `s \length`; `xs \slice(1, 4)` makes a slice of the array `xs`, and the
  literal `Slice[1, 2, 3]` a slice of all of a new array.
module slice

import nanyx/array

export type Slice(a) = private (items: Array(a), start: int, length: int)

--| `value` moved into the range from `low` to `high`.
def clamp: int, int, int -> int = { value, low, high ->
  if value < low then low else if value > high then high else value
}

--| The run of `length` elements of `items` from `start`, bounds from `from` up to `to` clamped into
  it.
def within: Array(a), int, int, int, int -> Slice(a) = { items, start, length, from, to ->
  def first = clamp(from, 0, length)
  def last = clamp(to, first, length)
  Slice(items = items, start = start + first, length = last - first)
}

--| The elements of `xs` from `from` up to but not including `to`, sharing `xs`'s storage: each bound
  is moved into `0` to the length of `xs`, so `xs \slice(1, 100)` is everything after the first.
export def array.slice: array(a), int, int -> Slice(a) = { xs, from, to ->
  within(xs, 0, array.length(xs), from, to)
}

--| All of `xs`, as a slice that shares its storage. The literal `Slice[1, 2, 3]` is made with it.
export def Slice.fromArray: Array(a) -> Slice(a) = { xs ->
  Slice(items = xs, start = 0, length = array.length(xs))
}

--| The elements of `xs`, in order, as a slice of all of a new array.
export def Slice.fromList: list(a) -> Slice(a) = { xs ->
  Slice.fromArray(array.fromList(xs))
}

--| How many elements `s` views.
export def Slice.length: Slice(a) -> int = { s ->
  s.length
}

--| Whether `s` views no elements.
export def Slice.isEmpty: Slice(a) -> bool = { s ->
  s.length == 0
}

--| The element of `s` at `index`, counting from 0 at the start of `s`, or `#notFound` when `index`
  is negative or past its end.
export def Slice.at: Slice(a), int -> #some(a) | #notFound = { s, index ->
  if index >= 0 and index < s.length then array.at(s.items, s.start + index) else #notFound
}

--| The elements of `s` from `from` up to but not including `to`, counting from the start of `s`,
  sharing the same storage. The bounds clamp into `s`, as [`array.slice`]'s do.
export def Slice.slice: Slice(a), int, int -> Slice(a) = { s, from, to ->
  within(s.items, s.start, s.length, from, to)
}

--| `step` applied to `initial` and the first element, then to that and the second, and so on: the
  last result, or `initial` for an empty slice.
export def Slice.fold: [c] Slice(a), b, ([c] b, a -> b) -> b = { s, initial, step ->
  foldFrom(s, 0, initial, step)
}

--| The elements of `s` combined with `f`, in order, starting from the first: a slice of `1` to `5`
  reduced with `{ * }` is `#some(120)`, and an empty slice, having no first element, gives `#none`.
  To start from another value, use [`Slice.fold`].
export def Slice.reduce: [c] Slice(a), ([c] a, a -> a) -> #some(a) | #none = { s, f ->
  match Slice.at(s, 0)
    | #some(first) -> #some(foldFrom(s, 1, first, f))
    | #notFound -> #none
}

def foldFrom: [c] Slice(a), int, b, ([c] b, a -> b) -> b = { s, index, acc, step ->
  match Slice.at(s, index)
    | #some(element) -> foldFrom(s, index + 1, step(acc, element), step)
    | #notFound -> acc
}

--| [`Slice.fold`] from the last element to the first, without copying: a slice of `"a"`, `"b"` and
  `"c"` folded back with `{ acc, x -> acc ++ x }` from `""` is `"cba"`.
export def Slice.foldBack: [c] Slice(a), b, ([c] b, a -> b) -> b = { s, initial, step ->
  foldBackFrom(s, s.length - 1, initial, step)
}

--| [`Slice.fold`] that can stop part-way: `step` gives `#some(acc)` to go on to the next element,
  and anything else it gives ends the fold there and is its result, as it is. A fold that runs to the
  end gives `#some(acc)`. `step` isn't called again after it stops.
export def Slice.foldWhile
  : [c] Slice(a), b, ([c] b, a -> #some(b) | r) -> #some(b) | r
  = { s, initial, step ->
    foldWhileFrom(s, 0, initial, step)
  }

-- [`Slice.foldWhile`] of the elements of `s` from `index` on.
def foldWhileFrom
  : [c] Slice(a), int, b, ([c] b, a -> #some(b) | r) -> #some(b) | r
  = { s, index, acc, step ->
    match Slice.at(s, index)
      | #some(element) ->
        match step(acc, element)
          | #some(next) -> foldWhileFrom(s, index + 1, next, step)
          | r -> r
      | #notFound -> #some(acc)
  }

--| The elements of `s`, in order, each read when the sequence is pulled. A slice is [`Iterable`] by
  it, so a `for` loop walks one.
export def Slice.toSeq: Slice(a) -> seq(a) = { s ->
  seq.unfold(
    0
    { index ->
      match Slice.at(s, index)
        | #some(element) -> #some(element, index + 1)
        | #notFound -> #done
    }
  )
}

--| The elements of `s`, in order, as a list.
export def Slice.toList: Slice(a) -> list(a) = { s ->
  list.reverse(Slice.fold(s, [], { acc, element -> [element, ...acc] }))
}

--| A copy of the elements of `s`, in order, as an array of its own, which doesn't keep the array
  `s` views alive.
export def Slice.toArray: Slice(a) -> Array(a) = { s ->
  Slice.map(s, { x -> x })
}

--| An array of `f` applied to each element of `s`, in order.
export def Slice.map: [c] Slice(a), ([c] a -> b) -> Array(b) = { s, f ->
  mapFrom(s, __nanyx_array_new(s.length), 0, f)
}

-- `made`, a new array as long as `s`, once `f` of each element of `s` from `index` on is written
-- into it.
def mapFrom: [c] Slice(a), array(b), int, ([c] a -> b) -> array(b) = { s, made, index, f ->
  if index < s.length then
    __nanyx_array_write(made, index, f(__nanyx_array_get(s.items, s.start + index)))
    mapFrom(s, made, index + 1, f)
  else made
}

-- `step` applied to `acc` and each element of `s` from `index` down to the first, last first: a
-- list built by putting each element in front of `acc` comes out in order.
def foldBackFrom: [c] Slice(a), int, b, ([c] b, a -> b) -> b = { s, index, acc, step ->
  match Slice.at(s, index)
    | #some(element) -> foldBackFrom(s, index - 1, step(acc, element), step)
    | #notFound -> acc
}

--| An array of the elements of `s` that `keep` holds for, in order.
export def Slice.filter: [c] Slice(a), ([c] a -> bool) -> Array(a) = { s, keep ->
  array.fromList(
    foldBackFrom(s, s.length - 1, [], { acc, x -> if keep(x) then [x, ...acc] else acc })
  )
}

--| An array of the values `f` gives as `#some`, in order, leaving out the elements it gives `#skip`
  for: a `map` and a `filter` in one walk.
export def Slice.filterMap: [c] Slice(a), ([c] a -> #some(b) | #skip) -> Array(b) = { s, f ->
  array.fromList(
    foldBackFrom(
      s
      s.length - 1
      []
      { acc, x ->
        match f(x)
          | #some(y) -> [y, ...acc]
          | #skip -> acc
      }
    )
  )
}

--| An array of the values `f` emits for each element in turn, in the order it emits them, as
  [`list.select`] gives them: `f` calls [`Emit`]'s `emit` for each.
export def Slice.select: [c] Slice(a), ([c, Emit(b)] a -> ()) -> Array(b) = { s, f ->
  array.fromList(list.select(Slice.toList(s), f))
}

--| The first value `f` yields, running it on the elements in turn, or `#notFound` when it yields
  none. A lambda with `yield` in it is a lazy sequence (see [`Yield`]), so this stops at the first
  yield: `f` runs on no element after the one it yields for.
export def Slice.selectOne
  : [c, d] Slice(a), ([c] a -> [d] seq(b)) -> #some(b) | #notFound
  = { s, f ->
    def selected = s \Slice.toSeq \seq.flatMap(f)

    match selected.next()
      | #next(y, _) -> #some(y)
      | #done -> #notFound
  }

-- The position of the first element of `s` from `index` on that `matches` holds for.
def findIndexFrom
  : [c] Slice(a), int, ([c] a -> bool) -> #some(int) | #notFound
  = { s, index, matches ->
    match Slice.at(s, index)
      | #some(element) -> (if matches(element)
        then #some(index)
        else findIndexFrom(s, index + 1, matches))
      | #notFound -> #notFound
  }

--| The first element `matches` holds for, or `#notFound`.
export def Slice.find: [c] Slice(a), ([c] a -> bool) -> #some(a) | #notFound = { s, matches ->
  match findIndexFrom(s, 0, matches)
    | #some(index) -> Slice.at(s, index)
    | #notFound -> #notFound
}

--| The position of the first element `matches` holds for, counting from 0 at the start of `s`, as
  [`Slice.at`] does, or `#notFound`.
export def Slice.findIndex
  : [c] Slice(a), ([c] a -> bool) -> #some(int) | #notFound
  = { s, matches ->
    findIndexFrom(s, 0, matches)
  }

--| Whether `test` holds for any element (so `false` for an empty slice).
export def Slice.any: [c] Slice(a), ([c] a -> bool) -> bool = { s, test ->
  findIndexFrom(s, 0, test) is #some(_)
}

--| Whether `test` holds for every element (so `true` for an empty slice).
export def Slice.all: [c] Slice(a), ([c] a -> bool) -> bool = { s, test ->
  findIndexFrom(s, 0, { x -> not test(x) }) is #notFound
}

--| Whether an element of `s` is equal to `x`. Elements are compared with `==`, by their structure.
export def Slice.contains: [Eq(a)] Slice(a), a -> bool = { s, x ->
  Slice.any(s, { y -> y == x })
}

--| An array of the elements of `s`, last first.
export def Slice.reverse: Slice(a) -> Array(a) = { s ->
  array.init(s.length, { index -> __nanyx_array_get(s.items, s.start + s.length - 1 - index) })
}

--| An array of the elements of `s` in the order `order` gives: `order(a, b)` says whether `a` comes
  before `b` (`#less`), after it (`#greater`), or either way (`#equal`), as `compare` does. The sort
  is stable: elements `order` finds equal keep their order. It is [`array.sortWith`] of a copy of
  the elements.
export def Slice.sortWith
  : [c] Slice(a), ([c] a, a -> #less | #equal | #greater) -> Array(a)
  = { s, order ->
    array.sortWith(Slice.toArray(s), order)
  }

--| An array of the elements of `s` in ascending order of `key`. The sort is stable: elements with the
  same key keep their order.
export def Slice.sortBy: [Ord(b), c] Slice(a), ([c] a -> b) -> Array(a) = { s, key ->
  Slice.sortWith(s, { x, y -> compare(key(x), key(y)) })
}

--| An array of the elements of `s` in ascending order of their `Ord`. The sort is stable.
export def Slice.sort: [Ord(a)] Slice(a) -> Array(a) = { s ->
  Slice.sortWith(s, compare)
}

--| The first `count` elements of `s` (all of them when there are fewer), as a slice of the same
  array: it copies nothing.
export def Slice.take: Slice(a), int -> Slice(a) = { s, count ->
  Slice.slice(s, 0, count)
}

--| The elements of `s` after the first `count`, as a slice of the same array: it copies nothing.
export def Slice.skip: Slice(a), int -> Slice(a) = { s, count ->
  Slice.slice(s, count, s.length)
}

--| An array of pairs of the elements of `xs` and `ys` at the same position, as long as the shorter.
export def Slice.zip: Slice(a), Slice(b) -> Array((a, b)) = { xs, ys ->
  array.init(
    (if xs.length < ys.length then xs.length else ys.length)
    { index ->
      (__nanyx_array_get(xs.items, xs.start + index), __nanyx_array_get(ys.items, ys.start + index))
    }
  )
}

--| An array of the running totals of a fold: `initial`, then each value [`Slice.fold`] passes along,
  so the last is what the fold gives back, and it holds one more element than `s`.
export def Slice.scan: [c] Slice(a), b, ([c] b, a -> b) -> Array(b) = { s, initial, step ->
  scanFrom(s, __nanyx_array_new(s.length + 1), 0, initial, step)
}

-- `made`, a new array one longer than `s`, once `state` is written at `index` and each value `step`
-- makes of it and the elements of `s` from `index` on after it.
def scanFrom
  : [c] Slice(a), array(b), int, b, ([c] b, a -> b) -> array(b)
  = { s, made, index, state, step ->
    __nanyx_array_write(made, index, state)

    if index < s.length
      then scanFrom(
        s
        made
        index + 1
        step(state, __nanyx_array_get(s.items, s.start + index))
        step
      )
      else made
  }
