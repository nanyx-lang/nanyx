@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- Instant ---------------------------------------------------------------------------------------
--
-- Dates are proleptic Gregorian. A day's date is worked out from the number of days since 1970
-- and back with Howard Hinnant's `civil_from_days` and `days_from_civil`, in whole numbers only.

--| A point in time: a number of nanoseconds since the start of 1970, UTC (Unix time), which
  reaches about 292 years either side of it. `Clock`'s `now` gives one. The time between two is
  their difference, exactly, and a time added to one moves it: `now() - start` and `now() + 5s`.
  [`Instant.since`], [`Instant.plus`] and [`Instant.minus`] are the same by name, and `minus` moves
  one back, `now() \minus(5s)`, which `-` doesn't, as it is the time between two. [`Instant.shift`]
  moves one by a time that may be negative either way: `now() \shift(-5s)`. It is written as
  ISO 8601 writes it, in UTC: `"{i}"` is `2026-11-25T18:20:57Z`.
export type Instant = private int

--| The start of 1970, UTC, which a host's clock counts its time of day from:
  `Instant.epoch \plus(1_700_000_000s)`.
export def Instant.epoch: Instant = Instant(0)

--| The time from `earlier` to `i`, exactly: `now() \since(start)` is how long has passed since
  `start`. It is negative if `earlier` is after `i`. It is [`Instant.-`] by name.
export def Instant.since: Instant, Instant -> Time(int) = { Instant(nanos), Instant(earlier) ->
  (nanos - earlier) * 1ns
}

--| The instant `time` after `i`: `now() \plus(5s)`. It is [`Instant.+`] by name.
export def Instant.plus: Instant, Time(int) -> Instant = { Instant(nanos), time ->
  Instant(nanos + time // 1ns)
}

--| The instant `time` before `i`: `now() \minus(1d)`. `-` is the time between two instants, so
  moving one back is by name only.
export def Instant.minus: Instant, Time(int) -> Instant = { Instant(nanos), time ->
  Instant(nanos - time // 1ns)
}

--| The instant `time` from `i`: on for a positive time and back for a negative one, as a time
  worked out at run time may be either. `now() \shift(-5s)` is five seconds ago.
export def Instant.shift: Instant, Time(int) -> Instant = { Instant(nanos), time ->
  Instant(nanos + time // 1ns)
}

--| The time from `earlier` to `i`, exactly, as [`Instant.since`] gives it: `now() - start`.
export def Instant.`-`: Instant, Instant -> Time(int) = { i, earlier ->
  Instant.since(i, earlier)
}

--| The instant `time` after `i`, as [`Instant.plus`] gives it: `now() + 5s`.
export def Instant.`+`: Instant, Time(int) -> Instant = { i, time ->
  Instant.plus(i, time)
}

--| The time from [`Instant.epoch`], the start of 1970, UTC, to `at`: its Unix time. Divide it by a
  unit for a number of them, as an API that takes Unix time wants: `now() \toUnixTime // 1ms` is
  the milliseconds since 1970, and `// 1s` the seconds.
export def Instant.toUnixTime: Instant -> Time(int) = { at ->
  at \since(Instant.epoch)
}

-- The nanoseconds in a second, and the seconds in a day.
def isoSecond: int = 1_000_000_000

def isoDay: int = 86_400

--| The year, month and day, in UTC, of the day `days` days after 1 January 1970.
def isoCivil: int -> (year: int, month: int, day: int) = { days ->
  def shifted = days + 719_468
  def era = shifted // 146_097
  def ofEra = shifted - era * 146_097
  def yearOfEra = (ofEra - ofEra // 1_460 + ofEra // 36_524 - ofEra // 146_096) // 365
  def ofYear = ofEra - (365 * yearOfEra + yearOfEra // 4 - yearOfEra // 100)
  def shiftedMonth = (5 * ofYear + 2) // 153
  def month = if shiftedMonth < 10 then shiftedMonth + 3 else shiftedMonth - 9

  (
    year = yearOfEra + era * 400 + (if month <= 2 then 1 else 0)
    month = month
    day = ofYear - (153 * shiftedMonth + 2) // 5 + 1
  )
}

--| How many days after 1 January 1970 the day `day` of the month `month` of the year `year` is.
def isoDaysOf: int, int, int -> int = { year, month, day ->
  def marchYear = if month <= 2 then year - 1 else year
  def era = marchYear // 400
  def yearOfEra = marchYear - era * 400
  def ofYear = (153 * (if month > 2 then month - 3 else month + 9) + 2) // 5 + day - 1
  era * 146_097 + yearOfEra * 365 + yearOfEra // 4 - yearOfEra // 100 + ofYear - 719_468
}

--| How many days the month `month` of the year `year` has.
def isoMonthLength: int, int -> int = { year, month ->
  if month == 2 then
    if year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) then 29 else 28
  else if month == 4 or month == 6 or month == 9 or month == 11 then 30 else 31
}

--| `text` with zeros in front of it until it is `width` long.
def isoZeros: string, int -> string = { text, width ->
  if __nanyx_string_length(text) >= width then text else isoZeros("0" ++ text, width)
}

--| `n`, which is not negative, in decimal, with zeros in front of it until it is `width` digits.
def isoPadded: int, int -> string = { n, width ->
  isoZeros("{n}", width)
}

--| The year `year` as ISO 8601 writes it: four digits from 0000 to 9999, and a sign and six digits
  outside them, its expanded form.
def isoYear: int -> string = { year ->
  if year >= 0 and year <= 9_999
    then isoPadded(year, 4)
    else if year < 0 then "-{isoPadded(0 - year, 6)}" else "+{isoPadded(year, 6)}"
}

--| The date `days` days after 1 January 1970, as ISO 8601 writes it: `2026-11-25`.
def isoDate: int -> string = { days ->
  def date = isoCivil(days)
  "{isoYear(date.year)}-{isoPadded(date.month, 2)}-{isoPadded(date.day, 2)}"
}

--| `nanos` nanoseconds, from 0 to a second, as the fraction of a second after the seconds: nothing
  for none, and else a point and as few digits as are needed, `.25` for a quarter of a second.
def isoFraction: int -> string = { nanos ->
  if nanos == 0 then "" else ".{isoTrimmed(nanos, 9)}"
}

--| The `width` digits of `n` with the zeros at their end left off.
def isoTrimmed: int, int -> string = { n, width ->
  if n % 10 == 0 then isoTrimmed(n // 10, width - 1) else isoPadded(n, width)
}

--| `i` as ISO 8601 writes it, in UTC: its date and its time of day, `2026-11-25T18:20:57Z`, with
  the fraction of a second only when it isn't whole, in as few digits as are needed, up to
  nanoseconds: `2026-11-25T18:20:57.25Z`. A time before 1970 is written the same way:
  `1969-12-31T23:59:59Z`. It is what `"{i}"` writes.
export def Instant.toIsoString: Instant -> string = { Instant(nanos) ->
  def seconds = nanos // isoSecond
  def ofDay = seconds % isoDay
  def hours = isoPadded(ofDay // 3_600, 2)
  def minutes = isoPadded(ofDay % 3_600 // 60, 2)
  def wholeSeconds = isoPadded(ofDay % 60, 2)
  "{isoDate(seconds // isoDay)}T{hours}:{minutes}:{wholeSeconds}{isoFraction(nanos % isoSecond)}Z"
}

--| The UTC date of `i` alone, as ISO 8601 writes it: `2026-11-25`.
export def Instant.toIsoDate: Instant -> string = { Instant(nanos) ->
  isoDate(nanos // isoSecond // isoDay)
}

--| `i` as ISO 8601 writes it, in UTC (see [`Instant.toIsoString`]).
export def Instant.toString: Instant -> string = { i ->
  Instant.toIsoString(i)
}

--| Whether `a` and `b` are the same instant.
export def Instant.`==`: Instant, Instant -> bool = { Instant(a), Instant(b) ->
  a == b
}

--| Which of two instants comes first.
export def Instant.compare
  : Instant, Instant -> #less | #equal | #greater
  = { Instant(a), Instant(b) ->
    int.compare(a, b)
  }

--| The hash of `i`.
export def Instant.hash: Instant -> int = { Instant(nanos) ->
  int.hash(nanos)
}

--| Why a text is no ISO 8601 date and time: the byte at which it stops being one, counting from 0,
  and what ISO 8601 has there.
export type NotIso = (at: int, expected: string)

--| The byte of `text` at `at`, or -1 past its end.
def isoByte: string, int -> int = { text, at ->
  if at < __nanyx_string_length(text) then __nanyx_string_byte_at(text, at) else -1
}

--| The number the `count` digits of `text` at `at` write, after `sum`.
def isoDigits: string, int, int, int -> #some(int) | #notIso(NotIso) = { text, at, count, sum ->
  def byte = isoByte(text, at)

  if count == 0
    then #some(sum)
    else if byte >= 48 and byte <= 57
      then isoDigits(text, at + 1, count - 1, sum * 10 + byte - 48)
      else #notIso(NotIso(at = at, expected = "a digit"))
}

--| How many digits `text` has from `at` on, up to ten: more than any part of ISO 8601 has, so that
  a longer run is too long, whatever its length.
def isoDigitCount: string, int -> int = { text, at ->
  isoDigitRun(text, at, 0)
}

--| `counted`, and how many digits `text` has from `at` on, up to ten in all.
def isoDigitRun: string, int, int -> int = { text, at, counted ->
  def byte = isoByte(text, at)

  if counted < 10 and byte >= 48 and byte <= 57
    then isoDigitRun(text, at + 1, counted + 1)
    else counted
}

--| `#some()` if the byte of `text` at `at` is `byte`, which ISO 8601 writes as `written`.
def isoExpect: string, int, int, string -> #some() | #notIso(NotIso) = { text, at, byte, written ->
  if isoByte(text, at) == byte then #some() else #notIso(NotIso(at = at, expected = written))
}

--| `n`, read at `at`, if it is from `low` to `high`, which ISO 8601 says as `what`.
def isoWithin
  : int, int, int, int, string -> #some(int) | #notIso(NotIso)
  = { n, at, low, high, what ->
    if n >= low and n <= high then #some(n) else #notIso(NotIso(at = at, expected = what))
  }

--| The year written at the start of `text`, and where it ends: four digits, or a sign and four to
  six, ISO 8601's expanded form.
def isoYearAt: string -> #some(year: int, next: int) | #notIso(NotIso) = { text ->
  def first = isoByte(text, 0)
  def signed = first == 43 or first == 45
  def start = if signed then 1 else 0
  def count = isoDigitCount(text, start)
  def wanted = if signed then count >= 4 and count <= 6 else count == 4

  def expected = if signed then "a year of four to six digits" else "a year of four digits"

  if not wanted then #notIso(NotIso(at = start, expected = expected)) else
    match isoDigits(text, start, count, 0)
      | #some(year) -> #some(year = (if first == 45 then 0 - year else year), next = start + count)
      | _ -> #notIso(NotIso(at = start, expected = expected))
}

--| The fraction of a second written at `at`, in nanoseconds, after a point, and where it ends.
def isoFractionAt: string, int -> #some(nanos: int, next: int) | #notIso(NotIso) = { text, at ->
  if isoByte(text, at) != 46 then #some(nanos = 0, next = at) else
    def count = isoDigitCount(text, at + 1)

    if count == 0 or count > 9 then #notIso(
      NotIso(at = at + 1, expected = "one to nine digits of a second")
    ) else
      match isoDigits(text, at + 1, count, 0)
        | #some(digits) -> #some(nanos = digits * isoScale(9 - count), next = at + 1 + count)
        | #notIso(failure) -> #notIso(failure)
}

--| 10 to the power `n`.
def isoScale: int -> int = { n ->
  if n == 0 then 1 else 10 * isoScale(n - 1)
}

--| How many seconds ahead of UTC the offset written at `at` is: `Z`, none, or `+hh:mm` or
  `-hh:mm`, and where it ends.
def isoOffsetAt: string, int -> #some(seconds: int, next: int) | #notIso(NotIso) = { text, at ->
  def sign = isoByte(text, at)

  if sign == 90
    then #some(seconds = 0, next = at + 1)
    else if sign == 43 or sign == 45 then
      proc {
        def hours = try isoWithin(
          try isoDigits(text, at + 1, 2, 0)
          at + 1
          0
          23
          "an hour from 00 to 23"
        )

        try isoExpect(text, at + 3, 58, "':'")

        def minutes = try isoWithin(
          try isoDigits(text, at + 4, 2, 0)
          at + 4
          0
          59
          "minutes from 00 to 59"
        )

        def seconds = hours * 3_600 + minutes * 60
        return (seconds = (if sign == 45 then 0 - seconds else seconds), next = at + 6)
      }
    else #notIso(NotIso(at = at, expected = "'Z', or an offset such as '+01:00'"))
}

-- The first and last seconds of an instant, and the nanoseconds of a second at each.
def isoFirstSecond: int = -9_223_372_037

def isoLastSecond: int = 9_223_372_036

--| The instant `nanos` nanoseconds after the second `seconds` after the start of 1970, if an
  `Instant` reaches it.
def isoInstant: int, int -> #some(Instant) | #outOfRange = { seconds, nanos ->
  def below = seconds < isoFirstSecond or seconds == isoFirstSecond and nanos < 145_224_192
  def above = seconds > isoLastSecond or seconds == isoLastSecond and nanos > 854_775_807

  -- The first second's nanoseconds are counted from the second after it, which `int` reaches.
  if below or above
    then #outOfRange
    else if seconds < 0
      then #some(Instant((seconds + 1) * isoSecond + (nanos - isoSecond)))
      else #some(Instant(seconds * isoSecond + nanos))
}

--| The instant `text` writes, as ISO 8601 does: a date and a time of day, `2026-11-25T18:20:57Z`,
  with a fraction of a second if it has one, `…57.25Z`, and either `Z`, for UTC, or an offset
  from it, `+01:00`, which is taken off to give the time in UTC. A date alone, `2026-11-25`, is
  the start of that day in UTC. A year can be written with a sign and up to six digits, as ISO
  8601's expanded form writes it, `+012026`.

  It gives `#notIso` with the byte at which the text stops being ISO 8601, counting from 0, and
  what ISO 8601 has there; and `#outOfRange` for a time more than about 292 years from 1970,
  which no `Instant` reaches.
export def Instant.fromIsoString
  : string -> #some(Instant) | #notIso(NotIso) | #outOfRange
  = { text ->
    proc {
      def year = try isoYearAt(text)
      def at = year.next
      try isoExpect(text, at, 45, "'-'")

      def month = try isoWithin(
        try isoDigits(text, at + 1, 2, 0)
        at + 1
        1
        12
        "a month from 01 to 12"
      )

      try isoExpect(text, at + 3, 45, "'-'")
      def lastDay = isoMonthLength(year.year, month)

      def day = try isoWithin(
        try isoDigits(text, at + 4, 2, 0)
        at + 4
        1
        lastDay
        "a day of the month, from 01 to {lastDay}"
      )

      def days = isoDaysOf(year.year, month, day)
      def end = __nanyx_string_length(text)

      if at + 6 == end then (return try isoInstant(days * isoDay, 0)) else
        try isoExpect(text, at + 6, 84, "'T', or the end of the date")

        def hours = try isoWithin(
          try isoDigits(text, at + 7, 2, 0)
          at + 7
          0
          23
          "an hour from 00 to 23"
        )

        try isoExpect(text, at + 9, 58, "':'")

        def minutes = try isoWithin(
          try isoDigits(text, at + 10, 2, 0)
          at + 10
          0
          59
          "minutes from 00 to 59"
        )

        try isoExpect(text, at + 12, 58, "':'")

        def seconds = try isoWithin(
          try isoDigits(text, at + 13, 2, 0)
          at + 13
          0
          59
          "seconds from 00 to 59"
        )

        def fraction = try isoFractionAt(text, at + 15)
        def offset = try isoOffsetAt(text, fraction.next)

        try if offset.next == end
          then #some()
          else #notIso(NotIso(at = offset.next, expected = "the end of the text"))

        def local = days * isoDay + hours * 3_600 + minutes * 60 + seconds
        return try isoInstant(local - offset.seconds, fraction.nanos)
    }
  }
