--| Functions on strings.

  Each is attached to `string`, so with `import nanyx/text` it is called as `string.trim(s)`, or as
  `s \trim` when `s` is known to be a string. A dot on a value never reaches an attached definition:
  `s.trim` is an error.

  Strings are UTF-8. Most of these functions work byte by byte: `length` counts bytes (not
  characters or grapheme clusters), indices and widths are byte offsets, `uppercase` and `lowercase`
  only change ASCII letters, and the trimming and `words` functions only treat ASCII whitespace as
  whitespace. Multi-byte characters pass through unchanged, except that `padStart` and `padEnd` cut
  their fill at a byte count, so a multi-byte `fill` can be cut mid-character. `chars`, `reverse` and
  `codePoints` work by character, where a character is one Unicode code point: they read each UTF-8
  sequence's lead byte, so they never cut a character in half. `fromCodePoint` turns a code point
  back into a character.

  Every function here is stack-safe: each one that walks a string calls itself only in tail
  position, so it works on a string of any length.
module text

-- Everything here is written over four compiler intrinsics: `__nanyx_string_length`,
-- `__nanyx_string_byte_at`, `__nanyx_string_slice` and `__nanyx_string_from_byte`; `split` and
-- `words` also build their results with `__nanyx_list_cons`, last first, and reverse them with the
-- prelude's `list.reverse`. `++` (concatenation) and `==` on strings are language operators.

--| The number of bytes in `s`.
export def string.length: string -> int = { s ->
  __nanyx_string_length(s)
}

--| The `length` bytes of `s` starting at byte `start`. Out-of-range values are clamped, so the result
  is never longer than what `s` actually holds.
export def string.substring: (string, start: int, length: int) -> string = { s, start, length ->
  __nanyx_string_slice(s, start, length)
}

--| The first `n` bytes of `s`, or all of `s` when it is shorter. A negative `n` takes none. Bytes are
  counted as `substring` and `indexOf` count them, so `s \take(i)` cuts at an index `indexOf` gave.
export def string.take: string, int -> string = { s, n ->
  if n <= 0 then "" else string.substring(s, start = 0, length = n)
}

--| All but the first `n` bytes of `s`, or `""` when it is shorter. A negative `n` skips none.
export def string.skip: string, int -> string = { s, n ->
  if n <= 0
    then s
    else if n >= string.length(s)
      then ""
      else string.substring(s, start = n, length = string.length(s) - n)
}

--| Whether `s` begins with `prefix`.
export def string.startsWith: string, string -> bool = { s, prefix ->
  if string.length(prefix) > string.length(s)
    then false
    else string.substring(s, start = 0, length = string.length(prefix)) == prefix
}

--| Whether `s` ends with `suffix`.
export def string.endsWith: string, string -> bool = { s, suffix ->
  if string.length(suffix) > string.length(s)
    then false
    else string.substring(
        s
        start = string.length(s) - string.length(suffix)
        length = string.length(suffix)
      ) == suffix
}

--| The byte index of the first occurrence of `needle` in `s` at or after `from`, or -1.
def indexFrom: string, string, int -> int = { s, needle, from ->
  if from + string.length(needle) > string.length(s)
    then -1
    else if string.substring(s, start = from, length = string.length(needle)) == needle
      then from
      else indexFrom(s, needle, from + 1)
}

--| The byte index of the last occurrence of `needle` in `s` starting at or before `from`, or -1.
def lastIndexFrom: string, string, int -> int = { s, needle, from ->
  if from < 0
    then -1
    else if string.substring(s, start = from, length = string.length(needle)) == needle
      then from
      else lastIndexFrom(s, needle, from - 1)
}

--| The byte index of the first occurrence of `needle` in `s`. An empty `needle` is found at 0.
export def string.indexOf: string, string -> #some(int) | #notFound = { s, needle ->
  def index = indexFrom(s, needle, 0)
  if index >= 0 then #some(index) else #notFound
}

--| The byte index of the last occurrence of `needle` in `s`. An empty `needle` is found at the end.
export def string.lastIndexOf: string, string -> #some(int) | #notFound = { s, needle ->
  def index = lastIndexFrom(s, needle, string.length(s) - string.length(needle))
  if index >= 0 then #some(index) else #notFound
}

--| Whether `needle` occurs anywhere in `s`.
export def string.contains: string, string -> bool = { s, needle ->
  indexFrom(s, needle, 0) >= 0
}

def countFrom: string, string, int, int -> int = { s, needle, from, found ->
  def index = indexFrom(s, needle, from)
  if index < 0 then found else countFrom(s, needle, index + string.length(needle), found + 1)
}

--| The number of non-overlapping occurrences of `needle` in `s`. An empty `needle` is counted 0 times.
export def string.count: string, string -> int = { s, needle ->
  if string.length(needle) == 0 then 0 else countFrom(s, needle, 0, 0)
}

--| `s` without `prefix`, or `s` unchanged when it doesn't start with `prefix`.
export def string.removePrefix: string, string -> string = { s, prefix ->
  if string.startsWith(s, prefix)
    then string.substring(
      s
      start = string.length(prefix)
      length = string.length(s) - string.length(prefix)
    )
    else s
}

--| `s` without `suffix`, or `s` unchanged when it doesn't end with `suffix`.
export def string.removeSuffix: string, string -> string = { s, suffix ->
  if string.endsWith(s, suffix)
    then string.substring(s, start = 0, length = string.length(s) - string.length(suffix))
    else s
}

def upperByte: int -> int = { b ->
  if b >= 97 then (if b <= 122 then b - 32 else b) else b
}

def lowerByte: int -> int = { b ->
  if b >= 65 then (if b <= 90 then b + 32 else b) else b
}

def toUpperFrom: string, int, string -> string = { s, i, acc ->
  if i >= string.length(s)
    then acc
    else toUpperFrom(
      s
      i + 1
      acc ++ __nanyx_string_from_byte(upperByte(__nanyx_string_byte_at(s, i)))
    )
}

def toLowerFrom: string, int, string -> string = { s, i, acc ->
  if i >= string.length(s)
    then acc
    else toLowerFrom(
      s
      i + 1
      acc ++ __nanyx_string_from_byte(lowerByte(__nanyx_string_byte_at(s, i)))
    )
}

--| `s` with every ASCII letter upper-cased.
export def string.uppercase: string -> string = { s ->
  toUpperFrom(s, 0, "")
}

--| `s` with every ASCII letter lower-cased.
export def string.lowercase: string -> string = { s ->
  toLowerFrom(s, 0, "")
}

--| Whether byte `b` is a space, tab, line feed or carriage return.
def isWhitespace: int -> bool = { b ->
  b == 32 or b == 9 or b == 10 or b == 13
}

--| The index of the first non-whitespace byte at or after `i` (or the length of `s`).
def skipWhitespace: string, int -> int = { s, i ->
  if i < string.length(s)
    then (if isWhitespace(__nanyx_string_byte_at(s, i)) then skipWhitespace(s, i + 1) else i)
    else i
}

--| The index of the first whitespace byte at or after `i` (or the length of `s`).
def skipToWhitespace: string, int -> int = { s, i ->
  if i < string.length(s)
    then (if isWhitespace(__nanyx_string_byte_at(s, i)) then i else skipToWhitespace(s, i + 1))
    else i
}

--| The index just past the last non-whitespace byte before `stop` (or 0).
def skipWhitespaceBack: string, int -> int = { s, stop ->
  if stop > 0
    then (if isWhitespace(__nanyx_string_byte_at(s, stop - 1))
      then skipWhitespaceBack(s, stop - 1)
      else stop)
    else stop
}

--| `s` without leading and trailing whitespace.
export def string.trim: string -> string = { s ->
  def start = skipWhitespace(s, 0)
  def stop = skipWhitespaceBack(s, string.length(s))
  if stop > start then string.substring(s, start = start, length = stop - start) else ""
}

--| `s` without leading whitespace.
export def string.trimStart: string -> string = { s ->
  def start = skipWhitespace(s, 0)
  string.substring(s, start = start, length = string.length(s) - start)
}

--| `s` without trailing whitespace.
export def string.trimEnd: string -> string = { s ->
  string.substring(s, start = 0, length = skipWhitespaceBack(s, string.length(s)))
}

--| Whether `s` has no bytes at all.
export def string.isEmpty: string -> bool = { s ->
  string.length(s) == 0
}

--| Whether `s` is empty or only whitespace.
export def string.isBlank: string -> bool = { s ->
  skipWhitespace(s, 0) == string.length(s)
}

--| `acc` followed by `s` repeated `times` times. `s` doubles at each step, so this takes as many steps
  as `times` has bits; since every copy is the same, the order they are added to `acc` in doesn't matter.
def repeatOnto: string, int, string -> string = { s, times, acc ->
  if times <= 0
    then acc
    else if times % 2 == 1
      then repeatOnto(s ++ s, times / 2, acc ++ s)
      else repeatOnto(s ++ s, times / 2, acc)
}

--| `s` repeated `times` times (the empty string when `times` is zero or negative). Stack-safe: it works
  for any `times`.
export def string.repeat: string, int -> string = { s, times ->
  repeatOnto(s, times, "")
}

--| The bytes needed in front of or behind `s` to make it `width` bytes long, cut from repeats of `fill`.
def padding: string, int, string -> string = { s, width, fill ->
  def missing = width - string.length(s)

  if missing <= 0 or string.length(fill) == 0
    then ""
    else string.substring(string.repeat(fill, missing), start = 0, length = missing)
}

--| `s` with `fill` repeated in front of it until it is `width` bytes long. Longer strings are unchanged.
export def string.padStart: (string, width: int, fill: string) -> string = { s, width, fill ->
  padding(s, width, fill) ++ s
}

--| `s` with `fill` repeated after it until it is `width` bytes long. Longer strings are unchanged.
export def string.padEnd: (string, width: int, fill: string) -> string = { s, width, fill ->
  s ++ padding(s, width, fill)
}

--| The pieces of `s` from byte `from` on between occurrences of `separator`, last first, in front of
  `acc`.
def splitFrom: string, string, int, list(string) -> list(string) = { s, separator, from, acc ->
  def index = indexFrom(s, separator, from)

  if index < 0
    then __nanyx_list_cons(string.substring(s, start = from, length = string.length(s) - from), acc)
    else splitFrom(
      s
      separator
      index + string.length(separator)
      __nanyx_list_cons(string.substring(s, start = from, length = index - from), acc)
    )
}

--| The pieces of `s` between occurrences of `on`. An empty `on` yields `[s]`. Stack-safe:
  it works however many pieces there are.
export def string.split: (string, on: string) -> list(string) = { s, on ->
  if string.length(on) == 0 then [s] else list.reverse(splitFrom(s, on, 0, []))
}

--| The part of `s` before the first `on`, and the part after it, or `#notFound` when `s` does not
  contain `on`. An empty `on` is found at the start, so it gives `("", s)`.
export def string.splitOnce: (string, on: string) -> #some(string, string) | #notFound = { s, on ->
  def index = indexFrom(s, on, 0)
  def after = index + string.length(on)

  if index < 0
    then #notFound
    else #some(
      string.substring(s, start = 0, length = index)
      string.substring(s, start = after, length = string.length(s) - after)
    )
}

def joinRest: list(string), string, string -> string = { pieces, separator, acc ->
  match pieces
    | [] -> acc
    | [piece, ...rest] -> joinRest(rest, separator, (acc ++ separator) ++ piece)
}

--| The `pieces` concatenated with `separator` between each pair.
export def string.join: list(string), string -> string = { pieces, separator ->
  match pieces
    | [] -> ""
    | [first, ...rest] -> joinRest(rest, separator, first)
}

--| The `pieces` concatenated end to end.
export def string.concat: list(string) -> string = { pieces ->
  string.join(pieces, "")
}

--| `s` with every occurrence of `pattern` replaced by `replacement`. An empty `pattern` leaves `s` unchanged.
export def string.replace
  : (string, pattern: string, replacement: string) -> string
  = { s, pattern, replacement ->
    if string.length(pattern) == 0
      then s
      else string.join(string.split(s, on = pattern), replacement)
  }

def withoutCarriageReturn: string -> string = { line ->
  string.removeSuffix(line, __nanyx_string_from_byte(13))
}

--| The lines of `s`, split on line feeds, with any carriage return before a line feed dropped. A final
  line break doesn't start another line, so "a\nb\n" has two lines and "" has none. Stack-safe: it
  works however many lines there are.
export def string.lines: string -> list(string) = { s ->
  def lineFeed = __nanyx_string_from_byte(10)

  if string.length(s) == 0
    then []
    else list.map(
      string.split(string.removeSuffix(s, lineFeed), on = lineFeed)
      withoutCarriageReturn
    )
}

--| The runs of non-whitespace in `s` from byte `from` on, last first, in front of `acc`.
def wordsFrom: string, int, list(string) -> list(string) = { s, from, acc ->
  def start = skipWhitespace(s, from)
  def stop = skipToWhitespace(s, start)

  if start >= string.length(s)
    then acc
    else wordsFrom(
      s
      stop
      __nanyx_list_cons(string.substring(s, start = start, length = stop - start), acc)
    )
}

--| The runs of non-whitespace in `s`, in order. Stack-safe: it works however many words there are.
export def string.words: string -> list(string) = { s ->
  list.reverse(wordsFrom(s, 0, []))
}

--| Whether byte `b` continues a UTF-8 sequence rather than starting one.
def isContinuationByte: int -> bool = { b ->
  b >= 128 and b < 192
}

--| The index of the first byte of the character that byte `i` of `s` belongs to.
def charStart: string, int -> int = { s, i ->
  if i > 0 and isContinuationByte(__nanyx_string_byte_at(s, i)) then charStart(s, i - 1) else i
}

--| The index of the first byte at or after `i` that starts a character (or the length of `s`).
def nextCharStart: string, int -> int = { s, i ->
  if isContinuationByte(__nanyx_string_byte_at(s, i)) then nextCharStart(s, i + 1) else i
}

--| The characters of `s` before byte `stop`, in order, in front of `acc`.
def charsBefore: string, int, list(string) -> list(string) = { s, stop, acc ->
  def start = charStart(s, stop - 1)

  if stop <= 0
    then acc
    else charsBefore(
      s
      start
      __nanyx_list_cons(string.substring(s, start = start, length = stop - start), acc)
    )
}

--| Each character of `s` as a string of its own, in order. A character is one Unicode code point, so
  "héllo" has five characters though it is six bytes long. Stack-safe: it works on a string of any
  length.
export def string.chars: string -> list(string) = { s ->
  charsBefore(s, string.length(s), [])
}

--| The characters of `s` from byte `start` on, last first, in front of `acc`.
def charsReversedFrom: string, int, list(string) -> list(string) = { s, start, acc ->
  def stop = nextCharStart(s, start + 1)

  if start >= string.length(s)
    then acc
    else charsReversedFrom(
      s
      stop
      __nanyx_list_cons(string.substring(s, start = start, length = stop - start), acc)
    )
}

--| `pieces` joined two at a time (the first with the second, the third with the fourth, and so on),
  last first, in front of `acc`.
def pairUp: list(string), list(string) -> list(string) = { pieces, acc ->
  match pieces
    | [first, second, ...rest] -> pairUp(rest, __nanyx_list_cons(first ++ second, acc))
    | [last] -> __nanyx_list_cons(last, acc)
    | [] -> acc
}

--| `pieces` concatenated end to end, joined in pairs pass by pass, so that each byte is copied only as
  many times as the number of pieces can be halved.
def concatInPairs: list(string) -> string = { pieces ->
  match pieces
    | [] -> ""
    | [piece] -> piece
    | _ -> concatInPairs(list.reverse(pairUp(pieces, [])))
}

--| `s` with its characters (code points, not bytes) in reverse order, so it never cuts a character in
  half. Stack-safe: it works on a string of any length.
export def string.reverse: string -> string = { s ->
  concatInPairs(charsReversedFrom(s, 0, []))
}

--| The bits a character's lead byte `b` holds, for a character `length` bytes long.
def leadBits: int, int -> int = { b, length ->
  if length == 1 then b else if length == 2 then b % 32 else if length == 3 then b % 16 else b % 8
}

--| `value` with the six bits of each continuation byte of `s` from `i` up to `stop` added to it.
def continueCodePoint: string, int, int, int -> int = { s, i, stop, value ->
  if i >= stop
    then value
    else continueCodePoint(s, i + 1, stop, value * 64 + __nanyx_string_byte_at(s, i) % 64)
}

--| The code point of the character of `s` that runs from byte `start` up to byte `stop`.
def codePointAt: string, int, int -> int = { s, start, stop ->
  continueCodePoint(s, start + 1, stop, leadBits(__nanyx_string_byte_at(s, start), stop - start))
}

--| The code points of the characters of `s` before byte `stop`, in order, in front of `acc`.
def codePointsBefore: string, int, list(int) -> list(int) = { s, stop, acc ->
  def start = charStart(s, stop - 1)

  if stop <= 0
    then acc
    else codePointsBefore(s, start, __nanyx_list_cons(codePointAt(s, start, stop), acc))
}

--| The Unicode code point of each character of `s`, in order: `"aé€" \codePoints` is
  `[97, 233, 8364]`. It has one number for each of [`string.chars`]. Stack-safe: it works on a string
  of any length.
export def string.codePoints: string -> list(int) = { s ->
  codePointsBefore(s, string.length(s), [])
}

--| The UTF-8 continuation byte that holds the six bits of `codePoint` above its lowest `shift`.
def continuationByte: int, int -> string = { codePoint, shift ->
  __nanyx_string_from_byte(128 + codePoint / shift % 64)
}

--| The UTF-8 encoding of `codePoint`, which is a valid code point.
def encodeCodePoint: int -> string = { codePoint ->
  def lead = { first, shift -> __nanyx_string_from_byte(first + codePoint / shift) }
  def next = { shift -> continuationByte(codePoint, shift) }

  if codePoint < 128
    then __nanyx_string_from_byte(codePoint)
    else if codePoint < 2048
      then lead(192, 64) ++ next(1)
      else if codePoint < 65536
        then lead(224, 4096) ++ next(64) ++ next(1)
        else lead(240, 262144) ++ next(4096) ++ next(64) ++ next(1)
}

--| The character whose Unicode code point is `codePoint`, as a string: `string.fromCodePoint(233)` is
  `#some("é")`. A negative number, a surrogate (55296 to 57343, `0xD800` to `0xDFFF`) or a number past
  the last code point (1114111, `0x10FFFF`) gives `#invalidCodePoint`.
export def string.fromCodePoint: int -> #some(string) | #invalidCodePoint = { codePoint ->
  if codePoint < 0 or codePoint > 1114111 or codePoint >= 55296 and codePoint <= 57343
    then #invalidCodePoint
    else #some(encodeCodePoint(codePoint))
}
