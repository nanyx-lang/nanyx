--| Functions on strings.

  Each is attached to `string`, so it is in scope wherever strings are, without an import, and is called as `string.trim(s)`, or as
  `s \trim` when `s` is known to be a string. A dot on a value never reaches an attached definition:
  `s.trim` is an error.

  Strings are UTF-8. Most of these functions work byte by byte: `length` counts bytes (not
  characters or grapheme clusters), indices and widths are byte offsets, `uppercase` and `lowercase`
  only change ASCII letters, and the trimming and `words` functions only treat ASCII whitespace as
  whitespace. Multi-byte characters pass through unchanged, except that `padStart` and `padEnd` cut
  their fill at a byte count, so a multi-byte `fill` can be cut mid-character. `chars`, `reverse` and
  `codePoints` work by character, where a character is one Unicode scalar value, a `char`: they read
  each UTF-8 sequence's lead byte, so they never cut a character in half. `fromChars` and
  `fromCodePoint` turn characters back into a string. `toUtf8` gives a string's bytes as an array, and `fromUtf8` turns bytes
  back into a string, checking that they are well-formed UTF-8.

  Every function here is stack-safe: each one that walks a string calls itself only in tail
  position, so it works on a string of any length.
module text

-- Everything here is written over nine compiler intrinsics: `__nanyx_string_length`,
-- `__nanyx_string_byte_at`, `__nanyx_string_slice`, `__nanyx_string_from_byte`,
-- `__nanyx_string_from_bytes`, which copies an `Array(U8)`'s bytes into a string at once,
-- `__nanyx_string_join`, which copies each piece of its result once,
-- `__nanyx_string_index_between`, which finds a string in another, and `__nanyx_string_new` and
-- `__nanyx_string_write`, which make a string whose length is known first and copy each stretch of
-- it in once, as `repeat`, `padStart`, `padEnd`, `replace` and `reverse` do. `split` and `words`
-- also build their results with `__nanyx_list_cons`, last first, and reverse them with the
-- prelude's `list.reverse`. `toUtf8` and `fromUtf8` also use the array intrinsics
-- `__nanyx_array_new`, `__nanyx_array_write`, `__nanyx_array_get` and `__nanyx_array_length`, so
-- that this module needs no import. `++` (concatenation) and `==` on strings are language
-- operators. A string built from many pieces whose length isn't known first is built with
-- `string.build`, which copies each piece once into a growing buffer, since `++` copies both its
-- operands.

--| The number of bytes in `s`.
export def string.length: string -> int = { s ->
  __nanyx_string_length(s)
}

--| The `length` bytes of `s` starting at byte `start`. Out-of-range values are clamped, so the result
  is never longer than what `s` actually holds.
export def string.substring: (string, start: int, length: int) -> string = { s, start, length ->
  __nanyx_string_slice(s, start, length)
}

--| The first `n` bytes of `s`, or all of `s` when it is shorter. A negative `n` takes none. Bytes are
  counted as `substring` and `indexOf` count them, so `s \take(i)` cuts at an index `indexOf` gave.
export def string.take: string, int -> string = { s, n ->
  if n <= 0 then "" else string.substring(s, start = 0, length = n)
}

--| All but the first `n` bytes of `s`, or `""` when it is shorter. A negative `n` skips none.
export def string.skip: string, int -> string = { s, n ->
  if n <= 0
    then s
    else if n >= string.length(s)
      then ""
      else string.substring(s, start = n, length = string.length(s) - n)
}

-- Whether the bytes of `needle` from `index` up to `length`, its length, are those of `s` from
-- `at + index` on, compared in place, without copying either. `s` holds at least `at + length` bytes.
def matchesAt: string, string, int, int, int -> bool = { s, needle, length, at, index ->
  if index >= length
    then true
    else if __nanyx_string_byte_at(s, at + index) == __nanyx_string_byte_at(needle, index)
      then matchesAt(s, needle, length, at, index + 1)
      else false
}

--| Whether `s` begins with `prefix`.
export def string.startsWith: string, string -> bool = { s, prefix ->
  def length = string.length(prefix)
  length <= string.length(s) and matchesAt(s, prefix, length, 0, 0)
}

--| Whether `s` ends with `suffix`.
export def string.endsWith: string, string -> bool = { s, suffix ->
  def length = string.length(suffix)
  def start = string.length(s) - length
  start >= 0 and matchesAt(s, suffix, length, start, 0)
}

--| The byte index of the first occurrence of `needle` in `s` at or after `from`, or -1.
def indexFrom: string, string, int -> int = { s, needle, from ->
  __nanyx_string_index_between(s, needle, from, string.length(s))
}

--| The byte index of the last occurrence of `needle` in `s` starting at or before `from`, or -1.
  `from + string.length(needle)` is at most `string.length(s)`.
def lastIndexFrom: string, string, int -> int = { s, needle, from ->
  lastIndexBefore(s, needle, string.length(needle), from)
}

def lastIndexBefore: string, string, int, int -> int = { s, needle, length, from ->
  if from < 0
    then -1
    else if matchesAt(s, needle, length, from, 0)
      then from
      else lastIndexBefore(s, needle, length, from - 1)
}

--| The byte index of the first occurrence of `needle` in `s`. An empty `needle` is found at 0.
export def string.indexOf: string, string -> #some(int) | #notFound = { s, needle ->
  def index = indexFrom(s, needle, 0)
  if index >= 0 then #some(index) else #notFound
}

--| The byte index of the last occurrence of `needle` in `s`. An empty `needle` is found at the end.
export def string.lastIndexOf: string, string -> #some(int) | #notFound = { s, needle ->
  def index = lastIndexFrom(s, needle, string.length(s) - string.length(needle))
  if index >= 0 then #some(index) else #notFound
}

--| Whether `needle` occurs anywhere in `s`.
export def string.contains: string, string -> bool = { s, needle ->
  indexFrom(s, needle, 0) >= 0
}

def countFrom: string, string, int, int -> int = { s, needle, from, found ->
  def index = indexFrom(s, needle, from)
  if index < 0 then found else countFrom(s, needle, index + string.length(needle), found + 1)
}

--| The number of non-overlapping occurrences of `needle` in `s`. An empty `needle` is counted 0 times.
export def string.count: string, string -> int = { s, needle ->
  if string.length(needle) == 0 then 0 else countFrom(s, needle, 0, 0)
}

--| `s` without `prefix`, or `s` unchanged when it doesn't start with `prefix`.
export def string.removePrefix: string, string -> string = { s, prefix ->
  if string.startsWith(s, prefix)
    then string.substring(
      s
      start = string.length(prefix)
      length = string.length(s) - string.length(prefix)
    )
    else s
}

--| `s` without `suffix`, or `s` unchanged when it doesn't end with `suffix`.
export def string.removeSuffix: string, string -> string = { s, suffix ->
  if string.endsWith(s, suffix)
    then string.substring(s, start = 0, length = string.length(s) - string.length(suffix))
    else s
}

--| `s` with every ASCII letter upper-cased, made in one allocation.
export def string.uppercase: string -> string = { s ->
  __nanyx_string_shift_bytes(s, 97, 122, -32)
}

--| `s` with every ASCII letter lower-cased, made in one allocation.
export def string.lowercase: string -> string = { s ->
  __nanyx_string_shift_bytes(s, 65, 90, 32)
}

--| Whether byte `b` is a space, tab, line feed or carriage return.
def isWhitespace: int -> bool = { b ->
  b == 32 or b == 9 or b == 10 or b == 13
}

--| The index of the first non-whitespace byte at or after `i` (or the length of `s`).
def skipWhitespace: string, int -> int = { s, i ->
  if i < string.length(s)
    then (if isWhitespace(__nanyx_string_byte_at(s, i)) then skipWhitespace(s, i + 1) else i)
    else i
}

--| The index of the first whitespace byte at or after `i` (or the length of `s`).
def skipToWhitespace: string, int -> int = { s, i ->
  if i < string.length(s)
    then (if isWhitespace(__nanyx_string_byte_at(s, i)) then i else skipToWhitespace(s, i + 1))
    else i
}

--| The index just past the last non-whitespace byte before `stop` (or 0).
def skipWhitespaceBack: string, int -> int = { s, stop ->
  if stop > 0
    then (if isWhitespace(__nanyx_string_byte_at(s, stop - 1))
      then skipWhitespaceBack(s, stop - 1)
      else stop)
    else stop
}

--| `s` without leading and trailing whitespace.
export def string.trim: string -> string = { s ->
  def start = skipWhitespace(s, 0)
  def stop = skipWhitespaceBack(s, string.length(s))
  if stop > start then string.substring(s, start = start, length = stop - start) else ""
}

--| `s` without leading whitespace.
export def string.trimStart: string -> string = { s ->
  def start = skipWhitespace(s, 0)
  string.substring(s, start = start, length = string.length(s) - start)
}

--| `s` without trailing whitespace.
export def string.trimEnd: string -> string = { s ->
  string.substring(s, start = 0, length = skipWhitespaceBack(s, string.length(s)))
}

--| Whether `s` has no bytes at all.
export def string.isEmpty: string -> bool = { s ->
  string.length(s) == 0
}

--| Whether `s` is empty or only whitespace.
export def string.isBlank: string -> bool = { s ->
  skipWhitespace(s, 0) == string.length(s)
}

--| `made`, a new string, once the `filled` bytes written into it from `start` are copied after
  themselves until `total` bytes from `start` are written: each copy doubles what is written, so
  this takes as many steps as the result has bits.
def doubleFrom: string, int, int, int -> string = { made, start, filled, total ->
  if filled < total then
    def count = if filled < total - filled then filled else total - filled
    __nanyx_string_write(made, start + filled, made, start, count)
    doubleFrom(made, start, filled + count, total)
  else made
}

--| `made`, a new string, once `count` bytes of repeats of `fill`, which isn't empty, are written
  into it from `at`.
def fillFrom: string, int, string, int -> string = { made, at, fill, count ->
  def first = if string.length(fill) < count then string.length(fill) else count
  __nanyx_string_write(made, at, fill, 0, first)
  doubleFrom(made, at, first, count)
}

--| `s` repeated `times` times (the empty string when `times` is zero or negative). Stack-safe: it works
  for any `times`.
export def string.repeat: string, int -> string = { s, times ->
  def length = string.length(s)

  if times <= 0 or length == 0
    then ""
    else if times == 1
      then s
      else fillFrom(__nanyx_string_new(length * times), 0, s, length * times)
}

--| `s` with `fill` repeated in front of it until it is `width` bytes long. Longer strings are unchanged.
export def string.padStart: (string, width: int, fill: string) -> string = { s, width, fill ->
  def missing = width - string.length(s)

  if missing <= 0 or string.length(fill) == 0 then s else
    def made = fillFrom(__nanyx_string_new(width), 0, fill, missing)
    __nanyx_string_write(made, missing, s, 0, string.length(s))
    made
}

--| `s` with `fill` repeated after it until it is `width` bytes long. Longer strings are unchanged.
export def string.padEnd: (string, width: int, fill: string) -> string = { s, width, fill ->
  def missing = width - string.length(s)

  if missing <= 0 or string.length(fill) == 0 then s else
    def made = __nanyx_string_new(width)
    __nanyx_string_write(made, 0, s, 0, string.length(s))
    fillFrom(made, string.length(s), fill, missing)
}

--| The pieces of `s` from byte `from` on between occurrences of `separator`, last first, in front of
  `acc`.
def splitFrom: string, string, int, list(string) -> list(string) = { s, separator, from, acc ->
  def index = indexFrom(s, separator, from)

  if index < 0
    then __nanyx_list_cons(string.substring(s, start = from, length = string.length(s) - from), acc)
    else splitFrom(
      s
      separator
      index + string.length(separator)
      __nanyx_list_cons(string.substring(s, start = from, length = index - from), acc)
    )
}

--| The pieces of `s` between occurrences of `on`. An empty `on` yields `[s]`. Stack-safe:
  it works however many pieces there are.
export def string.split: (string, on: string) -> list(string) = { s, on ->
  if string.length(on) == 0 then [s] else list.reverse(splitFrom(s, on, 0, []))
}

--| The part of `s` before the first `on`, and the part after it, or `#notFound` when `s` does not
  contain `on`. An empty `on` is found at the start, so it gives `("", s)`.
export def string.splitOnce: (string, on: string) -> #some(string, string) | #notFound = { s, on ->
  def index = indexFrom(s, on, 0)
  def after = index + string.length(on)

  if index < 0
    then #notFound
    else #some(
      string.substring(s, start = 0, length = index)
      string.substring(s, start = after, length = string.length(s) - after)
    )
}

--| The `pieces` concatenated with `separator` between each pair. Each piece is copied once, so it
  takes time in proportion to the length of the result.
export def string.join: list(string), string -> string = { pieces, separator ->
  __nanyx_string_join(pieces, separator)
}

--| The `pieces` concatenated end to end.
export def string.concat: list(string) -> string = { pieces ->
  string.join(pieces, "")
}

--| `capacity` doubled until it holds `needed` bytes.
def grownCapacity: int, int -> int = { capacity, needed ->
  if capacity >= needed then capacity else grownCapacity(capacity * 2, needed)
}

--| A new string of `capacity` bytes that starts with the first `used` bytes of `buffer`.
def copiedInto: string, int, int -> string = { buffer, used, capacity ->
  def made = __nanyx_string_new(capacity)
  __nanyx_string_write(made, 0, buffer, 0, used)
  made
}

--| The string of the pieces `block` emits, through [`Emit`], in the order it emits them:
  `string.build { for rows | row -> emit(row.name); emit(",") }`. `block` runs once, now, under a
  handler that copies each piece into one buffer, of 64 bytes at first, and into one twice its size
  when it is full, and then into a string of the length written. So it takes time in proportion to
  the length of the result, and allocates a number of blocks that grows with the log of that length,
  where joining the pieces one at a time with `++` copies the string so far for each of them.
export def string.build: [c] ([c, Emit(string)] () -> ()) -> string = { block ->
  memory {
    mut buffer = __nanyx_string_new(64)
    mut used = 0

    use Emit(string)(
      emit = { piece ->
        def size = string.length(piece)

        if used + size > string.length(buffer) then
          buffer := copiedInto(buffer, used, grownCapacity(string.length(buffer) * 2, used + size))

        __nanyx_string_write(buffer, used, piece, 0, size)
        used := used + size
      }
    ) in block()

    if used == 0
      then ""
      else if used == string.length(buffer) then buffer else copiedInto(buffer, used, used)
  }
}

--| `made`, a new string, once the bytes of `s` from `from` on are written into it from `at`, with
  `replacement` written in place of each occurrence of `pattern`.
def replaceFrom
  : string, string, string, string, int, int -> string
  = { s, pattern, replacement, made, from, at ->
    def index = indexFrom(s, pattern, from)
    def before = index - from

    if index < 0 then
      __nanyx_string_write(made, at, s, from, string.length(s) - from)
      made
    else
      __nanyx_string_write(made, at, s, from, before)
      __nanyx_string_write(made, at + before, replacement, 0, string.length(replacement))

      replaceFrom(
        s
        pattern
        replacement
        made
        index + string.length(pattern)
        at + before + string.length(replacement)
      )
  }

--| `s` with every occurrence of `pattern` replaced by `replacement`. An empty `pattern` leaves `s` unchanged.
export def string.replace
  : (string, pattern: string, replacement: string) -> string
  = { s, pattern, replacement ->
    def found = if string.length(pattern) == 0 then 0 else countFrom(s, pattern, 0, 0)
    def length = string.length(s) + found * (string.length(replacement) - string.length(pattern))

    if found == 0 then s else replaceFrom(s, pattern, replacement, __nanyx_string_new(length), 0, 0)
  }

def withoutCarriageReturn: string -> string = { line ->
  string.removeSuffix(line, __nanyx_string_from_byte(13))
}

--| The lines of `s`, split on line feeds, with any carriage return before a line feed dropped. A final
  line break doesn't start another line, so "a\nb\n" has two lines and "" has none. Stack-safe: it
  works however many lines there are.
export def string.lines: string -> list(string) = { s ->
  def lineFeed = __nanyx_string_from_byte(10)

  if string.length(s) == 0
    then []
    else list.map(
      string.split(string.removeSuffix(s, lineFeed), on = lineFeed)
      withoutCarriageReturn
    )
}

--| The runs of non-whitespace in `s` from byte `from` on, last first, in front of `acc`.
def wordsFrom: string, int, list(string) -> list(string) = { s, from, acc ->
  def start = skipWhitespace(s, from)
  def stop = skipToWhitespace(s, start)

  if start >= string.length(s)
    then acc
    else wordsFrom(
      s
      stop
      __nanyx_list_cons(string.substring(s, start = start, length = stop - start), acc)
    )
}

--| The runs of non-whitespace in `s`, in order. Stack-safe: it works however many words there are.
export def string.words: string -> list(string) = { s ->
  list.reverse(wordsFrom(s, 0, []))
}

--| Whether byte `b` continues a UTF-8 sequence rather than starting one.
def isContinuationByte: int -> bool = { b ->
  b >= 128 and b < 192
}

--| The index of the first byte of the character that byte `i` of `s` belongs to.
def charStart: string, int -> int = { s, i ->
  if i > 0 and isContinuationByte(__nanyx_string_byte_at(s, i)) then charStart(s, i - 1) else i
}

--| The index of the first byte at or after `i` that starts a character (or the length of `s`).
def nextCharStart: string, int -> int = { s, i ->
  if isContinuationByte(__nanyx_string_byte_at(s, i)) then nextCharStart(s, i + 1) else i
}

--| The chars of `s` before byte `stop`, in order, in front of `acc`.
def charsBefore: string, int, list(char) -> list(char) = { s, stop, acc ->
  def start = charStart(s, stop - 1)

  if stop <= 0
    then acc
    else charsBefore(
      s
      start
      __nanyx_list_cons(__nanyx_from_int(codePointAt(s, start, stop)), acc)
    )
}

--| Each character of `s`, in order. A character is one Unicode scalar value, a [`char`], so "héllo"
  has five though it is six bytes long. Stack-safe: it works on a string of any length.
export def string.chars: string -> list(char) = { s ->
  charsBefore(s, string.length(s), [])
}

--| The string of `chars`, in order: `string.fromChars(["h", "é"])` is `"hé"`.
export def string.fromChars: list(char) -> string = { chars ->
  string.join(list.map(chars, char.toString), "")
}

--| `made`, a new string as long as `s`, once each character of `s` from byte `start` on is written
  into it where it ends as far from the end of `made` as it starts from the start of `s`.
def reverseFrom: string, string, int -> string = { s, made, start ->
  def stop = nextCharStart(s, start + 1)

  if start < string.length(s) then
    __nanyx_string_write(made, string.length(s) - stop, s, start, stop - start)
    reverseFrom(s, made, stop)
  else made
}

--| `s` with its characters (code points, not bytes) in reverse order, so it never cuts a character in
  half. Stack-safe: it works on a string of any length.
export def string.reverse: string -> string = { s ->
  if string.length(s) <= 1 then s else reverseFrom(s, __nanyx_string_new(string.length(s)), 0)
}

--| The bits a character's lead byte `b` holds, for a character `length` bytes long.
def leadBits: int, int -> int = { b, length ->
  if length == 1 then b else if length == 2 then b % 32 else if length == 3 then b % 16 else b % 8
}

--| `value` with the six bits of each continuation byte of `s` from `i` up to `stop` added to it.
def continueCodePoint: string, int, int, int -> int = { s, i, stop, value ->
  if i >= stop
    then value
    else continueCodePoint(s, i + 1, stop, value * 64 + __nanyx_string_byte_at(s, i) % 64)
}

--| The code point of the character of `s` that runs from byte `start` up to byte `stop`.
def codePointAt: string, int, int -> int = { s, start, stop ->
  continueCodePoint(s, start + 1, stop, leadBits(__nanyx_string_byte_at(s, start), stop - start))
}

--| The character of `s` that starts at byte `start`, which must start one: what a function that walks
  a string by position reads, without making a list of its characters, as [`nanyx/trie`]'s
  `StringTrie` does.
export def __stringCharAt: string, int -> char = { s, start ->
  __nanyx_from_int(codePointAt(s, start, nextCharStart(s, start + 1)))
}

--| The byte at which the character of `s` after the one that starts at byte `start` starts, or the
  length of `s`: where a walk by position goes next (see [`__stringCharAt`]).
export def __stringNextChar: string, int -> int = { s, start ->
  nextCharStart(s, start + 1)
}

--| The code points of the characters of `s` before byte `stop`, in order, in front of `acc`.
def codePointsBefore: string, int, list(int) -> list(int) = { s, stop, acc ->
  def start = charStart(s, stop - 1)

  if stop <= 0
    then acc
    else codePointsBefore(s, start, __nanyx_list_cons(codePointAt(s, start, stop), acc))
}

--| The Unicode code point of each character of `s`, in order: `"aé€" \codePoints` is
  `[97, 233, 8364]`. It has one number for each of [`string.chars`], which gives the chars
  themselves, each of whose code point [`char.toInt`] gives: prefer those. Stack-safe: it works on a
  string of any length.
export def string.codePoints: string -> list(int) = { s ->
  codePointsBefore(s, string.length(s), [])
}

--| The character whose Unicode code point is `codePoint`, as a string: `string.fromCodePoint(233)` is
  `#some("é")`. A negative number, a surrogate (55296 to 57343, `0xD800` to `0xDFFF`) or a number past
  the last code point (1114111, `0x10FFFF`) gives `#invalidCodePoint`. [`char.fromInt`] gives the
  char itself, which [`char.toString`] makes a string: prefer those.
export def string.fromCodePoint: int -> #some(string) | #invalidCodePoint = { codePoint ->
  match char.fromInt(codePoint)
    | #some(c) -> #some(char.toString(c))
    | #invalidCodePoint -> #invalidCodePoint
}

-- UTF-8 bytes ----------------------------------------------------------------------------------

--| The bytes of `s`, its UTF-8 encoding, in order: `"aé" \toUtf8` is `[97, 195, 169]`. Stack-safe:
  it works on a string of any length.
export def string.toUtf8: string -> Array(U8) = { s ->
  bytesFrom(s, __nanyx_array_new(string.length(s)), 0)
}

--| `bytes`, a new array as long as `s`, once each byte of `s` from `i` on is written into it.
def bytesFrom: string, Array(U8), int -> Array(U8) = { s, bytes, i ->
  if i < string.length(s) then
    __nanyx_array_write(bytes, i, U8.fromInt(__nanyx_string_byte_at(s, i)))
    bytesFrom(s, bytes, i + 1)
  else bytes
}

--| Byte `i` of `bytes`, as an int.
def byteOf: Array(U8), int -> int = { bytes, i ->
  U8.toInt(__nanyx_array_get(bytes, i))
}

--| Whether `bytes`, which holds `count` bytes, has a byte at `i` and it is from `low` to `high`.
def byteBetween: Array(U8), int, int, int, int -> bool = { bytes, count, i, low, high ->
  i < count and byteOf(bytes, i) >= low and byteOf(bytes, i) <= high
}

--| Whether `bytes`, which holds `count` bytes, has `n` continuation bytes from `i` on.
def continuationsFrom: Array(U8), int, int, int -> bool = { bytes, count, i, n ->
  if n <= 0
    then true
    else if byteBetween(bytes, count, i, 128, 191)
      then continuationsFrom(bytes, count, i + 1, n - 1)
      else false
}

--| The length of the well-formed UTF-8 sequence at byte `i` of `bytes`, which holds `count` bytes,
  or 0 when there isn't one there. The range each lead byte allows its second byte rules out
  overlong encodings, surrogates and code points past 0x10FFFF.
def sequenceLength: Array(U8), int, int -> int = { bytes, count, i ->
  def lead = byteOf(bytes, i)

  def sequence = { low, high, length ->
    def secondFits = byteBetween(bytes, count, i + 1, low, high)
    if secondFits and continuationsFrom(bytes, count, i + 2, length - 2) then length else 0
  }

  if lead < 128
    then 1
    else if lead < 194
      then 0
      else if lead < 224
        then sequence(128, 191, 2)
        else if lead == 224
          then sequence(160, 191, 3)
          else if lead == 237
            then sequence(128, 159, 3)
            else if lead < 240
              then sequence(128, 191, 3)
              else if lead == 240
                then sequence(144, 191, 4)
                else if lead < 244
                  then sequence(128, 191, 4)
                  else if lead == 244 then sequence(128, 143, 4) else 0
}

--| Whether the bytes of `bytes` from `i` on, up to `count`, are well-formed UTF-8.
def wellFormedFrom: Array(U8), int, int -> bool = { bytes, count, i ->
  def length = if i < count then sequenceLength(bytes, count, i) else 0

  if i >= count
    then true
    else if length > 0 then wellFormedFrom(bytes, count, i + length) else false
}

--| The string whose UTF-8 encoding is `bytes`: `string.fromUtf8([97, 195, 169])` is `#some("aé")`.
  Bytes that aren't well-formed UTF-8 give `#invalidUtf8`: a continuation byte with no lead byte, a
  sequence cut short, an overlong encoding, a surrogate (`0xD800` to `0xDFFF`) or a code point past
  `0x10FFFF`. Stack-safe: it works on any number of bytes.
export def string.fromUtf8: Array(U8) -> #some(string) | #invalidUtf8 = { bytes ->
  def count = __nanyx_array_length(bytes)

  if wellFormedFrom(bytes, count, 0) then #some(__nanyx_string_from_bytes(bytes)) else #invalidUtf8
}

-- String slices --------------------------------------------------------------------------------

--| A view of a run of a string's bytes, which shares the string instead of copying it: the string,
  the byte the run starts at and how many bytes it is. [`string.slice`] makes one, and a slice of a
  slice is one too, each without copying, so a parser or a lexer can walk a text and look at its
  tokens without making a substring of each. [`StringSlice.toString`] copies the run into a string
  of its own, which lets go of the larger one. Bytes are counted as [`string.substring`] counts them.
export type StringSlice = private (text: string, start: int, length: int)

--| `value` moved into the range from `low` to `high`.
def clampBetween: int, int, int -> int = { value, low, high ->
  if value < low then low else if value > high then high else value
}

--| The run of `length` bytes of `text` from `start`, bounds from `from` up to `to` clamped into it.
def sliceWithin: string, int, int, int, int -> StringSlice = { text, start, length, from, to ->
  def first = clampBetween(from, 0, length)
  def last = clampBetween(to, first, length)
  StringSlice(text = text, start = start + first, length = last - first)
}

--| The bytes of `s` from `from` up to but not including `to`, as a slice that shares `s`: each bound
  is moved into `0` to the length of `s`, and the slice is empty when `to` is before `from`.
export def string.slice: string, int, int -> StringSlice = { s, from, to ->
  sliceWithin(s, 0, string.length(s), from, to)
}

--| The number of bytes `s` views.
export def StringSlice.length: StringSlice -> int = { s ->
  s.length
}

--| Whether `s` views no bytes.
export def StringSlice.isEmpty: StringSlice -> bool = { s ->
  s.length == 0
}

--| The byte of `s` at `index`, counting from 0 at the start of `s`, or `#none` when `index` is
  negative or past its end.
export def StringSlice.byteAt: StringSlice, int -> #some(int) | #none = { s, index ->
  if index >= 0 and index < s.length
    then #some(__nanyx_string_byte_at(s.text, s.start + index))
    else #none
}

--| The bytes of `s` from `from` up to but not including `to`, counting from the start of `s`,
  sharing the same string. The bounds clamp into `s`, as [`string.slice`]'s do.
export def StringSlice.slice: StringSlice, int, int -> StringSlice = { s, from, to ->
  sliceWithin(s.text, s.start, s.length, from, to)
}

--| Whether the bytes `s` views begin with `prefix`, compared without copying them.
export def StringSlice.startsWith: StringSlice, string -> bool = { s, prefix ->
  def length = string.length(prefix)
  length <= s.length and matchesAt(s.text, prefix, length, s.start, 0)
}

--| The byte index, counting from 0 at the start of `s`, of the first occurrence of `needle` in the
  bytes `s` views, found without copying them. An empty `needle` is found at 0.
export def StringSlice.indexOf: StringSlice, string -> #some(int) | #notFound = { s, needle ->
  def length = string.length(needle)
  def index = __nanyx_string_index_between(s.text, needle, s.start, s.start + s.length - length)
  if index >= 0 then #some(index - s.start) else #notFound
}

--| A copy of the bytes `s` views, as a string of its own, which doesn't keep the string `s` views
  alive.
export def StringSlice.toString: StringSlice -> string = { s ->
  __nanyx_string_slice(s.text, s.start, s.length)
}
