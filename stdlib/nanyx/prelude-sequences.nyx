@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- Sequences -------------------------------------------------------------------------------------
--
-- Attached to `seq`, so they are called as `seq.map(s, f)`, or as `s \map(f)` when `s` is known to
-- be a sequence. A sequence is lazy: nothing is worked out until it is pulled, and a function that
-- gives back a sequence runs its callbacks when that is pulled, so the result requires their
-- contexts (see docs/src/content/deep-dives/lazy-sequences.md).

--| A lazy sequence of `a`s: a function that, when called, gives back the first element and the rest
  of the sequence, `#next(x, rest)`, or `#done`. Calling it changes nothing, so a sequence can be
  pulled again, and does its work again. A sequence whose steps need contexts says so in its type,
  `[Console] seq(int)`, and the rest of it needs them too. Ranges are sequences: `1..10` is
  `seq.range(1, 10)` and `0..` is `seq.from(0)`.
export type Sequence(a) = [k] protected (next: [k] () -> #next(a, Sequence(a)) | #done)

--| The sequence of no elements.
export def seq.empty: () -> seq(a) = {
  noElements
}

-- The sequence of no elements, made once: each `seq.empty()` shares it.
def noElements: seq(a) = Sequence(next = { #done })

--| The sequence `f` gives, worked out when it is pulled, not now: `f` runs each time the sequence is
  pulled.
export def seq.delay: ([c] () -> [d] seq(a)) -> [c, d] seq(a) = { f ->
  Sequence(
    next = {
      def s = f()
      s.next()
    }
  )
}

--| `x` alone: what a `yield x` that ends a sequence's block is.
export def __seqLast: a -> seq(a) = { x ->
  Sequence(next = { #next(x, seq.empty()) })
}

--| `f` of each element of `s`: what a `for` loop that yields one value each time round is in a sequence's block.
export def __seqMap: ([c] seq(a)), ([d] a -> b) -> [c, d] seq(b) = { s, f ->
  seq.map(s, f)
}

--| `x`, then the elements of the sequence `rest` gives, which runs only when the sequence is pulled
  past `x`.
export def seq.cons: a, ([c] () -> [d] seq(a)) -> [c, d] seq(a) = { x, rest ->
  Sequence(next = { #next(x, seq.delay(rest)) })
}

--| The sequence `block` gives, worked out when it is pulled. A block with `yield` in it is a sequence:
  `seq { yield 1  yield 2 }` gives `1` and `2`, and the code after a `yield` runs only when the
  sequence is pulled that far.
export def seq: ([c] () -> [d] seq(a)) -> [c, d] seq(a) = { block ->
  seq.delay(block)
}

--| The values that come one after another, so that a range of them can be counted through: `succ`
  gives the value after `x`. A range, `first..last`, takes the values from `first` up to `last` in
  steps of `succ`, and stops by their [`Ord`]. A type gets it by attaching `succ`, as `int` does.
export context Enumerable(a) = (succ: a -> a)

--| The value after `n`: `n + 1`. `int`'s [`Enumerable`], which counts a range of `int`s.
export def int.succ: int -> int = { n ->
  n + 1
}

--| The values from `first` up to `last`, both included, each the `succ` of the one before: `1..10`.
  Empty when `last` is less than `first`.
export def seq.range: [Enumerable(a), Ord(a)] a, a -> seq(a) = { first, last ->
  Sequence(next = { if first > last then #done else #next(first, seq.range(succ(first), last)) })
}

--| The values from `first` up, each the `succ` of the one before, without end: `0..`.
export def seq.from: [Enumerable(a)] a -> seq(a) = { first ->
  Sequence(next = { #next(first, seq.from(succ(first))) })
}

--| [`seq.range`] of `int`s, which counts: what `1..10` calls.
export def __intRange: int, int -> seq(int) = { first, last ->
  Sequence(next = { if first > last then #done else #next(first, __intRange(first + 1, last)) })
}

--| [`seq.from`] of an `int`, which counts: what `0..` calls.
export def __intFrom: int -> seq(int) = { first ->
  Sequence(next = { #next(first, __intFrom(first + 1)) })
}

--| The elements `step` gives, starting from `state`: `#some(x, next)` gives `x` and carries on from
  `next`, and `#done` ends the sequence. `step` runs when the sequence is pulled.
export def seq.unfold: b, ([c] b -> #some(a, b) | #done) -> [c] seq(a) = { state, step ->
  Sequence(
    next = {
      match step(state)
        | #some(x, next) -> #next(x, seq.unfold(next, step))
        | #done -> #done
    }
  )
}

--| What can be iterated: a value of type `c` that gives a sequence of `elem`s. A `for` loop walks
  anything `Iterable`, and the `seq` functions that read a sequence take one. A type gets it by
  attaching `toSeq`, whose type fixes `elem`: `list.toSeq: list(a) -> seq(a)` makes the `elem` of a
  `list(int)` an `int`. A signature that needs the element type fixes it by name,
  `[Iterable(c, elem = string)]`. The sequence `toSeq` gives needs no contexts.
export context Iterable(c) = (elem: type, toSeq: c -> seq(elem))

--| `s` itself: a sequence is [`Iterable`].
export def seq.toSeq: seq(a) -> seq(a) = { s -> s }

--| The sequence of `xs`, through its [`Iterable`]: what a `for` loop walks when `xs` is not a list, a
  sequence, a map or a set.
export def __toSeq: [Iterable(c)] c -> seq(elem) = { xs ->
  toSeq(xs)
}

--| `s` as it is, its steps' contexts and all: what a `for` loop in a sequence's block walks when it
  is over a sequence, where it is over anything else [`Iterable`] through `__toSeq`.
export def __seqItself: ([c] seq(a)) -> [c] seq(a) = { s -> s }

--| The elements of `xs`, in order.
export def list.toSeq: list(a) -> seq(a) = { xs ->
  Sequence(
    next = {
      match xs
        | [] -> #done
        | [x, ...rest] -> #next(x, list.toSeq(rest))
    }
  )
}

--| The elements of `xs`, in order: `seq.fromList([1, 2, 3]) \seq.toList` is `[1, 2, 3]`. The same
  as [`list.toSeq`].
export def seq.fromList: list(a) -> seq(a) = { xs ->
  list.toSeq(xs)
}

--| The elements of `xs`, in order, each read when the sequence is pulled. What a literal builds a
  sequence with, `seq[1, 2, 3]` or `Sequence[1, 2, 3]`. The same as [`array.toSeq`].
export def seq.fromArray: array(a) -> seq(a) = { xs ->
  array.toSeq(xs)
}

--| `f` applied to each element of `s`, when it is pulled: `(1..3) \seq.map { * 2 }` gives `2`, `4`
  and `6`.
export def seq.map: ([c] seq(a)), ([d] a -> b) -> [c, d] seq(b) = { s, f ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) -> #next(f(x), seq.map(rest, f))
        | #done -> #done
    }
  )
}

--| Pairs the elements of `s` and `t` in order, ending when either ends, as `list.zip` stops at the
  shorter list: `seq.zip(0.., list.toSeq(["a", "b"]))` gives `(0, "a")` and `(1, "b")`. Each pair
  pulls one element from each side, and nothing more.
export def seq.zip: ([c] seq(a)), ([d] seq(b)) -> [c, d] seq((a, b)) = { s, t ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) ->
          match t.next()
            | #next(y, more) -> #next((x, y), seq.zip(rest, more))
            | #done -> #done
        | #done -> #done
    }
  )
}

--| The elements of `s`, then those of `t`.
export def seq.append: ([c] seq(a)), ([d] seq(a)) -> [c, d] seq(a) = { s, t ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) -> #next(x, seq.append(rest, t))
        | #done -> t.next()
    }
  )
}

--| The elements of the sequences `f` gives for each element of `s`, one after another, when it is
  pulled: `(1..3) \seq.flatMap { n -> seq.range(1, n) }` gives `1`, `1`, `2`, `1`, `2` and `3`. Lazy:
  `f` runs on an element only when the sequence is pulled that far.
export def seq.flatMap: ([c] seq(a)), ([d] a -> [d] seq(b)) -> [c, d] seq(b) = { s, f ->
  Sequence(next = { flatMapNext(s, f) })
}

-- The next element of `seq.flatMap(s, f)`: the first of the sequence `f` gives for the first element
-- of `s` that gives one. Each inner sequence is walked here, not appended to the rest, so its elements
-- cost one step each (see "What a step costs" in docs/src/content/deep-dives/lazy-sequences.md).
def flatMapNext
  : [c, d] ([c] seq(a)), ([d] a -> [d] seq(b)) -> #next(b, ([c, d] seq(b))) | #done
  = { s, f ->
    match s.next()
      | #next(x, rest) -> flatMapInner(f(x), rest, f)
      | #done -> #done
  }

-- The next element of `inner`, then of the sequences `f` gives for the elements of `rest`.
def flatMapInner
  : [c, d] ([d] seq(b)), ([c] seq(a)), ([d] a -> [d] seq(b)) -> #next(b, ([c, d] seq(b))) | #done
  = { inner, rest, f ->
    match inner.next()
      | #next(y, more) -> #next(y, flatMapFrom(more, rest, f))
      | #done -> flatMapNext(rest, f)
  }

-- The elements of `inner`, then those of the sequences `f` gives for the elements of `rest`.
def flatMapFrom
  : ([d] seq(b)), ([c] seq(a)), ([d] a -> [d] seq(b)) -> [c, d] seq(b)
  = { inner, rest, f ->
    Sequence(next = { flatMapInner(inner, rest, f) })
  }

--| The elements of each sequence of `s`, one after another: `[[1, 2], [3]] \list.map(list.toSeq)
  \list.toSeq \seq.flatten` gives `1`, `2` and `3`. Lazy: it pulls `s` one sequence at a time.
export def seq.flatten: ([c] seq(seq(a))) -> [c] seq(a) = { s ->
  seq.flatMap(s, { inner -> inner })
}

--| The values `f` yields for each element in turn, in the order it yields them: [`seq.flatMap`] for
  a lambda with `yield` in it, which is a lazy sequence (see [`Yield`]). Lazy: the code after a
  `yield` runs only when the sequence is pulled that far.
export def seq.select: ([c] seq(a)), ([d] a -> [d] seq(b)) -> [c, d] seq(b) = { s, f ->
  seq.flatMap(s, f)
}

--| The payload of each `#some` that `f` gives for the elements of `s`, skipping each `#skip`:
  `(1..6) \seq.filterMap { n -> if n % 2 == 0 then #some(n * 10) else #skip }` gives `20`, `40` and
  `60`. Lazy: pulling it pulls `s` until `f` gives a `#some`, in constant stack.
export def seq.filterMap: ([c] seq(a)), ([d] a -> #some(b) | #skip) -> [c, d] seq(b) = { s, f ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) ->
          def more = seq.filterMap(rest, f)

          match f(x)
            | #some(y) -> #next(y, more)
            | #skip -> more.next()
        | #done -> #done
    }
  )
}

--| `f` applied to each element of `s` and its position, counting from `index`.
def seq.mapIndexedFrom: ([c] seq(a)), ([d] int, a -> b), int -> [c, d] seq(b) = { s, f, index ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) -> #next(f(index, x), seq.mapIndexedFrom(rest, f, index + 1))
        | #done -> #done
    }
  )
}

--| `f` applied to the position of each element of `s`, counting from 0, and the element:
  `["a", "b"] \list.toSeq \seq.mapIndexed { i, x -> "{i}{x}" }` gives `"0a"` and `"1b"`. Lazy.
export def seq.mapIndexed: ([c] seq(a)), ([d] int, a -> b) -> [c, d] seq(b) = { s, f ->
  seq.mapIndexedFrom(s, f, 0)
}

--| `s` from the first element for which `predicate` is false: `(1..5) \seq.skipWhile { < 3 }` gives
  `3`, `4` and `5`. Lazy: the elements it skips are pulled when the sequence is first pulled.
export def seq.skipWhile: ([c] seq(a)), ([d] a -> bool) -> [c, d] seq(a) = { s, predicate ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) ->
          if predicate(x) then
            def more = seq.skipWhile(rest, predicate)
            more.next()
          else #next(x, rest)
        | #done -> #done
    }
  )
}

--| The running totals of a fold: `initial`, then each value [`seq.fold`] passes along:
  `(1..3) \seq.scan(0) { + }` gives `0`, `1`, `3` and `6`. Lazy: each total is worked out when it is
  pulled, so it works on an endless sequence.
export def seq.scan: ([c] seq(a)), b, ([d] b, a -> b) -> [c, d] seq(b) = { s, initial, step ->
  Sequence(
    next = {
      #next(
        initial
        Sequence(
          next = {
            match s.next()
              | #next(x, rest) ->
                def more = seq.scan(rest, step(initial, x), step)
                more.next()
              | #done -> #done
          }
        )
      )
    }
  )
}

--| `f` applied to the elements of `s` and `t` in pairs, ending when either ends, as [`seq.zip`] does:
  `seq.zipWith(1.., 10..12, { + })` gives `11`, `13` and `15`. Lazy.
export def seq.zipWith
  : ([c] seq(a)), ([d] seq(b)), ([e] a, b -> f) -> [c, d, e] seq(f)
  = { s, t, f ->
    seq.map(seq.zip(s, t), { (x, y) -> f(x, y) })
  }

--| `s` with `separator` between each pair of neighbouring elements: `(1..3) \seq.intersperse(0)`
  gives `1`, `0`, `2`, `0` and `3`. Lazy.
export def seq.intersperse: ([c] seq(a)), a -> [c] seq(a) = { s, separator ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) -> #next(x, seq.flatMap(rest, { y -> list.toSeq([separator, y]) }))
        | #done -> #done
    }
  )
}

--| The first `size` elements of `s` as a list, last first, in front of `acc`, with the rest of `s`;
  fewer when `s` ends first.
def seq.takeList: [c] ([c] seq(a)), int, list(a) -> (list(a), ([c] seq(a))) = { s, size, acc ->
  if size <= 0 then (list.reverse(acc), s) else
    match s.next()
      | #next(x, rest) -> seq.takeList(rest, size - 1, [x, ...acc])
      | #done -> (list.reverse(acc), seq.empty())
}

--| `s` cut into lists of `size` elements, in order; the last is shorter when the sequence ends part
  way through one: `(1..5) \seq.chunks(2)` gives `[1, 2]`, `[3, 4]` and `[5]`. Lazy: each list is
  pulled when it is. A `size` below 1 crashes.
export def seq.chunks: ([c] seq(a)), int -> [c] seq(list(a)) = { s, size ->
  if size < 1 then crash("seq.chunks: the size must be 1 or more, but is {size}")

  Sequence(
    next = {
      def (chunk, rest) = seq.takeList(s, size, [])

      match chunk
        | [] -> #done
        | _ -> #next(chunk, seq.chunks(rest, size))
    }
  )
}

--| Each run of `size` neighbouring elements after `window`, which holds the `size - 1` before them.
def seq.windowsAfter: ([c] seq(a)), int, list(a) -> [c] seq(list(a)) = { s, size, window ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) ->
          def full = list.append(window, x)
          #next(full, seq.windowsAfter(rest, size, list.skip(full, 1)))
        | #done -> #done
    }
  )
}

--| Every run of `size` neighbouring elements, in order: `(1..4) \seq.windows(2)` gives `[1, 2]`,
  `[2, 3]` and `[3, 4]`, and a sequence shorter than `size` has none. Lazy: each window pulls one
  more element. A `size` below 1 crashes.
export def seq.windows: ([c] seq(a)), int -> [c] seq(list(a)) = { s, size ->
  if size < 1 then crash("seq.windows: the size must be 1 or more, but is {size}")

  Sequence(
    next = {
      def (first, rest) = seq.takeList(s, size - 1, [])
      def windows = seq.windowsAfter(rest, size, first)
      if list.length(first) < size - 1 then #done else windows.next()
    }
  )
}

--| The elements of `s` not in `seen`, each the first of its kind, adding each to `seen`.
def seq.distinctAfter: [Eq(a)] ([c] seq(a)), list(a) -> [c] seq(a) = { s, seen ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) ->
          if list.contains(seen, x) then
            def more = seq.distinctAfter(rest, seen)
            more.next()
          else #next(x, seq.distinctAfter(rest, [x, ...seen]))
        | #done -> #done
    }
  )
}

--| The elements of `s` without repeats, each where it first appears, compared with `==`. Lazy, but it
  remembers each element it has given, so its memory grows with the distinct elements, and finding
  the next one compares with each of them.
export def seq.distinct: [Eq(a)] ([c] seq(a)) -> [c] seq(a) = { s ->
  seq.distinctAfter(s, [])
}

--| The elements of `s` whose key is not in `seen`, each the first with its key.
def seq.distinctByAfter
  : [Eq(b), Hash(b)] ([c] seq(a)), ([d] a -> b), set(b) -> [c, d] seq(a)
  = { s, key, seen ->
    Sequence(
      next = {
        match s.next()
          | #next(x, rest) ->
            def k = key(x)

            if set.contains(seen, k) then
              def more = seq.distinctByAfter(rest, key, seen)
              more.next()
            else #next(x, seq.distinctByAfter(rest, key, set.insert(seen, k)))
          | #done -> #done
      }
    )
  }

--| The elements of `s` without two of the same `key`, each where the first with its key appears. Lazy,
  but it remembers each key it has seen, so its memory grows with the distinct keys.
export def seq.distinctBy
  : [Eq(b), Hash(b)] ([c] seq(a)), ([d] a -> b) -> [c, d] seq(a)
  = { s, key ->
    seq.distinctByAfter(s, key, set.empty)
  }

--| The sequence of `count` elements whose element at each position is `f` applied to the position:
  `seq.init(3, { i -> i * 2 })` gives `0`, `2` and `4`. Lazy: `f` runs on a position when the
  sequence is pulled that far. A `count` of zero or less gives no elements.
export def seq.init: int, ([c] int -> a) -> [c] seq(a) = { count, f ->
  seq.map(seq.range(0, count - 1), f)
}

--| `count` copies of `x`: `seq.replicate(0, count = 3)` gives `0`, `0` and `0`. A `count` of zero or
  less gives none.
export def seq.replicate: (a, count: int) -> seq(a) = { x, count ->
  seq.map(seq.range(1, count), { _ -> x })
}

--| The first parts of the pairs of `pairs` and their second parts, each a sequence: the inverse of
  [`seq.zip`]. Each side pulls `pairs` on its own, so a sequence whose steps have effects runs them
  once for each side pulled.
export def seq.unzip: [c] ([c] seq((a, b))) -> ([c] seq(a), ([c] seq(b))) = { pairs ->
  (seq.map(pairs, { (x, _) -> x }), seq.map(pairs, { (_, y) -> y }))
}

--| The elements of `s` for which `predicate` is true. Pulling it pulls `s` until one is, in constant
  stack.
export def seq.filter: ([c] seq(a)), ([d] a -> bool) -> [c, d] seq(a) = { s, predicate ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) ->
          def more = seq.filter(rest, predicate)
          if predicate(x) then #next(x, more) else more.next()
        | #done -> #done
    }
  )
}

--| The first `count` elements of `s`, or all of them if it has fewer. It pulls no more of `s` than
  that, so it ends an endless sequence: `(0..) \seq.take(3)` is `0`, `1` and `2`.
export def seq.take: ([c] seq(a)), int -> [c] seq(a) = { s, count ->
  Sequence(
    next = {
      if count <= 0 then
        #done
      else
        match s.next()
          | #next(x, rest) -> #next(x, seq.take(rest, count - 1))
          | #done -> #done
    }
  )
}

--| `s` without its first `count` elements, which are pulled and thrown away when it is pulled.
export def seq.skip: ([c] seq(a)), int -> [c] seq(a) = { s, count ->
  Sequence(
    next = {
      if count <= 0 then
        s.next()
      else
        match s.next()
          | #next(_, rest) ->
            def more = seq.skip(rest, count - 1)
            more.next()
          | #done -> #done
    }
  )
}

--| The elements of `s` up to the first for which `predicate` is false.
export def seq.takeWhile: ([c] seq(a)), ([d] a -> bool) -> [c, d] seq(a) = { s, predicate ->
  Sequence(
    next = {
      match s.next()
        | #next(x, rest) -> (if predicate(x)
          then #next(x, seq.takeWhile(rest, predicate))
          else #done)
        | #done -> #done
    }
  )
}

--| `step` applied to `initial` and the first element, then to that result and the second, and so
  on, pulling the whole of `s` now. Stack-safe, but an endless sequence never ends.
export def seq.fold: [c, d] ([c] seq(a)), b, ([d] b, a -> b) -> b = { s, initial, step ->
  match s.next()
    | #next(x, rest) -> seq.fold(rest, step(initial, x), step)
    | #done -> initial
}

--| [`seq.fold`] that can stop part-way: `step` gives `#some(acc)` to go on to the next element, and
  anything else it gives ends the fold there and is its result, as it is. A fold that runs to the end
  gives `#some(acc)`. It pulls no element after it stops, so it ends on an endless sequence that
  stops: `(1..) \seq.foldWhile(0, { total, n -> if total + n > 10 then #full(total) else
  #some(total + n) })` is `#full(10)`.
export def seq.foldWhile
  : [c, d] ([c] seq(a)), b, ([d] b, a -> #some(b) | r) -> #some(b) | r
  = { s, initial, step ->
    match s.next()
      | #next(x, rest) ->
        match step(initial, x)
          | #some(next) -> seq.foldWhile(rest, next, step)
          | r -> r
      | #done -> #some(initial)
  }

--| The elements of `s`, pulled now, combined with `f`, in order, starting from the first: `(1..5)
  \seq.reduce { * }` is `#some(120)`, and an empty sequence, having no first element, gives `#none`.
  To start from another value, use [`seq.fold`].
export def seq.reduce: [c, d] ([c] seq(a)), ([d] a, a -> a) -> #some(a) | #none = { s, f ->
  match s.next()
    | #next(x, rest) -> #some(seq.fold(rest, x, f))
    | #done -> #none
}

--| The elements of `s`, pulled now, as a list: `(1..3) \seq.toList` is `[1, 2, 3]`. Stack-safe, but
  an endless sequence never ends.
export def seq.toList: [c] ([c] seq(a)) -> list(a) = { s ->
  seq.fold(s, [], { acc, x -> [x, ...acc] }) \list.reverse
}

--| The elements of `s`, pulled now, as a list: `(1..3) \list.fromSeq` is `[1, 2, 3]`. It requires
  the contexts the sequence's steps do. An endless sequence never ends: cut it with [`seq.take`].
export def list.fromSeq: [c] ([c] seq(a)) -> list(a) = { s ->
  seq.toList(s)
}

-- Reading a sequence until the answer is known. These pull `s` now, and stop at the first element
-- that settles the answer, so they end on an endless sequence that has one.

--| The first element of `s` for which `matches` is true, or `#notFound`: `(1..) \seq.find { n -> n * n
  > 50 }` is `#some(8)`. It pulls `s` up to that element.
export def seq.find: [c, d] ([c] seq(a)), ([d] a -> bool) -> #some(a) | #notFound = { s, matches ->
  match s.next()
    | #next(x, rest) -> (if matches(x) then #some(x) else seq.find(rest, matches))
    | #done -> #notFound
}

--| The position, from `index`, of the first element of `s` for which `matches` is true.
def seq.findIndexFrom
  : [c, d] ([c] seq(a)), ([d] a -> bool), int -> #some(int) | #notFound
  = { s, matches, index ->
    match s.next()
      | #next(x, rest) -> (if matches(x)
        then #some(index)
        else seq.findIndexFrom(rest, matches, index + 1))
      | #done -> #notFound
  }

--| The position, counting from 0, of the first element of `s` for which `matches` is true, or
  `#notFound`. It pulls `s` up to that element.
export def seq.findIndex
  : [c, d] ([c] seq(a)), ([d] a -> bool) -> #some(int) | #notFound
  = { s, matches ->
    seq.findIndexFrom(s, matches, 0)
  }

--| The position, counting from 0, of the first element of `s` that is `== x`, or `#notFound`. It pulls
  `s` up to that element.
export def seq.indexOf: [Eq(a), c] ([c] seq(a)), a -> #some(int) | #notFound = { s, x ->
  seq.findIndex(s, { y -> y == x })
}

--| Whether `s` has an element `== x`. It pulls `s` until it finds one.
export def seq.contains: [Eq(a), c] ([c] seq(a)), a -> bool = { s, x ->
  seq.any(s, { y -> y == x })
}

--| Whether `test` holds for any element of `s` (so `false` for an empty one). It pulls `s` until it
  holds.
export def seq.any: [c, d] ([c] seq(a)), ([d] a -> bool) -> bool = { s, test ->
  match seq.find(s, test)
    | #some(_) -> true
    | #notFound -> false
}

--| Whether `test` holds for every element of `s` (so `true` for an empty one). It pulls `s` until it
  doesn't.
export def seq.all: [c, d] ([c] seq(a)), ([d] a -> bool) -> bool = { s, test ->
  match seq.find(s, { x -> not test(x) })
    | #some(_) -> false
    | #notFound -> true
}

--| The first element of `s`, or `#emptyList` when it has none, as [`list.head`] says. It pulls one
  element.
export def seq.head: [c] ([c] seq(a)) -> #some(a) | #emptyList = { s ->
  match s.next()
    | #next(x, _) -> #some(x)
    | #done -> #emptyList
}

--| The element of `s` at `index`, counting from 0, or `#notFound` when `index` is negative or `s`
  ends before it. It pulls `s` up to that element.
export def seq.at: [c] ([c] seq(a)), int -> #some(a) | #notFound = { s, index ->
  if index < 0 then #notFound else
    match s.next()
      | #next(x, rest) -> (if index == 0 then #some(x) else seq.at(rest, index - 1))
      | #done -> #notFound
}

--| Whether `s` has no elements. It pulls one element.
export def seq.isEmpty: [c] ([c] seq(a)) -> bool = { s ->
  match s.next()
    | #next(_, _) -> false
    | #done -> true
}

--| The first value `f` yields, running it on the elements in turn as [`seq.select`] does, or
  `#notFound` when it yields none. It stops at the first yield.
export def seq.selectOne
  : [c, d] ([c] seq(a)), ([d] a -> [d] seq(b)) -> #some(b) | #notFound
  = { s, f ->
    def selected = seq.flatMap(s, f)

    match selected.next()
      | #next(y, _) -> #some(y)
      | #done -> #notFound
  }

-- Reading the whole of a sequence. These pull every element of `s` now, so on an endless sequence
-- they never return: cut it with `seq.take` first.

--| How many elements of `s` `test` holds for. It pulls the whole of `s`.
export def seq.count: [c, d] ([c] seq(a)), ([d] a -> bool) -> int = { s, test ->
  seq.fold(s, 0, { n, x -> if test(x) then n + 1 else n })
}

--| How many elements `s` has. It pulls the whole of `s`.
export def seq.length: [c] ([c] seq(a)) -> int = { s ->
  seq.fold(s, 0, { n, _ -> n + 1 })
}

--| The last element of `s`, or `x` when it has none.
def seq.lastAfter: [c] ([c] seq(a)), a -> a = { s, x ->
  match s.next()
    | #next(y, rest) -> seq.lastAfter(rest, y)
    | #done -> x
}

--| The last element of `s`, or `#emptyList` when it has none. It pulls the whole of `s`.
export def seq.last: [c] ([c] seq(a)) -> #some(a) | #emptyList = { s ->
  match s.next()
    | #next(x, rest) -> #some(seq.lastAfter(rest, x))
    | #done -> #emptyList
}

--| `best`, or the element of `s` that `better` keeps over it and each of the others.
def seq.bestAfter: [c, d] ([c] seq(a)), ([d] a, a -> bool), a -> a = { s, better, best ->
  match s.next()
    | #next(x, rest) -> seq.bestAfter(rest, better, if better(x, best) then x else best)
    | #done -> best
}

--| The element of `s` that `better` keeps over each of the others, or `#emptyList`.
def seq.bestOf: [c, d] ([c] seq(a)), ([d] a, a -> bool) -> #some(a) | #emptyList = { s, better ->
  match s.next()
    | #next(x, rest) -> #some(seq.bestAfter(rest, better, x))
    | #done -> #emptyList
}

--| The largest element of `s`, or `#emptyList` when it has none; of equal ones, the first. It pulls the
  whole of `s`.
export def seq.max: [Ord(a), c] ([c] seq(a)) -> #some(a) | #emptyList = { s ->
  seq.bestOf(s, { x, y -> x > y })
}

--| The smallest element of `s`, or `#emptyList` when it has none; of equal ones, the first. It pulls
  the whole of `s`.
export def seq.min: [Ord(a), c] ([c] seq(a)) -> #some(a) | #emptyList = { s ->
  seq.bestOf(s, { x, y -> x < y })
}

--| The element of `s` whose `key` is largest, or `#emptyList` when it has none; of equal keys, the
  first. It pulls the whole of `s`.
export def seq.maxBy
  : [Ord(b), c, d] ([c] seq(a)), ([d] a -> b) -> #some(a) | #emptyList
  = { s, key ->
    seq.bestOf(s, { x, y -> key(x) > key(y) })
  }

--| The element of `s` whose `key` is smallest, or `#emptyList` when it has none; of equal keys, the
  first. It pulls the whole of `s`.
export def seq.minBy
  : [Ord(b), c, d] ([c] seq(a)), ([d] a -> b) -> #some(a) | #emptyList
  = { s, key ->
    seq.bestOf(s, { x, y -> key(x) < key(y) })
  }

--| The elements of `s` added up, from the element type's zero: `(1..4) \seq.sum` is `10`. It pulls
  the whole of `s`.
export def seq.sum: [Add(a), c] ([c] seq(a)) -> a = { s ->
  seq.fold(s, zero, { total, x -> total + x })
}

--| The elements of `s` for which `test` holds, and those for which it doesn't, each a list in order. It
  pulls the whole of `s`.
export def seq.partition: [c, d] ([c] seq(a)), ([d] a -> bool) -> (list(a), list(a)) = { s, test ->
  def (yes, no) = seq.fold(
    s
    ([], [])
    { (yes, no), x -> if test(x) then ([x, ...yes], no) else (yes, [x, ...no]) }
  )

  (list.reverse(yes), list.reverse(no))
}
