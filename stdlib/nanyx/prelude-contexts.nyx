@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- Equality --------------------------------------------------------------------------------------

--| How two values of type `a` are compared. `x == y` is read through it, and `x != y` is
  `not (x == y)`. The compiler has its own for every type that holds no function, which compares
  by structure: records field by field, lists element by element, tags by name and then payload.
  Functions have no equality, and a private type has only the `==` it attaches. A function that compares values of one of its type variables
  requires it: `def same: [Eq(a)] a, a -> bool`.
export context Eq(a) = (`==`: (a, a) -> bool)

--| The `==` of the compiler's own [`Eq`]: what a function that requires `Eq(a)` is passed when it is
  called with a type that has no `==` of its own.
export def __equals: a, a -> bool = { x, y ->
  x == y
}

--| What `xs == ys` calls on two lists whose elements have an `Eq` other than the compiler's own:
  `==` on a `list(Email)`, or on a `list(a)` in a function that requires `Eq(a)`. The lists are
  compared element by element through that `Eq`. `!=` is `not` of it.
export def __listEquals: [Eq(a)] list(a), list(a) -> bool = {
  | [], [] -> true
  | [x, ...xs], [y, ...ys] -> (if x == y then __listEquals(xs, ys) else false)
  | _, _ -> false
}

--| Whether the lists `xs` and `ys` hold equal elements in the same order, as `same` compares two
  elements. The `==` the compiler derives for a list whose elements have an `==` of their own
  calls it.
export def __listEqualsBy: [c] list(a), list(a), ([c] a, a -> bool) -> bool = { xs, ys, same ->
  match xs
    | [] -> list.isEmpty(ys)
    | [x, ...restOfXs] ->
      match ys
        | [] -> false
        | [y, ...restOfYs] ->
          if same(x, y) then __listEqualsBy(restOfXs, restOfYs, same) else false
}

-- Joining ---------------------------------------------------------------------------------------

--| The values of type `a` that join, end to end. `x ++ y` is read through it:
  `def surround: [Append(a)] a, a -> a = { edge, x -> edge ++ x ++ edge }` works at `string` and
  at any `list`. A type gets one by attaching `` def Path.`++` = ... ``.
export context Append(a) = (`++`: (a, a) -> a)

-- The compiler's own `Append` of `string` and `list(a)`: the members attached to them, which are
-- what a function that requires one is passed. `++` on a `string` or a `list` is the built-in
-- operator, not a call.

--| `x` followed by `y`.
export def string.`++`: string, string -> string = { x, y ->
  x ++ y
}

--| The elements of `xs` followed by those of `ys`.
export def list.`++`: list(a), list(a) -> list(a) = { xs, ys ->
  xs ++ ys
}

-- Ordering --------------------------------------------------------------------------------------

--| How two values of type `a` are put in order. `x < y`, `x <= y`, `x > y` and `x >= y` are read
  through it, so the four cannot disagree. The compiler has its own for numbers, `bool` (`false`
  first), `string` (by bytes, which is the order of code points), and tuples and lists of them
  (position by position, and a list that is a prefix of another first). Records and tags have no
  order: a nominal type gets one by attaching `compare`, and a private type has no other, and a list of records is sorted by a key
  with [`list.sortBy`]. A tuple or a list that holds a type with a `compare` of its own is ordered
  through it, position by position. A function that orders values of one of its type variables requires it:
  `def largest: [Ord(a)] list(a) -> ...`. `Ord` does not require `Eq`; a type that attaches both
  should keep them consistent.
export context Ord(a) = (compare: (a, a) -> #less | #equal | #greater)

--| The `compare` of the compiler's own [`Ord`]: what a function that requires `Ord(a)` is passed when
  it is called with a type that has no `compare` of its own. On floats it is a total order, with
  NaN after every other float, while `<` and the others on floats follow IEEE 754.
export def __compare: a, a -> #less | #equal | #greater = { x, y ->
  def order = __nanyx_compare(x, y)

  if order < 0 then #less else if order > 0 then #greater else #equal
}

--| What `x < y` calls when it reads an `Ord` other than the compiler's own: one a function
  requires, one loaded with `use`, or one built from an attached `compare`. `<=`, `>` and `>=`
  call the three after it.
export def __less: [Ord(a)] a, a -> bool = { x, y ->
  match compare(x, y)
    | #less -> true
    | _ -> false
}

export def __lessOrEqual: [Ord(a)] a, a -> bool = { x, y ->
  match compare(x, y)
    | #greater -> false
    | _ -> true
}

export def __greater: [Ord(a)] a, a -> bool = { x, y ->
  match compare(x, y)
    | #greater -> true
    | _ -> false
}

export def __greaterOrEqual: [Ord(a)] a, a -> bool = { x, y ->
  match compare(x, y)
    | #less -> false
    | _ -> true
}

--| How `x` and `y` are ordered through their `Ord`, whichever that is. The `compare` the compiler
  derives for a tuple whose parts have a `compare` of their own orders each part with it.
export def __compareOf: [Ord(a)] a, a -> #less | #equal | #greater = { x, y ->
  compare(x, y)
}

--| What `xs < ys` calls on two lists whose elements have an `Ord` other than the compiler's own:
  `<` on a `list(Version)`, or on a `list(a)` in a function that requires `Ord(a)`. The lists are
  ordered element by element through that `Ord`, and a list that is a prefix of the other comes
  first. `<=`, `>` and `>=` call the three after it.
export def __listCompare: [Ord(a)] list(a), list(a) -> #less | #equal | #greater = {
  | [], [] -> #equal
  | [], _ -> #less
  | _, [] -> #greater
  | [x, ...xs], [y, ...ys] ->
    match compare(x, y)
      | #equal -> __listCompare(xs, ys)
      | #less -> #less
      | #greater -> #greater
}

export def __listLess: [Ord(a)] list(a), list(a) -> bool = { xs, ys ->
  match __listCompare(xs, ys)
    | #less -> true
    | _ -> false
}

export def __listLessOrEqual: [Ord(a)] list(a), list(a) -> bool = { xs, ys ->
  match __listCompare(xs, ys)
    | #greater -> false
    | _ -> true
}

export def __listGreater: [Ord(a)] list(a), list(a) -> bool = { xs, ys ->
  match __listCompare(xs, ys)
    | #greater -> true
    | _ -> false
}

export def __listGreaterOrEqual: [Ord(a)] list(a), list(a) -> bool = { xs, ys ->
  match __listCompare(xs, ys)
    | #less -> false
    | _ -> true
}

-- Each built-in type with an order has its order attached as `compare`, so it can be called and
-- passed around. A built-in type's order is always the compiler's own: `<` and `Ord` do not read
-- these.

--| Whether `x` is less than, equal to or greater than `y`.
export def int.compare: int, int -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

--| Whether `x` is less than, equal to or greater than `y`, with NaN after every other float, as
  [`__compare`] orders floats.
export def float.compare: float, float -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

--| Whether `x` is less than, equal to or greater than `y`, with `false` first.
export def bool.compare: bool, bool -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

--| Whether `x` is less than, equal to or greater than `y`, by bytes, which is the order of code
  points.
export def string.compare: string, string -> #less | #equal | #greater = { x, y ->
  __compare(x, y)
}

-- Hashing ---------------------------------------------------------------------------------------

--| How a value of type `a` is hashed: an `int` that is the same for any two values `==` finds equal,
  so that a map can find a key by its hash. The compiler has its own for every type it has its own
  `Eq` for, which hashes by structure. A private type has only the `hash` it attaches. A nominal type that attaches its own `==` must attach a
  `hash` that agrees with it, or it has none: `def Email.hash = { e -> string.hash(lower(e)) }`
  for an `==` that ignores case. A function that hashes values of one of its type variables
  requires it: `def bucket: [Hash(a)] a, int -> int`.
export context Hash(a) = (hash: a -> int)

--| The `hash` of the compiler's own [`Hash`]: what a function that requires `Hash(a)` is passed when
  it is called with a type that has no `hash` of its own.
export def __hash: a -> int = { x ->
  __nanyx_hash(x)
}

--| The hash of `x` through its `Hash`, whichever that is. The `hash` the compiler derives for a
  structure whose parts have a `hash` of their own hashes each part with it.
export def __hashOf: [Hash(a)] a -> int = { x ->
  hash(x)
}

--| `seed` and `part`, two hashes, made one, in an order that tells `(a, b)` from `(b, a)`. The
  `hash` the compiler derives for a structure whose parts have a `hash` of their own folds its
  parts' hashes with it.
export def __hashCombine: int, int -> int = { seed, part ->
  int.wrappingAdd(int.wrappingMul(seed, 31), part)
}

--| The hash of the list `xs`, its elements' hashes, as `hashOf` gives them, folded in order into
  `seed`. The `hash` the compiler derives for a list whose elements have a `hash` of their own
  calls it.
export def __listHashBy: [c] int, list(a), ([c] a -> int) -> int = { seed, xs, hashOf ->
  match xs
    | [] -> seed
    | [x, ...rest] -> __listHashBy(__hashCombine(seed, hashOf(x)), rest, hashOf)
}

-- Each built-in type has its hash attached as `hash`, so that a type's own `hash` can be built from
-- its parts' hashes. A built-in type's hash is always the compiler's own: `Hash` does not read
-- these.

--| The compiler's own hash of `x`, as [`Hash`] gives it to a type with no `hash` of its own.
export def int.hash: int -> int = { x ->
  __hash(x)
}

--| The compiler's own hash of `x`, as [`Hash`] gives it to a type with no `hash` of its own.
export def float.hash: float -> int = { x ->
  __hash(x)
}

--| The compiler's own hash of `x`, as [`Hash`] gives it to a type with no `hash` of its own.
export def bool.hash: bool -> int = { x ->
  __hash(x)
}

--| The compiler's own hash of `s`, as [`Hash`] gives it to a type with no `hash` of its own.
export def string.hash: string -> int = { s ->
  __hash(s)
}

-- Text ------------------------------------------------------------------------------------------

--| How a value of type `a` is written as text. A hole in a string, `"Total: {total}"`, is written
  through it, so a type can be interpolated when it has one: a type gets one by attaching a
  `toString`, `def Point.toString = { p -> "({p.x}, {p.y})" }`, and a block can load another with
  `use`. The compiler has its own for `int`, `float`, `bool`, `string` and tags without a payload,
  and derives one for a tag with a payload, a tuple, a record, a list, a map and a set from the
  `ToString` of each part: `#some(3)`, `(1, two)`, `(x = 1, y = 2)`, `[1, 2, 3]`, `[a => 1]`. A
  measured value is written in the largest unit it is a whole number of: `1500ms`, `2min`.
export context ToString(a) = (toString: a -> string)

--| What `x \toString` calls where `x`'s type attaches no `toString`, as a list, a record, a tag or
  a unit quantity does not: `x` written by its [`ToString`], so `[1, 2] \toString` is `"[1, 2]"`.
export def __toStringOf: [ToString(a)] a -> string = { x ->
  "{x}"
}

--| What the compiler makes a hole in a string call: `"{x}"` is `"{__interpolate(x)}"`, so a hole
  needs a [`ToString`] of its value's type, as a call to a function that requires one does.
export def __interpolate: [ToString(a)] a -> string = { value ->
  toString(value)
}

--| The `toString` of the compiler's own [`ToString`] of a tag without a payload: what a function
  that requires `ToString(a)` is passed when it is called with one. It writes the tag's name.
export def __toString: a -> string = { value ->
  "{value}"
}

--| What the derived `toString` of a measured value stored as an `int` calls: `n` of its
  dimension's default storage units, written in the first of the units `names` that it is a whole
  number of, each as many default storage units as the scale beside it in `scales`, the largest
  first, so `1500ms` is written `1500ms` and `120s` is `2min`. Zero is written in `display`, the
  dimension's default display unit, `0s`, if it is not empty. A value no unit fits is written as
  an exact decimal of the first of the units `decimalNames` it is one of, each as many default
  storage units as the scale beside it in `decimalScales`, the smallest first: where the default
  storage unit is 0.2mm, made up because no unit is one, 13 of it is `2.6mm`. A value that is a
  decimal of none of them, and zero if `display` is empty, is written as a number of default
  storage units, between `before` and `after`.
export def __measuredIntToString
  : int, list(string), list(int), string, list(string), list(int), string, string -> string
  = {
    | n, [name, ...names], [scale, ...scales], display, decimalNames, decimalScales, before, after ->
      if n != 0 and n % scale == 0
        then "{n // scale}{name}"
        else __measuredIntToString(
          n
          names
          scales
          display
          decimalNames
          decimalScales
          before
          after
        )
    | n, _, _, display, decimalNames, decimalScales, before, after ->
      if n == 0 and display != ""
        then "0{display}"
        else measuredDecimal(n, decimalNames, decimalScales, before, after)
  }

--| `n` default storage units written as an exact decimal of the first of the units `names` it is
  one of, each as many default storage units as the scale beside it in `scales`, or as a number of
  default storage units, between `before` and `after`, if it is a decimal of none of them.
def measuredDecimal: int, list(string), list(int), string, string -> string = {
  | n, [name, ...names], [scale, ...scales], before, after ->
    def common = commonDivisor(n, scale)
    def denominator = scale // common
    def places = decimalPlaces(denominator, 0, 1)

    if places < 0
      then measuredDecimal(n, names, scales, before, after)
      else "{decimalText(n // common * (tenToThe(places, 1) // denominator), places)}{name}"
  | n, _, _, before, after -> "{before}{n}{after}"
}

--| The greatest common divisor of `a` and `b`, never negative.
def commonDivisor: int, int -> int = { a, b ->
  if b == 0 then (if a < 0 then -a else a) else commonDivisor(b, a % b)
}

--| How many decimal places a fraction over `denominator` has, the fewest `places` from which
  `power`, 10 to the power `places`, is a whole number of it; -1 if it has more than 18, as one
  over 3 does.
def decimalPlaces: int, int, int -> int = { denominator, places, power ->
  if power % denominator == 0
    then places
    else if places >= 18 then -1 else decimalPlaces(denominator, places + 1, power * 10)
}

--| `digits` divided by 10 to the power `places`, written as a decimal: `decimalText(26, 1)` is
  `2.6`.
def decimalText: int, int -> string = { digits, places ->
  def magnitude = if digits < 0 then -digits else digits
  def sign = if digits < 0 then "-" else ""
  def scale = tenToThe(places, 1)

  if places == 0
    then "{digits}"
    else "{sign}{magnitude // scale}.{zeroPadded(magnitude % scale, places)}"
}

--| What the derived `toString` of a measured value stored as a `float` calls: `x` of its
  dimension's default storage units, written in the first of the units `names` that its magnitude
  is at least 1 of, each as many default storage units as the scale beside it in `scales`, the
  largest first, so `1.5s` is written `1.5s`, `120.0s` is `2.0min` and `-1.5s` is `-1.5s`. A
  number under 1 of every unit is written in the last, the smallest: `0.25ns`. It is written as a
  `float` is, so a whole number keeps its decimal point. A number within a millionth of a millionth
  of a whole one is that whole one, as arithmetic on a `float` rounds. Zero is written in
  `display`, the dimension's default display unit, if it is not empty, and with no units, as a
  number of default storage units between `before` and `after`.
export def __measuredFloatToString
  : float, list(string), list(float), string, string, string -> string
  = {
    | x, [name, ...names], [scale, ...scales], display, before, after ->
      def count = x / scale
      def whole = wholeOf(count, #round)
      def near = (if whole < 0.0 then -whole else whole) * 1.0e-12
      def shown = if count - whole <= near and whole - count <= near then whole else count

      def smallest = match names
        | [] -> true
        | _ -> false

      if x != 0.0 and (shown >= 1.0 or shown <= -1.0 or smallest)
        then "{shown}{name}"
        else __measuredFloatToString(x, names, scales, display, before, after)
    | x, _, _, display, before, after ->
      if x == 0.0 and display != "" then "{x}{display}" else "{before}{x}{after}"
  }

--| What the derived `toString` of a value of a derived dimension stored as an `int` calls: `n` of
  its parts' default storage units, written in `name`, its parts' default display units, each of
  which is `numerator / denominator` of the others, when it is a whole number of them, so
  `2000mm * 1000mm` is written `2m*m`. A value that is no whole number of them is written as a
  number of default storage units, between `before` and `after`: `1500mm*mm`.
export def __measuredRatioToString
  : int, string, int, int, string, string -> string
  = { n, name, numerator, denominator, before, after ->
    if n % numerator == 0 then "{n // numerator * denominator}{name}" else "{before}{n}{after}"
  }

--| What the derived `toString` of a list calls: `xs` in square brackets, each element written by
  `show`, with `, ` between them. The elements' texts are joined once, so each is copied once.
export def __listToString: [c] list(a), ([c] a -> string) -> string = { xs, show ->
  "[{__nanyx_string_join(list.map(xs, show), ", ")}]"
}

-- Each built-in type has an attached `toString`, so a value can be turned into text by a function
-- that can be passed around, `scores \map(int.toString)`, as well as by interpolation. Each one
-- writes the value as interpolation does, with the compiler's own `ToString` for the type.

--| `n` in decimal, with a leading `-` when it is negative.
export def int.toString: int -> string = { n ->
  "{n}"
}

--| `x` in decimal, with the fewest digits that read back as `x`.
export def float.toString: float -> string = { x ->
  "{x}"
}

--| `true` or `false`.
export def bool.toString: bool -> string = { b ->
  "{b}"
}

--| `s` itself.
export def string.toString: string -> string = { s -> s }

--| How a value of type `a` is read from text, with `failure` for text that does not hold one:
  [`int.fromString`] gives back `#some(int) | #invalidInt`, so `int`'s `failure` is `#invalidInt`.
  A type gets one by attaching a `fromString`, as `int`, `float` and `bool` do,
  which also fixes its `failure`, so a function can read a value of whichever type it is called at:
  `def readAll: [FromString(a)] list(string) -> list(#some(a) | failure)`.
export context FromString(a) = (failure: type, fromString: string -> #some(a) | failure)

-- Types -----------------------------------------------------------------------------------------

--| The type `a` as a value, which the compiler gives for every type: a function that is given a
  value of type `a` can require `Typed(a)` and read `typeOf`, instead of also taking a parameter
  of type `Type(a)`, `def encode: [Typed(a)] a -> Json = { value -> encodeAt(value, typeOf) }`. A
  `use` can load another, but the only `Type(a)` value is `type a`, so it stands for the
  same type.
export context Typed(a) = (typeOf: Type(a))

--| The `typeOf` of the compiler's own [`Typed`]: what a function that requires `Typed(a)` is passed
  when it is called at a type.
export def __typeOf: Type(a) = type a

-- Defaults --------------------------------------------------------------------------------------

--| A value of type `a` to fall back on, or to fill with: `def valueOrDefault: [Default(a)] #some(a) |
  #none -> a`. A type gets one by attaching a `default` value, `def Point.default = Point(x = 0, y = 0)`,
  as each built-in type does.
export context Default(a) = (default: a)

--| `0`.
export def int.default: int = 0

--| `0.0`.
export def float.default: float = 0.0

--| `""`, the empty string.
export def string.default: string = ""

--| `false`.
export def bool.default: bool = false

--| `[]`, the empty list.
export def list.default: list(a) = []

--| `#none`: the `default` of the compiler's own [`Default`] of `#some(a) | #none`, which, being a union, has no
  name to attach one to.
export def __noneDefault: #some(a) | #none = #none

-- Yielding --------------------------------------------------------------------------------------

--| The keyword `yield`, of kind `#yield`: a block or lambda with `yield x` in it is a lazy sequence of
  the values it yields, and the code after a `yield` runs only when the sequence is pulled that far.
  `seq { yield 1  yield 2 }` gives `1` and `2`. Nothing loads this context: the compiler rewrites the
  block into calls to [`seq.cons`] and [`seq.empty`], so the sequence needs no context of its own. A
  builder that takes every value at once, such as [`list.build`] or [`list.select`], takes a function
  that calls [`Emit`]'s `emit` instead, which pushes each value as it comes and makes no sequence.
export context Yield(a) = (
  @customKeywordType(#yield)
  yield: a -> seq(a)
)

--| Values pushed one at a time to whatever handles them: `emit(x)` hands `x` to the handler in scope
  and carries on once it returns. It is the pushing counterpart of [`Yield`]: nothing is made per value
  but what the handler makes, and a `for` loop around an `emit` stays a loop. The builders that take
  every value at once, such as [`list.build`] and [`list.select`], take a function that requires
  `Emit` and run it under a handler that adds each value to what they build: `xs \list.select { x ->
  if x > 0 then emit(x) }` keeps the positive ones. A handler of your own is a `use`: `use Emit(int)(emit
  = { x -> println(x) }) in walk(tree)` prints each value `walk` emits.
export context Emit(a) = (emit: a -> ())
