@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- Time ------------------------------------------------------------------------------------------

--| How long something takes: a duration, stored in nanoseconds in any number type, so `500ms` is
  a `Time(int)` of 500,000,000 and `0.5s` a `Time(float)`, and written in seconds when no other
  unit fits, so zero is `0s`. A point in time is not one.
export dimension Time

--| A nanosecond, `Time`'s default storage unit: every other unit of it is a whole number of
  them. It is set by hand, as an [`Instant`] counts nanoseconds.
@storageUnit export unit ns: Time

--| A microsecond, 1,000 nanoseconds.
export unit us: Time = 1_000ns

--| A millisecond, 1,000 microseconds.
export unit ms: Time = 1_000us

--| A second, 1,000 milliseconds, and `Time`'s default display unit.
@baseUnit export unit s: Time = 1_000ms

--| A minute, 60 seconds.
export unit min: Time = 60s

--| An hour, 60 minutes.
export unit hr: Time = 60min

--| A day, 24 hours. Months and years are not units of `Time`, as their lengths vary.
export unit d: Time = 24hr
