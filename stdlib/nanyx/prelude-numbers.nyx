@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- Numbers ---------------------------------------------------------------------------------------

--| The value of the ASCII digit `b`, or -1 when `b` is not one.
def digitValue: int -> int = { b ->
  if b >= 48 and b <= 57 then b - 48 else -1
}

--| The negative of the number the decimal digits of `s` from byte `i` on write after the digits whose
  negative is `acc`, or `#invalidInt` at the first byte that is not a digit, or once the number is
  past the range of `int`. It is read as a negative number because the smallest `int`,
  -922337203685477580 * 10 - 8, has no positive, and each step is checked before it is taken.
def parseDigits: string, int, int -> #some(int) | #invalidInt = { s, i, acc ->
  if i >= __nanyx_string_length(s)
    then #some(acc)
    else if digitValue(__nanyx_string_byte_at(s, i)) < 0
      then #invalidInt
      else if acc < -922337203685477580 or
        acc == -922337203685477580 and digitValue(__nanyx_string_byte_at(s, i)) > 8
        then #invalidInt
        else parseDigits(s, i + 1, acc * 10 - digitValue(__nanyx_string_byte_at(s, i)))
}

--| The integer `s` writes in decimal, with an optional leading `-` or `+`, or `#invalidInt` for
  anything else (an empty string, a sign alone, spaces, other characters, or a number past the range
  of `int`).
export def int.fromString: string -> #some(int) | #invalidInt = { s ->
  def first = __nanyx_string_byte_at(s, 0)
  def start = if first == 45 or first == 43 then 1 else 0

  if __nanyx_string_length(s) <= start
    then #invalidInt
    else match parseDigits(s, start, 0)
      | #some(negated) ->
        if first == 45
          then #some(negated)
          else if negated == -922337203685477580 * 10 - 8 then #invalidInt else #some(0 - negated)
      | #invalidInt -> #invalidInt
}

--| `n` as a float: `int.toFloat(3)` is 3.0. Every `int` has an exact `float`. To go back, see
  `floor`, `ceil`, `round` and `truncate` in `nanyx/math`.
export def int.toFloat: int -> float = { n ->
  __nanyx_int_to_float(n)
}

-- Arithmetic ------------------------------------------------------------------------------------

--| The values of type `a` that add. `x + y` is read through it, and so is `0` beside a value of
  type `a` in a function whose type requires it: `def total: [Add(a)] list(a) -> a`. A type gets
  one by attaching the two members, `def Money.zero = ...` and `` def Money.`+` = ... ``.
export context Add(a) = (zero: a, `+`: (a, a) -> a)

--| The values of type `a` that subtract. `x - y` and `-x` are read through it. A type gets one by
  attaching the two members, `` def Money.`-` = ... `` and `def Money.negate = ...`.
export context Sub(a) = (`-`: (a, a) -> a, negate: a -> a)

--| The numbers of type `a`: [`Add`]'s and [`Sub`]'s members, and `x * y`, `x / y` and `x % y`. In a
  function whose type requires it, any other integer literal beside a value of type `a` is `fromInt`
  of it, so `def square: [Num(a)] a -> a = { x -> x * x }` and `{ x -> x * 2 }` work at `int` and
  `float`. A function that requires `Num(a)` can call one that requires `Add(a)` or `Sub(a)`: a
  `Num` has every member they have. On an integer type `/` truncates and `%` takes the sign of `x`;
  on `float` they are IEEE 754's. `math.mod` is the modulo with the sign of `y`. `isInteger` says which `a` is: `true` for an integer type, so
  `x ** -1` stops the program on one.
export context Num(a) = (
  zero: a
  `+`: (a, a) -> a
  `-`: (a, a) -> a
  negate: a -> a
  `*`: (a, a) -> a
  `/`: (a, a) -> a
  `%`: (a, a) -> a
  fromInt: int -> a
  isInteger: bool
)

-- The compiler's own `Add`, `Sub` and `Num` of `int` and `float`: the members attached to `int`
-- and `float`, which are what a function that requires one is passed. `+` on an `int` or a `float`
-- is the built-in operator, not a call.

--| The `int` that adds nothing.
export def int.zero: int = 0

--| The largest `int`, `9223372036854775807` (`2 ** 63 - 1`). Arithmetic that goes past it stops the program.
export def int.maxValue: int = 9223372036854775807

--| The smallest `int`, `-9223372036854775808` (`-(2 ** 63)`). Arithmetic that goes below it stops the program.
export def int.minValue: int = -9223372036854775808

--| `x` plus `y`.
export def int.`+`: int, int -> int = { x, y ->
  x + y
}

--| `x` minus `y`.
export def int.`-`: int, int -> int = { x, y ->
  x - y
}

--| `n` with its sign changed.
export def int.negate: int -> int = { n ->
  -n
}

--| `x` times `y`.
export def int.`*`: int, int -> int = { x, y ->
  x * y
}

--| `x` divided by `y`, truncated towards zero: `7 / 2` is 3 and `-7 / 2` is -3.
export def int.`/`: int, int -> int = { x, y ->
  x / y
}

--| The remainder of `x` divided by `y`, with the sign of `x`: `-7 % 2` is -1. For the modulo with the
  sign of `y`, which wraps an index into a range, see `math.mod`.
export def int.`%`: int, int -> int = { x, y ->
  x % y
}

--| `n` itself.
export def int.fromInt: int -> int = { n ->
  n
}

--| `true`: an `int` is an integer type.
export def int.isInteger: bool = true

--| The bits set in both `x` and `y`: `int.bitAnd(12, 10)` is 8.
export def int.bitAnd: int, int -> int = { x, y ->
  __nanyx_bit_and(x, y)
}

--| The bits set in `x`, in `y` or in both: `int.bitOr(12, 10)` is 14.
export def int.bitOr: int, int -> int = { x, y ->
  __nanyx_bit_or(x, y)
}

--| The bits set in one of `x` and `y` but not both: `int.bitXor(12, 10)` is 6.
export def int.bitXor: int, int -> int = { x, y ->
  __nanyx_bit_xor(x, y)
}

--| `n` with each of its bits flipped, which is `-n - 1`: `int.bitNot(0)` is -1.
export def int.bitNot: int -> int = { n ->
  __nanyx_bit_not(n)
}

--| `x` with its bits moved `count` places towards the high end, zeros coming in at the low end: `1 \int.shiftLeft(4)`
  is 16. Only the low six bits of `count` are read, so a count is taken modulo 64.
export def int.shiftLeft: int, int -> int = { x, count ->
  __nanyx_shift_left(x, count)
}

--| `x` with its bits moved `count` places towards the low end, copies of the sign bit coming in at the high end, so
  that the sign is kept: `int.shiftRight(-8, 1)` is -4. Only the low six bits of `count` are read, so a count is
  taken modulo 64.
export def int.shiftRight: int, int -> int = { x, count ->
  __nanyx_shift_right(x, count)
}

--| `x` with its bits moved `count` places towards the low end, zeros coming in at the high end, as if `x` had no
  sign: `int.shiftRightUnsigned(-1, 60)` is 15. Only the low six bits of `count` are read, so a count is taken
  modulo 64.
export def int.shiftRightUnsigned: int, int -> int = { x, count ->
  __nanyx_shift_right_unsigned(x, count)
}

--| The `float` that adds nothing.
export def float.zero: float = 0.0

--| `x` plus `y`.
export def float.`+`: float, float -> float = { x, y ->
  x + y
}

--| `x` minus `y`.
export def float.`-`: float, float -> float = { x, y ->
  x - y
}

--| `x` with its sign changed: `float.negate(0.0)` is negative zero.
export def float.negate: float -> float = { x ->
  -x
}

--| `x` times `y`.
export def float.`*`: float, float -> float = { x, y ->
  x * y
}

--| `x` divided by `y`.
export def float.`/`: float, float -> float = { x, y ->
  x / y
}

--| The remainder of `x` divided by `y`, truncated as C's `fmod` is: `7.5 % 2.0` is 1.5.
export def float.`%`: float, float -> float = { x, y ->
  x % y
}

--| `n` as a float, as [`int.toFloat`] gives it.
export def float.fromInt: int -> float = { n ->
  int.toFloat(n)
}

--| `false`: a `float` is not an integer type.
export def float.isInteger: bool = false

-- Powers ----------------------------------------------------------------------------------------

--| `acc` times `base` to the power `exponent`, for an `exponent` of zero or more: by repeated
  squaring, so it takes as many steps as `exponent` has bits.
def powOnto: [Num(a)] a, int, a -> a = { base, exponent, acc ->
  if exponent == 0
    then acc
    else powOnto(base * base, exponent / 2, if exponent % 2 == 0 then acc else acc * base)
}

--| What `base ** exponent` is: `base` multiplied by itself `exponent` times, so `2 ** 10` is 1024
  and `x ** 0` is 1. A negative exponent is `1 / base ** -exponent` on a type that is not an
  integer type, so `2.0 ** -1` is 0.5; on an integer type, which can't hold the result, it
  stops the program, as [`crash`] does.
export def __pow: [Num(a)] a, int -> a = { base, exponent ->
  if exponent >= 0
    then powOnto(base, exponent, fromInt(1))
    else if isInteger
      then crash("{exponent} is a negative exponent, and an integer raised to one isn't an integer")
      else fromInt(1) / powOnto(base, -exponent, fromInt(1))
}

--| What `f >> g` is: the function that applies `f`, and then `g` to what `f` returns.
export def __composeForward: ([c] a -> b), ([c] b -> d) -> [c] a -> d = { f, g ->
  { x -> g(f(x)) }
}

--| What `g << f` is: the same function as `f >> g`.
export def __composeBackward: ([c] b -> d), ([c] a -> b) -> [c] a -> d = { g, f ->
  { x -> g(f(x)) }
}

--| `base ** exponent`, as a function that can be passed around.
export def pow: [Num(a)] a, int -> a = { base, exponent ->
  base ** exponent
}

--| `2 ** n` times `x`, for an `n` that is a whole number of any size. A power of two past the range
  of a float is taken in steps of 2 ** 600, so for an `x` near 1, or a whole `x` below 2 ** 53, only
  the last step rounds: `scaleByTwos(1.0, -1074)` is the smallest float above zero.
def scaleByTwos: float, int -> float = { x, n ->
  if n > 1000
    then scaleByTwos(x * 2.0 ** 600, n - 600)
    else if n < -1000
      then scaleByTwos(x / 2.0 ** 600, n + 600)
      else if n >= 0 then x * 2.0 ** n else x / 2.0 ** -n
}

--| The sum of the series for `e ** r`, from the term `term` (which is `r ** k / k!`) on, with `sum`
  the terms before it. Twenty terms are enough for any `r` of at most `ln(2) / 2`.
def expSeries: float, float, float, int -> float = { r, term, sum, k ->
  if k > 20 then sum else expSeries(r, term * r / int.toFloat(k + 1), sum + term, k + 1)
}

--| `e ** z`, as `2 ** n * e ** r` with `r` of at most `ln(2) / 2`. `nanyx/math` gives it as `math.exp`.
export def __floatExp: float -> float = { z ->
  if z != z
    then z
    else if z > 709.8
      then 1.0 / 0.0
      else if z < -745.2
        then 0.0
        else expAround(z, __nanyx_float_floor(z / 0.6931471805599453 + 0.5))
}

--| `e ** z`, for `n` the number of `ln(2)`s nearest `z`. As in fdlibm, `r` is `z - n * ln(2)` held as
  `hi - lo`, with `ln(2)` split so that `hi` is exact. `e ** r` is `(1 + hi) + (q - lo)`, with `q`
  the series from `r ** 2 / 2` on: of the ways to add them up, it is the one most often the float
  nearest, and `e ** 1.0` is the float nearest `e`.
def expAround: float, float -> float = { z, n ->
  def hi = z - n * 0.6931471803691238
  def lo = n * 0.00000000019082149292705877
  def r = hi - lo
  scaleByTwos(1.0 + hi + (expSeries(r, r * r / 2.0, 0.0, 2) - lo), __nanyx_float_to_int(n))
}

--| The sum of the series for `atanh(t)`, from the term `term` (which is `t ** (2k + 1)`) on, with
  `sum` the terms before it. Thirty terms are enough for any `t` below 1/3.
def atanhSeries: float, float, float, int -> float = { term, tt, sum, k ->
  if k > 30 then sum else atanhSeries(term * tt, tt, sum + term / int.toFloat(2 * k + 1), k + 1)
}

--| The natural logarithm of `m * 2 ** k`, for an `m` above zero: `m` is moved into [1, 2) first.
def lnScaled: float, int -> float = { m, k ->
  if m >= 2.0
    then lnScaled(m / 2.0, k + 1)
    else if m < 1.0 then lnScaled(m * 2.0, k - 1) else lnOfReduced(m, k)
}

--| The natural logarithm of `m * 2 ** k`, for an `m` in [1, 2): `ln(m)` is `2 * atanh((m - 1) / (m + 1))`.
def lnOfReduced: float, int -> float = { m, k ->
  def t = (m - 1.0) / (m + 1.0)
  2.0 * atanhSeries(t, t * t, 0.0, 0) + int.toFloat(k) * 0.6931471805599453
}

--| The natural logarithm of `x`: minus infinity at zero, and NaN below it. `nanyx/math` gives it as `math.ln`.
export def __floatLn: float -> float = { x ->
  if x != x or x < 0.0
    then 0.0 / 0.0
    else if x == 0.0 then -1.0 / 0.0 else if x == 1.0 / 0.0 then x else lnScaled(x, 0)
}

--| `x` to the power `y`, which need not be a whole number: `float.pow(2.0, 0.5)` is the square root
  of 2. A whole `y` is `x ** y`, exactly; any other is `e ** (y * ln(x))`, so a negative `x` gives
  NaN.
export def float.pow: float, float -> float = { x, y ->
  def whole = __nanyx_float_trunc(y)

  if whole == y and y < 2147483648.0 and y > -2147483648.0
    then x ** __nanyx_float_to_int(whole)
    else __floatExp(y * __floatLn(x))
}

-- Reading floats --------------------------------------------------------------------------------

-- A decimal is read as a whole number `w`, its first 19 significant digits with the point taken out,
-- and a power of ten `e` that puts the point back: "12.5e3" is 125 times 10 ** 2. 19 digits are
-- below 2 ** 64, so `w` holds them as the bits of an `int`, read as if it had no sign. When `w` is
-- every digit and below 2 ** 53, and `e` is between -22 and 22, both `w` and 10 ** `e` are exact
-- floats, so the one multiplication or division rounds to the nearest float, as Clinger's fast path
-- does. Any other decimal of at most 19 digits is read with the Eisel–Lemire algorithm (see
-- [`eiselLemire`]), which gives the nearest float with a few multiplications of whole numbers. A
-- decimal of more digits is between `w` and `w + 1` times 10 ** `e`, and when those two give the same
-- float, so does it. When they don't, it is read exactly: the float is moved a step at a time from
-- that guess until the decimal is between the halfway points on either side of it, each comparison
-- made exactly, in whole numbers of any size, as Clinger's AlgorithmR does.

--| `m` times 10 ** `e`, for a whole `m` of zero or more. When `m` is below 2 ** 53 and `e` is
  between -22 and 22 both are exact, so the one multiplication or division rounds to the nearest
  float. Otherwise the power of ten is rounded too, by a few units in the last place.
def scaleByTens: float, int -> float = { m, e ->
  if m == 0.0
    then 0.0
    else if e >= 0
      then m * 10.0 ** e
      else if e < -300 then m / 10.0 ** 300 / 10.0 ** (-300 - e) else m / 10.0 ** -e
}

--| The decimal `s` writes from byte `i` on, read so far as `w` times 10 ** `e`. `w` holds the first
  19 significant digits, `held` of them so far, and `dropped` is whether a digit after those was not
  0. `digits` is how many digits there have been, and `afterPoint` whether they included a `.`. The
  decimal's digits start at byte `start`.
def readDecimal
  : string, int, int, int, int, int, int, bool, bool -> #some(float) | #invalidFloat
  = { s, start, i, w, e, digits, held, dropped, afterPoint ->
    if i >= __nanyx_string_length(s)
      then (if digits == 0
        then #invalidFloat
        else #some(decimalToFloat(s, start, w, e, dropped, 0)))
      else readDecimalByte(
        s
        start
        i
        w
        e
        digits
        held
        dropped
        afterPoint
        __nanyx_string_byte_at(s, i)
      )
  }

--| [`readDecimal`] at the byte `b`, which is byte `i` of `s`.
def readDecimalByte
  : string, int, int, int, int, int, int, bool, bool, int -> #some(float) | #invalidFloat
  = { s, start, i, w, e, digits, held, dropped, afterPoint, b ->
    def d = digitValue(b)

    if d >= 0
      then (if held < 19
        then readDecimal(
          s
          start
          i + 1
          int.wrappingAdd(int.wrappingMul(w, 10), d)
          (if afterPoint then e - 1 else e)
          digits + 1
          (if held == 0 and d == 0 then 0 else held + 1)
          dropped
          afterPoint
        )
        else readDecimal(
          s
          start
          i + 1
          w
          (if afterPoint then e else e + 1)
          digits + 1
          held
          dropped or d != 0
          afterPoint
        ))
      else if b == 46 and not afterPoint
        then readDecimal(s, start, i + 1, w, e, digits, held, dropped, true)
        else if (b == 101 or b == 69) and digits > 0
          then readExponent(s, start, i + 1, w, e, dropped)
          else #invalidFloat
  }

--| The exponent that starts at byte `i` of `s`, after its `e`, with its optional sign, applied to
  `w` and `e`.
def readExponent
  : string, int, int, int, int, bool -> #some(float) | #invalidFloat
  = { s, start, i, w, e, dropped ->
    def sign = __nanyx_string_byte_at(s, i)

    if sign == 45
      then readExponentDigits(s, start, i + 1, w, e, dropped, -1, 0, 0)
      else readExponentDigits(s, start, (if sign == 43 then i + 1 else i), w, e, dropped, 1, 0, 0)
  }

--| The digits of an exponent from byte `i` of `s` on, with `n` and `digits` the value and count read
  so far. An exponent past 100000 is held there: it makes infinity or zero all the same.
def readExponentDigits
  : string, int, int, int, int, bool, int, int, int -> #some(float) | #invalidFloat
  = { s, start, i, w, e, dropped, sign, n, digits ->
    if i >= __nanyx_string_length(s)
      then (if digits == 0
        then #invalidFloat
        else #some(decimalToFloat(s, start, w, e + sign * n, dropped, sign * n)))
      else if digitValue(__nanyx_string_byte_at(s, i)) < 0
        then #invalidFloat
        else readExponentDigits(
          s
          start
          i + 1
          w
          e
          dropped
          sign
          (if n > 100000 then n else n * 10 + digitValue(__nanyx_string_byte_at(s, i)))
          digits + 1
        )
  }

--| The float nearest the decimal whose digits start at byte `start` of `s`, which is `w` times
  10 ** `e` as [`readDecimal`] read it, or more by less than 10 ** `e` when `dropped`, and whose
  exponent, after an `e`, is `exponent`.
def decimalToFloat
  : string, int, int, int, bool, int -> float
  = { s, start, w, e, dropped, exponent ->
    if w == 0
      then 0.0
      else if dropped
        then readTruncated(s, start, w, e, exponent, eiselLemire(w, e))
        else if w > 0 and w < 9007199254740992 and e >= -22 and e <= 22
          then scaleByTens(int.toFloat(w), e)
          else eiselLemire(w, e)
  }

--| [`decimalToFloat`] of a decimal with more digits than `w` holds, which is between `w` and `w + 1`
  times 10 ** `e`, with `guess` the float nearest `w` times 10 ** `e`.
def readTruncated: string, int, int, int, int, float -> float = { s, start, w, e, exponent, guess ->
  if eiselLemire(int.wrappingAdd(w, 1), e) == guess
    then guess
    else gatherDigits(s, start, [], 0, 0, 0, false, exponent, guess)
}

-- The Eisel–Lemire algorithm (Lemire, "Number Parsing at a Gigabyte per Second", 2021), as Go, Rust
-- and C++'s `from_chars` read a decimal: `w`, shifted so that its top bit is set, times the top 128
-- bits of `5 ** q`, gives the float's 53 bits, and the bit after them, with enough of the rest to
-- round them, for any `w` of at most 19 digits (Mushtak and Lemire, "Fast Number Parsing Without
-- Fallback", 2023). The 128 bits of each power of five from -342 to 308 are in a table the compiler
-- puts in a module that reads floats, two words of 64 bits each, which `__nanyx_power_of_five`
-- reads. Every whole number here is 64 bits read as if it had no sign, so it is made with the
-- wrapping operations and compared with [`lessUnsigned`].

--| The float nearest `w` times 10 ** `q`, for a `w` that is not 0, read as if it had no sign. A
  decimal below 10 ** -342 is less than half the smallest float above zero, and one of at least
  10 ** 309 is past the largest float.
def eiselLemire: int, int -> float = { w, q ->
  if q < -342 then 0.0 else if q > 308 then 1.0 / 0.0 else eiselLemireShifted(w, q, leadingZeros(w))
}

--| [`eiselLemire`] of `w`, which has `zeros` bits that are 0 above its top bit.
def eiselLemireShifted: int, int, int -> float = { w, q, zeros ->
  def x = int.shiftLeft(w, zeros)
  def index = 2 * (q + 342)
  def power = __nanyx_power_of_five(index)
  def high = mulHigh(x, power)

  if int.bitAnd(high, 511) == 511
    then eiselLemireRefined(
      q
      zeros
      high
      int.wrappingMul(x, power)
      mulHigh(x, __nanyx_power_of_five(index + 1))
    )
    else roundProduct(q, zeros, high, int.wrappingMul(x, power))
}

--| [`roundProduct`] of the product `high` and `low` with `more`, the top 64 bits of the shifted `w`
  times the power's low word, added: when the 9 bits below the 55 it rounds are all 1, they could
  carry into them.
def eiselLemireRefined: int, int, int, int, int -> float = { q, zeros, high, low, more ->
  def sum = int.wrappingAdd(low, more)

  roundProduct(q, zeros, (if lessUnsigned(sum, more) then int.wrappingAdd(high, 1) else high), sum)
}

--| The float the 128-bit product `high` and `low` of [`eiselLemireShifted`] gives: its top 54 or 55
  bits are the float's 53, the bit to round them by, and one more when the top bit is 0. `power2` is
  the float's biased exponent, 1 for the smallest normal float.
def roundProduct: int, int, int, int -> float = { q, zeros, high, low ->
  def upper = int.shiftRightUnsigned(high, 63)
  def shift = upper + 9
  def mantissa = int.shiftRightUnsigned(high, shift)
  def power2 = int.shiftRight(217706 * q, 16) + 63 + upper - zeros + 1023

  if power2 <= 0
    then roundSubnormal(mantissa, 1 - power2)
    else roundNormal(
      (if exactlyHalfway(q, mantissa, shift, high, low) then mantissa - 1 else mantissa)
      power2
    )
}

--| Whether the decimal is exactly halfway between two floats, when `mantissa`, the top bits of the
  product `high` and `low` that [`roundProduct`] took by `shift`, ends in the bits 01: no bit below
  is 1, which only a power of ten from -4 to 23 can give. Its last bit, then, is cleared, so that
  [`roundNormal`] rounds it down to even.
def exactlyHalfway: int, int, int, int, int -> bool = { q, mantissa, shift, high, low ->
  if low == 0 or low == 1
    then q >= -4 and q <= 23 and int.bitAnd(mantissa, 3) == 1 and
      int.shiftLeft(mantissa, shift) == high
    else false
}

--| The float of `mantissa`, the 53 bits of a normal float and the bit to round them by, rounded,
  whose biased exponent is `power2`: infinity past the largest float. Rounding up to 2 ** 53 makes
  the float's 53 bits 1 followed by 0s and adds one to its exponent, and an addition gives just that,
  as the top bit is not stored.
def roundNormal: int, int -> float = { mantissa, power2 ->
  def rounded = int.shiftRightUnsigned(mantissa + int.bitAnd(mantissa, 1), 1)

  if power2 + int.shiftRightUnsigned(rounded, 53) >= 2047
    then 1.0 / 0.0
    else __nanyx_float_from_bits(int.shiftLeft(power2 - 1, 52) + rounded)
}

--| The subnormal float, or the smallest normal one, nearest `mantissa`, shifted right by `shift`
  bits but 1, which is then rounded.
def roundSubnormal: int, int -> float = { mantissa, shift ->
  if shift >= 64 then 0.0 else roundSubnormalShifted(int.shiftRightUnsigned(mantissa, shift))
}

--| [`roundSubnormal`] of `shifted`, which has the bit to round by as its last.
def roundSubnormalShifted: int -> float = { shifted ->
  __nanyx_float_from_bits(int.shiftRightUnsigned(shifted + int.bitAnd(shifted, 1), 1))
}

--| How many bits that are 0 are above the top bit of `w`, which is not 0, read as if it had no sign.
def leadingZeros: int -> int = { w ->
  leadingZerosFrom(w, 0, 32)
}

--| [`leadingZeros`] of `w` shifted left by `count` bits, looking at its top `step` bits, then at
  half as many.
def leadingZerosFrom: int, int, int -> int = { w, count, step ->
  if step == 0
    then count
    else if int.shiftRightUnsigned(w, 64 - step) == 0
      then leadingZerosFrom(int.shiftLeft(w, step), count + step, step / 2)
      else leadingZerosFrom(w, count, step / 2)
}

--| Whether `x` is less than `y`, both read as if they had no sign.
def lessUnsigned: int, int -> bool = { x, y ->
  int.bitXor(x, -9223372036854775807 - 1) < int.bitXor(y, -9223372036854775807 - 1)
}

--| The top 64 bits of the 128-bit product of `x` and `y`, both read as if they had no sign, from the
  products of their 32-bit halves.
def mulHigh: int, int -> int = { x, y ->
  def xLow = int.bitAnd(x, 4294967295)
  def xHigh = int.shiftRightUnsigned(x, 32)
  def yLow = int.bitAnd(y, 4294967295)
  def yHigh = int.shiftRightUnsigned(y, 32)
  def lowHigh = int.wrappingMul(xLow, yHigh)
  def highLow = int.wrappingMul(xHigh, yLow)
  def lowLow = int.wrappingMul(xLow, yLow)

  def middle = int.shiftRightUnsigned(lowLow, 32) + int.bitAnd(lowHigh, 4294967295) +
    int.bitAnd(highLow, 4294967295)

  int.wrappingAdd(
    int.wrappingAdd(int.wrappingMul(xHigh, yHigh), int.shiftRightUnsigned(lowHigh, 32))
    int.shiftRightUnsigned(highLow, 32) + int.shiftRightUnsigned(middle, 32)
  )
}

--| Every digit of the decimal from byte `i` of `s` on, up to its exponent or its end, as a whole
  number of any size (see [`limbsMulAdd`]): `whole` holds the digits gathered so far but the last
  `chunkDigits`, which are `chunk`. `significant` is how many digits there have been since the first
  that is not 0, and `e10` the power of ten that puts the point back, which starts as the exponent.
  It goes on to [`readExactly`] with `guess`, a float near the decimal.
def gatherDigits
  : string, int, list(int), int, int, int, bool, int, float -> float
  = { s, i, whole, chunk, chunkDigits, significant, afterPoint, e10, guess ->
    def b = __nanyx_string_byte_at(s, i)
    def d = digitValue(b)

    if d >= 0
      then gatherDigits(
        s
        i + 1
        (if chunkDigits == 8 then limbsMulAdd(whole, 1000000000, chunk * 10 + d) else whole)
        (if chunkDigits == 8 then 0 else chunk * 10 + d)
        (if chunkDigits == 8 then 0 else chunkDigits + 1)
        (if significant == 0 and d == 0 then 0 else significant + 1)
        afterPoint
        (if afterPoint then e10 - 1 else e10)
        guess
      )
      else if b == 46
        then gatherDigits(s, i + 1, whole, chunk, chunkDigits, significant, true, e10, guess)
        else readExactly(limbsMulAdd(whole, 10 ** chunkDigits, chunk), significant, e10, guess)
  }

--| The float nearest `digits` times 10 ** `e10`, where `digits` has `significant` digits, starting
  from `guess`. A decimal of at least 10 ** 309 is infinity, and one below 10 ** -324, less than half
  the smallest float above zero, is 0, without the work of reading them exactly.
def readExactly: list(int), int, int, float -> float = { digits, significant, e10, guess ->
  if significant == 0
    then 0.0
    else if significant + e10 >= 310
      then 1.0 / 0.0
      else if significant + e10 <= -324
        then 0.0
        else settleFromGuess(
          (if e10 >= 0 then limbsMulPowerOfFive(digits, e10) else digits)
          (if e10 >= 0 then [1] else limbsMulPowerOfFive([1], -e10))
          e10
          guess
        )
}

--| The float nearest the decimal [`compareWithHalfway`] reads from `scaled`, `fives` and `e10`,
  starting from `guess`: the largest float when `guess` is infinity.
def settleFromGuess: list(int), list(int), int, float -> float = { scaled, fives, e10, guess ->
  if guess == 1.0 / 0.0
    then settle(scaled, fives, e10, 9007199254740991, 971)
    else if guess == 0.0
      then settle(scaled, fives, e10, 0, -1074)
      else settleFromFloat(scaled, fives, e10, guess, binaryExponent(guess) - 52)
}

--| [`settleFromGuess`] for a `guess` above zero that is `mantissa * 2 ** k` for a whole `mantissa`
  below 2 ** 53, or for a smaller `k` if `guess` is too small to have one that is at least -1074.
def settleFromFloat
  : list(int), list(int), int, float, int -> float
  = { scaled, fives, e10, guess, k ->
    if k < -1074
      then settleFromFloat(scaled, fives, e10, guess, -1074)
      else settle(scaled, fives, e10, __nanyx_float_to_int(scaleByTwos(guess, -k)), k)
  }

--| The `k` for which `x / 2 ** k` is at least 1 and below 2, for a finite `x` above zero.
def binaryExponent: float -> int = { x ->
  if x < 1.0e-300
    then binaryExponentFrom(x * 2.0 ** 600, 512, -600)
    else binaryExponentFrom(x, 512, 0)
}

--| [`binaryExponent`] of `x * 2 ** k`, moving `x` towards [1, 2) by `2 ** step`, then by each power
  of two below it.
def binaryExponentFrom: float, int, int -> int = { x, step, k ->
  if step == 0
    then k
    else if x >= 2.0 ** step
      then binaryExponentFrom(x / 2.0 ** step, step / 2, k + step)
      else if x * 2.0 ** step < 2.0
        then binaryExponentFrom(x * 2.0 ** step, step / 2, k - step)
        else binaryExponentFrom(x, step / 2, k)
}

-- A candidate float is `mantissa * 2 ** k`, with `mantissa` a whole number below 2 ** 53 and `k`
-- from -1074 to 971. The float after it is `(mantissa + 1) * 2 ** k`, so the halfway point between
-- the two is `(2 * mantissa + 1) * 2 ** (k - 1)`.

--| `mantissa * 2 ** k` as a float, which is exact; infinity past the largest float.
def floatOfMantissa: int, int -> float = { mantissa, k ->
  scaleByTwos(int.toFloat(mantissa), k)
}

--| Whether the decimal is above (1), at (0) or below (-1) the halfway point between `mantissa * 2 ** k`
  and the float after it. The decimal is `scaled * 2 ** e10 / fives`, as [`readExactly`] gives
  them: its digits times `5 ** e10` and 1 for an `e10` of zero or more, and its digits and
  `5 ** -e10` for a negative one. Both sides are made whole numbers before they are compared.
def compareWithHalfway
  : list(int), list(int), int, int, int -> int
  = { scaled, fives, e10, mantissa, k ->
    def halfway = limbsMulInt(fives, 2 * mantissa + 1)
    def shift = e10 - k + 1

    if shift >= 0
      then limbsCompare(limbsShiftLeft(scaled, shift), halfway)
      else limbsCompare(scaled, limbsShiftLeft(halfway, -shift))
  }

--| The float nearest the decimal, starting from the candidate `mantissa * 2 ** k`.
def settle: list(int), list(int), int, int, int -> float = { scaled, fives, e10, mantissa, k ->
  def order = compareWithHalfway(scaled, fives, e10, mantissa, k)

  if order > 0
    then stepUp(scaled, fives, e10, mantissa, k)
    else if order == 0
      then nearestEven(mantissa, k)
      else if mantissa == 0 then 0.0 else stepDown(scaled, fives, e10, mantissa, k)
}

--| [`settleAbove`] the float after `mantissa * 2 ** k`, for a decimal above the halfway point
  between the two.
def stepUp: list(int), list(int), int, int, int -> float = { scaled, fives, e10, mantissa, k ->
  if mantissa + 1 == 9007199254740992
    then settleAbove(scaled, fives, e10, 4503599627370496, k + 1)
    else settleAbove(scaled, fives, e10, mantissa + 1, k)
}

--| The float nearest a decimal that is above the halfway point between `mantissa * 2 ** k` and the
  float before it: infinity past the largest float.
def settleAbove: list(int), list(int), int, int, int -> float = { scaled, fives, e10, mantissa, k ->
  if k > 971
    then 1.0 / 0.0
    else settledAbove(
      scaled
      fives
      e10
      mantissa
      k
      compareWithHalfway(scaled, fives, e10, mantissa, k)
    )
}

--| [`settleAbove`], with `order` the decimal's [`compareWithHalfway`] of `mantissa * 2 ** k`.
def settledAbove
  : list(int), list(int), int, int, int, int -> float
  = { scaled, fives, e10, mantissa, k, order ->
    if order > 0
      then stepUp(scaled, fives, e10, mantissa, k)
      else if order == 0 then nearestEven(mantissa, k) else floatOfMantissa(mantissa, k)
  }

--| [`settleBelow`] the float before `mantissa * 2 ** k`, for a decimal below the halfway point
  between the two.
def stepDown: list(int), list(int), int, int, int -> float = { scaled, fives, e10, mantissa, k ->
  if mantissa == 4503599627370496 and k > -1074
    then settleBelow(scaled, fives, e10, 9007199254740991, k - 1)
    else settleBelow(scaled, fives, e10, mantissa - 1, k)
}

--| The float nearest a decimal that is below the halfway point between the float after
  `mantissa * 2 ** k` and the one after that.
def settleBelow: list(int), list(int), int, int, int -> float = { scaled, fives, e10, mantissa, k ->
  def order = compareWithHalfway(scaled, fives, e10, mantissa, k)

  if order > 0
    then floatOfMantissa(mantissa + 1, k)
    else if order == 0
      then nearestEven(mantissa, k)
      else if mantissa == 0 then 0.0 else stepDown(scaled, fives, e10, mantissa, k)
}

--| Of `mantissa * 2 ** k` and the float after it, the one whose mantissa is even, for a decimal
  halfway between them, as IEEE 754 rounds a tie.
def nearestEven: int, int -> float = { mantissa, k ->
  if mantissa % 2 == 0 then floatOfMantissa(mantissa, k) else floatOfMantissa(mantissa + 1, k)
}

-- Whole numbers of any size, as reading a float exactly needs: a list of 32-bit limbs, the lowest
-- first, so `[1, 2]` is `1 + 2 * 2 ** 32`. A list may end in limbs that are 0. Each step keeps its
-- products below 2 ** 63, so no `int` overflows.

--| `xs` times `k` plus `add`, for a `k` and an `add` from 0 to below 2 ** 31.
def limbsMulAdd: list(int), int, int -> list(int) = { xs, k, add ->
  limbsMulAddOnto(xs, k, add, [])
}

--| [`limbsMulAdd`] of the limbs `xs`, with `carry` to add, after the limbs `acc`, which are in
  reverse.
def limbsMulAddOnto: list(int), int, int, list(int) -> list(int) = {
  | [], _, carry, acc -> reverseOnto((if carry == 0 then acc else [carry, ...acc]), [])
  | [x, ...rest], k, carry, acc ->
    limbsMulAddLimb(rest, k, x * k + carry, acc)
}

--| [`limbsMulAddOnto`], with `t` the limb `x * k + carry` and its carry.
def limbsMulAddLimb: list(int), int, int, list(int) -> list(int) = { rest, k, t, acc ->
  limbsMulAddOnto(rest, k, int.shiftRightUnsigned(t, 32), [int.bitAnd(t, 4294967295), ...acc])
}

--| `xs` times `5 ** n`, for an `n` of zero or more.
def limbsMulPowerOfFive: list(int), int -> list(int) = { xs, n ->
  if n >= 13
    then limbsMulPowerOfFive(limbsMulAdd(xs, 1220703125, 0), n - 13)
    else limbsMulAdd(xs, 5 ** n, 0)
}

--| `xs` times `v`, for a `v` from 0 to below 2 ** 62: `v` is split into two parts of 31 bits.
def limbsMulInt: list(int), int -> list(int) = { xs, v ->
  limbsAdd(
    limbsShiftLeft(limbsMulAdd(xs, int.shiftRightUnsigned(v, 31), 0), 31)
    limbsMulAdd(xs, int.bitAnd(v, 2147483647), 0)
  )
}

--| `xs` times `2 ** n`, for an `n` of zero or more.
def limbsShiftLeft: list(int), int -> list(int) = { xs, n ->
  prependZeros(shiftBitsOnto(xs, n % 32, 0, []), n / 32)
}

--| `xs` with `count` limbs that are 0 in front.
def prependZeros: list(int), int -> list(int) = { xs, count ->
  if count == 0 then xs else prependZeros([0, ...xs], count - 1)
}

--| The limbs `xs` times `2 ** bits`, for `bits` below 32, with `carry` to add, after the limbs `acc`,
  which are in reverse.
def shiftBitsOnto: list(int), int, int, list(int) -> list(int) = {
  | [], _, carry, acc -> reverseOnto((if carry == 0 then acc else [carry, ...acc]), [])
  | [x, ...rest], bits, carry, acc ->
    shiftBitsLimb(rest, bits, carry, int.shiftLeft(x, bits), acc)
}

--| [`shiftBitsOnto`], with `t` the limb `x * 2 ** bits`.
def shiftBitsLimb: list(int), int, int, int, list(int) -> list(int) = { rest, bits, carry, t, acc ->
  shiftBitsOnto(
    rest
    bits
    int.shiftRightUnsigned(t, 32)
    [int.bitOr(int.bitAnd(t, 4294967295), carry), ...acc]
  )
}

--| `xs` plus `ys`.
def limbsAdd: list(int), list(int) -> list(int) = { xs, ys ->
  limbsAddOnto(xs, ys, 0, [])
}

--| [`limbsAdd`] of the limbs `xs` and `ys`, with `carry` to add, after the limbs `acc`, which are in
  reverse.
def limbsAddOnto: list(int), list(int), int, list(int) -> list(int) = {
  | [], [], carry, acc -> reverseOnto((if carry == 0 then acc else [carry, ...acc]), [])
  | [], ys, carry, acc -> limbsAddOnto(ys, [], carry, acc)
  | [x, ...xs], [], carry, acc -> limbsAddSum(xs, [], x + carry, acc)
  | [x, ...xs], [y, ...ys], carry, acc -> limbsAddSum(xs, ys, x + y + carry, acc)
}

--| [`limbsAddOnto`], with `t` the sum of a limb of each and the carry.
def limbsAddSum: list(int), list(int), int, list(int) -> list(int) = { xs, ys, t, acc ->
  limbsAddOnto(xs, ys, int.shiftRightUnsigned(t, 32), [int.bitAnd(t, 4294967295), ...acc])
}

--| 1 when `xs` is more than `ys`, 0 when they are equal and -1 when it is less.
def limbsCompare: list(int), list(int) -> int = { xs, ys ->
  limbsCompareFrom(xs, ys, 0)
}

--| [`limbsCompare`] of `xs` and `ys`, the limbs above those already compared, with `order` what the
  limbs below gave: a higher limb that differs decides.
def limbsCompareFrom: list(int), list(int), int -> int = {
  | [], [], order -> order
  | [x, ...xs], [], order -> limbsCompareFrom(xs, [], if x > 0 then 1 else order)
  | [], [y, ...ys], order -> limbsCompareFrom([], ys, if y > 0 then -1 else order)
  | [x, ...xs], [y, ...ys], order ->
    limbsCompareFrom(xs, ys, if x > y then 1 else if x < y then -1 else order)
}

--| The float `s` writes in decimal, or `#invalidFloat` for anything else (an empty string, a sign
  alone, spaces, other characters, `"1.2.3"`). It reads an optional leading `-` or `+`, digits with
  an optional `.` among them (`"3"`, `"0.25"`, `".5"` and `"5."` are all read), and an optional
  exponent, `e` or `E` then an integer: `"1.0e-7"`. `NaN`, `Infinity` and `-Infinity` are read as
  [`float.toString`] writes them.

  The result is the float nearest the decimal, however many digits it has, and of two equally
  near, the one whose last bit is 0, as IEEE 754 rounds. So every float `float.toString` writes reads
  back as itself, and `float.fromString("0.1")` is the float the literal `0.1` is. A number at least
  halfway from the largest float to 2 ** 1024 is infinity, and one at most half the smallest float
  above zero is 0. A decimal of at most 19 significant digits is read with a few multiplications of
  64-bit whole numbers; one of more digits that is very near halfway between two floats is read with
  exact arithmetic on whole numbers of any size, which takes longer.
export def float.fromString: string -> #some(float) | #invalidFloat = { s ->
  def first = __nanyx_string_byte_at(s, 0)
  def start = if first == 45 or first == 43 then 1 else 0

  if s == "NaN"
    then #some(0.0 / 0.0)
    else if first == 45
      then mapSome(readFloatMagnitude(s, start), float.negate)
      else readFloatMagnitude(s, start)
}

--| The float `s` writes from byte `start` on, after any sign.
def readFloatMagnitude: string, int -> #some(float) | #invalidFloat = { s, start ->
  if s == "Infinity" or s == "+Infinity" or s == "-Infinity"
    then #some(1.0 / 0.0)
    else readDecimal(s, start, start, 0, 0, 0, 0, false, false)
}
