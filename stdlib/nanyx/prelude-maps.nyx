@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- Maps ------------------------------------------------------------------------------------------
--
-- A `map(k, v)` holds one value for each of its keys. It is written `["a" => 1, "b" => 2]`, and
-- calling it looks a key up: `m("a")` is `map.get(m, "a")`. Keys are compared with `==`, so a map
-- needs an `Eq` of its key type. Attached to `map`, so they are called as `map.insert(m, k, v)`, or
-- as `m \insert(k, v)` when `m` is known to be a map. Maps are immutable: every function gives back
-- a new map.
--
-- A map is held as its store, a `__mapStore(k, v)`: a hash trie, whose shape the compiler defines
-- (`Maps.storeOf`) and every algorithm on which is here:
--
--   #empty                     the map with no keys, never part of another trie
--   #node(leafBits, leaves, nodeBits, nodes)
--                              the keys whose hashes agree on the bits the nodes above read, split by
--                              the next five: `leafBits` has bit `c` set for each five-bit value `c`
--                              whose keys `leaves` holds as a bucket, and `nodeBits` for each whose
--                              keys a node of `nodes` holds, each array in the order of `c`
--
-- A bucket is the entries of the keys whose hashes are the same, one or more, each a key and its
-- value, in the compiler's own order of their keys' structure (`__compare`). It doesn't keep the
-- hash: an insert that meets a bucket of other keys hashes one of them again. A node at depth `d`
-- reads bits `5d` to `5d + 4` of a hash, from its low end, and its two sets of bits share none. The
-- root is a node, or `#empty`. A node below it has two buckets or nodes or more, or one node, as
-- inserting two keys whose hashes agree on more bits makes; never one bucket alone, which removing a
-- key moves up into the node above. So the same keys make the same trie however they were added and
-- removed, and its walk gives them in one order, that of their hashes read five bits at a time from
-- the low end: unspecified, but the same for equal maps (see
-- docs/src/content/deep-dives/maps-and-sets.md). A `for` loop reads a bucket straight from its node's
-- array (`StoreWalk` in the compiler).

--| The five bits of the hash `h` a node at `shift` reads.
def chunkOf: int, int -> int = { h, shift ->
  int.bitAnd(int.shiftRightUnsigned(h, shift), 31)
}

--| How many bits of `bits`, which has no more than 32, are set.
def bitCount: int -> int = { bits ->
  def pairs = bits - int.bitAnd(int.shiftRightUnsigned(bits, 1), 1431655765)

  def nibbles = int.bitAnd(pairs, 858993459) +
    int.bitAnd(int.shiftRightUnsigned(pairs, 2), 858993459)

  def bytes = int.bitAnd(nibbles + int.shiftRightUnsigned(nibbles, 4), 252645135)
  def halves = bytes + int.shiftRightUnsigned(bytes, 8)
  int.bitAnd(halves + int.shiftRightUnsigned(halves, 16), 63)
}

--| Where in a node's array, with `bits` set, the element for the bit `bit` is, or would go.
def slotOf: int, int -> int = { bits, bit ->
  bitCount(int.bitAnd(bits, bit - 1))
}

--| `children` with `child` put in at `slot`.
def insertedAt: array(a), int, a -> array(a) = { children, slot, child ->
  def count = __nanyx_array_length(children)
  def made = __nanyx_array_new(count + 1)

  copyInto(children, 0, made, 0, slot)
  __nanyx_array_write(made, slot, child)
  copyInto(children, slot, made, slot + 1, count - slot)
  made
}

--| `children` with the child at `slot` taken out.
def removedAt: array(a), int -> array(a) = { children, slot ->
  def count = __nanyx_array_length(children)
  def made = __nanyx_array_new(count - 1)

  copyInto(children, 0, made, 0, slot)
  copyInto(children, slot + 1, made, slot, count - slot - 1)
  made
}

--| `children` with `child` at `slot` in place of the one there.
def replacedAt: array(a), int, a -> array(a) = { children, slot, child ->
  def count = __nanyx_array_length(children)
  def made = __nanyx_array_new(count)

  copyInto(children, 0, made, 0, slot)
  __nanyx_array_write(made, slot, child)
  copyInto(children, slot + 1, made, slot + 1, count - slot - 1)
  made
}

--| Writes `count` elements of `from`, from `index` on, into `made`, a new array, from `at` on.
def copyInto: array(a), int, array(a), int, int -> () = { from, index, made, at, count ->
  if count > 0 then
    __nanyx_array_write(made, at, __nanyx_array_get(from, index))
    copyInto(from, index + 1, made, at + 1, count - 1)
  else ()
}

--| The value `entries` holds for `key`, or `#notFound`, comparing every key.
def findEntry: [Eq(k)] list((k, v)), k -> #some(v) | #notFound = {
  | [], _ -> #notFound
  | [(entryKey, value), ...rest], key -> if entryKey == key
    then #some(value)
    else findEntry(rest, key)
}

--| `entries`, a bucket's, without `key`. `acc` holds the entries before, last first.
def withoutEntry: [Eq(k)] list((k, v)), k, list((k, v)) -> list((k, v)) = {
  | [], _, acc -> reverseOnto(acc, [])
  | [(entryKey, value), ...rest], key, acc -> if entryKey == key
    then reverseOnto(acc, rest)
    else withoutEntry(rest, key, [(entryKey, value), ...acc])
}

--| `entries`, a bucket's, in the compiler's own order of their keys' structure and without `key`,
  with `key` holding `value` in its place in that order. `acc` holds the entries before, last first.
def placedEntry: list((k, v)), k, v, list((k, v)) -> list((k, v)) = {
  | [], key, value, acc -> reverseOnto(acc, [(key, value)])
  | [(entryKey, entryValue), ...rest], key, value, acc -> match __compare(entryKey, key)
    | #greater -> reverseOnto(acc, [(key, value), (entryKey, entryValue), ...rest])
    | _ -> placedEntry(rest, key, value, [(entryKey, entryValue), ...acc])
}

--| The node of `leafBits` and its buckets, `leaves`, and `nodeBits` and its nodes, `nodes`.
def nodeWith
  : int, array(list((k, v))), int, array(__mapStore(k, v)) -> __mapStore(k, v)
  = { leafBits, leaves, nodeBits, nodes ->
    #node(leafBits, leaves, nodeBits, nodes)
  }

--| The node at `shift` with `entries`, a bucket, alone.
def bucketNode: list((k, v)), int, int -> __mapStore(k, v) = { entries, h, shift ->
  nodeWith(
    int.shiftLeft(1, chunkOf(h, shift))
    __nanyx_array_of_list([entries])
    0
    __nanyx_array_new(0)
  )
}

--| The hash of the keys of `entries`, a bucket's, which all have the same one.
def bucketHash: [Hash(k)] list((k, v)) -> int = {
  | [] -> 0
  | [(key, _), ..._] -> hash(key)
}

--| The value `store` holds for `key`, whose hash is `h`, or `#notFound`, below a node at `shift`.
def findIn
  : [Eq(k)] __mapStore(k, v), k, int, int -> #some(v) | #notFound
  = { store, key, h, shift ->
    match store
      | #empty -> #notFound
      | #node(leafBits, leaves, nodeBits, nodes) -> findInNode(
        leafBits
        leaves
        nodeBits
        nodes
        key
        h
        shift
      )
  }

--| [`findIn`] a node of `leafBits`, `leaves`, `nodeBits` and `nodes`.
def findInNode
  : [Eq(k)]
    int, array(list((k, v))), int, array(__mapStore(k, v)), k, int, int -> #some(v) | #notFound
  = { leafBits, leaves, nodeBits, nodes, key, h, shift ->
    def bit = int.shiftLeft(1, chunkOf(h, shift))

    if int.bitAnd(leafBits, bit) != 0
      then findEntry(__nanyx_array_get(leaves, slotOf(leafBits, bit)), key)
      else if int.bitAnd(nodeBits, bit) != 0
        then findIn(__nanyx_array_get(nodes, slotOf(nodeBits, bit)), key, h, shift + 5)
        else #notFound
  }

--| The node at `shift` that holds `first`, a bucket whose keys' hash is `firstHash`, and `second`,
  another whose keys' hash is `secondHash`: a chain of nodes as long as the two hashes agree, then
  one node with both.
def joined
  : list((k, v)), int, list((k, v)), int, int -> __mapStore(k, v)
  = { first, firstHash, second, secondHash, shift ->
    def firstBit = int.shiftLeft(1, chunkOf(firstHash, shift))
    def secondBit = int.shiftLeft(1, chunkOf(secondHash, shift))

    if firstBit == secondBit
      then nodeWith(
        0
        __nanyx_array_new(0)
        firstBit
        __nanyx_array_of_list([joined(first, firstHash, second, secondHash, shift + 5)])
      )
      else if firstBit < secondBit
        then nodeWith(
          int.bitOr(firstBit, secondBit)
          __nanyx_array_of_list([first, second])
          0
          __nanyx_array_new(0)
        )
        else nodeWith(
          int.bitOr(firstBit, secondBit)
          __nanyx_array_of_list([second, first])
          0
          __nanyx_array_new(0)
        )
  }

--| `store`, below a node at `shift`, with `key`, whose hash is `h`, holding `value`, in place of any
  value it held.
def insertedIn
  : [Eq(k), Hash(k)] __mapStore(k, v), k, int, v, int -> __mapStore(k, v)
  = { store, key, h, value, shift ->
    match store
      | #empty -> bucketNode([(key, value)], h, shift)
      | #node(leafBits, leaves, nodeBits, nodes) -> insertedInNode(
        leafBits
        leaves
        nodeBits
        nodes
        key
        h
        value
        shift
      )
  }

--| [`insertedIn`] a node of `leafBits`, `leaves`, `nodeBits` and `nodes`.
def insertedInNode
  : [Eq(k), Hash(k)]
    int, array(list((k, v))), int, array(__mapStore(k, v)), k, int, v, int -> __mapStore(k, v)
  = { leafBits, leaves, nodeBits, nodes, key, h, value, shift ->
    def bit = int.shiftLeft(1, chunkOf(h, shift))

    if int.bitAnd(leafBits, bit) != 0
      then insertedInBucket(
        leafBits
        leaves
        nodeBits
        nodes
        slotOf(leafBits, bit)
        bit
        key
        h
        value
        shift
      )
      else if int.bitAnd(nodeBits, bit) != 0
        then insertedInChild(
          leafBits
          leaves
          nodeBits
          nodes
          slotOf(nodeBits, bit)
          key
          h
          value
          shift
        )
        else nodeWith(
          int.bitOr(leafBits, bit)
          insertedAt(leaves, slotOf(leafBits, bit), [(key, value)])
          nodeBits
          nodes
        )
  }

--| [`insertedInNode`], whose bucket at `slot`, for `bit`, the key goes in: the bucket with it, if
  its keys have the key's hash, or a node of the two buckets in its place.
def insertedInBucket
  : [Eq(k), Hash(k)]
    int,
    array(list((k, v))),
    int,
    array(__mapStore(k, v)),
    int,
    int,
    k,
    int,
    v,
    int
    -> __mapStore(k, v)
  = { leafBits, leaves, nodeBits, nodes, slot, bit, key, h, value, shift ->
    def entries = __nanyx_array_get(leaves, slot)
    def theirs = bucketHash(entries)

    if theirs == h
      then nodeWith(
        leafBits
        replacedAt(leaves, slot, placedEntry(withoutEntry(entries, key, []), key, value, []))
        nodeBits
        nodes
      )
      else nodeWith(
        int.bitXor(leafBits, bit)
        removedAt(leaves, slot)
        int.bitOr(nodeBits, bit)
        insertedAt(
          nodes
          slotOf(nodeBits, bit)
          joined(entries, theirs, [(key, value)], h, shift + 5)
        )
      )
  }

--| [`insertedInNode`], whose node at `slot` the key goes in.
def insertedInChild
  : [Eq(k), Hash(k)]
    int, array(list((k, v))), int, array(__mapStore(k, v)), int, k, int, v, int -> __mapStore(k, v)
  = { leafBits, leaves, nodeBits, nodes, slot, key, h, value, shift ->
    def child = insertedIn(__nanyx_array_get(nodes, slot), key, h, value, shift + 5)
    nodeWith(leafBits, leaves, nodeBits, replacedAt(nodes, slot, child))
  }

--| `store`, below a node at `shift`, without `key`, whose hash is `h`. A node left with no keys is
  `#empty`, which only the root is; the node above takes in a node left with one bucket alone.
def removedFrom
  : [Eq(k)] __mapStore(k, v), k, int, int -> __mapStore(k, v)
  = { store, key, h, shift ->
    match store
      | #empty -> store
      | #node(leafBits, leaves, nodeBits, nodes) -> removedFromNode(
        store
        leafBits
        leaves
        nodeBits
        nodes
        key
        h
        shift
      )
  }

--| [`removedFrom`] `store`, a node of `leafBits`, `leaves`, `nodeBits` and `nodes`.
def removedFromNode
  : [Eq(k)]
    __mapStore(k, v),
    int,
    array(list((k, v))),
    int,
    array(__mapStore(k, v)),
    k,
    int,
    int
    -> __mapStore(k, v)
  = { store, leafBits, leaves, nodeBits, nodes, key, h, shift ->
    def bit = int.shiftLeft(1, chunkOf(h, shift))

    if int.bitAnd(leafBits, bit) != 0
      then removedFromBucket(leafBits, leaves, nodeBits, nodes, slotOf(leafBits, bit), bit, key)
      else if int.bitAnd(nodeBits, bit) != 0
        then removedFromChild(
          leafBits
          leaves
          nodeBits
          nodes
          slotOf(nodeBits, bit)
          bit
          key
          h
          shift
        )
        else store
  }

--| [`removedFromNode`], whose bucket at `slot`, for `bit`, holds the key if any does.
def removedFromBucket
  : [Eq(k)] int, array(list((k, v))), int, array(__mapStore(k, v)), int, int, k -> __mapStore(k, v)
  = { leafBits, leaves, nodeBits, nodes, slot, bit, key ->
    match withoutEntry(__nanyx_array_get(leaves, slot), key, [])
      | [] -> nodeOrEmpty(int.bitXor(leafBits, bit), removedAt(leaves, slot), nodeBits, nodes)
      | left -> nodeWith(leafBits, replacedAt(leaves, slot, left), nodeBits, nodes)
  }

--| The node of `leafBits`, `leaves`, `nodeBits` and `nodes`, or `#empty` when it has neither.
def nodeOrEmpty
  : int, array(list((k, v))), int, array(__mapStore(k, v)) -> __mapStore(k, v)
  = { leafBits, leaves, nodeBits, nodes ->
    if leafBits == 0 and nodeBits == 0 then #empty else nodeWith(leafBits, leaves, nodeBits, nodes)
  }

--| [`removedFromNode`], whose node at `slot`, for `bit`, holds the key if any does: the node left in
  its place, or its one bucket, if that is all it has left.
def removedFromChild
  : [Eq(k)]
    int,
    array(list((k, v))),
    int,
    array(__mapStore(k, v)),
    int,
    int,
    k,
    int,
    int
    -> __mapStore(k, v)
  = { leafBits, leaves, nodeBits, nodes, slot, bit, key, h, shift ->
    match removedFrom(__nanyx_array_get(nodes, slot), key, h, shift + 5)
      | #empty -> nodeOrEmpty(leafBits, leaves, int.bitXor(nodeBits, bit), removedAt(nodes, slot))
      | #node(childLeafBits, childLeaves, childNodeBits, childNodes) -> withChild(
        leafBits
        leaves
        nodeBits
        nodes
        slot
        bit
        childLeafBits
        childLeaves
        childNodeBits
        childNodes
      )
  }

--| The node of `leafBits`, `leaves`, `nodeBits` and `nodes`, with the node of `childLeafBits`,
  `childLeaves`, `childNodeBits` and `childNodes` at `slot`, for `bit`, in place of the one there:
  as a bucket, if it holds one bucket alone.
def withChild
  : int,
    array(list((k, v))),
    int,
    array(__mapStore(k, v)),
    int,
    int,
    int,
    array(list((k, v))),
    int,
    array(__mapStore(k, v))
    -> __mapStore(k, v)
  = { leafBits, leaves, nodeBits, nodes, slot, bit, childLeafBits, childLeaves, childNodeBits, childNodes ->
    if childNodeBits == 0 and bitCount(childLeafBits) == 1
      then nodeWith(
        int.bitOr(leafBits, bit)
        insertedAt(leaves, slotOf(leafBits, bit), __nanyx_array_get(childLeaves, 0))
        int.bitXor(nodeBits, bit)
        removedAt(nodes, slot)
      )
      else nodeWith(
        leafBits
        leaves
        nodeBits
        replacedAt(nodes, slot, nodeWith(childLeafBits, childLeaves, childNodeBits, childNodes))
      )
  }

--| The entries of `store`, each a key and its value, in the order of its walk, then `rest`.
def entriesOnto: __mapStore(k, v), list((k, v)) -> list((k, v)) = { store, rest ->
  match store
    | #empty -> rest
    | #node(leafBits, leaves, nodeBits, nodes) -> nodeEntriesOnto(
      leafBits
      leaves
      nodeBits
      nodes
      31
      rest
    )
}

--| The entries of a node of `leafBits`, `leaves`, `nodeBits` and `nodes`, of its buckets and nodes
  for the five-bit values up to `chunk`, in order, then `rest`.
def nodeEntriesOnto
  : int, array(list((k, v))), int, array(__mapStore(k, v)), int, list((k, v)) -> list((k, v))
  = { leafBits, leaves, nodeBits, nodes, chunk, rest ->
    if chunk < 0
      then rest
      else nodeEntriesOnto(
        leafBits
        leaves
        nodeBits
        nodes
        chunk - 1
        chunkEntriesOnto(leafBits, leaves, nodeBits, nodes, __nanyx_shift_left(1, chunk), rest)
      )
  }

--| The entries of the bucket or node a node of `leafBits`, `leaves`, `nodeBits` and `nodes` has for
  `bit`, if any, then `rest`.
def chunkEntriesOnto
  : int, array(list((k, v))), int, array(__mapStore(k, v)), int, list((k, v)) -> list((k, v))
  = { leafBits, leaves, nodeBits, nodes, bit, rest ->
    if __nanyx_bit_and(leafBits, bit) != 0
      then bucketOnto(elementFor(leaves, leafBits, bit), rest)
      else if __nanyx_bit_and(nodeBits, bit) != 0
        then entriesOnto(elementFor(nodes, nodeBits, bit), rest)
        else rest
  }

--| The element of `elements`, a node's array, whose bits are `bits`, for the bit `bit`. It is generic
  in what the array holds, and calls intrinsics rather than `int`'s functions, as every function
  the compiler calls a map through must: one that isn't generic would be made for every program,
  whether it reads a map or not.
def elementFor: array(a), int, int -> a = { elements, bits, bit ->
  def below = __nanyx_bit_and(bits, bit - 1)

  def pairs = below - __nanyx_bit_and(__nanyx_shift_right_unsigned(below, 1), 1431655765)

  def nibbles = __nanyx_bit_and(pairs, 858993459) +
    __nanyx_bit_and(__nanyx_shift_right_unsigned(pairs, 2), 858993459)

  def bytes = __nanyx_bit_and(nibbles + __nanyx_shift_right_unsigned(nibbles, 4), 252645135)
  def halves = bytes + __nanyx_shift_right_unsigned(bytes, 8)

  __nanyx_array_get(
    elements
    __nanyx_bit_and(halves + __nanyx_shift_right_unsigned(halves, 16), 63)
  )
}

--| `entries`, a bucket's, in order, then `rest`.
def bucketOnto: list((k, v)), list((k, v)) -> list((k, v)) = {
  | [entry], rest -> [entry, ...rest]
  | entries, rest -> reverseOnto(reverseOnto(entries, []), rest)
}

--| `step` applied to `acc` and each key and value of `store` in turn, in the order of its walk.
def foldStore: [c] __mapStore(k, v), b, ([c] b, k, v -> b) -> b = { store, acc, step ->
  match store
    | #empty -> acc
    | #node(leafBits, leaves, nodeBits, nodes) -> foldNode(
      leafBits
      leaves
      nodeBits
      nodes
      0
      acc
      step
    )
}

--| `step` applied to `acc` and each key and value of a node of `leafBits`, `leaves`, `nodeBits` and
  `nodes`, of its buckets and nodes for the five-bit values from `chunk` on.
def foldNode
  : [c] int, array(list((k, v))), int, array(__mapStore(k, v)), int, b, ([c] b, k, v -> b) -> b
  = { leafBits, leaves, nodeBits, nodes, chunk, acc, step ->
    if chunk > 31
      then acc
      else foldNode(
        leafBits
        leaves
        nodeBits
        nodes
        chunk + 1
        foldChunk(leafBits, leaves, nodeBits, nodes, int.shiftLeft(1, chunk), acc, step)
        step
      )
  }

--| `step` applied to `acc` and each key and value of the bucket or node a node of `leafBits`,
  `leaves`, `nodeBits` and `nodes` has for `bit`, if any.
def foldChunk
  : [c] int, array(list((k, v))), int, array(__mapStore(k, v)), int, b, ([c] b, k, v -> b) -> b
  = { leafBits, leaves, nodeBits, nodes, bit, acc, step ->
    if int.bitAnd(leafBits, bit) != 0
      then foldEntries(__nanyx_array_get(leaves, slotOf(leafBits, bit)), acc, step)
      else if int.bitAnd(nodeBits, bit) != 0
        then foldStore(__nanyx_array_get(nodes, slotOf(nodeBits, bit)), acc, step)
        else acc
  }

--| `step` applied to `acc` and each key and value of `entries` in turn.
def foldEntries: [c] list((k, v)), b, ([c] b, k, v -> b) -> b = {
  | [], acc, _ -> acc
  | [(key, value), ...rest], acc, step -> foldEntries(rest, step(acc, key, value), step)
}

--| `store` with `convertKey` of each key and `convertValue` of each value in its place, the shape
  as it is, so nothing is hashed or compared again.
def convertedStore
  : [c] __mapStore(k, v), ([c] k -> j), ([c] v -> w) -> __mapStore(j, w)
  = { store, convertKey, convertValue ->
    match store
      | #empty -> #empty
      | #node(leafBits, leaves, nodeBits, nodes) -> nodeWith(
        leafBits
        convertedLeaves(
          leaves
          __nanyx_array_new(__nanyx_array_length(leaves))
          0
          convertKey
          convertValue
        )
        nodeBits
        convertedChildren(
          nodes
          __nanyx_array_new(__nanyx_array_length(nodes))
          0
          convertKey
          convertValue
        )
      )
  }

--| `made`, a new array, once each of `leaves`, buckets, from `index` on is written into it with
  `convertKey` of each key and `convertValue` of each value in its place.
def convertedLeaves
  : [c]
    array(list((k, v))), array(list((j, w))), int, ([c] k -> j), ([c] v -> w) -> array(list((j, w)))
  = { leaves, made, index, convertKey, convertValue ->
    if index < __nanyx_array_length(leaves) then
      __nanyx_array_write(
        made
        index
        convertedEntries(__nanyx_array_get(leaves, index), convertKey, convertValue, [])
      )

      convertedLeaves(leaves, made, index + 1, convertKey, convertValue)
    else made
  }

--| `entries`, a bucket's, with `convertKey` of each key and `convertValue` of each value in its
  place, after `acc`, the ones before, last first.
def convertedEntries: [c] list((k, v)), ([c] k -> j), ([c] v -> w), list((j, w)) -> list((j, w)) = {
  | [], _, _, acc -> reverseOnto(acc, [])
  | [(key, value), ...rest], convertKey, convertValue, acc -> convertedEntries(
    rest
    convertKey
    convertValue
    [(convertKey(key), convertValue(value)), ...acc]
  )
}

--| `x` as it is.
def unchanged: a -> a = { x -> x }

--| `made`, a new array, once [`convertedStore`] of each of `children` from `index` on is written
  into it.
def convertedChildren
  : [c]
    array(__mapStore(k, v)),
    array(__mapStore(j, w)),
    int,
    ([c] k -> j),
    ([c] v -> w)
    -> array(__mapStore(j, w))
  = { children, made, index, convertKey, convertValue ->
    if index < __nanyx_array_length(children) then
      __nanyx_array_write(
        made
        index
        convertedStore(__nanyx_array_get(children, index), convertKey, convertValue)
      )

      convertedChildren(children, made, index + 1, convertKey, convertValue)
    else made
  }

--| A map's store with `convertKey` of each key and `convertValue` of each value in its place, its
  shape as it is: how the compiler boxes the keys and values of a map for its type's description,
  and unboxes them again, without hashing anything (see `Maps.convertedStore` in the compiler).
export def __mapStoreConverted
  : [c] __mapStore(k, v), ([c] k -> j), ([c] v -> w) -> __mapStore(j, w)
  = { store, convertKey, convertValue ->
    convertedStore(store, convertKey, convertValue)
  }

--| A set's store with `convert` of each element in its place, as [`__mapStoreConverted`] converts a
  map's.
export def __setStoreConverted
  : [c] __mapStore(a, ()), ([c] a -> b) -> __mapStore(b, ())
  = { store, convert ->
    convertedStore(store, convert, unchanged)
  }

--| `store` with the entries `f` gives `#some` for, each with the value it gives, and without the
  others: the entries kept stay where they were, and a node below the root left with one bucket alone
  is that bucket in the node above, so the trie is the one their keys make.
def chosenStore
  : [c] __mapStore(k, v), ([c] k, v -> #some(w) | #skip) -> __mapStore(k, w)
  = { store, f ->
    match store
      | #empty -> #empty
      | #node(leafBits, leaves, nodeBits, nodes) -> chosenNode(
        leafBits
        leaves
        nodeBits
        nodes
        0
        0
        []
        0
        []
        f
      )
  }

--| The node of the buckets and nodes of a node of `leafBits`, `leaves`, `nodeBits` and `nodes` for
  the five-bit values from `chunk` on, each with the entries `f` chooses, after `keptLeafBits` and
  `keptLeaves`, and `keptNodeBits` and `keptNodes`, the ones before, last first, that keep any; or
  `#empty`, if none does.
def chosenNode
  : [c]
    int,
    array(list((k, v))),
    int,
    array(__mapStore(k, v)),
    int,
    int,
    list(list((k, w))),
    int,
    list(__mapStore(k, w)),
    ([c] k, v -> #some(w) | #skip)
    -> __mapStore(k, w)
  = { leafBits, leaves, nodeBits, nodes, chunk, keptLeafBits, keptLeaves, keptNodeBits, keptNodes, f ->
    def bit = int.shiftLeft(1, chunk)

    if chunk > 31
      then nodeOrEmpty(
        keptLeafBits
        __nanyx_array_of_list(reverseOnto(keptLeaves, []))
        keptNodeBits
        __nanyx_array_of_list(reverseOnto(keptNodes, []))
      )
      else if int.bitAnd(leafBits, bit) != 0
        then chosenBucket(
          leafBits
          leaves
          nodeBits
          nodes
          chunk
          keptLeafBits
          keptLeaves
          keptNodeBits
          keptNodes
          chosenEntries(__nanyx_array_get(leaves, slotOf(leafBits, bit)), f, [])
          f
        )
        else if int.bitAnd(nodeBits, bit) != 0
          then chosenChild(
            leafBits
            leaves
            nodeBits
            nodes
            chunk
            keptLeafBits
            keptLeaves
            keptNodeBits
            keptNodes
            chosenStore(__nanyx_array_get(nodes, slotOf(nodeBits, bit)), f)
            f
          )
          else chosenNode(
            leafBits
            leaves
            nodeBits
            nodes
            chunk + 1
            keptLeafBits
            keptLeaves
            keptNodeBits
            keptNodes
            f
          )
  }

--| [`chosenNode`] on from the next five-bit value, with `chosen`, the entries kept of the bucket for
  `chunk`, kept if there are any.
def chosenBucket
  : [c]
    int,
    array(list((k, v))),
    int,
    array(__mapStore(k, v)),
    int,
    int,
    list(list((k, w))),
    int,
    list(__mapStore(k, w)),
    list((k, w)),
    ([c] k, v -> #some(w) | #skip)
    -> __mapStore(k, w)
  = { leafBits, leaves, nodeBits, nodes, chunk, keptLeafBits, keptLeaves, keptNodeBits, keptNodes, chosen, f ->
    match chosen
      | [] -> chosenNode(
        leafBits
        leaves
        nodeBits
        nodes
        chunk + 1
        keptLeafBits
        keptLeaves
        keptNodeBits
        keptNodes
        f
      )
      | _ -> chosenNode(
        leafBits
        leaves
        nodeBits
        nodes
        chunk + 1
        int.bitOr(keptLeafBits, int.shiftLeft(1, chunk))
        [chosen, ...keptLeaves]
        keptNodeBits
        keptNodes
        f
      )
  }

--| [`chosenNode`] on from the next five-bit value, with `chosen`, what is kept of the node for
  `chunk`: nothing, a bucket alone, which is kept as a bucket, or a node.
def chosenChild
  : [c]
    int,
    array(list((k, v))),
    int,
    array(__mapStore(k, v)),
    int,
    int,
    list(list((k, w))),
    int,
    list(__mapStore(k, w)),
    __mapStore(k, w),
    ([c] k, v -> #some(w) | #skip)
    -> __mapStore(k, w)
  = { leafBits, leaves, nodeBits, nodes, chunk, keptLeafBits, keptLeaves, keptNodeBits, keptNodes, chosen, f ->
    match bucketAlone(chosen)
      | #some(entries) -> chosenBucket(
        leafBits
        leaves
        nodeBits
        nodes
        chunk
        keptLeafBits
        keptLeaves
        keptNodeBits
        keptNodes
        entries
        f
      )
      | #none -> match chosen
        | #empty -> chosenNode(
          leafBits
          leaves
          nodeBits
          nodes
          chunk + 1
          keptLeafBits
          keptLeaves
          keptNodeBits
          keptNodes
          f
        )
        | _ -> chosenNode(
          leafBits
          leaves
          nodeBits
          nodes
          chunk + 1
          keptLeafBits
          keptLeaves
          int.bitOr(keptNodeBits, int.shiftLeft(1, chunk))
          [chosen, ...keptNodes]
          f
        )
  }

--| The one bucket of `store`, if it is a node with that alone.
def bucketAlone: __mapStore(k, v) -> #some(list((k, v))) | #none = {
  | #node(leafBits, leaves, 0, _) -> (if bitCount(leafBits) == 1
    then #some(__nanyx_array_get(leaves, 0))
    else #none)
  | _ -> #none
}

--| The entries of `entries` `f` gives `#some` for, each with the value it gives, in order, after
  `acc`, the ones before, last first.
def chosenEntries
  : [c] list((k, v)), ([c] k, v -> #some(w) | #skip), list((k, w)) -> list((k, w))
  = {
    | [], _, acc -> reverseOnto(acc, [])
    | [(key, value), ...rest], f, acc -> chosenEntries(rest, f, chosenOnto(key, f(key, value), acc))
  }

--| `acc` with `key` and the value `chosen` holds before it, if it holds one.
def chosenOnto: k, (#some(w) | #skip), list((k, w)) -> list((k, w)) = {
  | key, #some(value), acc -> [(key, value), ...acc]
  | _, #skip, acc -> acc
}

--| How many keys `store` holds.
def storeLength: __mapStore(k, v) -> int = { store ->
  foldStore(store, 0, { count, _, _ -> count + 1 })
}

--| `m` with each of `entries` inserted in turn.
def insertAll: [Eq(k), Hash(k)] map(k, v), list((k, v)) -> map(k, v) = {
  | m, [] -> m
  | m, [(key, value), ...rest] -> insertAll(map.insert(m, key, value), rest)
}

--| The map with no keys. `[]` where a map is expected is this map.
export def map.empty: map(k, v) = __nanyx_map_of_store(#empty)

--| What the compiler makes a map literal call: `["a" => 1, "b" => 2]` is
  `__map([("a", 1), ("b", 2)])`. A key written twice holds the value written last.
export def __map: [Eq(k), Hash(k)] list((k, v)) -> map(k, v) = { entries ->
  insertAll(map.empty, entries)
}

--| The map holding each of `entries`, in order: of two entries with the same key, the later wins.
export def map.fromList: [Eq(k), Hash(k)] list((k, v)) -> map(k, v) = { entries ->
  insertAll(map.empty, entries)
}

--| The map holding each of `entries`, in order: of two entries with the same key, the later wins.
  What a literal builds a map with where a map is expected, as `[]` is, or written `map[...]`.
export def map.fromArray: [Eq(k), Hash(k)] array((k, v)) -> map(k, v) = { entries ->
  insertAll(map.empty, list.fromArray(entries))
}

--| The map holding each of the entries of `s`, pulled now, in order: of two entries with the same
  key, the later wins, as in [`map.fromList`]. It requires the contexts the sequence's steps do.
export def map.fromSeq: [Eq(k), Hash(k), c] ([c] seq((k, v))) -> map(k, v) = { s ->
  seq.fold(s, map.empty, { m, entry -> map.insert(m, entry.0, entry.1) })
}

--| The map of the entries `block` emits, through [`Emit`]: `map.build { emit(("a", 1)) }`. Of two
  entries with the same key, the later wins. The same as `list.build(block) \map.fromList`.
export def map.build: [Eq(k), Hash(k), c] ([c, Emit((k, v))] () -> ()) -> map(k, v) = { block ->
  map.fromList(list.build(block))
}

--| The entries of `m`, each a key and its value, in the order of their keys' hashes: an order that
  is the same for two maps with the same keys, however they were built, but that a program should
  not rely on. Sort the list for an order of your own: `map.toList(m) \list.sortBy { entry -> entry.0 }`.
export def map.toList: map(k, v) -> list((k, v)) = { m ->
  entriesOnto(__nanyx_map_store(m), [])
}

--| The entries of `m` as a sequence of key-value pairs, in the order [`map.toList`] gives them.
export def map.toSeq: map(k, v) -> seq((k, v)) = { m ->
  list.toSeq(map.toList(m))
}

--| The value `m` holds for `key`, or `#notFound`. Calling the map, `m(key)`, is the same.
export def map.get: [Eq(k), Hash(k)] map(k, v), k -> #some(v) | #notFound = { m, key ->
  findIn(__nanyx_map_store(m), key, hash(key), 0)
}

--| Whether `m` holds a value for `key`.
export def map.containsKey: [Eq(k), Hash(k)] map(k, v), k -> bool = { m, key ->
  isSome(findIn(__nanyx_map_store(m), key, hash(key), 0))
}

--| `m` with `key` holding `value`, in place of any value it held before.
export def map.insert: [Eq(k), Hash(k)] map(k, v), k, v -> map(k, v) = { m, key, value ->
  __nanyx_map_of_store(insertedIn(__nanyx_map_store(m), key, hash(key), value, 0))
}

--| `m` without `key` or its value. A map that has no `key` is given back as it is.
export def map.remove: [Eq(k), Hash(k)] map(k, v), k -> map(k, v) = { m, key ->
  __nanyx_map_of_store(removedFrom(__nanyx_map_store(m), key, hash(key), 0))
}

--| The number of keys.
export def map.length: map(k, v) -> int = { m ->
  storeLength(__nanyx_map_store(m))
}

--| `groups` with the elements of `xs` added, each to the front of the group of its key.
def groupInto: [Eq(b), Hash(b), c] list(a), ([c] a -> b), map(b, list(a)) -> map(b, list(a)) = {
  | [], _, groups -> groups
  | [x, ...rest], key, groups ->
    def group = someOr(map.get(groups, key(x)), [])
    groupInto(rest, key, map.insert(groups, key(x), [x, ...group]))
}

--| The elements of `xs` grouped by `key`: a map from each key to the elements that have it, in
  order.
export def list.groupBy: [Eq(b), Hash(b), c] list(a), ([c] a -> b) -> map(b, list(a)) = { xs, key ->
  map.map(groupInto(xs, key, map.empty), list.reverse)
}

--| The keys of `m`, in the order of [`map.toList`].
export def map.keys: map(k, v) -> list(k) = { m ->
  list.map(map.toList(m), { entry -> entry.0 })
}

--| The values of `m`, in the order of [`map.toList`].
export def map.values: map(k, v) -> list(v) = { m ->
  list.map(map.toList(m), { entry -> entry.1 })
}

--| Whether `m` has no keys.
export def map.isEmpty: map(k, v) -> bool = { m ->
  match __nanyx_map_store(m)
    | #empty -> true
    | _ -> false
}

--| `step` applied to `acc` and each key and value of `m` in turn, in the order of [`map.toList`].
export def map.fold: [c] map(k, v), b, ([c] b, k, v -> b) -> b = { m, acc, step ->
  foldStore(__nanyx_map_store(m), acc, step)
}

--| [`map.fold`] that can stop part-way: `step` gives `#some(acc)` to go on to the next key and
  value, and anything else it gives ends the fold there and is its result, as it is. A fold that
  runs to the end gives `#some(acc)`. `step` isn't called again after it stops.
export def map.foldWhile
  : [c] map(k, v), b, ([c] b, k, v -> #some(b) | r) -> #some(b) | r
  = { m, acc, step ->
    list.foldWhile(map.toList(m), acc, { acc, entry -> step(acc, entry.0, entry.1) })
  }

--| The values of `m` combined with `f`, in the order of [`map.toList`], starting from the first: `["a" => 4, "b" => 5]
  \map.reduce { * }` is `#some(20)`, and an empty map, having no first value, gives `#none`. To
  start from another value, use [`map.fold`].
export def map.reduce: [c] map(k, v), ([c] v, v -> v) -> #some(v) | #none = { m, f ->
  list.reduce(map.values(m), f)
}

--| `m` with `f` applied to each value. The keys stay as they are, in the same order.
export def map.map: [c] map(k, v), ([c] v -> w) -> map(k, w) = { m, f ->
  __nanyx_map_of_store(convertedStore(__nanyx_map_store(m), unchanged, f))
}

--| The entries of `m` whose key and value pass `keep`, in the same order.
export def map.filter: [c] map(k, v), ([c] k, v -> bool) -> map(k, v) = { m, keep ->
  __nanyx_map_of_store(
    chosenStore(
      __nanyx_map_store(m)
      { key, value -> if keep(key, value) then #some(value) else #skip }
    )
  )
}

--| The entries of `m` whose key and value `f` gives `#some` for, each with the new value it gives,
  in the same order: a [`map.filter`] and a [`map.map`] in one walk. Keys `f` gives `#skip` for
  are left out.
export def map.filterMap: [c] map(k, v), ([c] k, v -> #some(w) | #skip) -> map(k, w) = { m, f ->
  __nanyx_map_of_store(chosenStore(__nanyx_map_store(m), f))
}

--| Whether `test` holds for any key and its value (so `false` for an empty map). It stops at the
  first entry it holds for.
export def map.any: [c] map(k, v), ([c] k, v -> bool) -> bool = { m, test ->
  list.any(map.toList(m), { entry -> test(entry.0, entry.1) })
}

--| Whether `test` holds for every key and its value (so `true` for an empty map). It stops at the
  first entry it fails for.
export def map.all: [c] map(k, v), ([c] k, v -> bool) -> bool = { m, test ->
  list.all(map.toList(m), { entry -> test(entry.0, entry.1) })
}

--| Whether the maps `m` and `n` hold the same keys, compared with `==`, and equal values for each,
  as `same` compares two values, whatever order their keys were added in. The `==` the compiler
  derives for a map calls it.
export def __mapEqualsBy
  : [Eq(k), c] map(k, v), map(k, v), ([c] v, v -> bool) -> bool
  = { m, n, same ->
    def theirs = map.toList(n)

    if map.length(m) != list.length(theirs)
      then false
      else list.all(
        map.toList(m)
        { entry ->
          match findEntry(theirs, entry.0)
            | #some(value) -> same(entry.1, value)
            | #notFound -> false
        }
      )
  }

--| The hash of the map `m` from its keys' and values' hashes, as `hashKey` and `hashValue` give them,
  in no order, so that maps [`__mapEqualsBy`] finds equal have the same hash. The `hash` the
  compiler derives for a map whose keys or values have their own calls it.
export def __mapHashBy
  : [c] map(k, v), ([c] k -> int), ([c] v -> int) -> int
  = { m, hashKey, hashValue ->
    map.fold(
      m
      map.length(m)
      { acc, key, value -> int.bitXor(acc, __hashCombine(hashKey(key), hashValue(value))) }
    )
  }

--| What the derived `toString` of a map calls: `m` as its literal is written, its entries in
  square brackets in the order of [`map.toList`], each key and value written by `showKey` and
  `showValue` with ` => ` between them: `[tea => 3, cake => 1]`. The empty map is `[=>]`.
export def __mapToString
  : [c] map(k, v), ([c] k -> string), ([c] v -> string) -> string
  = { m, showKey, showValue ->
    match map.toList(m)
      | [] -> "[=>]"
      | entries -> __listToString(
        entries
        { entry -> "{showKey(entry.0)} => {showValue(entry.1)}" }
      )
  }

--| `m` with `key` holding `f` of what `m` holds for it, `#some(value)` or `#notFound`. A key `m`
  does not have is added.
export def map.update
  : [Eq(k), Hash(k), c] map(k, v), k, ([c] (#some(v) | #notFound) -> v) -> map(k, v)
  = { m, key, f ->
    map.insert(m, key, f(map.get(m, key)))
  }

--| The entries of `m`, then those of `other` whose keys `m` does not have. Where both have a key,
  the value is `other`'s, as a later entry wins in `map.fromList`, so `defaults \map.union(overrides)`
  gives the overrides.
export def map.union: [Eq(k), Hash(k)] map(k, v), map(k, v) -> map(k, v) = { m, other ->
  insertAll(m, map.toList(other))
}

--| `m` with each of `entries` inserted in turn, where `m` has the key already holding `combine` of
  its value and the entry's.
def combineAll: [Eq(k), Hash(k), c] map(k, v), list((k, v)), ([c] v, v -> v) -> map(k, v) = {
  | m, [], _ -> m
  | m, [(key, value), ...rest], combine ->
    def combined = map.update(
      m
      key
      {
        | #some(old) -> combine(old, value)
        | #notFound -> value
      }
    )

    combineAll(combined, rest, combine)
}

--| As `map.union`, but where both have a key the value is `combine` of `m`'s value and `other`'s.
export def map.unionWith
  : [Eq(k), Hash(k), c] map(k, v), map(k, v), ([c] v, v -> v) -> map(k, v)
  = { m, other, combine ->
    combineAll(m, map.toList(other), combine)
  }

-- Sets ------------------------------------------------------------------------------------------
--
-- A `set(a)` holds each of its elements once. It is made with a literal, `set[1, 2, 3]`, with
-- `set.fromList([1, 2, 2, 3])`, or from `set.empty` with `set.insert`. Its elements need an `Eq` and a `Hash`, as a map's keys do.
-- Attached to `set`, so they are called as `set.contains(s, x)`, or as `s \contains(x)` when `s` is
-- known to be a set. Sets are immutable: every function gives back a new set.
--
-- A set is held as the store of a map from each of its elements to `()`, built and read by the
-- same algorithms (see `Sets.storeOf` in the compiler).

--| The elements of `store`, a set's, in the order of its walk.
def elementsOf: __mapStore(a, ()) -> list(a) = { store ->
  reverseOnto(keysOnto(entriesOnto(store, []), []), [])
}

--| The keys of `entries`, last first, then `acc`. Like every function the compiler calls a map
  through, it makes no lambda, which would be numbered ahead of the program's own.
def keysOnto: list((k, v)), list(k) -> list(k) = {
  | [], acc -> acc
  | [(key, _), ...rest], acc -> keysOnto(rest, [key, ...acc])
}

export def set.empty: set(a) = __nanyx_set_of_store(#empty)

--| The set of the elements of `xs`, each once.
export def set.fromList: [Eq(a), Hash(a)] list(a) -> set(a) = { xs ->
  list.fold(xs, set.empty, set.insert)
}

--| The set of the elements of `xs`, each once. What a literal
  builds a set with, `set[1, 2]`, or `[1, 2]` where a set is expected.
export def set.fromArray: [Eq(a), Hash(a)] array(a) -> set(a) = { xs ->
  set.fromList(list.fromArray(xs))
}

--| The set of the elements of `s`, pulled now, each once. It
  requires the contexts the sequence's steps do.
export def set.fromSeq: [Eq(a), Hash(a), c] ([c] seq(a)) -> set(a) = { s ->
  set.fromList(seq.toList(s))
}

--| The set of what `block` emits, through [`Emit`]: `set.build { emit(1); emit(1) }` holds one `1`.
  The same as `list.build(block) \set.fromList`.
export def set.build: [Eq(a), Hash(a), c] ([c, Emit(a)] () -> ()) -> set(a) = { block ->
  set.fromList(list.build(block))
}

--| The elements of `s`, in the order of their hashes, as [`map.toList`] gives a map's keys: the same
  for two sets with the same elements, however they were built, but not one a program should rely on.
export def set.toList: set(a) -> list(a) = { s ->
  elementsOf(__nanyx_set_store(s))
}

--| The elements of `s` as a sequence, in the order [`set.toList`] gives them.
export def set.toSeq: set(a) -> seq(a) = { s ->
  list.toSeq(set.toList(s))
}

--| Whether `s` holds `x`.
export def set.contains: [Eq(a), Hash(a)] set(a), a -> bool = { s, x ->
  isSome(findIn(__nanyx_set_store(s), x, hash(x), 0))
}

--| `s` with `x` added. A set that holds `x` is given back as it is.
export def set.insert: [Eq(a), Hash(a)] set(a), a -> set(a) = { s, x ->
  if set.contains(s, x)
    then s
    else __nanyx_set_of_store(insertedIn(__nanyx_set_store(s), x, hash(x), (), 0))
}

--| `s` without `x`. A set that does not hold `x` is given back as it is.
export def set.remove: [Eq(a), Hash(a)] set(a), a -> set(a) = { s, x ->
  __nanyx_set_of_store(removedFrom(__nanyx_set_store(s), x, hash(x), 0))
}

--| The number of elements.
export def set.length: set(a) -> int = { s ->
  storeLength(__nanyx_set_store(s))
}

--| Whether `s` has no elements.
export def set.isEmpty: set(a) -> bool = { s ->
  match __nanyx_set_store(s)
    | #empty -> true
    | _ -> false
}

--| `step` applied to `acc` and each element of `s` in turn, in the order of [`set.toList`].
export def set.fold: [c] set(a), b, ([c] b, a -> b) -> b = { s, acc, step ->
  foldStore(__nanyx_set_store(s), acc, { acc, x, _ -> step(acc, x) })
}

--| [`set.fold`] that can stop part-way: `step` gives `#some(acc)` to go on to the next element,
  and anything else it gives ends the fold there and is its result, as it is. A fold that runs to the
  end gives `#some(acc)`. `step` isn't called again after it stops.
export def set.foldWhile
  : [c] set(a), b, ([c] b, a -> #some(b) | r) -> #some(b) | r
  = { s, acc, step ->
    list.foldWhile(set.toList(s), acc, step)
  }

--| The elements of `s` combined with `f`, in the order of [`set.toList`], starting from the first: `set[1, 2, 3, 4, 5]
  \set.reduce { * }` is `#some(120)`, and an empty set, having no first element, gives `#none`. To
  start from another value, use [`set.fold`].
export def set.reduce: [c] set(a), ([c] a, a -> a) -> #some(a) | #none = { s, f ->
  list.reduce(set.toList(s), f)
}

--| The set of `f` of each element of `s`. Elements that `f` makes equal are kept once, where the
  first of them was.
export def set.map: [Eq(b), Hash(b), c] set(a), ([c] a -> b) -> set(b) = { s, f ->
  set.fromList(list.map(set.toList(s), f))
}

--| The elements of `s` that pass `keep`, in the same order.
export def set.filter: [c] set(a), ([c] a -> bool) -> set(a) = { s, keep ->
  __nanyx_set_of_store(
    chosenStore(__nanyx_set_store(s), { x, _ -> if keep(x) then #some() else #skip })
  )
}

--| The set of the values `f` gives as `#some`, leaving out the elements it gives `#skip` for: a
  [`set.filter`] and a [`set.map`] in one walk. Values that come out equal are kept once, where the
  first of them was.
export def set.filterMap
  : [Eq(b), Hash(b), c] set(a), ([c] a -> #some(b) | #skip) -> set(b)
  = { s, f ->
    set.fromList(list.filterMap(set.toList(s), f))
  }

--| The set of the values `f` emits for each element in turn, through [`Emit`], as in
  [`list.select`]. Values that come out equal are kept once, where the first of them was.
export def set.select: [Eq(b), Hash(b), c] set(a), ([c, Emit(b)] a -> ()) -> set(b) = { s, f ->
  set.fromList(list.select(set.toList(s), f))
}

--| Whether `test` holds for any element (so `false` for an empty set). It stops at the first element
  it holds for.
export def set.any: [c] set(a), ([c] a -> bool) -> bool = { s, test ->
  list.any(set.toList(s), test)
}

--| Whether `test` holds for every element (so `true` for an empty set). It stops at the first
  element it fails for.
export def set.all: [c] set(a), ([c] a -> bool) -> bool = { s, test ->
  list.all(set.toList(s), test)
}

--| Whether `t` holds every element of `s`.
export def set.isSubset: [Eq(a), Hash(a)] set(a), set(a) -> bool = { s, t ->
  list.all(set.toList(s), { x -> set.contains(t, x) })
}

--| Whether the sets `s` and `t` hold the same elements, as `same` compares two, whatever order they
  were added in. The `==` the compiler derives for a set calls it.
export def __setEqualsBy: [c] set(a), set(a), ([c] a, a -> bool) -> bool = { s, t, same ->
  def theirs = set.toList(t)

  if set.length(s) != list.length(theirs)
    then false
    else list.all(set.toList(s), { x -> list.any(theirs, { y -> same(x, y) }) })
}

--| The hash of the set `s` from its elements' hashes, as `hashElement` gives them, in no order, as
  [`__mapHashBy`] hashes a map.
export def __setHashBy: [c] set(a), ([c] a -> int) -> int = { s, hashElement ->
  set.fold(s, set.length(s), { acc, x -> int.bitXor(acc, hashElement(x)) })
}

--| What the derived `toString` of a set calls: the elements of `s` as a list of them is written,
  each written by `show`: `[1, 2]`.
export def __setToString: [c] set(a), ([c] a -> string) -> string = { s, show ->
  __listToString(set.toList(s), show)
}

--| The elements of `s` and those of `t`.
export def set.union: [Eq(a), Hash(a)] set(a), set(a) -> set(a) = { s, t ->
  list.fold(set.toList(t), s, set.insert)
}

--| The elements of `s` that `t` holds too.
export def set.intersection: [Eq(a), Hash(a)] set(a), set(a) -> set(a) = { s, t ->
  set.filter(s, { x -> set.contains(t, x) })
}

--| The elements of `s` that `t` does not hold.
export def set.difference: [Eq(a), Hash(a)] set(a), set(a) -> set(a) = { s, t ->
  set.filter(s, { x -> not set.contains(t, x) })
}
