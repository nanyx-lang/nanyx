--| Mutable lists: lists that grow at the end, changed in place.

  An `MList(a)` is a list that [`MList.add`] grows at the end, in constant time, and whose
  elements [`MList.set`] changes in place. It holds its cells in [`MRef`](mref)s, so it
  belongs to the `memory` block it was made in: every operation requires that block's `Memory`,
  and the list can't leave the block, so give back [`MList.toList`] of it, which takes no time
  when the `MList` isn't used afterwards. [`MList.at`] and [`MList.set`] walk to the element, as
  `list.at` does, so code that reads or changes elements by index wants an [`MArray`](marray),
  whose `at` and `set` take constant time; an `MList` is for building a list.

  Each function is attached to `MList`, so with `import nanyx/mlist` it is called as
  `MList.add(items, 5)`, or as `items \add(5)`, and `items += 5` adds too.
module mlist

import nanyx/mref

-- The first of the list's cells, the last of them, and how many there are, each in a reference of its
-- own, so that `add` changes them in place and makes nothing but the new cell. `add` changes the last
-- cell's tail to a new cell, and `set` changes a cell's element: the cells are the list's own until
-- `toList` hands them over, so nothing else sees them change.
export type MList(a) = [Memory] private (
  first: MRef(list(a))
  last: MRef(list(a))
  count: MRef(int)
)

--| A new list with nothing in it.
export def MList.empty: [Memory] () -> MList(a) = {
  MList(first = MRef.new([]), last = MRef.new([]), count = MRef.new(0))
}

--| A new list holding `xs`, in order.
export def MList.fromList: [Memory] list(a) -> MList(a) = { xs ->
  def items = MList.empty()
  for xs | x -> MList.add(items, x)
  items
}

--| A new list holding `xs`, in order. What a literal builds a list with, `MList[1, 2, 3]`, or
  `[1, 2, 3]` where an `MList` is expected.
export def MList.fromArray: [Memory] Array(a) -> MList(a) = { xs ->
  MList.fromList(list.fromArray(xs))
}

--| A new list holding the elements of `s`, pulled now, in order. It requires the contexts the
  sequence's steps do.
export def MList.fromSeq: [Memory, c] ([c] seq(a)) -> MList(a) = { s ->
  def items = MList.empty()
  seq.fold(s, (), { _, x -> MList.add(items, x) })
  items
}

--| A new list of what `block` yields. The same as `seq(block) \MList.fromSeq`.
export def MList.build: [Memory, c, d] ([c] () -> [d] seq(a)) -> MList(a) = { block ->
  MList.fromSeq(seq(block))
}

--| Adds `value` at the end of `items`.
export def MList.add: [Memory] MList(a), a -> () = { MList(state), value ->
  def cell = [value]

  match MRef.get(state.last)
    | [] -> MRef.set(state.first, cell)
    | last -> __nanyx_list_set_tail(last, cell)

  MRef.set(state.last, cell)
  MRef.set(state.count, MRef.get(state.count) + 1)
}

--| Adds `value` at the end of `items`, as [`MList.add`] does: `items += 5`.
export def MList.`+=`: [Memory] MList(a), a -> () = { items, value ->
  MList.add(items, value)
}

--| The element of `items` at `index`, counting from 0, or `#notFound` when `index` is negative or
  past the end. It walks to the element, in time proportional to `index`: use an `MArray` to index
  often.
export def MList.at: [Memory] MList(a), int -> #some(a) | #notFound = { MList(state), index ->
  list.at(MRef.get(state.first), index)
}

--| Changes the element of `items` at `index`, counting from 0, to `value`: `#ok`, or `#outOfRange`
  when `index` is negative or past the end, and `items` is left as it was.
export def MList.set
  : [Memory] MList(a), int, a -> #ok | #outOfRange
  = { MList(state), index, value ->
    if index >= 0 and index < MRef.get(state.count) then
      setHeadAt(MRef.get(state.first), index, value)
      #ok
    else #outOfRange
  }

-- Changes the element of the cell `index` cells into `cells` to `value`, in place. The cells are the
-- `MList`'s own, as they are for `add`.
def setHeadAt: list(a), int, a -> () = { cells, index, value ->
  match cells
    | [_, ...rest] -> (if index == 0
      then __nanyx_list_set_head(cells, value)
      else setHeadAt(rest, index - 1, value))
    | [] -> ()
}

--| How many elements `items` holds.
export def MList.length: [Memory] MList(a) -> int = { MList(state) ->
  MRef.get(state.count)
}

--| The elements of `items` now, in order, as a sequence: adding to `items` later doesn't change
  it. A mutable list is [`Iterable`] by it, so a `for` loop walks one.
export def MList.toSeq: [Memory] MList(a) -> seq(a) = { items ->
  list.toSeq(MList.toList(items))
}

--| The elements of `items`, in order, as a list. When `items` isn't used afterwards, this takes no
  time: the list is the cells `items` built. Otherwise it copies them, so that adding to `items`
  later leaves the list as it is.
export def MList.toList: [Memory] MList(a) -> list(a) = { MList(state) ->
  def first = MRef.get(state.first)
  if __nanyx_is_exclusive(state) then first else list.map(first, { x -> x })
}

--| The elements of `xs` combined with `f`, in order, starting from the first: an `MList` of `1` to
  `5` reduced with `{ * }` is `#some(120)`, and an empty one, having no first element, gives
  `#none`. To start from another value, use [`list.fold`].
export def MList.reduce: [Memory, c] MList(a), ([c] a, a -> a) -> #some(a) | #none = { xs, f ->
  list.reduce(MList.toList(xs), f)
}
