--| Mutable lists: lists that grow at the end, changed in place.

  An `MList(a)` is a list that [`MList.add`] grows at the end, in constant time, and whose
  elements [`MList.set`] changes in place. It holds its elements in an [`MRef`](mref), so it
  belongs to the `memory` block it was made in: every operation requires that block's `Memory`,
  and the list can't leave the block. [`MList.at`] and [`MList.set`] walk to the element, as
  `list.get` does.

  Each function is attached to `MList`, so with `import nanyx/mlist` it is called as
  `MList.add(items, 5)`, or as `items \add(5)`.
module mlist

import nanyx/mref

-- The elements last first, so that `add` puts one in front, and how many there are.
export type MList(a) = [Memory] private MRef((reversed: list(a), count: int))

--| A new list with nothing in it.
export def MList.empty: [Memory] () -> MList(a) = {
  MList(MRef.new(reversed = [], count = 0))
}

--| A new list holding `xs`, in order.
export def MList.fromList: [Memory] list(a) -> MList(a) = { xs ->
  MList(MRef.new(reversed = list.reverse(xs), count = list.length(xs)))
}

--| A new list holding `xs`, in order. What a literal builds a list with, `MList[1, 2, 3]`, or
  `[1, 2, 3]` where an `MList` is expected.
export def MList.fromArray: [Memory] Array(a) -> MList(a) = { xs ->
  MList.fromList(list.fromArray(xs))
}

--| Adds `value` at the end of `items`.
export def MList.add: [Memory] MList(a), a -> () = { MList(state), value ->
  def held = MRef.get(state)
  MRef.set(state, (reversed = [value, ...held.reversed], count = held.count + 1))
}

--| The element of `items` at `index`, counting from 0, or `#none` when `index` is negative or past
  the end.
export def MList.at: [Memory] MList(a), int -> #some(a) | #none = { MList(state), index ->
  def held = MRef.get(state)

  if index < 0 then #none else
    match list.get(held.reversed, held.count - 1 - index)
      | #some(x) -> #some(x)
      | #outOfRange -> #none
}

--| Changes the element of `items` at `index`, counting from 0, to `value`: `#ok`, or `#outOfRange`
  when `index` is negative or past the end, and `items` is left as it was.
export def MList.set
  : [Memory] MList(a), int, a -> #ok | #outOfRange
  = { MList(state), index, value ->
    def held = MRef.get(state)

    if index >= 0 and index < held.count then
      def position = held.count - 1 - index
      def changed = list.mapIndexed(held.reversed, { i, x -> if i == position then value else x })
      MRef.set(state, (reversed = changed, count = held.count))
      #ok
    else #outOfRange
  }

--| How many elements `items` holds.
export def MList.count: [Memory] MList(a) -> int = { MList(state) ->
  MRef.get(state).count
}

--| The elements of `items`, in order, as a list.
export def MList.toList: [Memory] MList(a) -> list(a) = { MList(state) ->
  list.reverse(MRef.get(state).reversed)
}
