--| `x` as the nearest `F32`, or an infinity past the largest `F32`.
export def float.toF32: float -> F32 = { x ->
  __nanyx_to_float(x)
}

--| `x` as a `float`, which holds every `F32` exactly.
export def F32.toFloat: F32 -> float = { x ->
  __nanyx_to_float(x)
}

--| `x` made whole as `mode` says: dropping its fraction, to the nearest whole number with halves
  away from zero, or down, or up.
def wholeOf: float, (#truncate | #round | #floor | #ceil) -> float = { x, mode ->
  match mode
    | #truncate -> __nanyx_float_trunc(x)
    | #floor -> __nanyx_float_floor(x)
    | #ceil -> __nanyx_float_ceil(x)
    | #round ->
      def whole = __nanyx_float_trunc(x)

      if x - whole >= 0.5 then whole + 1.0 else if whole - x >= 0.5 then whole - 1.0 else whole
}

--| `x` as an `int`, made whole as `mode` says: `float.toInt(2.5, #round)` is 3. A value that is
  NaN, infinite or past the range of `int` stops the program; see [`float.tryToInt`].
export def float.toInt: float, (#truncate | #round | #floor | #ceil) -> int = { x, mode ->
  __nanyx_float_to_int(wholeOf(x, mode))
}

--| `x` as an `int`, made whole as `mode` says, or `#outOfRange` when it is NaN, infinite or past
  the range of `int`.
export def float.tryToInt
  : float, (#truncate | #round | #floor | #ceil) -> #some(int) | #outOfRange
  = { x, mode ->
    def whole = wholeOf(x, mode)

    if whole >= -9_223_372_036_854_775_808.0 and whole < 9_223_372_036_854_775_808.0
      then #some(__nanyx_float_to_int(whole))
      else #outOfRange
  }

--| `x` as an `int`, as [`float.toInt`] makes it one.
export def F32.toInt: F32, (#truncate | #round | #floor | #ceil) -> int = { x, mode ->
  float.toInt(F32.toFloat(x), mode)
}

--| `x` as an `int`, or `#outOfRange`, as [`float.tryToInt`] makes it one.
export def F32.tryToInt
  : F32, (#truncate | #round | #floor | #ceil) -> #some(int) | #outOfRange
  = { x, mode ->
    float.tryToInt(F32.toFloat(x), mode)
  }

-- Reading sized numbers -------------------------------------------------------------------------
--
-- Each sized integer type reads itself from text as `int.fromString` reads an `int`, with its own tag
-- for text it cannot read, and so has a `FromString`. `F32.fromString` is beside `float.fromString`.

--| The integer `s` writes, as `int.fromString` reads it, when it is from `low` to `high`, or
  `#invalid`. When `low` is 0 the type is unsigned, and a leading `-` is `#invalid` too.
def readIntIn: string, int, int -> #some(int) | #invalid = { s, low, high ->
  if low == 0 and __nanyx_string_byte_at(s, 0) == 45
    then #invalid
    else match int.fromString(s)
      | #some(n) -> (if n >= low and n <= high then #some(n) else #invalid)
      | #invalidInt -> #invalid
}

--| The `I8` `s` writes in decimal, or `#invalidI8` for anything else, a number past the range of
  `I8` included.
export def I8.fromString: string -> #some(I8) | #invalidI8 = { s ->
  match readIntIn(s, -128, 127)
    | #some(n) -> #some(__nanyx_int_cast(n))
    | #invalid -> #invalidI8
}

--| The `I16` `s` writes in decimal, or `#invalidI16` for anything else, a number past the range of
  `I16` included.
export def I16.fromString: string -> #some(I16) | #invalidI16 = { s ->
  match readIntIn(s, -32_768, 32_767)
    | #some(n) -> #some(__nanyx_int_cast(n))
    | #invalid -> #invalidI16
}

--| The `I32` `s` writes in decimal, or `#invalidI32` for anything else, a number past the range of
  `I32` included.
export def I32.fromString: string -> #some(I32) | #invalidI32 = { s ->
  match readIntIn(s, -2_147_483_648, 2_147_483_647)
    | #some(n) -> #some(__nanyx_int_cast(n))
    | #invalid -> #invalidI32
}

--| The `U8` `s` writes in decimal, or `#invalidU8` for anything else, a leading `-` or a number
  past the range of `U8` included.
export def U8.fromString: string -> #some(U8) | #invalidU8 = { s ->
  match readIntIn(s, 0, 255)
    | #some(n) -> #some(__nanyx_int_cast(n))
    | #invalid -> #invalidU8
}

--| The `U16` `s` writes in decimal, or `#invalidU16` for anything else, a leading `-` or a number
  past the range of `U16` included.
export def U16.fromString: string -> #some(U16) | #invalidU16 = { s ->
  match readIntIn(s, 0, 65_535)
    | #some(n) -> #some(__nanyx_int_cast(n))
    | #invalid -> #invalidU16
}

--| The `U32` `s` writes in decimal, or `#invalidU32` for anything else, a leading `-` or a number
  past the range of `U32` included.
export def U32.fromString: string -> #some(U32) | #invalidU32 = { s ->
  match readIntIn(s, 0, 4_294_967_295)
    | #some(n) -> #some(__nanyx_int_cast(n))
    | #invalid -> #invalidU32
}

--| The number the decimal digits of `s` from byte `i` on write after the digits whose value is
  `acc`, or `#invalidU64` at the first byte that is not a digit, or once the number is past the
  range of `U64`. Each step is checked before it is taken.
def parseU64Digits: string, int, U64 -> #some(U64) | #invalidU64 = { s, i, acc ->
  if i >= __nanyx_string_length(s)
    then #some(acc)
    else if digitValue(__nanyx_string_byte_at(s, i)) < 0
      then #invalidU64
      else if acc > 1_844_674_407_370_955_161 or
        acc == 1_844_674_407_370_955_161 and digitValue(__nanyx_string_byte_at(s, i)) > 5
        then #invalidU64
        else parseU64Digits(
          s
          i + 1
          acc * 10 + U64.fromInt(digitValue(__nanyx_string_byte_at(s, i)))
        )
}

--| The `U64` `s` writes in decimal, with an optional leading `+`, or `#invalidU64` for anything
  else, a leading `-` or a number past 18446744073709551615 included. It reads its digits itself,
  as the largest `U64`s are past the range of `int`.
export def U64.fromString: string -> #some(U64) | #invalidU64 = { s ->
  def start = if __nanyx_string_byte_at(s, 0) == 43 then 1 else 0

  if __nanyx_string_length(s) <= start then #invalidU64 else parseU64Digits(s, start, 0)
}

--| The `F32` nearest the float `s` writes, as `float.fromString` reads it, or `#invalidF32` for
  anything else. A number too large for an `F32` is infinity.
export def F32.fromString: string -> #some(F32) | #invalidF32 = { s ->
  match float.fromString(s)
    | #some(x) -> #some(float.toF32(x))
    | #invalidFloat -> #invalidF32
}
