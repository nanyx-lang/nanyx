@partial module prelude

-- Part of the prelude, which is prelude.nyx and each file beside it marked @partial.

-- Conversions ------------------------------------------------------------------------------------

-- Each number type converts to each other one with a definition attached to it, named after the type
-- it converts to: `I32.toInt`, `int.toU8`, `I64.toFloat`. One that keeps every value gives the value;
-- one that may not, from an integer type to a narrower one or between signed and unsigned, gives
-- `#some` of it or `#outOfRange`, and leaves the caller to decide.

export def int.toI8: int -> #some(I8) | #outOfRange = { n ->
  if n >= -128 and n <= 127 then #some(__nanyx_int_cast(n)) else #outOfRange
}

export def int.toI16: int -> #some(I16) | #outOfRange = { n ->
  if n >= -32_768 and n <= 32_767 then #some(__nanyx_int_cast(n)) else #outOfRange
}

export def int.toI32: int -> #some(I32) | #outOfRange = { n ->
  if n >= -2_147_483_648 and n <= 2_147_483_647 then #some(__nanyx_int_cast(n)) else #outOfRange
}

export def int.toU8: int -> #some(U8) | #outOfRange = { n ->
  if n >= 0 and n <= 255 then #some(__nanyx_int_cast(n)) else #outOfRange
}

export def int.toU16: int -> #some(U16) | #outOfRange = { n ->
  if n >= 0 and n <= 65_535 then #some(__nanyx_int_cast(n)) else #outOfRange
}

export def int.toU32: int -> #some(U32) | #outOfRange = { n ->
  if n >= 0 and n <= 4_294_967_295 then #some(__nanyx_int_cast(n)) else #outOfRange
}

export def int.toU64: int -> #some(U64) | #outOfRange = { n ->
  if n >= 0 then #some(__nanyx_int_cast(n)) else #outOfRange
}

export def int.toF32: int -> F32 = { n ->
  __nanyx_to_float(n)
}

