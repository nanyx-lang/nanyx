--| `x` as the nearest `F32`, or an infinity past the largest `F32`.
export def float.toF32: float -> F32 = { x ->
  __nanyx_to_float(x)
}

--| `x` as a `float`, which holds every `F32` exactly.
export def F32.toFloat: F32 -> float = { x ->
  __nanyx_to_float(x)
}

--| `x` made whole as `mode` says: dropping its fraction, to the nearest whole number with halves
  away from zero, or down, or up.
def wholeOf: float, (#truncate | #round | #floor | #ceil) -> float = { x, mode ->
  match mode
    | #truncate -> __nanyx_float_trunc(x)
    | #floor -> __nanyx_float_floor(x)
    | #ceil -> __nanyx_float_ceil(x)
    | #round ->
      def whole = __nanyx_float_trunc(x)

      if x - whole >= 0.5 then whole + 1.0 else if whole - x >= 0.5 then whole - 1.0 else whole
}

--| `x` as an `int`, made whole as `mode` says: `float.toInt(2.5, #round)` is 3. A value that is
  NaN, infinite or past the range of `int` stops the program; see [`float.tryToInt`].
export def float.toInt: float, (#truncate | #round | #floor | #ceil) -> int = { x, mode ->
  __nanyx_float_to_int(wholeOf(x, mode))
}

--| `x` as an `int`, made whole as `mode` says, or `#outOfRange` when it is NaN, infinite or past
  the range of `int`.
export def float.tryToInt
  : float, (#truncate | #round | #floor | #ceil) -> #some(int) | #outOfRange
  = { x, mode ->
    def whole = wholeOf(x, mode)

    if whole >= -9_223_372_036_854_775_808.0 and whole < 9_223_372_036_854_775_808.0
      then #some(__nanyx_float_to_int(whole))
      else #outOfRange
  }

--| `x` as an `int`, as [`float.toInt`] makes it one.
export def F32.toInt: F32, (#truncate | #round | #floor | #ceil) -> int = { x, mode ->
  float.toInt(F32.toFloat(x), mode)
}

--| `x` as an `int`, or `#outOfRange`, as [`float.tryToInt`] makes it one.
export def F32.tryToInt
  : F32, (#truncate | #round | #floor | #ceil) -> #some(int) | #outOfRange
  = { x, mode ->
    float.tryToInt(F32.toFloat(x), mode)
  }
