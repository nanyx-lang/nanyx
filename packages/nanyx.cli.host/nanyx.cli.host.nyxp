(
  package = (
    name = "nanyx.cli.host"
    version = "0.41.0"
    sources = ["src/**/*.nyx"]
    host = (
      root = "cli.host"
      prelude = "cli.prelude"
      component = (root = "cli.host.wasi", world = "nanyx:console/command", library = "nanyx:console/library")
    )
  )
  dependencies = [
    (package = "nanyx.cli", version = "0.41.0")
    (package = "nanyx.fs", version = "0.41.0")
    (package = "nanyx.http", version = "0.41.0")
    (package = "nanyx.wasi", version = "0.41.0")
  ]
)
