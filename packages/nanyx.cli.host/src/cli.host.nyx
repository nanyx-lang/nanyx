--| The console host: it runs a command-line program's entry point.

  A program's `@entry` is passed to [`run`], which runs it through [`provide`] in the contexts this
  host provides, as a component's exports that require contexts are:
  [`Console`], which reads and writes the standard streams, [`Env`], [`FileSystem`], which reads
  and writes files, [`Http`], which makes HTTP requests, [`Random`], which draws from the operating
  system's random source, [`Clock`], which reads its clocks, and `Async`, which the calls that wait
  require. `Console`, `Env`, `FileSystem`, `Random` and `Clock` are written on WASI's
  functions, and `Http` on the `nanyx` runtime's own `nanyx:http`, since WASI preview 1 has no
  networking. They are written in the host library `nanyx.wasi`, which declares WASI's functions
  with `@extern` and calls them with the [`HostRuntime`] the toolchain provides to it, passing their
  buffers in memory with `nanyx/host.memory`: `Console`, `Env` and `FileSystem` in its
  `preview1.system`, which the test host's `@test(#io)` tests run with too, and the random source,
  the clocks and `nanyx:http`, which the HTTP host shares.
export module cli.host

import (
  nanyx/async as (Async)
  nanyx/clock as (Clock)
  nanyx/host.async as (cancelled)
  nanyx/host.memory
  nanyx/host.runtime
  nanyx/random as (Random)
  nanyx.cli/console as (Console)
  nanyx.cli/env as (Env)
  nanyx.fs/filesystem as (FileSystem)
  nanyx.http/client as (Http)
  nanyx.wasi/files as wasiFiles
  nanyx.wasi/preview1 as (timeOn, systemBits)
  nanyx.wasi/preview1.system as wasiSystem
  nanyx.wasi/runtime as (sendThroughRuntime, sleepOnRuntime)
  nanyx.wasi/stdin as wasiStdin
)

--| Calls `f` with a `Console` that reads and writes the standard streams, an `Env` that reads what
  the program was started with, a `Clock` that reads the operating system's clocks, a `FileSystem`
  that reads and writes the directories the runtime opened for it, an `Http` that makes requests
  through the runtime, a `Random` that draws from the operating system, and `Async`, so that it may
  wait, and gives back what `f` returns. A component's export that requires contexts is called
  through it.
export def provide
  : [HostRuntime, Async] ([Async, Clock, Console, Env, FileSystem, Http, Random] () -> a) -> a
  = { f ->
    use Console(
      write = { text -> wasiSystem.writeTo(1, text) }
      writeError = { text -> wasiSystem.writeTo(2, text) }
      readLine = { _ -> wasiStdin.readLineAfter(wasiSystem.fill, []) }
      readToEnd = { _ -> #some(wasiStdin.readToEndAfter(wasiSystem.fill, [])) }
      flush = { _ -> () }
    )

    use Env(
      args = { _ -> wasiSystem.arguments() }
      variable = { name -> wasiSystem.environmentVariable(name) }
      exit = { code -> wasiSystem.exitProcess(code) }
    )

    use FileSystem(
      readFile = { at -> if cancelled()
          then #cancelled
          else wasiSystem.readWith(at, { address, count -> stringAt(address, count) })
      }
      readFileBytes = { at -> if cancelled()
          then #cancelled
          else wasiSystem.readWith(at, { address, count -> wasiFiles.bytesAt(address, count) })
      }
      readFileChunk = { at, offset, length -> if cancelled()
          then #cancelled
          else wasiSystem.chunkAt(at, offset, length)
      }
      writeFile = { at, text -> if cancelled()
          then #cancelled
          else wasiSystem.writeWith(at, text, 9, 0)
      }
      appendFile = { at, text -> if cancelled()
          then #cancelled
          else wasiSystem.writeWith(at, text, 1, 1)
      }
      pathExists = { at -> if cancelled() then false else wasiSystem.existsAt(at) }
      deleteFile = { at -> if cancelled() then #cancelled else wasiSystem.deleteAt(at) }
      listDirectory = { at -> if cancelled() then #cancelled else wasiSystem.namesAt(at) }
      createDirectory = { at ->
        if cancelled() then #cancelled else
          wasiSystem.atPath(
            at
            { directory, address, length -> wasiSystem.pathCreateDirectory(
                directory
                address
                length
              )
            }
          )
      }
    )

    use Http(sendRequest = { request -> sendThroughRuntime(request) })
    use Random(bits = { _ -> systemBits() })

    use Clock(
      now = { _ -> Instant.epoch \plus(timeOn(0)) }
      ticks = { _ -> timeOn(1) }
      sleep = { time -> sleepOnRuntime(time) }
    )

    f()
  }

--| Runs `entry`, the program's entry point, in the contexts [`provide`] provides. What `entry`
  returns is ignored.
export def run
  : [HostRuntime, Async] ([Async, Clock, Console, Env, FileSystem, Http, Random] () -> a) -> ()
  = { entry ->
    ignore(provide(entry))
  }
