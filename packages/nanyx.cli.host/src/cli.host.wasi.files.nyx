def fileAppendFutureDropReadable: [HostRuntime] I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[method]descriptor.read-directory")
def readDirectory: [HostRuntime] I32, I32 -> ()

@extern(
  "wasi:filesystem/types@0.3.0"
  "[async-lower][stream-read-0][method]descriptor.read-directory"
)
def directoryStreamRead: [HostRuntime] I32, I32, I32 -> I32

@extern("wasi:filesystem/types@0.3.0", "[stream-drop-readable-0][method]descriptor.read-directory")
def directoryStreamDropReadable: [HostRuntime] I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[future-drop-readable-1][method]descriptor.read-directory")
def directoryFutureDropReadable: [HostRuntime] I32 -> ()

-- `descriptor-type`'s cases, by their place in the variant.
def directoryType: I32 = 2

def otherType: I32 = 7

-- `open-flags` and `descriptor-flags`, each a bit, and `path-flags`' one, `symlink-follow`.
def createFlag: I32 = 1

def directoryFlag: I32 = 2

def truncateFlag: I32 = 8

def readFlag: I32 = 1

def writeFlag: I32 = 2

def followSymlinks: I32 = 1

--| The `FsError` the `wasi:filesystem` `error-code` at `at` stands for: its case, by its place in the
  variant, and for `other`, the `option<string>` at 4, which is freed.
def errorAt: [HostRuntime] I32 -> FsError = { at ->
  def code = readByte(at)

  if code == 19
    then #notFound
    else if code == 0 or code == 30 or code == 32
      then #permissionDenied
      else if code == 13
        then #isDirectory
        else if code == 23
          then #notDirectory
          else if code == 6
            then #alreadyExists
            else if code == 36 and readByte(at + 4) == 1
              then #other(takeString(at + 8))
              else #other("wasi:filesystem error {code}")
}

--| What a `result<_, error-code>` at `at` holds: `#ok`, or the `FsError` of its error, at 4.
def resultAt: [HostRuntime] I32 -> #ok | FsError = { at ->
  if readByte(at) == 0 then #ok else errorAt(at + 4)
}

--| The address of the list of preopens, read the first time they are needed: each a descriptor then
  its name's address and length, 12 bytes. Their count is at 60 in the host's block.
def preopens: [HostRuntime] () -> I32 = { _ ->
  if readI32(stateAt(12)) == 0 then readPreopens() else ()
  readI32(stateAt(56))
}

--| Reads the preopens into the host's block.
def readPreopens: [HostRuntime] () -> () = { _ ->
  getDirectories(stateAt(56))
  writeI32(stateAt(12), 1)
}

--| The preopen, from the `index`th of the `count` in the list at `list` on, that `text` is in, with
  the path relative to it.
def locatedFrom
  : [HostRuntime] I32, I32, I32, string -> #some(I32, string) | FsError
  = { list, index, count, text ->
    if index >= count then #permissionDenied else
      def entry = I32.wrappingAdd(list, index * 12)
      def name = stringAt(readI32(entry + 4), readI32(entry + 8))

      match within(name, text)
        | #some(relative) -> #some(readI32(entry), relative)
        | #outside -> locatedFrom(list, index + 1, count, text)
  }

--| The preopen `at` is in, with the path relative to it.
def located: [HostRuntime] Path -> #some(I32, string) | FsError = { at ->
  def list = preopens()
  locatedFrom(list, 0, readI32(stateAt(60)), Path.toString(at))
}

--| Calls `call` with the preopen `at` is in, the path relative to it as an address and a length,
  and a block of `size` bytes, aligned to 8, where it gives its result; and gives what `read` makes
  of that result.
def withResult
  : [HostRuntime]
    Path,
    I32,
    ([HostRuntime] I32, I32, I32, I32 -> ()),
    ([HostRuntime] I32 -> #ok | FsError)
    -> #ok | FsError
  = { at, size, call, read ->
    match located(at)
      | #some(directory, relative) ->
        def block = allocate(size + 8)
        def result = aligned8(block)
        call(directory, addressOf(relative), byteLength(relative), result)
        keepAlive(relative)
        def made = read(result)
        free(block)
        made
      | e -> e
  }

--| Opens `at` with the `open-flags` `openFlags` and the `descriptor-flags` `descriptorFlags`, and
  gives its descriptor.
def openAt
  : [HostRuntime] Path, I32, I32 -> #some(I32) | FsError
  = { at, openFlags, descriptorFlags ->
    match located(at)
      | #some(directory, relative) ->
        def block = allocate(24)

        openAtPath(
          directory
          followSymlinks
          addressOf(relative)
          byteLength(relative)
          openFlags
          descriptorFlags
          block
        )

        keepAlive(relative)

        def opened = if readByte(block) == 0 then #some(readI32(block + 4)) else errorAt(block + 4)

        free(block)
        opened
      | e -> e
  }

--| The kind and the size of the file `descriptor`, from its `descriptor-stat`: its `size` is at 24
  in it, after the result's 8 bytes.
def described: [HostRuntime] I32 -> #some(I32, int) | FsError = { descriptor ->
  def block = allocate(120)
  def stat = aligned8(block)
  statDescriptor(descriptor, stat)

  def found = match kindIn(stat)
    | #some(kind) -> #some(kind, readI64(stat + 32))
    | e -> e

  free(block)
  found
}

--| The kind of file a `result<descriptor-stat, error-code>` at `stat` says, or its error: the
  `descriptor-stat`'s `type` at 8, a variant whose `other` may hold a string, which is freed.
def kindIn: [HostRuntime] I32 -> #some(I32) | FsError = { stat ->
  if readByte(stat) != 0 then errorAt(stat + 8) else
    freeOptionalString(stat + 12)
    #some(readByte(stat + 8))
}

--| How many bytes of the stream `reader` it reads into the `size` bytes at `buffer`, after the
  `done` it has read: until the buffer is full or the stream ends.
def readInto: [HostRuntime] I32, I32, I32, I32 -> I32 = { reader, buffer, size, done ->
  if done >= size then done else
    def status = settled(reader, fileStreamRead(reader, I32.wrappingAdd(buffer, done), size - done))
    def read = done + status // 16
    if status % 16 != 0 then read else readInto(reader, buffer, size, read)
}

--| Up to `size` bytes of the file `descriptor`, from byte `offset` on, read into a new buffer, and
  what `contents` makes of them, given their address and how many there are.
def readFrom
  : [HostRuntime] I32, int, I32, ([HostRuntime] I32, I32 -> a) -> a
  = { descriptor, offset, size, contents ->
    def ends = allocate(8)
    fileReadViaStream(descriptor, offset, ends)
    def reader = readI32(ends)
    def done = readI32(ends + 4)
    free(ends)
    def buffer = allocate(size + 1)
    def read = readInto(reader, buffer, size, 0)
    fileStreamDropReadable(reader)
    fileReadFutureDropReadable(done)
    def made = contents(buffer, read)
    free(buffer)
    made
  }

--| What `contents` makes of the bytes of the file at `at`, given their address and how many there
  are.
def readWith
  : [HostRuntime] Path, ([HostRuntime] I32, I32 -> a) -> #some(a) | FsError
  = { at, contents ->
    match openAt(at, 0, readFlag)
      | #some(descriptor) ->
        def result = match described(descriptor)
          | #some(kind, size) ->
            if kind == directoryType then #isDirectory else
              match int.toI32(size)
                | #some(fits) -> #some(readFrom(descriptor, 0, fits, contents))
                | #outOfRange -> #other("the file is too large to read at once")
          | e -> e

        dropDescriptor(descriptor)
        result
      | e -> e
  }

--| Up to `length` bytes of the file at `at`, from byte `offset` on, or an error for an `offset` past
  its end: the file is opened, read and closed again, so nothing is left open between one chunk and
  the next.
def chunkAt: [HostRuntime] Path, int, int -> #some(string) | FsError = { at, offset, length ->
  match int.toI32(length)
    | #outOfRange -> #other("a chunk that large can't be read at once")
    | #some(size) ->
      match openAt(at, 0, readFlag)
        | #some(descriptor) ->
          def result = match described(descriptor)
            | #some(kind, fileSize) ->
              if kind == directoryType
                then #isDirectory
                else if offset > fileSize then
                  #other("it is shorter than it was: it ends at byte {fileSize}, before {offset}")
                else #some(
                  readFrom(descriptor, offset, size, { address, count -> stringAt(address, count) })
                )
            | e -> e

          dropDescriptor(descriptor)
          result
        | e -> e
}

--| Writes `text` to the file at `at`, which it opens with the `open-flags` `openFlags`, through
  `output`, the descriptor's `write-via-stream` or `append-via-stream` as `outputOf` gives them. A
  directory at `at` is `#isDirectory`, whatever the system says: Windows refuses to open one for
  writing as `invalid`, where Linux says `is-directory`.
def writeWith
  : [HostRuntime] Path, string, I32, ([HostRuntime] I32 -> Output) -> #ok | FsError
  = { at, text, openFlags, outputOf ->
    match openAt(at, openFlags, writeFlag)
      | #some(descriptor) ->
        def result = allocate(24)
        writeTo(outputOf(descriptor), text, result)
        dropDescriptor(descriptor)
        def written = resultAt(result)
        free(result)
        written
      | e ->
        match kindAt(at)
          | #some(kind) -> (if kind == directoryType then #isDirectory else e)
          | _ -> e
  }

--| A file's `write-via-stream`, from its start, as an `Output`.
def overwriting: [HostRuntime] I32 -> Output = { descriptor ->
  (
    streamNew = fileWriteStreamNew
    writeViaStream = { readable -> fileWriteViaStream(descriptor, readable, 0) }
    streamWrite = fileWriteStreamWrite
    streamDropWritable = fileWriteStreamDropWritable
    futureRead = fileWriteFutureRead
    futureDropReadable = fileWriteFutureDropReadable
  )
}

--| A file's `append-via-stream` as an `Output`.
def appending: [HostRuntime] I32 -> Output = { descriptor ->
  (
    streamNew = fileAppendStreamNew
    writeViaStream = { readable -> fileAppendViaStream(descriptor, readable) }
    streamWrite = fileAppendStreamWrite
    streamDropWritable = fileAppendStreamDropWritable
    futureRead = fileAppendFutureRead
    futureDropReadable = fileAppendFutureDropReadable
  )
}

--| How many directory entries are read at a time.
def entriesAtOnce: I32 = 64

--| The names in the `count` directory entries at `entries`, from the `index`th on, after `names`.
  Each is 24 bytes: its `type` at 0, a variant whose `other` may hold a string, and its `name` at
  16; the host allocated the strings, which are freed.
def namesIn
  : [HostRuntime] I32, I32, I32, list(string) -> list(string)
  = { entries, index, count, names ->
    if index >= count then names else
      def entry = I32.wrappingAdd(entries, index * 24)
      if readByte(entry) == otherType then freeOptionalString(entry + 4) else ()
      def name = takeString(entry + 16)
      namesIn(entries, index + 1, count, [name, ...names])
  }

--| The names the stream of directory entries `reader` gives, read `entriesAtOnce` at a time into the
  buffer at `buffer`, after `names`.
def namesFrom: [HostRuntime] I32, I32, list(string) -> list(string) = { reader, buffer, names ->
  def status = settled(reader, directoryStreamRead(reader, buffer, entriesAtOnce))
  def read = namesIn(buffer, 0, status // 16, names)
  if status % 16 != 0 then read else namesFrom(reader, buffer, read)
}

--| The names of what the directory at `at` holds.
def namesAt: [HostRuntime] Path -> #some(list(string)) | FsError = { at ->
  match openAt(at, directoryFlag, readFlag)
    | #some(descriptor) ->
      def ends = allocate(8)
      readDirectory(descriptor, ends)
      def reader = readI32(ends)
      def done = readI32(ends + 4)
      free(ends)
      def buffer = allocate(entriesAtOnce * 24)
      def names = namesFrom(reader, buffer, [])
      free(buffer)
      directoryStreamDropReadable(reader)
      directoryFutureDropReadable(done)
      dropDescriptor(descriptor)
      #some(list.reverse(names))
    | e -> e
}

--| The kind of file at `at`, from its `descriptor-stat`.
def kindAt: [HostRuntime] Path -> #some(I32) | FsError = { at ->
  match located(at)
    | #some(directory, relative) ->
      def block = allocate(120)
      def stat = aligned8(block)
      statAtPath(directory, followSymlinks, addressOf(relative), byteLength(relative), stat)
      keepAlive(relative)
      def found = kindIn(stat)
      free(block)
      found
    | e -> e
}

--| Whether there is anything at `at` that the program may reach.
def existsAt: [HostRuntime] Path -> bool = { at ->
  match kindAt(at)
    | #some(_) -> true
    | _ -> false
}

--| Deletes the file at `at`: a directory is `#isDirectory`, whatever the system says.
def deleteAt: [HostRuntime] Path -> #ok | FsError = { at ->
  match kindAt(at)
    | #some(kind) ->
      if kind == directoryType then #isDirectory else withResult(at, 24, unlinkFileAtPath, resultAt)
    | e -> e
}

--| Makes the directory `at`.
def createDirectoryAt: [HostRuntime] Path -> #ok | FsError = { at ->
  withResult(at, 24, createDirectoryAtPath, resultAt)
}
