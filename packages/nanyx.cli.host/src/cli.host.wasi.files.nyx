-- Part of the console host's component root, cli.host.wasi.nyx and this file: its file system,
-- which the FileSystem it provides is written on.
@partial export module cli.host.wasi

-- The file system ---------------------------------------------------------------------------------

-- `FileSystem` is written on `wasi:filesystem`. It reaches files only through the directories the
-- host opened for the program, its preopens, which `get-directories` gives: each a descriptor with
-- the name the program knows it by. `wasmtime run --dir .` opens the current directory as `.`. A
-- path is found in a preopen as the core root finds it (see `cli.files`).
--
-- The preopens are read once, and kept: the address of their list at 56 in the host's block, its
-- count at 60, and at 12, whether it has been read. A call that gives its result in memory is given
-- a block of its own, which it frees once it has read it.

@extern("wasi:filesystem/preopens@0.3.0", "get-directories")
def getDirectories: [HostRuntime] I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[resource-drop]descriptor")
def dropDescriptor: [HostRuntime] I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[method]descriptor.open-at")
def openAtPath: [HostRuntime] I32, I32, I32, I32, I32, I32, I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[method]descriptor.stat")
def statDescriptor: [HostRuntime] I32, I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[method]descriptor.stat-at")
def statAtPath: [HostRuntime] I32, I32, I32, I32, I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[method]descriptor.create-directory-at")
def createDirectoryAtPath: [HostRuntime] I32, I32, I32, I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[method]descriptor.unlink-file-at")
def unlinkFileAtPath: [HostRuntime] I32, I32, I32, I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[method]descriptor.read-via-stream")
def fileReadViaStream: [HostRuntime] I32, I64, I32 -> ()

@extern(
  "wasi:filesystem/types@0.3.0"
  "[async-lower][stream-read-0][method]descriptor.read-via-stream"
)
def fileStreamRead: [HostRuntime] I32, I32, I32 -> I32

@extern("wasi:filesystem/types@0.3.0", "[stream-drop-readable-0][method]descriptor.read-via-stream")
def fileStreamDropReadable: [HostRuntime] I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[future-drop-readable-1][method]descriptor.read-via-stream")
def fileReadFutureDropReadable: [HostRuntime] I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[stream-new-0][method]descriptor.write-via-stream")
def fileWriteStreamNew: [HostRuntime] () -> I64

@extern("wasi:filesystem/types@0.3.0", "[method]descriptor.write-via-stream")
def fileWriteViaStream: [HostRuntime] I32, I32, I64 -> I32

@extern(
  "wasi:filesystem/types@0.3.0"
  "[async-lower][stream-write-0][method]descriptor.write-via-stream"
)
def fileWriteStreamWrite: [HostRuntime] I32, I32, I32 -> I32

@extern(
  "wasi:filesystem/types@0.3.0"
  "[stream-drop-writable-0][method]descriptor.write-via-stream"
)
def fileWriteStreamDropWritable: [HostRuntime] I32 -> ()

@extern(
  "wasi:filesystem/types@0.3.0"
  "[async-lower][future-read-1][method]descriptor.write-via-stream"
)
def fileWriteFutureRead: [HostRuntime] I32, I32 -> I32

@extern(
  "wasi:filesystem/types@0.3.0"
  "[future-drop-readable-1][method]descriptor.write-via-stream"
)
def fileWriteFutureDropReadable: [HostRuntime] I32 -> ()

@extern("wasi:filesystem/types@0.3.0", "[stream-new-0][method]descriptor.append-via-stream")
def fileAppendStreamNew: [HostRuntime] () -> I64

@extern("wasi:filesystem/types@0.3.0", "[method]descriptor.append-via-stream")
def fileAppendViaStream: [HostRuntime] I32, I32 -> I32

@extern(
  "wasi:filesystem/types@0.3.0"
  "[async-lower][stream-write-0][method]descriptor.append-via-stream"
