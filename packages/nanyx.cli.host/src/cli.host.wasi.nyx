--| The console host's component root: what `nanyx build` builds a WASI 0.3 component from, of the
  world `nanyx:console/command`, which is `wasi:cli/command@0.3.0` and `wasi:http/client@0.3.0`.
  A component imports only what the program uses: `wasmtime run`, or any runtime that implements
  WASI 0.3, runs one that makes no requests, and `wasmtime run -S http` one that does.

  Its [`run`] runs the program's entry point as `cli.host`'s does, through [`provide`], which
  a component's exports that require contexts are called through too, in the contexts it can write
  on WASI 0.3 alone: [`Console`] on `wasi:cli`'s stdin, stdout and stderr, [`Env`] on
  `wasi:cli/environment` and `exit`, [`FileSystem`] on `wasi:filesystem` (see
  `cli.host.wasi.files.nyx`), [`Http`] on `wasi:http/client`, [`Clock`] on `wasi:clocks` and
  [`Random`] on `wasi:random`, and `Async`: everything `cli.host` provides.

  It calls WASI 0.3 through `@extern`s named as wit-component expects, and passes their values in
  the canonical ABI by hand, with `nanyx/host.memory`; what it shares with other hosts, such as
  stdout, the HTTP client and the clocks, is in the host library `nanyx.wasi`. A call that waits is
  lowered async and waited on at once, so the program blocks in it, as it does under `nanyx run`.
@partial export module cli.host.wasi

import (
  nanyx/async as (Async)
  nanyx/clock as (Clock, wholeMilliseconds)
  nanyx/host.async as (cancelled)
  nanyx/host.memory
  nanyx/host.runtime
  nanyx/random as (Random)
  nanyx/text
  nanyx.cli/console as (Console, IoError)
  nanyx.cli/env as (Env)
  nanyx.fs/filesystem as (FileSystem, FsError)
  nanyx.fs/filesystem as filesystem
  nanyx.fs/path as (Path)
  nanyx.http/client as (Http, HttpError)
  nanyx.http/request as (Method, Request)
  nanyx.http/response as (Response)
  nanyx.wasi/abi as (Output, aligned8, freeOptionalString, listFrom, readableEnd, settled, takeString, writableEnd, writeOut, writeTo)
  nanyx.wasi/cli as (stderr, stdout)
  nanyx.wasi/clocks as clocks
  nanyx.wasi/files as (bytesAt, within)
  nanyx.wasi/http as (sendThroughWasi)
  nanyx.wasi/random as wasiRandom
  nanyx.wasi/stdin as (bufferOffset, bufferSize, readLineAfter, readToEndAfter, stateAt)
)

-- The host keeps its state in the block the module sets aside for it (see `hostState`): at 4 and 8,
-- where what is left of the standard input it has read starts and ends in its buffer (see
-- `cli.stdin`); at 16, the readable end of standard input's stream, once it is open, and at 20
-- its future; at 12, 56 and 60, the preopens (see `cli.host.wasi.files.nyx`); and from 64 to the
-- end of the block, the buffer standard input is read into.

-- Console ----------------------------------------------------------------------------------------

@extern("wasi:cli/stdin@0.3.0", "read-via-stream")
def stdinReadViaStream: [HostRuntime] I32 -> ()

@extern("wasi:cli/stdin@0.3.0", "[async-lower][stream-read-0]read-via-stream")
def stdinStreamRead: [HostRuntime] I32, I32, I32 -> I32

--| Standard input's stream, opened the first time it is read: `wasi:cli/stdin`'s `read-via-stream`
  gives it, and the future that says how reading it ended, which the host never reads.
def stdinStream: [HostRuntime] () -> I32 = { _ ->
  if readI32(stateAt(16)) == 0 then stdinReadViaStream(stateAt(16)) else ()
  readI32(stateAt(16))
}

--| How many bytes of standard input are left in the buffer, read into it when none are; 0 when the
  input has ended, or cannot be read.
def fill: [HostRuntime] () -> I32 = { _ ->
  def start = readI32(stateAt(4))
  def end = readI32(stateAt(8))

  if start < end then end - start else
    def reader = stdinStream()
    def status = settled(reader, stdinStreamRead(reader, stateAt(bufferOffset), bufferSize))
    def read = status // 16
    writeI32(stateAt(4), 0)
    writeI32(stateAt(8), read)
    read
}

-- Env --------------------------------------------------------------------------------------------

@extern("wasi:cli/environment@0.3.0", "get-arguments")
def getArguments: [HostRuntime] I32 -> ()

@extern("wasi:cli/environment@0.3.0", "get-environment")
def getEnvironment: [HostRuntime] I32 -> ()

@extern("wasi:cli/exit@0.3.0", "exit-with-code")
def exitWithCode: [HostRuntime] I32 -> ()

--| The value of the environment variable `name` in `variables`, or `#notSet` when it has none.
def variableIn: list((string, string)), string -> #some(string) | #notSet = {
  | [], _ -> #notSet
  | [(variable, value), ...rest], name -> if variable == name
    then #some(value)
    else variableIn(rest, name)
}

--| The program's command-line arguments, after its name.
def arguments: [HostRuntime] () -> list(string) = { _ ->
  match listFrom(getArguments, 8, takeString)
    | [] -> []
    | [_, ...rest] -> rest
}

--| The value of the environment variable `name`, or `#notSet` when it has none.
def environmentVariable: [HostRuntime] string -> #some(string) | #notSet = { name ->
  def variables = listFrom(getEnvironment, 16, { at -> (takeString(at), takeString(at + 8)) })
  variableIn(variables, name)
}

--| Ends the program with the exit code `code`, or 1 for a code that isn't 0 to 255, which is all an
  exit code can be. `exit-with-code` never returns: the call after it only gives the function its
  type.
def exitProcess: [HostRuntime] int -> undefined = { code ->
  def exitCode = if code >= 0 and code <= 255 then I32.fromInt(code) else 1
  exitWithCode(exitCode)
  exitProcess(code)
}

--| Calls `f` with a `Console` that reads and writes the standard streams, an `Env` that reads what
  the program was started with, a `FileSystem` that reads and writes the directories the host
  opened for it, an `Http` that makes requests through the host, a `Clock` that reads the host's
  clocks, a `Random` that draws from its random source, and `Async`, so that it may wait, and gives
  back what `f` returns. A component's export that requires contexts is called through it.
export def provide
  : [HostRuntime, Async] ([Async, Clock, Console, Env, FileSystem, Http, Random] () -> a) -> a
  = { f ->
    use Console(
      write = { text -> writeOut(stdout, text) }
      writeError = { text -> writeOut(stderr, text) }
      readLine = { _ -> readLineAfter(fill, []) }
      readToEnd = { _ -> #some(readToEndAfter(fill, [])) }
      flush = { _ -> () }
    )

    use Env(
      args = { _ -> arguments() }
      variable = { name -> environmentVariable(name) }
      exit = { code -> exitProcess(code) }
    )

    use FileSystem(
      readFile = { at -> if cancelled()
          then #cancelled
          else readWith(at, { address, count -> stringAt(address, count) })
      }
      readFileBytes = { at -> if cancelled()
          then #cancelled
          else readWith(at, { address, count -> bytesAt(address, count) })
      }
      readFileChunk = { at, offset, length -> if cancelled()
          then #cancelled
          else chunkAt(at, offset, length)
      }
      writeFile = { at, text -> if cancelled()
          then #cancelled
          else writeWith(at, text, createFlag + truncateFlag, overwriting)
      }
      appendFile = { at, text -> if cancelled()
          then #cancelled
          else writeWith(at, text, createFlag, appending)
      }
      pathExists = { at -> if cancelled() then false else existsAt(at) }
      deleteFile = { at -> if cancelled() then #cancelled else deleteAt(at) }
      listDirectory = { at -> if cancelled() then #cancelled else namesAt(at) }
      createDirectory = { at -> if cancelled() then #cancelled else createDirectoryAt(at) }
    )

    use Http(sendRequest = { request -> sendThroughWasi(request) })
    use Random(bits = { _ -> wasiRandom.bits() })

    use Clock(
      now = { _ -> Instant.epoch \plus(clocks.timeOfDay()) }
      ticks = { _ -> clocks.ticks() }
      sleep = { time -> clocks.sleepFor(wholeMilliseconds(time)) }
    )

    f()
  }

--| Runs `entry`, the program's entry point, in the contexts [`provide`] provides. What `entry`
  returns is ignored. When the environment variable `NANYX_FILES_IN_MEMORY` is `1`, its
  `FileSystem` keeps what it writes in memory, over the real files, as the preview 1 root's does
  (see `cli.host`'s `run`).
export def run
  : [HostRuntime, Async] ([Async, Clock, Console, Env, FileSystem, Http, Random] () -> a) -> ()
  = { entry ->
    ignore(
      provide(
        {
          if variable("NANYX_FILES_IN_MEMORY") == #some("1")
            then filesystem.overlay(entry)
            else entry()
        }
      )
    )
  }
