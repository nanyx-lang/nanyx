--| JSON text, read into a [`Json`] value and written back out.

  [`parse`] reads text into a `Json`, or says where it stops being JSON and why, as a
  [`JsonError`]. [`print`] writes a value compactly, and [`printPretty`] writes it with each
  element and member on a line of its own. Nothing here needs a context. A program names
  `nanyx.json` in its manifest's `dependencies`, or a script in a `::dependency` line, and imports
  it as `import nanyx.json/json as json`, to call `json.parse(text)` as the docs do.

  An object is a `map(string, Json)`, and a map keeps its keys in the order they were first added:
  `parse` adds them in the order the text writes them, and `print` writes them in the map's order,
  so a document read and written again keeps its keys where they were. A key written twice holds
  the value written last, in the place it was first written.

  Text is UTF-8, as strings are, and a string's escapes are read as JSON writes them: `\"`, `\\`,
  `\/`, `\b`, `\f`, `\n`, `\r`, `\t` and `\uXXXX`, with a character past U+FFFF written as two
  `\u` escapes, a surrogate pair. Numbers are `float`s.

  Each function walks its text, or its value, once, and calls itself in tail position along an
  array or an object, so a document of any length is read and written in time in proportion to
  its size. Only nesting takes stack: an array in an array in an array, and so on.
@partial export module json

import (
  nanyx/math as math
  nanyx/text
)

--| A JSON value: `null`, a boolean, a number, a string, an array of values, or an object, whose
  members are values each named by a string.
export type Json =
  | #null
  | #bool(bool)
  | #number(float)
  | #string(string)
  | #array(list(Json))
  | #object(map(string, Json))

--| Why [`parse`] read no value: where the text stops being JSON, and what it found there.
  `position` is the byte the problem is at, counting from 0, and `line` and `column` say where
  that byte is, each counting from 1, with `column` counting characters.
export type JsonError = (
  position: int
  line: int
  column: int
  message: string
)

-- Reading ---------------------------------------------------------------------------------------
--
-- The text is read as a `StringSlice`, a byte at a time, without copying it. Each function takes
-- the byte to read from and gives back the byte after what it read, or where the text stopped
-- being JSON and why.

--| What reading a value gives: the value and the byte after it, or the byte where the text stops
  being JSON and why.
type Parsed = #parsed(Json, int) | #failed(int, string)

--| What reading the rest of a string gives: its characters and the byte after its closing quote,
  or the byte where the text stops being JSON and why.
type ReadString = #read(string, int) | #failed(int, string)

--| The byte of `text` at `i`, or -1 past its end.
def byteAt: StringSlice, int -> int = { text, i ->
  match StringSlice.byteAt(text, i)
    | #some(b) -> b
    | #none -> -1
}

--| Whether `b` is whitespace between tokens: a space, a tab, a line feed or a carriage return.
def isWhitespace: int -> bool = { b ->
  b == 32 or b == 9 or b == 10 or b == 13
}

--| The first byte at or after `i` that isn't whitespace.
def skipWhitespace: StringSlice, int -> int = { text, i ->
  if isWhitespace(byteAt(text, i)) then skipWhitespace(text, i + 1) else i
}

--| Whether `b` is a decimal digit.
def isDigit: int -> bool = { b ->
  b >= 48 and b <= 57
}

--| The first byte at or after `i` that isn't a decimal digit.
def skipDigits: StringSlice, int -> int = { text, i ->
  if isDigit(byteAt(text, i)) then skipDigits(text, i + 1) else i
}

--| The byte after the character that runs through byte `i`: the first at or after `i` that
  doesn't continue a UTF-8 sequence.
def charEnd: StringSlice, int -> int = { text, i ->
  def b = byteAt(text, i)
  if b >= 128 and b < 192 then charEnd(text, i + 1) else i
}

--| The bytes of `text` from `start` up to `stop`, as a string of their own.
def between: StringSlice, int, int -> string = { text, start, stop ->
  StringSlice.toString(StringSlice.slice(text, start, stop))
}

--| What a message says it found at byte `i`: the character there, in quotes, or the end of the
  text.
def found: StringSlice, int -> string = { text, i ->
  def b = byteAt(text, i)

  if b < 0
    then "the end of the text"
    else if b < 32
      then "a control character"
      else "'" ++ between(text, i, charEnd(text, i + 1)) ++ "'"
}

--| The value that starts at the first byte at or after `from` that isn't whitespace.
def parseValue: StringSlice, int -> Parsed = { text, from ->
  def i = skipWhitespace(text, from)
  def b = byteAt(text, i)

  if b == 123
    then parseObject(text, i + 1)
    else if b == 91
      then parseArray(text, i + 1)
      else if b == 34
        then stringValue(readString(text, i + 1, i + 1, []))
        else if b == 45 or isDigit(b)
          then parseNumber(text, i)
          else if b == 116
            then parseWord(text, i, "true", #bool(true))
            else if b == 102
              then parseWord(text, i, "false", #bool(false))
              else parseWord(text, i, "null", #null)
}

--| What reading a string gave, as a value.
def stringValue: ReadString -> Parsed = {
  | #read(s, after) -> #parsed(#string(s), after)
  | #failed(at, message) -> #failed(at, message)
}

--| `value`, if `text` writes `word` at byte `i`.
def parseWord: StringSlice, int, string, Json -> Parsed = { text, i, word, value ->
  if StringSlice.startsWith(StringSlice.slice(text, i, StringSlice.length(text)), word)
    then #parsed(value, i + string.length(word))
    else #failed(i, "Expected a value, found {found(text, i)}")
}

--| The number that starts at byte `start`, with its optional `-`.
def parseNumber: StringSlice, int -> Parsed = { text, start ->
  def digits = if byteAt(text, start) == 45 then start + 1 else start

  if isDigit(byteAt(text, digits))
    then parseFraction(
      text
      start
      if byteAt(text, digits) == 48 then digits + 1 else skipDigits(text, digits)
    )
    else #failed(digits, "Expected a digit, found {found(text, digits)}")
}

--| The rest of the number that starts at byte `start`, from byte `i`, after its whole part: an
  optional fraction, then an optional exponent. A digit at `i` follows a whole part of `0`.
def parseFraction: StringSlice, int, int -> Parsed = { text, start, i ->
  if isDigit(byteAt(text, i))
    then #failed(i - 1, "A number can't start with a 0 followed by more digits")
    else if byteAt(text, i) != 46
      then parseExponent(text, start, i)
      else if isDigit(byteAt(text, i + 1))
        then parseExponent(text, start, skipDigits(text, i + 1))
        else #failed(i + 1, "Expected a digit after '.', found {found(text, i + 1)}")
}

--| The rest of the number that starts at byte `start`, from byte `i`: an optional exponent, `e` or
  `E`, an optional sign, and digits.
def parseExponent: StringSlice, int, int -> Parsed = { text, start, i ->
  def b = byteAt(text, i)
  def sign = byteAt(text, i + 1)

  if b != 101 and b != 69
    then numberBetween(text, start, i)
    else if sign == 43 or sign == 45
      then parseExponentDigits(text, start, i + 2)
      else parseExponentDigits(text, start, i + 1)
}

--| The digits of the exponent of the number that starts at byte `start`, from byte `i`.
def parseExponentDigits: StringSlice, int, int -> Parsed = { text, start, i ->
  if isDigit(byteAt(text, i))
    then numberBetween(text, start, skipDigits(text, i))
    else #failed(i, "Expected a digit in the exponent, found {found(text, i)}")
}

--| The number `text` writes from byte `start` up to `stop`, which is JSON's grammar for a number,
  and so `float.fromString`'s too.
def numberBetween: StringSlice, int, int -> Parsed = { text, start, stop ->
  #parsed(
    #number(orCrash(float.fromString(between(text, start, stop)), "A JSON number is a float"))
    stop
  )
}

--| The rest of a string, from byte `i`, after its opening quote. `start` is where the run of bytes
  being read without an escape starts, and `pieces` holds what was read before it, last first.
def readString: StringSlice, int, int, list(string) -> ReadString = { text, i, start, pieces ->
  def b = byteAt(text, i)

  if b == 34
    then #read(joined(between(text, start, i), pieces), i + 1)
    else if b == 92
      then readEscape(text, i, [between(text, start, i), ...pieces])
      else if b < 0
        then #failed(i, "Expected a '\"' to end the string, found the end of the text")
        else if b < 32
          then #failed(
            i
            "A string can't hold a control character: write it as an escape, such as '\\n'"
          )
          else readString(text, i + 1, start, pieces)
}

--| `pieces`, last first, then `last`, joined.
def joined: string, list(string) -> string = {
  | last, [] -> last
  | last, pieces -> string.concat(list.reverse([last, ...pieces]))
}

--| The rest of a string from the escape at byte `i`, its backslash.
def readEscape: StringSlice, int, list(string) -> ReadString = { text, i, pieces ->
  def e = byteAt(text, i + 1)

  if e == 117
    then readUnicode(text, i, pieces)
    else match escapeOf(e)
      | #some(c) -> readString(text, i + 2, i + 2, [c, ...pieces])
      | #none -> #failed(
        i
        "Expected an escape after '\\', found {found(
          text
          i + 1
        )}: a string's escapes are \\\", \\\\, \\/, \\b, \\f, \\n, \\r, \\t and \\uXXXX"
      )
}

--| The character the escape `\` then `e` stands for, but for `\u`.
def escapeOf: int -> #some(string) | #none = { e ->
  if e == 34
    then #some("\"")
    else if e == 92
      then #some("\\")
      else if e == 47
        then #some("/")
        else if e == 98
          then #some("\u{8}")
          else if e == 102
            then #some("\u{c}")
            else if e == 110
              then #some("\n")
              else if e == 114 then #some("\r") else if e == 116 then #some("\t") else #none
}

--| The value of the hexadecimal digit `b`, or -1 when it isn't one.
def hexValue: int -> int = { b ->
  if isDigit(b)
    then b - 48
    else if b >= 97 and b <= 102 then b - 87 else if b >= 65 and b <= 70 then b - 55 else -1
}

--| The number the hexadecimal digits from byte `i` up to `stop` write, after `value`, or -1 when
  one of them isn't a hexadecimal digit.
def hexFrom: StringSlice, int, int, int -> int = { text, i, stop, value ->
  if i >= stop
    then value
    else if hexValue(byteAt(text, i)) < 0
      then -1
      else hexFrom(text, i + 1, stop, value * 16 + hexValue(byteAt(text, i)))
}

--| The rest of a string from the `\u` escape at byte `i`: four hexadecimal digits, and, after a
  high surrogate, the `\u` escape of a low one.
def readUnicode: StringSlice, int, list(string) -> ReadString = { text, i, pieces ->
  def unit = hexFrom(text, i + 2, i + 6, 0)

  if unit < 0
    then #failed(i, "Expected four hexadecimal digits after '\\u'")
    else if unit >= 55296 and unit <= 56319
      then readLowSurrogate(text, i, unit, pieces)
      else if unit >= 56320 and unit <= 57343
        then #failed(i, unpairedSurrogate)
        else readCodePoint(text, i + 6, unit, pieces)
}

--| What a message says of a surrogate escape that isn't half of a pair.
def unpairedSurrogate: string =
  "A '\\u' escape of a surrogate needs the other half of its pair: a character past U+FFFF is written as a high surrogate then a low one, such as '\\uD83D\\uDE00'"

--| The rest of a string from the `\u` escape at byte `i` of the high surrogate `high`: the escape
  of the low surrogate after it.
def readLowSurrogate: StringSlice, int, int, list(string) -> ReadString = { text, i, high, pieces ->
  def low = if byteAt(text, i + 6) == 92 and byteAt(text, i + 7) == 117
    then hexFrom(text, i + 8, i + 12, 0)
    else -1

  if low >= 56320 and low <= 57343
    then readCodePoint(text, i + 12, 65536 + (high - 55296) * 1024 + (low - 56320), pieces)
    else #failed(i, unpairedSurrogate)
}

--| The rest of a string from byte `i`, after an escape of the character `codePoint`.
def readCodePoint
  : StringSlice, int, int, list(string) -> ReadString
  = { text, i, codePoint, pieces ->
    def c = orCrash(
      string.fromCodePoint(codePoint)
      "An escape that isn't a surrogate is a code point"
    )

    readString(text, i, i, [c, ...pieces])
  }

--| The array whose `[` is before byte `from`.
def parseArray: StringSlice, int -> Parsed = { text, from ->
  def i = skipWhitespace(text, from)
  if byteAt(text, i) == 93 then #parsed(#array([]), i + 1) else parseElements(text, i, [])
}

--| The elements of an array from byte `from` on, after `elements`, which hold those before it, last
  first.
def parseElements: StringSlice, int, list(Json) -> Parsed = { text, from, elements ->
  match parseValue(text, from)
    | #parsed(value, after) -> afterElement(text, skipWhitespace(text, after), [value, ...elements])
    | #failed(at, message) -> #failed(at, message)
}

--| The rest of an array from byte `i`, after an element: a `,` and the next element, or its `]`.
def afterElement: StringSlice, int, list(Json) -> Parsed = { text, i, elements ->
  def b = byteAt(text, i)

  if b == 44
    then parseElements(text, i + 1, elements)
    else if b == 93
      then #parsed(#array(list.reverse(elements)), i + 1)
      else #failed(i, "Expected ',' or ']' after an element of an array, found {found(text, i)}")
}

--| The object whose `{` is before byte `from`.
def parseObject: StringSlice, int -> Parsed = { text, from ->
  def i = skipWhitespace(text, from)
  if byteAt(text, i) == 125 then #parsed(#object(map.empty), i + 1) else parseMembers(text, i, [])
}

--| The members of an object from byte `from` on, after `members`, which hold those before it, last
  first: a key, a `:` and a value.
def parseMembers: StringSlice, int, list((string, Json)) -> Parsed = { text, from, members ->
  def i = skipWhitespace(text, from)

  if byteAt(text, i) == 34
    then parseMemberValue(text, readString(text, i + 1, i + 1, []), members)
    else #failed(i, "Expected a string to name a member of an object, found {found(text, i)}")
}

--| The rest of a member of an object, after its key, `read`: a `:` and its value.
def parseMemberValue
  : StringSlice, ReadString, list((string, Json)) -> Parsed
  = { text, read, members ->
    match read
      | #read(key, after) -> parseValueOf(text, key, skipWhitespace(text, after), members)
      | #failed(at, message) -> #failed(at, message)
  }

--| The value of the member `key`, from the `:` expected at byte `i`.
def parseValueOf
  : StringSlice, string, int, list((string, Json)) -> Parsed
  = { text, key, i, members ->
    if byteAt(text, i) == 58
      then afterValueOf(text, key, parseValue(text, i + 1), members)
      else #failed(i, "Expected ':' after the name of a member, found {found(text, i)}")
  }

--| The rest of an object, after the value of its member `key`, `parsed`.
def afterValueOf
  : StringSlice, string, Parsed, list((string, Json)) -> Parsed
  = { text, key, parsed, members ->
    match parsed
      | #parsed(value, after) -> afterMember(
        text
        skipWhitespace(text, after)
        [(key, value), ...members]
      )
      | #failed(at, message) -> #failed(at, message)
  }

--| The rest of an object from byte `i`, after a member: a `,` and the next member, or its `}`.
def afterMember: StringSlice, int, list((string, Json)) -> Parsed = { text, i, members ->
  def b = byteAt(text, i)

  if b == 44
    then parseMembers(text, i + 1, members)
    else if b == 125
      then #parsed(#object(map.fromList(list.reverse(members))), i + 1)
      else #failed(i, "Expected ',' or '\}' after a member of an object, found {found(text, i)}")
}

--| The JSON value `text` writes, or a [`JsonError`] that says where it stops being JSON and why.
  The text is one value, with any whitespace before and after it: `json.parse('[1, "two", null]')`
  is `#some(#array([#number(1.0), #string("two"), #null]))`, and `json.parse("[1, 2")` is an error
  at the end of the text.
export def parse: string -> #some(Json) | #error(JsonError) = { s ->
  def text = string.slice(s, 0, string.length(s))

  match parseValue(text, 0)
    | #parsed(value, after) -> endOfText(text, skipWhitespace(text, after), value)
    | #failed(at, message) -> #error(errorAt(text, at, message))
}

--| `value`, if byte `i` is the end of `text`.
def endOfText: StringSlice, int, Json -> #some(Json) | #error(JsonError) = { text, i, value ->
  if i >= StringSlice.length(text)
    then #some(value)
    else #error(
      errorAt(text, i, "Expected the end of the text after the value, found {found(text, i)}")
    )
}

--| The error `message` at byte `at` of `text`.
def errorAt: StringSlice, int, string -> JsonError = { text, at, message ->
  locate(text, 0, at, 1, 1, message)
}

--| The error `message` at byte `at`, with the line and column of byte `i` counted so far.
def locate
  : StringSlice, int, int, int, int, string -> JsonError
  = { text, i, at, line, column, message ->
    def b = byteAt(text, i)

    if i >= at or b < 0
      then JsonError(position = at, line = line, column = column, message = message)
      else if b == 10
        then locate(text, i + 1, at, line + 1, 1, message)
        else if b >= 128 and b < 192
          then locate(text, i + 1, at, line, column, message)
          else locate(text, i + 1, at, line, column + 1, message)
  }

-- Writing ---------------------------------------------------------------------------------------
--
-- A value is written as a list of pieces, last first, which are reversed and joined once at the
-- end, so each piece is copied once.

--| `x` as a JSON number: a whole number without a fraction, and any other as `float.toString`
  writes it. JSON has no NaN or infinity, so they are written as `null`.
def numberText: float -> string = { x ->
  if not math.isFinite(x)
    then "null"
    else if math.abs(x) >= 1.0e15
      then float.toString(x)
      else wholeText(x, float.toInt(x, #truncate))
}

--| `x`, which is `whole` with any fraction it has, as a JSON number.
def wholeText: float, int -> string = { x, whole ->
  if float.fromInt(whole) == x then int.toString(whole) else float.toString(x)
}

--| The hexadecimal digit `n`, which is less than 16.
def hexDigit: int -> string = { n ->
  string.substring("0123456789abcdef", start = n, length = 1)
}

--| The escape JSON writes the byte `b` with in a string: a quote, a backslash, or a control
  character.
def escapeFor: int -> string = { b ->
  if b == 34
    then "\\\""
    else if b == 92
      then "\\\\"
      else if b == 10
        then "\\n"
        else if b == 13
          then "\\r"
          else if b == 9
            then "\\t"
            else if b == 8
              then "\\b"
              else if b == 12 then "\\f" else "\\u00" ++ hexDigit(b / 16) ++ hexDigit(b % 16)
}

--| The pieces of `text` from byte `i` on, escaped, in front of `acc`. `start` is where the run of
  bytes written as they are starts.
def escaped: StringSlice, int, int, list(string) -> list(string) = { text, i, start, acc ->
  def b = byteAt(text, i)

  if b < 0
    then [between(text, start, i), ...acc]
    else if b == 34 or b == 92 or b < 32
      then escaped(text, i + 1, i + 1, [escapeFor(b), between(text, start, i), ...acc])
      else escaped(text, i + 1, start, acc)
}

--| `s` as a JSON string, in quotes and escaped, in front of `acc`.
def quoted: string, list(string) -> list(string) = { s, acc ->
  ["\"", ...escaped(string.slice(s, 0, string.length(s)), 0, 0, ["\"", ...acc])]
}

--| `value` written compactly, in front of `acc`.
def written: Json, list(string) -> list(string) = { value, acc ->
  match value
    | #null -> ["null", ...acc]
    | #bool(b) -> [(if b then "true" else "false"), ...acc]
    | #number(x) -> [numberText(x), ...acc]
    | #string(s) -> quoted(s, acc)
    | #array(elements) -> ["]", ...writtenElements(elements, ["[", ...acc])]
    | #object(members) -> ["\}", ...writtenMembers(map.toList(members), ["\{", ...acc])]
}

--| `elements` written compactly, with a `,` between each two, in front of `acc`.
def writtenElements: list(Json), list(string) -> list(string) = {
  | [], acc -> acc
  | [x], acc -> written(x, acc)
  | [x, ...rest], acc -> writtenElements(rest, [",", ...written(x, acc)])
}

--| `members` written compactly, each its key, a `:` and its value, with a `,` between each two, in
  front of `acc`.
def writtenMembers: list((string, Json)), list(string) -> list(string) = {
  | [], acc -> acc
  | [(key, x)], acc -> written(x, [":", ...quoted(key, acc)])
  | [(key, x), ...rest], acc -> writtenMembers(
    rest
    [",", ...written(x, [":", ...quoted(key, acc)])]
  )
}

--| `value` as JSON text, written compactly, with no whitespace: the array of `#number(1.0)` and
  `#string("two")` is `[1,"two"]`. A number with no fraction is written without one, as `1`, and
  NaN and infinity, which JSON has no way to write, as `null`. An object's members are written in
  its map's order. What `print` writes, [`parse`] reads back as the same value.
export def print: Json -> string = { value ->
  string.concat(list.reverse(written(value, [])))
}

--| `value` written over lines, in front of `acc`: each element and member on a line of its own,
  indented `indent` spaces further than the line its array or object starts on. `newline` is a
  line break and the indentation of the line `value` starts on.
def pretty: Json, int, string, list(string) -> list(string) = { value, indent, newline, acc ->
  match value
    | #array([]) -> ["[]", ...acc]
    | #array(elements) -> [
      "]"
      newline
      ...prettyElements(elements, indent, deeper(newline, indent), ["[", ...acc])
    ]
    | #object(members) -> (if map.isEmpty(members)
      then ["\{\}", ...acc]
      else [
        "\}"
        newline
        ...prettyMembers(map.toList(members), indent, deeper(newline, indent), ["\{", ...acc])
      ])
    | _ -> written(value, acc)
}

--| `newline` indented `indent` spaces further.
def deeper: string, int -> string = { newline, indent ->
  newline ++ string.repeat(" ", indent)
}

--| `elements` written over lines, each after `newline`, with a `,` between each two, in front of
  `acc`.
def prettyElements: list(Json), int, string, list(string) -> list(string) = {
  | [], _, _, acc -> acc
  | [x], indent, newline, acc -> pretty(x, indent, newline, [newline, ...acc])
  | [x, ...rest], indent, newline, acc -> prettyElements(
    rest
    indent
    newline
    [",", ...pretty(x, indent, newline, [newline, ...acc])]
  )
}

--| `members` written over lines, each after `newline`, its key, a `: ` and its value, with a `,`
  between each two, in front of `acc`.
def prettyMembers: list((string, Json)), int, string, list(string) -> list(string) = {
  | [], _, _, acc -> acc
  | [(key, x)], indent, newline, acc -> pretty(
    x
    indent
    newline
    [": ", ...quoted(key, [newline, ...acc])]
  )
  | [(key, x), ...rest], indent, newline, acc -> prettyMembers(
    rest
    indent
    newline
    [",", ...pretty(x, indent, newline, [": ", ...quoted(key, [newline, ...acc])])]
  )
}

--| `value` as JSON text, written to be read by people: each element of an array and member of an
  object on a line of its own, indented `indent` spaces further than the line the array or object
  starts on, with a space after each member's `:`. An empty array or object is written `[]` or
  `{}`. Numbers and strings are written as [`print`] writes them, and [`parse`] reads what it
  writes back as the same value.
export def printPretty: (Json, indent: int) -> string = { value, indent ->
  string.concat(list.reverse(pretty(value, indent, "\n", [])))
}
