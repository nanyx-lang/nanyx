--| WASI preview 1's random source and clocks, as the hosts' core roots read them.
export module preview1

import (
  nanyx/host.memory
  nanyx/host.runtime
)

@extern("wasi_snapshot_preview1", "random_get")
def randomGet: [HostRuntime] I32, I32 -> I32

@extern("wasi_snapshot_preview1", "clock_time_get")
def clockTimeGet: [HostRuntime] I32, I64, I32 -> I32

--| 64 bits from the operating system's random source, through WASI's `random_get`.
export def systemBits: [HostRuntime] () -> int = { _ ->
  def at = allocate(8)
  ignore(randomGet(at, 8))
  def bits = readI64(at)
  free(at)
  bits
}

--| The time in milliseconds on WASI's clock `clock`: 0, the time of day, or 1, the monotonic clock,
  which never goes backwards. `clock_time_get` gives nanoseconds.
export def millisecondsOn: [HostRuntime] I32 -> int = { clock ->
  def at = allocate(8)
  ignore(clockTimeGet(clock, 1_000_000, at))
  def nanoseconds = readI64(at)
  free(at)
  nanoseconds / 1_000_000
}
