--| WASI preview 1's random source and clocks, as the hosts' core roots read them.
export module preview1

import (
  nanyx/host.memory
  nanyx/host.runtime
  abi as (aligned8)
)

@extern("wasi_snapshot_preview1", "random_get")
def randomGet: [HostRuntime] I32, I32 -> I32

@extern("wasi_snapshot_preview1", "clock_time_get")
def clockTimeGet: [HostRuntime] I32, I64, I32 -> I32

--| 64 bits from the operating system's random source, through WASI's `random_get`.
export def systemBits: [HostRuntime] () -> int = { _ ->
  def at = allocate(8)
  ignore(randomGet(at, 8))
  def bits = readI64(at)
  free(at)
  bits
}

--| The time on WASI's clock `clock`, which `clock_time_get` gives in nanoseconds: 0, the time of
  day, since the start of 1970, or 1, the monotonic clock, which never goes backwards.
export def timeOn: [HostRuntime] I32 -> Time(int) = { clock ->
  -- WASI writes the time to an address that is a multiple of 8, which a block needn't start at.
  def block = allocate(16)
  def at = aligned8(block)
  ignore(clockTimeGet(clock, 1, at))
  def nanoseconds = readI64(at)
  free(block)
  nanoseconds * 1ns
}

--| The time on WASI's clock `clock` in whole milliseconds (see [`timeOn`]).
export def millisecondsOn: [HostRuntime] I32 -> int = { clock ->
  timeOn(clock) // 1ms
}
