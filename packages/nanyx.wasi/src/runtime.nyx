--| The `nanyx` runtime's own `nanyx:http`, which the hosts' core roots send requests through, since
  WASI preview 1 has no networking, and its `nanyx:async`, whose wait lets the program's other tasks run
  while a request is in flight or a task sleeps.
export module runtime

import (
  nanyx/async as (Async)
  nanyx/clock as (wholeMilliseconds)
  nanyx/host.async as (cancelled, waitOnHost)
  nanyx/host.memory
  nanyx/host.runtime
  nanyx.http/client as (HttpError)
  nanyx.http/request as (Request)
  nanyx.http/response as (Response)
  nanyx.http/wire as (readResponse, writeRequest)
  preview1 as (timeOn)
)

@extern("nanyx:http", "start")
def httpStart: [HostRuntime] I32, I32 -> I32

@extern("nanyx:http", "poll")
def httpPoll: [HostRuntime] I32, I32 -> I32

@extern("nanyx:http", "forget")
def httpForget: [HostRuntime] I32 -> ()

@extern("nanyx:http", "receive")
def httpReceive: [HostRuntime] I32 -> ()

@extern("nanyx:async", "wait")
def runtimeWait: [HostRuntime] I32 -> ()

-- A request is passed to `nanyx:http` written as `nanyx.http/wire` writes it, and its response comes
-- back written the same way. `start` starts it and gives a handle to it, and `poll` gives -1 while it is
-- in flight, and once it is answered, the answer's length, writing what kind of answer it had, a response
-- or why there is none, at the address it is given.

--| Waits until the runtime has answered the request of `handle`, while the program's other tasks run,
  and gives the answer's length, with its kind at `kind`; or -1, without waiting for the answer,
  once the task is cancelled.
def answerOf: [Async, HostRuntime] I32, I32 -> I32 = { handle, kind ->
  def length = httpPoll(handle, kind)

  if length >= 0 or cancelled() then length else
    waitOnHost(runtimeWait, -1)
    answerOf(handle, kind)
}

--| Sends `request` through `nanyx:http`, and gives its response, or why there is none. The program's
  other tasks run while it is in flight. In a cancelled task it gives `#cancelled`, and stops
  waiting for the response once the task is cancelled.
export def sendThroughRuntime
  : [Async, HostRuntime] Request -> #some(Response) | HttpError
  = { request ->
    if cancelled() then #cancelled else
      def wire = writeRequest(request)
      def handle = httpStart(addressOf(wire), byteLength(wire))
      keepAlive(wire)
      def kind = allocate(4)
      def length = answerOf(handle, kind)

      if length < 0 then
        httpForget(handle)
        free(kind)
        #cancelled
      else
        answered(kind, length)
  }

--| The answer `nanyx:http` kept, `length` bytes long, of the kind written at `kind`, which it frees.
def answered: [HostRuntime] I32, I32 -> #some(Response) | HttpError = { kind, length ->
  def buffer = allocate(length + 1)
  httpReceive(buffer)
  def answer = stringAt(buffer, length)
  free(buffer)
  def answeredKind = readI32(kind)
  free(kind)

  match answeredKind
    | 0 ->
      match readResponse(answer)
        | #some(response) -> #some(response)
        | #malformed -> #other("the runtime's answer to the request was malformed")
    | 1 -> #timeout
    | 2 -> #connectionFailed(answer)
    | 3 -> #invalidUrl
    | _ -> #other(answer)
}

--| Waits until `time` has passed on the monotonic clock, while the program's other tasks run:
  until then, it waits on the runtime for no longer than is left, in whole milliseconds, rounded
  up. In a cancelled task it returns at once, or as soon as the task is cancelled.
export def sleepOnRuntime: [Async, HostRuntime] Time(int) -> () = { time ->
  sleepUntil(timeOn(1) + time)
}

--| Waits until the monotonic clock reads `deadline`.
def sleepUntil: [Async, HostRuntime] Time(int) -> () = { deadline ->
  def left = deadline - timeOn(1)

  if left <= 0ns or cancelled() then () else
    match int.toI32(wholeMilliseconds(left))
      | #some(timeout) -> waitOnHost(runtimeWait, timeout)
      | #outOfRange -> waitOnHost(runtimeWait, 2_000_000_000)

    sleepUntil(deadline)
}
