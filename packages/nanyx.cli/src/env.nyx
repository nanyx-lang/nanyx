--| What a program is started with, and how it ends: its command-line arguments, its environment
  variables and its exit code.

  [`Env`] is a context the host provides: under the console host (`nanyx.cli.host`), whose prelude
  brings it into every module of the program, a program calls [`args`], [`variable`] and [`exit`]
  from its entry point, or from any function that declares `[Env]`. A library depends on
  `nanyx.cli` and imports `nanyx.cli/env`.
export module env

--| The process the program runs as. The host supplies the instance: the console host's reads
  what the program was started with.
export context Env = (
  --| The program's command-line arguments, after its name: `nanyx run tool.nyx a b` gives
    `["a", "b"]`.
  args: () -> list(string)
  --| The value of the environment variable `name`, or `#notSet` when it has none.
  variable: string -> #some(string) | #notSet
  --| Ends the program with the exit code `code`, without running the rest of it. It never returns,
    so its result is `undefined` and a call fits wherever a value of any type is expected.
  exit: int -> undefined
)
