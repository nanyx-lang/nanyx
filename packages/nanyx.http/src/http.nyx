--| Making HTTP requests.

  Each function requires [`Http`](client), waits for the response, and gives it, or why there was
  none as an [`HttpError`](client). Import the module as `import nanyx.http/http as http` to
  call `http.get`, `http.post` and `http.send` by those names.
export module http

import (
  nanyx/async as (Async)
  nanyx.http/client as (Http, HttpError)
  nanyx.http/request as (Request)
  nanyx.http/response as (Response)
)

--| Sends `request`, and gives its response.
export def send: [Async, Http] Request -> #some(Response) | HttpError = { request ->
  sendRequest(request)
}

--| Gets `url`, and gives the response.
export def get: [Async, Http] string -> #some(Response) | HttpError = { url ->
  sendRequest(Request.of(#get, url))
}

--| Posts `body` to `url`, and gives the response.
export def post: [Async, Http] string, string -> #some(Response) | HttpError = { url, body ->
  sendRequest(Request.of(#post, url) with body = body)
}
