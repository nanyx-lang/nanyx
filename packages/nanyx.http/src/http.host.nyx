--| The HTTP host: it serves a program whose entry point is a request handler.

  A program's `@entry` is a `Request -> Response` function, which is passed to [`run`]. Each
  request is answered by a fresh instance of the program: the runtime starts one, `run` takes the
  request from it through `nanyx:serve`, an import of the `nanyx` runtime's own, calls the handler,
  and gives the runtime the response. So nothing is shared between requests, and a request whose
  handler stops the program ends only that request, which the runtime answers with a 500.
  `nanyx run` serves the program on the port the host's `port` setting gives, 3000 by default.

  The host provides [`Http`], for requests the handler makes, written on the runtime's
  `nanyx:http`, `Async`, so that the handler can wait on them, [`Random`], which draws from the
  operating system's random source, and [`Clock`], which reads its clocks, and nothing else: no `Console` and no `FileSystem`.
export module http.host

import (
  nanyx/async as (Async)
  nanyx/clock as (Clock)
  nanyx/host.memory
  nanyx/host.runtime
  nanyx/random as (Random)
  nanyx.http.core/client as (Http, HttpError)
  nanyx.http.core/request as (Request)
  nanyx.http.core/response as (Response)
  nanyx.http.core/wire as (readRequest, readResponse, writeRequest, writeResponse)
)

@extern("nanyx:http", "send")
def httpSend: [HostRuntime] I32, I32, I32 -> I32

@extern("nanyx:http", "receive")
def httpReceive: [HostRuntime] I32 -> ()

@extern("nanyx:serve", "requestLength")
def requestLength: [HostRuntime] () -> I32

@extern("nanyx:serve", "request")
def requestInto: [HostRuntime] I32 -> ()

@extern("nanyx:serve", "respond")
def respond: [HostRuntime] I32, I32 -> ()

@extern("wasi_snapshot_preview1", "random_get")
def randomGet: [HostRuntime] I32, I32 -> I32

@extern("wasi_snapshot_preview1", "clock_time_get")
def clockTimeGet: [HostRuntime] I32, I64, I32 -> I32

-- The host keeps three things in the block the module sets aside for it (see `hostState`): at 0,
-- what kind of answer a request the handler made had; at 8, the bits `random_get` last gave; and at
-- 16, the time `clock_time_get` last gave.

--| 64 bits from the operating system's random source, through WASI's `random_get`. The console
  host does the same, for the reason `sendThroughRuntime` gives.
def systemBits: [HostRuntime] () -> int = { _ ->
  def at = I32.wrappingAdd(hostState(), 8)
  ignore(randomGet(at, 8))
  readI64(at)
}

--| The time in milliseconds on WASI's clock `clock`: 0, the time of day, or 1, the monotonic clock,
  which never goes backwards. The console host does the same, for the reason `sendThroughRuntime`
  gives.
def millisecondsOn: [HostRuntime] I32 -> int = { clock ->
  def at = I32.wrappingAdd(hostState(), 16)
  ignore(clockTimeGet(clock, 1_000_000, at))
  readI64(at) / 1_000_000
}

--| Sends `request` through `nanyx:http`, and gives its response, or why there is none. The console
  host does the same: only a host's root module may call foreign functions, so the two can't share
  it.
def sendThroughRuntime: [HostRuntime] Request -> #some(Response) | #error(HttpError) = { request ->
  def wire = writeRequest(request)
  def length = httpSend(addressOf(wire), byteLength(wire), hostState())
  keepAlive(wire)
  def buffer = allocate(length + 1)
  httpReceive(buffer)
  def answer = stringAt(buffer, length)
  free(buffer)

  match readI32(hostState())
    | 0 ->
      match readResponse(answer)
        | #some(response) -> #some(response)
        | #malformed -> #error(#other("the runtime's answer to the request was malformed"))
    | 1 -> #error(#timeout)
    | 2 -> #error(#connectionFailed(answer))
    | 3 -> #error(#invalidUrl)
    | _ -> #error(#other(answer))
}

--| The request this instance answers, from the runtime.
def incoming: [HostRuntime] () -> #some(Request) | #malformed = { _ ->
  def length = requestLength()
  def buffer = allocate(length + 1)
  requestInto(buffer)
  def text = stringAt(buffer, length)
  free(buffer)
  readRequest(text)
}

--| Gives the runtime `response`, the answer to the request.
def answer: [HostRuntime] Response -> () = { response ->
  def text = writeResponse(response)
  respond(addressOf(text), byteLength(text))
  keepAlive(text)
}

--| Answers the request this instance was started for with `handle`, the program's entry point, in
  an `Http` that makes requests through the runtime and a `Random` that draws from the operating
  system, and a `Clock` that reads its clocks. A request the runtime wrote wrongly is answered with
  a 400.
export def run
  : [HostRuntime, Async] ([Async, Clock, Http, Random] Request -> Response) -> ()
  = { handle ->
    use Http(sendRequest = { request -> sendThroughRuntime(request) })
    use Random(bits = { _ -> systemBits() })
    use Clock(now = { _ -> millisecondsOn(0) }, ticks = { _ -> millisecondsOn(1) })

    match incoming()
      | #some(request) -> answer(handle(request))
      | #malformed -> answer(Response.text(400, "Bad Request"))
  }
