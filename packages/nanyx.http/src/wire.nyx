--| How the `nanyx` runtime's own HTTP imports, `nanyx:http` and `nanyx:serve`, write requests and
  responses, for the hosts written on them. A program doesn't need it.

  A request is written as lines, each ended by `\n`: its method, its URL, its timeout in whole
  milliseconds, rounded up, how many headers it has, and each header's name and value on lines of
  their own; its body follows, as it is. A response is written the same way: its status, how many
  headers it has, each header's name and value, then its body.
export module wire

import (
  nanyx/clock as (wholeMilliseconds)
  nanyx/text
  nanyx.http/request as (Method, Request)
  nanyx.http/response as (Response)
)

--| `method`'s name, as HTTP writes it: `GET` for `#get`.
export def methodName: Method -> string = {
  | #get -> "GET"
  | #post -> "POST"
  | #put -> "PUT"
  | #delete -> "DELETE"
  | #patch -> "PATCH"
  | #head -> "HEAD"
  | #options -> "OPTIONS"
}

--| The method HTTP writes as `name`, or `#unknown`.
export def methodOf: string -> #some(Method) | #unknown = {
  | "GET" -> #some(#get)
  | "POST" -> #some(#post)
  | "PUT" -> #some(#put)
  | "DELETE" -> #some(#delete)
  | "PATCH" -> #some(#patch)
  | "HEAD" -> #some(#head)
  | "OPTIONS" -> #some(#options)
  | _ -> #unknown
}

--| `headers` written as lines: how many there are, then each one's name and value.
def headerLines: list((string, string)) -> string = { headers ->
  def lines = headers \map({ header -> "{header.0}\n{header.1}\n" })

  "{headers \length}\n{string.concat(lines)}"
}

--| The line at the start of `text`, and what follows it. The text is read where it is: only the line
  is copied, so reading a message line by line never copies its body.
def lineIn: StringSlice -> #some(string, StringSlice) | #malformed = { text ->
  match StringSlice.indexOf(text, "\n")
    | #notFound -> #malformed
    | #some(end) ->
      #some(
        StringSlice.toString(StringSlice.slice(text, 0, end))
        StringSlice.slice(text, end + 1, StringSlice.length(text))
      )
}

--| The headers written in `text`, `count` of them, after `headers` (the latest first), in order,
  with what follows them.
def headersIn
  : StringSlice,
    int,
    list((string, string))
    -> #some(list((string, string)), StringSlice) | #malformed
  = { text, count, headers ->
    if count <= 0 then #some(headers \reverse, text) else
      match lineIn(text)
        | #malformed -> #malformed
        | #some(name, rest) ->
          match lineIn(rest)
            | #malformed -> #malformed
            | #some(value, after) -> headersIn(after, count - 1, [(name, value), ...headers])
  }

--| The line at the start of `text`, as a whole number, and what follows it.
def numberLine: StringSlice -> #some(int, StringSlice) | #malformed = { text ->
  match lineIn(text)
    | #malformed -> #malformed
    | #some(line, rest) ->
      match int.fromString(line)
        | #some(number) -> #some(number, rest)
        | #invalidInt -> #malformed
}

--| The headers written at the start of `text`, with the count before them, and the body after them,
  which is the only copy made of it.
def headersAndBody: StringSlice -> #some(list((string, string)), string) | #malformed = { text ->
  match numberLine(text)
    | #malformed -> #malformed
    | #some(count, rest) ->
      match headersIn(rest, count, [])
        | #malformed -> #malformed
        | #some(headers, body) -> #some(headers, StringSlice.toString(body))
}

--| All of `text`, as a slice to read it by.
def whole: string -> StringSlice = { text ->
  string.slice(text, 0, string.length(text))
}

--| `request`, written.
export def writeRequest: Request -> string = { request ->
  "{methodName(request.method)}\n{request.url}\n{wholeMilliseconds(request.timeout)}\n{headerLines(
    request.headers
  )}{request.body}"
}

--| The request written in `text`.
export def readRequest: string -> #some(Request) | #malformed = { text ->
  match lineIn(whole(text))
    | #malformed -> #malformed
    | #some(name, rest) ->
      match (methodOf(name), lineIn(rest))
        | (#some(method), #some(url, after)) ->
          match numberLine(after)
            | #malformed -> #malformed
            | #some(timeout, more) ->
              match headersAndBody(more)
                | #malformed -> #malformed
                | #some(headers, body) ->
                  #some(
                    Request(
                      method = method
                      url = url
                      headers = headers
                      body = body
                      timeout = timeout * 1ms
                    )
                  )
        | _ -> #malformed
}

--| `response`, written.
export def writeResponse: Response -> string = { response ->
  "{response.status}\n{headerLines(response.headers)}{response.body}"
}

--| The response written in `text`.
export def readResponse: string -> #some(Response) | #malformed = { text ->
  match numberLine(whole(text))
    | #malformed -> #malformed
    | #some(status, rest) ->
      match headersAndBody(rest)
        | #malformed -> #malformed
        | #some(headers, body) -> #some(Response(status = status, headers = headers, body = body))
}
