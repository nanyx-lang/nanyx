--| What every module of a program the console host runs sees without importing it: the terminal,
  `Console`, with `print`, `println`, `eprint` and `eprintln`; the process, `Env`, with `args`,
  `variable` and `exit`; the file system, `FileSystem`, with `Path` and `FsError`; and outbound HTTP,
  `Http`, with `Request`, `Method`, `Response` and `HttpError`.
export module console.prelude

export nanyx.console.core/console (Console, IoError, print, println, eprint, eprintln)
export nanyx.console.core/env (Env)
export nanyx.fs/filesystem (FileSystem, FsError)
export nanyx.fs/path (Path)
export nanyx.http.core/client (Http, HttpError)
export nanyx.http.core/request (Request, Method)
export nanyx.http.core/response (Response)
