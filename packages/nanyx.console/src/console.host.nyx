--| The console host: it runs a command-line program's entry point.

  A program's `@entry` is passed to [`run`], which runs it in the contexts this host provides:
  [`Console`], which reads and writes the standard streams, [`Env`], [`FileSystem`], which reads
  and writes files, and [`Http`], which makes HTTP requests. The first three are written on WASI's
  functions, and `Http` on the `nanyx` runtime's own `nanyx:http`, since WASI preview 1 has no
  networking. The host declares them with `@extern` and calls them with the [`HostRuntime`] the
  toolchain provides to it, passing their buffers in memory with `nanyx/host.memory`.
export module console.host

import (
  nanyx/array
  nanyx/host.memory
  nanyx/host.runtime
  nanyx/text
  nanyx.console.core/console as (Console, IoError)
  nanyx.console.core/env as (Env)
  nanyx.fs/filesystem as (FileSystem, FsError)
  nanyx.fs/path as (Path)
  nanyx.fs/path as path
  nanyx.http.core/client as (Http, HttpError)
  nanyx.http.core/request as (Request)
  nanyx.http.core/response as (Response)
  nanyx.http.core/wire as (readResponse, writeRequest)
)

@extern("wasi_snapshot_preview1", "fd_write")
def fdWrite: [HostRuntime] I32, I32, I32, I32 -> I32

@extern("wasi_snapshot_preview1", "fd_read")
def fdRead: [HostRuntime] I32, I32, I32, I32 -> I32

@extern("wasi_snapshot_preview1", "args_sizes_get")
def argsSizesGet: [HostRuntime] I32, I32 -> I32

@extern("wasi_snapshot_preview1", "args_get")
def argsGet: [HostRuntime] I32, I32 -> I32

@extern("wasi_snapshot_preview1", "environ_sizes_get")
def environSizesGet: [HostRuntime] I32, I32 -> I32

@extern("wasi_snapshot_preview1", "environ_get")
def environGet: [HostRuntime] I32, I32 -> I32

@extern("wasi_snapshot_preview1", "proc_exit")
def procExit: [HostRuntime] I32 -> ()

-- The host keeps its state in the block the module sets aside for it (see `hostState`): at 4 and 8,
-- where what is left of the standard input it has read starts and ends in its buffer; at 12, an
-- iovec, the address and length of the bytes to write or read; at 20, the count of bytes written or
-- read; at 40, what kind of answer an HTTP request had; and from 64 to the end of the block, the buffer
-- standard input is read into.

--| The address `offset` bytes into the host's state.
def stateAt: [HostRuntime] I32 -> I32 = { offset ->
  I32.wrappingAdd(hostState(), offset)
}

--| How many bytes of standard input are read at a time: the rest of the host's block.
def bufferSize: I32 = 4032

--| Writes `text` to the file descriptor `fd`, as it is.
def writeTo: [HostRuntime] I32, string -> () = { fd, text ->
  writeI32(stateAt(12), addressOf(text))
  writeI32(stateAt(16), byteLength(text))
  ignore(fdWrite(fd, stateAt(12), 1, stateAt(20)))
  keepAlive(text)
}

--| How many bytes of standard input are left in the buffer, read into it when none are; 0 when the
  input has ended, or cannot be read.
def fill: [HostRuntime] () -> I32 = { _ ->
  def start = readI32(stateAt(4))
  def end = readI32(stateAt(8))

  if start < end then end - start else
    writeI32(stateAt(12), stateAt(64))
    writeI32(stateAt(16), bufferSize)
    def read = if fdRead(0, stateAt(12), 1, stateAt(20)) == 0 then readI32(stateAt(20)) else 0
    writeI32(stateAt(4), 0)
    writeI32(stateAt(8), read)
    read
}

--| Where the line from `index` ends in the buffer at `held`: after its first line break before
  `end`, or at `end`.
def lineEnd: [HostRuntime] I32, I32, I32 -> I32 = { held, index, end ->
  if index >= end
    then end
    else if readByte(I32.wrappingAdd(held, index)) == 10
      then index + 1
      else lineEnd(held, index + 1, end)
}

--| The standard input left in the buffer, read into it when none is, up to and including its first
  line break when `toLineBreak`; the empty string when the input has ended.
def readStdin: [HostRuntime] bool -> string = { toLineBreak ->
  def left = fill()
  def start = readI32(stateAt(4))
  def stop = if toLineBreak then lineEnd(stateAt(64), start, start + left) else start + left
  writeI32(stateAt(4), stop)
  stringAt(stateAt(I32.wrappingAdd(64, start)), stop - start)
}

--| `parts`, the latest first, joined in the order they were read.
def joined: list(string) -> string = { parts ->
  string.concat(list.reverse(parts))
}

--| The rest of the current line of standard input, after `parts`, the pieces of it read so far (the
  latest first), each of them not empty.
def readLineAfter: [HostRuntime] list(string) -> #some(string) | #error(IoError) = { parts ->
  def part = readStdin(true)

  if string.isEmpty(part)
    then (if list.isEmpty(parts) then #error(#endOfInput) else #some(joined(parts)))
    else if string.endsWith(part, "\n")
      then #some(
        string.removeSuffix(joined([string.take(part, string.length(part) - 1), ...parts]), "\r")
      )
      else readLineAfter([part, ...parts])
}

--| Everything left on standard input, after `blocks`, the blocks read so far (the latest first).
def readToEndAfter: [HostRuntime] list(string) -> string = { blocks ->
  def block = readStdin(false)
  if string.isEmpty(block) then joined(blocks) else readToEndAfter([block, ...blocks])
}

--| How many bytes the string ending in a zero byte at `address` has before it, after `count`.
def lengthFrom: [HostRuntime] I32, I32 -> I32 = { address, count ->
  if readByte(address + count) == 0 then count else lengthFrom(address, count + 1)
}

--| The first `count` of the strings ending in a zero byte that `pointers` holds the addresses of, in
  front of `acc`.
def entriesBefore: [HostRuntime] I32, I32, list(string) -> list(string) = { pointers, count, acc ->
  if count == 0 then acc else
    def address = readI32(pointers + (count - 1) * 4)
    entriesBefore(pointers, count - 1, [stringAt(address, lengthFrom(address, 0)), ...acc])
}

--| The program's arguments, its own name first, or its environment variables, each `NAME=value`:
  the list that `sizesGet` writes the count and byte length of at its two addresses, and `get` writes,
  each entry ended by a zero byte, in its second address, with their addresses at its first. The
  WASI functions are passed in rather than chosen by a tag, so a program that reads only one list
  imports only that list's functions.
def entriesOf
  : [HostRuntime] ([HostRuntime] I32, I32 -> I32), ([HostRuntime] I32, I32 -> I32) -> list(string)
  = { sizesGet, get ->
    def sizes = allocate(8)
    ignore(sizesGet(sizes, sizes + 4))
    def count = readI32(sizes)
    def pointers = allocate(count * 4 + 4)
    def buffer = allocate(readI32(sizes + 4) + 1)
    free(sizes)
    ignore(get(pointers, buffer))
    def entries = entriesBefore(pointers, count, [])
    free(pointers)
    free(buffer)
    entries
  }

--| The value in `entries`, each written `NAME=value`, of the variable whose entries start `prefix`.
def variableIn: list(string), string -> #some(string) | #notSet = {
  | [], _ -> #notSet
  | [entry, ...rest], prefix ->
    if string.startsWith(entry, prefix)
      then #some(string.skip(entry, string.length(prefix)))
      else variableIn(rest, prefix)
}

--| The program's command-line arguments, after its name.
def arguments: [HostRuntime] () -> list(string) = { _ ->
  match entriesOf({ at, bytes -> argsSizesGet(at, bytes) }, { at, buffer -> argsGet(at, buffer) })
    | [] -> []
    | [_, ...rest] -> rest
}

--| The value of the environment variable `name`, or `#notSet` when it has none.
def environmentVariable: [HostRuntime] string -> #some(string) | #notSet = { name ->
  variableIn(
    entriesOf({ at, bytes -> environSizesGet(at, bytes) }, { at, buffer -> environGet(at, buffer) })
    name ++ "="
  )
}

--| Ends the program with the exit code `code`, or 1 for a code that doesn't fit an `I32`. WASI's
  `proc_exit` never returns: the call after it only gives the function its type.
def exitProcess: [HostRuntime] int -> undefined = { code ->
  def exitCode = match int.toI32(code)
    | #some(fits) -> fits
    | #outOfRange -> 1

  procExit(exitCode)
  exitProcess(code)
}

-- The file system ---------------------------------------------------------------------------------

-- `FileSystem` is written on WASI's file functions. WASI reaches files only through the directories
-- the runtime opened for the program before it started, its preopens: each one is a descriptor, from
-- 3 up, with the name the program knows it by. `nanyx run` opens the current directory as `.` and by
-- its absolute path, and the directory `--allow-dir` names by its absolute path, each written with
-- `/`. A relative path is found in `.`, and an absolute one in the preopen whose name it starts with;
-- one in none is `#permissionDenied`, and so is a relative path that climbs out of `.`, which WASI
-- refuses.
--
-- These functions keep what they pass to WASI in the host's block, beside what `Console` keeps there:
-- at 24, the description of a preopen (its kind, then the length of its name at 28); at 32, the
-- descriptor a file is opened as; and at 36, how many bytes a directory listing filled.

@extern("wasi_snapshot_preview1", "fd_prestat_get")
def fdPrestatGet: [HostRuntime] I32, I32 -> I32

@extern("wasi_snapshot_preview1", "fd_prestat_dir_name")
def fdPrestatDirName: [HostRuntime] I32, I32, I32 -> I32

@extern("wasi_snapshot_preview1", "path_open")
def pathOpen: [HostRuntime] I32, I32, I32, I32, I32, I64, I64, I32, I32 -> I32

@extern("wasi_snapshot_preview1", "fd_close")
def fdClose: [HostRuntime] I32 -> I32

@extern("wasi_snapshot_preview1", "fd_pread")
def fdPread: [HostRuntime] I32, I32, I32, I64, I32 -> I32

@extern("wasi_snapshot_preview1", "fd_filestat_get")
def fdFilestatGet: [HostRuntime] I32, I32 -> I32

@extern("wasi_snapshot_preview1", "fd_readdir")
def fdReaddir: [HostRuntime] I32, I32, I32, I64, I32 -> I32

@extern("wasi_snapshot_preview1", "path_filestat_get")
def pathFilestatGet: [HostRuntime] I32, I32, I32, I32, I32 -> I32

@extern("wasi_snapshot_preview1", "path_unlink_file")
def pathUnlinkFile: [HostRuntime] I32, I32, I32 -> I32

@extern("wasi_snapshot_preview1", "path_create_directory")
def pathCreateDirectory: [HostRuntime] I32, I32, I32 -> I32

--| The `FsError` a WASI error number stands for.
def errorOf: I32 -> FsError = { errno ->
  if errno == 44
    then #notFound
    else if errno == 2 or errno == 63 or errno == 76
      then #permissionDenied
      else if errno == 31
        then #isDirectory
        else if errno == 54
          then #notDirectory
          else if errno == 20 then #alreadyExists else #other("WASI error {errno}")
}

--| `text`, a path, as preopens are compared: lowercase when it starts with a drive, as `C:/` does,
  since Windows doesn't tell `C:/Temp` from `c:/temp`.
def comparable: string -> string = { text ->
  if string.contains(string.take(text, 3), ":") then string.lowercase(text) else text
}

--| Where `text`, a normalised path, is in the preopen named `name`: the path relative to it, or
  `#outside`.
def within: string, string -> #some(string) | #outside = { name, text ->
  def rooted = string.startsWith(text, "/") or string.contains(string.take(text, 3), ":")

  if name == "." then (if rooted then #outside else #some(text)) else
    def base = comparable(Path.toString(path.of(name)))
    def compared = comparable(text)
    -- A root, such as `/` or `C:/`, ends in `/`; any other directory is followed by one.
    def prefix = if string.endsWith(base, "/") then base else base ++ "/"

    if not rooted
      then #outside
      else if compared == base
        then #some(".")
        else if string.startsWith(compared, prefix)
          then #some(string.skip(text, string.length(prefix)))
          else #outside
}

--| The preopen, from the descriptor `fd` up, that `text` is in, with the path relative to it.
def locatedFrom: [HostRuntime] I32, string -> #some(I32, string) | #error(FsError) = { fd, text ->
  if fdPrestatGet(fd, stateAt(24)) != 0 then #error(#permissionDenied) else
    def length = readI32(stateAt(28))
    def buffer = allocate(length)
    ignore(fdPrestatDirName(fd, buffer, length))
    def name = stringAt(buffer, length)
    free(buffer)

    match within(name, text)
      | #some(relative) -> #some(fd, relative)
      | #outside -> locatedFrom(fd + 1, text)
}

--| The preopen `at` is in, with the path relative to it.
def located: [HostRuntime] Path -> #some(I32, string) | #error(FsError) = { at ->
  locatedFrom(3, Path.toString(at))
}

--| Opens `at` with the WASI open flags `openFlags`, the rights `rights` and the descriptor flags
  `descriptorFlags`, and gives its descriptor.
def openAt
  : [HostRuntime] Path, I32, I64, I32 -> #some(I32) | #error(FsError)
  = { at, openFlags, rights, descriptorFlags ->
    match located(at)
      | #error(e) -> #error(e)
      | #some(directory, relative) ->
        def errno = pathOpen(
          directory
          1
          addressOf(relative)
          byteLength(relative)
          openFlags
          rights
          rights
          descriptorFlags
          stateAt(32)
        )

        keepAlive(relative)
        if errno == 0 then #some(readI32(stateAt(32))) else #error(errorOf(errno))
  }

--| Calls `action` with the preopen `at` is in and the path relative to it, which it passes to WASI
  as an address and a length, and gives what it gives: `#ok` for 0, and the `FsError` of any other
  WASI error number.
def atPath
  : [HostRuntime] Path, ([HostRuntime] I32, I32, I32 -> I32) -> #ok | #error(FsError)
  = { at, action ->
    match located(at)
      | #error(e) -> #error(e)
      | #some(directory, relative) ->
        def errno = action(directory, addressOf(relative), byteLength(relative))
        keepAlive(relative)
        if errno == 0 then #ok else #error(errorOf(errno))
  }

--| How many bytes of the file `fd` it reads into the `size` bytes at `buffer`, after the `done` it
  has read: until the buffer is full or the file ends.
def readInto
  : [HostRuntime] I32, I32, I32, I32 -> #some(I32) | #error(FsError)
  = { fd, buffer, size, done ->
    if done >= size then #some(done) else
      writeI32(stateAt(12), I32.wrappingAdd(buffer, done))
      writeI32(stateAt(16), size - done)
      def errno = fdRead(fd, stateAt(12), 1, stateAt(20))
      def read = readI32(stateAt(20))

      if errno != 0
        then #error(errorOf(errno))
        else if read == 0 then #some(done) else readInto(fd, buffer, size, done + read)
  }

--| The first address from `address` on that is a multiple of 8, where WASI writes a file's
  description (a filestat): a block of 72 bytes has 64 from there on.
def aligned: I32 -> I32 = { address ->
  address + (8 - address % 8) % 8
}

--| WASI's kind of file for a directory, in a file's description.
def directoryKind: I32 = 3

--| The kind and the size of the file `fd`, from its description.
def described: [HostRuntime] I32 -> #some(I32, int) | #error(FsError) = { fd ->
  def block = allocate(72)
  def stat = aligned(block)
  def errno = fdFilestatGet(fd, stat)
  def kind = readByte(stat + 16)
  def size = readI64(stat + 32)
  free(block)
  if errno == 0 then #some(kind, size) else #error(errorOf(errno))
}

--| What `contents` makes of the bytes of the file `fd`, given their address and how many there are.
def readOpen
  : [HostRuntime] I32, ([HostRuntime] I32, I32 -> a) -> #some(a) | #error(FsError)
  = { fd, contents ->
    match described(fd)
      | #error(e) -> #error(e)
      | #some(kind, size) ->
        if kind == directoryKind then #error(#isDirectory) else
          match int.toI32(size)
            | #some(fits) -> readSized(fd, fits, contents)
            | #outOfRange -> #error(#other("the file is too large to read at once"))
  }

--| What `contents` makes of the bytes of the file `fd`, `size` of them, given their address and
  how many there are.
def readSized
  : [HostRuntime] I32, I32, ([HostRuntime] I32, I32 -> a) -> #some(a) | #error(FsError)
  = { fd, size, contents ->
    def buffer = allocate(size + 1)

    def result = match readInto(fd, buffer, size, 0)
      | #some(read) -> #some(contents(buffer, read))
      | #error(e) -> #error(e)

    free(buffer)
    result
  }

--| What `contents` makes of the bytes of the file at `at`, given their address and how many there
  are.
def readWith
  : [HostRuntime] Path, ([HostRuntime] I32, I32 -> a) -> #some(a) | #error(FsError)
  = { at, contents ->
    match openAt(at, 0, 2, 0)
      | #error(e) -> #error(e)
      | #some(fd) ->
        def result = readOpen(fd, contents)
        ignore(fdClose(fd))
        result
  }

--| How many bytes of the file `fd`, from byte `offset` on, it reads into the `size` bytes at
  `buffer`, after the `done` it has read: until the buffer is full or the file ends.
def readAt
  : [HostRuntime] I32, int, I32, I32, I32 -> #some(I32) | #error(FsError)
  = { fd, offset, buffer, size, done ->
    if done >= size then #some(done) else
      writeI32(stateAt(12), I32.wrappingAdd(buffer, done))
      writeI32(stateAt(16), size - done)
      def errno = fdPread(fd, stateAt(12), 1, offset + I32.toInt(done), stateAt(20))
      def read = readI32(stateAt(20))

      if errno != 0
        then #error(errorOf(errno))
        else if read == 0 then #some(done) else readAt(fd, offset, buffer, size, done + read)
  }

--| Up to `size` bytes of the file `fd`, from byte `offset` on, as a string.
def readChunk
  : [HostRuntime] I32, int, I32 -> #some(string) | #error(FsError)
  = { fd, offset, size ->
    def buffer = allocate(size + 1)

    def result = match readAt(fd, offset, buffer, size, 0)
      | #some(read) -> #some(stringAt(buffer, read))
      | #error(e) -> #error(e)

    free(buffer)
    result
  }

--| Up to `length` bytes of the file at `at`, from byte `offset` on: the file is opened, read and
  closed again, so nothing is left open between one chunk and the next.
def chunkAt
  : [HostRuntime] Path, int, int -> #some(string) | #error(FsError)
  = { at, offset, length ->
    match int.toI32(length)
      | #outOfRange -> #error(#other("a chunk that large can't be read at once"))
      | #some(size) ->
        match openAt(at, 0, 6, 0)
          | #error(e) -> #error(e)
          | #some(fd) ->
            def result = match described(fd)
              | #error(e) -> #error(e)
              | #some(kind, _) ->
                if kind == directoryKind then #error(#isDirectory) else readChunk(fd, offset, size)

            ignore(fdClose(fd))
            result
  }

--| The bytes from `address` on, `count` of them, as an array.
def bytesAt: [HostRuntime] I32, I32 -> Array(U8) = { address, count ->
  array.init(
    I32.toInt(count)
    { index -> U8.fromInt(I32.toInt(readByte(I32.wrappingAdd(address, I32.fromInt(index))))) }
  )
}

--| Writes the `size` bytes at `buffer` to the file `fd`, after the `done` it has written.
def writeFrom
  : [HostRuntime] I32, I32, I32, I32 -> #ok | #error(FsError)
  = { fd, buffer, size, done ->
    if done >= size then #ok else
      writeI32(stateAt(12), I32.wrappingAdd(buffer, done))
      writeI32(stateAt(16), size - done)
      def errno = fdWrite(fd, stateAt(12), 1, stateAt(20))

      if errno != 0
        then #error(errorOf(errno))
        else writeFrom(fd, buffer, size, done + readI32(stateAt(20)))
  }

--| Writes `text` to the file at `at`, which it opens with the WASI open flags `openFlags` and
  descriptor flags `descriptorFlags`.
def writeWith
  : [HostRuntime] Path, string, I32, I32 -> #ok | #error(FsError)
  = { at, text, openFlags, descriptorFlags ->
    match openAt(at, openFlags, 64, descriptorFlags)
      | #error(e) -> #error(e)
      | #some(fd) ->
        def result = writeFrom(fd, addressOf(text), byteLength(text), 0)
        keepAlive(text)
        ignore(fdClose(fd))
        result
  }

--| How many bytes a directory listing is read in at a time.
def listingSize: I32 = 4096

--| The names in the directory `fd`, read into the `listingSize` bytes at `buffer` from the entry
  `cookie` on, after `names`.
def namesFrom
  : [HostRuntime] I32, I32, I64, list(string) -> #some(list(string)) | #error(FsError)
  = { fd, buffer, cookie, names ->
    def errno = fdReaddir(fd, buffer, listingSize, cookie, stateAt(36))
    if errno != 0 then #error(errorOf(errno)) else namesIn(fd, buffer, 0, cookie, names)
  }

--| The names in the entries in the listing at `buffer` from `offset` on, after `names`, then those
  read from the entry `cookie` on when the listing filled its buffer.
def namesIn
  : [HostRuntime] I32, I32, I32, I64, list(string) -> #some(list(string)) | #error(FsError)
  = { fd, buffer, offset, cookie, names ->
    def used = readI32(stateAt(36))
    def entry = I32.wrappingAdd(buffer, offset)
    def length = if offset + 24 <= used then readI32(entry + 16) else 0

    if offset + 24 > used or offset + 24 + length > used then (if used < listingSize
      then #some(names)
      else namesFrom(fd, buffer, cookie, names)) else
      def name = stringAt(entry + 24, length)
      def kept = if name == "." or name == ".." then names else [name, ...names]
      namesIn(fd, buffer, offset + 24 + length, readI64(entry), kept)
  }

--| The names of what the directory at `at` holds.
def namesAt: [HostRuntime] Path -> #some(list(string)) | #error(FsError) = { at ->
  match openAt(at, 2, 16386, 0)
    | #error(e) -> #error(e)
    | #some(fd) ->
      def buffer = allocate(listingSize)
      def names = namesFrom(fd, buffer, 0, [])
      free(buffer)
      ignore(fdClose(fd))
      names
}

--| The kind of file at `at`, from its description.
def kindAt: [HostRuntime] Path -> #some(I32) | #error(FsError) = { at ->
  def block = allocate(72)
  def stat = aligned(block)

  def found = atPath(
    at
    { directory, address, length -> pathFilestatGet(directory, 1, address, length, stat) }
  )

  def kind = readByte(stat + 16)
  free(block)

  match found
    | #ok -> #some(kind)
    | #error(e) -> #error(e)
}

--| Whether there is anything at `at` that the program may reach.
def existsAt: [HostRuntime] Path -> bool = { at ->
  match kindAt(at)
    | #some(_) -> true
    | #error(_) -> false
}

--| Deletes the file at `at`: a directory is `#isDirectory`, whatever the system says.
def deleteAt: [HostRuntime] Path -> #ok | #error(FsError) = { at ->
  match kindAt(at)
    | #error(e) -> #error(e)
    | #some(kind) ->
      if kind == directoryKind
        then #error(#isDirectory)
        else atPath(
          at
          { directory, address, length -> pathUnlinkFile(directory, address, length) }
        )
}

@extern("nanyx:http", "send")
def httpSend: [HostRuntime] I32, I32, I32 -> I32

@extern("nanyx:http", "receive")
def httpReceive: [HostRuntime] I32 -> ()

-- A request is passed to `nanyx:http` written as `nanyx.http.core/wire` writes it, and its response comes
-- back written the same way. What kind of answer `send` had, a response or why there is none, it writes
-- at 40 in the host's state.

--| Sends `request` through `nanyx:http`, and gives its response, or why there is none.
def sendThroughRuntime: [HostRuntime] Request -> #some(Response) | #error(HttpError) = { request ->
  def wire = writeRequest(request)
  def length = httpSend(addressOf(wire), byteLength(wire), stateAt(40))
  keepAlive(wire)
  def buffer = allocate(length + 1)
  httpReceive(buffer)
  def answer = stringAt(buffer, length)
  free(buffer)

  match readI32(stateAt(40))
    | 0 ->
      match readResponse(answer)
        | #some(response) -> #some(response)
        | #malformed -> #error(#other("the runtime's answer to the request was malformed"))
    | 1 -> #error(#timeout)
    | 2 -> #error(#connectionFailed(answer))
    | 3 -> #error(#invalidUrl)
    | _ -> #error(#other(answer))
}

--| Runs `entry`, the program's entry point, with a `Console` that reads and writes the standard
  streams, an `Env` that reads what the program was started with, and a `FileSystem` that reads and
  writes the directories the runtime opened for it. What `entry`
  returns is ignored.
export def run: [HostRuntime] ([Console, Env, FileSystem, Http] () -> a) -> () = { entry ->
  use Console(
    write = { text -> writeTo(1, text) }
    writeError = { text -> writeTo(2, text) }
    readLine = { _ -> readLineAfter([]) }
    readToEnd = { _ -> #some(readToEndAfter([])) }
    flush = { _ -> () }
  )

  use Env(
    args = { _ -> arguments() }
    variable = { name -> environmentVariable(name) }
    exit = { code -> exitProcess(code) }
  )

  use FileSystem(
    readFile = { at -> readWith(at, { address, count -> stringAt(address, count) }) }
    readFileBytes = { at -> readWith(at, { address, count -> bytesAt(address, count) }) }
    readFileChunk = { at, offset, length -> chunkAt(at, offset, length) }
    writeFile = { at, text -> writeWith(at, text, 9, 0) }
    appendFile = { at, text -> writeWith(at, text, 1, 1) }
    pathExists = { at -> existsAt(at) }
    deleteFile = { at -> deleteAt(at) }
    listDirectory = { at -> namesAt(at) }
    createDirectory = { at ->
      atPath(at, { directory, address, length -> pathCreateDirectory(directory, address, length) })
    }
  )

  use Http(sendRequest = { request -> sendThroughRuntime(request) })

  ignore(entry())
}
