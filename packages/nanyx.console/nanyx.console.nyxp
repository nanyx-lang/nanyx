(
  package = (
    name = "nanyx.console"
    version = "0.32.0"
    sources = ["src/**/*.nyx"]
    host = (
      root = "console.host"
      prelude = "console.prelude"
      component = (root = "console.host.wasi", world = "nanyx:console/command")
    )
  )
  dependencies = [
    (package = "nanyx.console.core", version = "0.32.0")
    (package = "nanyx.fs", version = "0.32.0")
    (package = "nanyx.http.core", version = "0.32.0")
  ]
)
