--| Listing and making directories.

  Each function requires [`FileSystem`](filesystem), and gives what went wrong as an
  [`FsError`](filesystem). Import the module as `import nanyx.fs/dir as dir` to call `dir.list` and
  `dir.create` by those names.
export module dir

import (
  nanyx/async as (Async)
  nanyx.fs/filesystem as (FileSystem, FsError)
  nanyx.fs/path as (Path)
  nanyx.fs/path as path
)

--| The paths of what the directory at `at` holds, its files and directories, each `at` joined with
  its name, sorted by name.
export def list: [Async, FileSystem] Path -> #some(list(Path)) | FsError = { at ->
  match listDirectory(at)
    | #some(names) -> #some(names \sort \map({ name -> path.join(at, name) }))
    | e -> e
}

--| Makes the directory `at`. Its parent must be there already, and `#alreadyExists` says
  something is at `at` already.
export def create: [Async, FileSystem] Path -> #ok | FsError = { at ->
  createDirectory(at)
}
