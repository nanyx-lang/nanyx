--| Reading and writing files.

  Each function requires [`FileSystem`](filesystem), and gives what went wrong as an
  [`FsError`](filesystem): reading a file that isn't there is `#notFound`, and one outside the
  directories the host gave the program is `#permissionDenied`. Import the module as
  `import nanyx.fs/file as file` to call `file.read`, `file.write` and the rest by those names.
export module file

import (
  nanyx/async as (Async)
  nanyx.fs/filesystem as (FileSystem, FsError)
  nanyx.fs/path as (Path)
)

--| The text of the file at `at`, read as UTF-8.
export def read: [Async, FileSystem] Path -> #some(string) | FsError = { at ->
  readFile(at)
}

--| The bytes of the file at `at`.
export def readBytes: [Async, FileSystem] Path -> #some(Array(U8)) | FsError = { at ->
  readFileBytes(at)
}

--| Writes `text` to the file at `at` in UTF-8, in place of what it held, and makes the file when
  there is none. Its directory must be there already.
export def write: [Async, FileSystem] Path, string -> #ok | FsError = { at, text ->
  writeFile(at, text)
}

--| Writes `text` to the end of the file at `at` in UTF-8, and makes the file when there is none.
export def append: [Async, FileSystem] Path, string -> #ok | FsError = { at, text ->
  appendFile(at, text)
}

--| Whether there is a file or a directory at `at` that the program may reach.
export def exists: [Async, FileSystem] Path -> bool = { at ->
  pathExists(at)
}

--| Deletes the file at `at`. A directory is `#isDirectory`: this deletes only files.
export def delete: [Async, FileSystem] Path -> #ok | FsError = { at ->
  deleteFile(at)
}

--| How many bytes [`lines`] reads at a time.
def chunkSize: int = 65536

--| `line` without the `\r` a Windows line break leaves at its end.
def withoutReturn: string -> string = { line ->
  string.removeSuffix(line, "\r")
}

--| The whole lines in `text`, and what follows the last line break, the start of a line not read
  to its end yet.
def piecesOf: string -> (list(string), string) = { text ->
  def pieces = string.split(text, on = "\n")

  def last = match list.last(pieces)
    | #some(piece) -> piece
    | #emptyList -> ""

  (list.dropLast(pieces), last)
}

--| What is left of a file [`lines`] reads: the lines read but not given yet, the start of a line
  read already, and the byte the next chunk starts at, or -1 at the file's end.
type Reading = (ready: list(string), carried: string, offset: int)

--| The next line of the file at `at`, and what is left of it after that.
def nextLine: [Async, FileSystem] Path, Reading -> #some(string, Reading) | #done = { at, reading ->
  match reading.ready
    | [line, ...rest] -> #some(withoutReturn(line), reading with ready = rest)
    | [] ->
      if reading.offset >= 0
        then afterChunk(at, reading, readFileChunk(at, reading.offset, chunkSize))
        else if reading.carried == ""
          then #done
          else #some(withoutReturn(reading.carried), Reading(ready = [], carried = "", offset = -1))
}

--| `error` in words, for a crash's message.
def describe: FsError -> string = {
  | #notFound -> "it is no longer there"
  | #permissionDenied -> "permission denied"
  | #isDirectory -> "it is a directory"
  | #notDirectory -> "a part of its path is not a directory"
  | #alreadyExists -> "something is already there"
  | #other(why) -> why
}

--| The next line of the file at `at` once `chunk`, read at `reading.offset`, is read: an empty
  chunk is the file's end. A read that failed stops the program, so that it is never taken for the
  end of a shorter file.
def afterChunk
  : [Async, FileSystem] Path, Reading, (#some(string) | FsError) -> #some(string, Reading) | #done
  = { at, reading, chunk ->
    match chunk
      | #some(text) ->
        if text == "" then nextLine(at, reading with offset = -1) else
          def (whole, rest) = piecesOf(reading.carried ++ text)

          nextLine(
            at
            Reading(ready = whole, carried = rest, offset = reading.offset + string.length(text))
          )
      | e -> crash("Couldn't read the rest of '{Path.toString(at)}': {describe(e)}")
  }

--| The lines of the file at `at`, read lazily, a chunk at a time: a file larger than memory is
  never held whole. Each line is without its line break, `\n` or `\r\n`, and a last line with none
  is a line too. The first chunk is read when this is called, and an [`FsError`](filesystem) tag
  says why the file can't be read; after that, the file is opened, read and closed again for each
  chunk the sequence pulls, so a sequence abandoned before its end leaves nothing open. A read that
  fails partway, because the file was deleted or cut short, say, stops the program with a crash
  naming the file and why: the sequence never ends early, so a short file and a failed read can't be
  mistaken for each other.

  ```nanyx fragment
  match file.lines(path.of("big.log"))
    | #some(lines) ->
      for lines | line -> println(line)
    | e -> println("Couldn't read the log: {e}")
  ```
export def lines
  : [Async, FileSystem] Path -> #some(([Async, FileSystem] seq(string))) | FsError
  = { at ->
    match readFileChunk(at, 0, chunkSize)
      | #some(first) ->
        def (whole, rest) = piecesOf(first)
        def offset = if first == "" then -1 else string.length(first)

        #some(
          seq.unfold(
            Reading(ready = whole, carried = rest, offset = offset)
            { reading -> nextLine(at, reading) }
          )
        )
      | e -> e
  }
