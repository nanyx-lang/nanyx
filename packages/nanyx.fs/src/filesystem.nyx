--| The file system, as a context a host provides.

  Code that reads or writes files declares `[Async, FileSystem]` and calls the functions of
  [`file`](file) and [`dir`](dir), which come from whichever `FileSystem` instance its caller
  supplies. The console host (`nanyx.console`) supplies one to the program's entry point, on WASI's
  file functions, which sees the current directory and those `nanyx run --allow-dir` adds; a host
  that doesn't provide it guarantees that nothing in the program touches the file system. A library
  depends on `nanyx.fs` and imports `nanyx.fs/filesystem`.
export module filesystem

import (
  nanyx/async as (Async)
  nanyx.fs/path as (Path)
)

--| Why a file or directory couldn't be read, written, deleted or made: there is nothing at the path;
  the program may not reach it (a path outside the directories the host gave it is this too); it
  is a directory where a file was meant, or the other way round; or there is something at the path
  already. Anything else is `#other`, with what the host said.
export type FsError =
  | #notFound
  | #permissionDenied
  | #isDirectory
  | #notDirectory
  | #alreadyExists
  | #other(string)

--| The file system, which a host supplies. Its members are the operations a host implements; code
  calls the functions of [`file`](file) and [`dir`](dir), which are written on them.
export context FileSystem = (
  --| The text of the file at `at`, read as UTF-8.
  readFile: [Async] Path -> #some(string) | #error(FsError)
  --| The bytes of the file at `at`.
  readFileBytes: [Async] Path -> #some(Array(U8)) | #error(FsError)
  --| Up to `length` bytes of the file at `at`, from byte `offset` on: fewer at its end, and none
    past it, but for an `offset` past its end, which is an error: the file is shorter than it was.
    The file is opened for each call, and closed before it returns.
  readFileChunk: [Async] (Path, int, int) -> #some(string) | #error(FsError)
  --| Writes `text` to the file at `at` in UTF-8, in place of what it held, making it when there is
    none.
  writeFile: [Async] (Path, string) -> #ok | #error(FsError)
  --| Writes `text` to the end of the file at `at` in UTF-8, making it when there is none.
  appendFile: [Async] (Path, string) -> #ok | #error(FsError)
  --| Whether there is a file or a directory at `at` that the program may reach.
  pathExists: [Async] Path -> bool
  --| Deletes the file at `at`.
  deleteFile: [Async] Path -> #ok | #error(FsError)
  --| The names of what the directory at `at` holds, in no order, without `.` and `..`.
  listDirectory: [Async] Path -> #some(list(string)) | #error(FsError)
  --| Makes the directory `at`, in a directory that is there already.
  createDirectory: [Async] Path -> #ok | #error(FsError)
)
