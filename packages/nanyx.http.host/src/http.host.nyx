--| The HTTP host: it serves a program whose entry point is a request handler.

  A program's `@entry` is a `Request -> Response` function, which is passed to [`run`]. Each
  request is answered by a fresh instance of the program: the runtime starts one, `run` takes the
  request from it through `nanyx:serve`, an import of the `nanyx` runtime's own, calls the handler,
  and gives the runtime the response. So nothing is shared between requests, and a request whose
  handler stops the program ends only that request, which the runtime answers with a 500.
  `nanyx run` serves the program on the port the host's `port` setting gives, 3000 by default.

  The host provides [`Http`], for requests the handler makes, written on the runtime's
  `nanyx:http`, `Async`, so that the handler can wait on them, [`Random`], which draws from the
  operating system's random source, and [`Clock`], which reads its clocks, and nothing else: no `Console` and no `FileSystem`.
export module http.host

import (
  nanyx/async as (Async)
  nanyx/clock as (Clock, wholeMilliseconds)
  nanyx/host.memory
  nanyx/host.runtime
  nanyx/random as (Random)
  nanyx.http/client as (Http)
  nanyx.http/request as (Request)
  nanyx.http/response as (Response)
  nanyx.http/wire as (readRequest, writeResponse)
  nanyx.wasi/preview1 as (timeOn, systemBits)
  nanyx.wasi/runtime as (sendThroughRuntime, sleepOnRuntime)
)

@extern("nanyx:serve", "requestLength")
def requestLength: [HostRuntime] () -> I32

@extern("nanyx:serve", "request")
def requestInto: [HostRuntime] I32 -> ()

@extern("nanyx:serve", "respond")
def respond: [HostRuntime] I32, I32 -> ()

--| The request this instance answers, from the runtime.
def incoming: [HostRuntime] () -> #some(Request) | #malformed = { _ ->
  def length = requestLength()
  def buffer = allocate(length + 1)
  requestInto(buffer)
  def text = stringAt(buffer, length)
  free(buffer)
  readRequest(text)
}

--| Gives the runtime `response`, the answer to the request.
def answer: [HostRuntime] Response -> () = { response ->
  def text = writeResponse(response)
  respond(addressOf(text), byteLength(text))
  keepAlive(text)
}

--| Answers the request this instance was started for with `handle`, the program's entry point, in
  an `Http` that makes requests through the runtime and a `Random` that draws from the operating
  system, and a `Clock` that reads its clocks. A request the runtime wrote wrongly is answered with
  a 400.
export def run
  : [HostRuntime, Async] ([Async, Clock, Http, Random] Request -> Response) -> ()
  = { handle ->
    use Http(sendRequest = { request -> sendThroughRuntime(request) })
    use Random(bits = { _ -> systemBits() })

    use Clock(
      now = { _ -> Instant.epoch \plus(timeOn(0)) }
      ticks = { _ -> timeOn(1) }
      sleep = { time -> sleepOnRuntime(wholeMilliseconds(time)) }
    )

    match incoming()
      | #some(request) -> answer(handle(request))
      | #malformed -> answer(Response.text(400, "Bad Request"))
  }
