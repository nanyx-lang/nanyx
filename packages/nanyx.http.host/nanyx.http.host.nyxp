(
  package = (
    name = "nanyx.http.host"
    version = "0.52.1"
    repository = "nanyx-lang/nanyx"
    nanyx = "=0.52.1"
    sources = ["src/**/*.nyx"]
    host = (
      root = "http.host"
      prelude = "http.prelude"
      settings = (port = 3000)
      component = (root = "http.host.wasi", world = "wasi:http/service@0.3.0")
    )
  )
  dependencies = [
    (package = "nanyx.http", version = "0.52.1")
    (package = "nanyx.wasi", version = "0.52.1")
  ]
)
