<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProgramStack.fs" />
    <Compile Include="AsyncImport.fs" />
    <Compile Include="HttpImport.fs" />
    <Compile Include="SpanTable.fs" />
    <Compile Include="TestTable.fs" />
    <Compile Include="Probing.fs" />
    <Compile Include="CrashImport.fs" />
    <Compile Include="Profiling.fs" />
    <Compile Include="Runner.fs" />
    <Compile Include="Serving.fs" />
    <Compile Include="Testing.fs" />
    <Compile Include="Linting.fs" />
    <Compile Include="Componentizer.fs" />
  </ItemGroup>

  <!--
    The componentizer (Componentizer.fs) is wit-component compiled to WebAssembly from the Rust crate in
    ../Nanyx.Componentizer, for wasm32-wasip1. The built .wasm is committed beside the crate and embedded in this
    assembly, so building the compiler doesn't need Rust. After changing the crate, rebuild it with
    `dotnet build -p:BuildComponentizer=true` (which needs Rust, with `rustup target add wasm32-wasip1`) and run
    `.github/scripts/componentizer-sources.sh` with its write flag; the Compiler workflow fails when the committed .wasm is older than
    the crate's sources.
  -->
  <PropertyGroup>
    <ComponentizerDirectory>$(MSBuildThisFileDirectory)../Nanyx.Componentizer/</ComponentizerDirectory>
    <ComponentizerWasm>$(ComponentizerDirectory)nanyx-componentizer.wasm</ComponentizerWasm>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ComponentizerWasm)" LogicalName="nanyx-componentizer.wasm" />
  </ItemGroup>

  <Target Name="BuildComponentizer" BeforeTargets="PrepareForBuild" Condition="'$(BuildComponentizer)' == 'true'">
    <Exec Command="cargo build --release --locked --target wasm32-wasip1" WorkingDirectory="$(ComponentizerDirectory)" />
    <Copy SourceFiles="$(ComponentizerDirectory)target/wasm32-wasip1/release/nanyx-componentizer.wasm" DestinationFiles="$(ComponentizerWasm)" />
  </Target>

  <ItemGroup>
    <!-- Embeds the Wasmtime engine; the package ships the native library for every platform the CLI is published for. -->
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- For `Nanyx.LargeStack`, which runs a program on a thread with a stack of its own (see `ProgramStack`). -->
    <ProjectReference Include="..\Nanyx.Parser\Nanyx.Parser.fsproj" />
  </ItemGroup>

</Project>
