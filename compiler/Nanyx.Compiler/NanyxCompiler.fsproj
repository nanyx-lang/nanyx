  </ItemGroup>

  <ItemGroup>
    <!--
      The standard library (the `nanyx` package) is Nanyx source in stdlib/nanyx at the repository root.
      It is embedded here so the published single-file `nanyx` binary carries it: one resource per
      file, named "nanyx/<file>.nyx". A module is in the file named for it, and may have more files, each
      starting `@partial module <module>` (see StandardLibrary in Builtins.fs).
    -->
    <EmbeddedResource Include="..\..\stdlib\nanyx\*.nyx" LogicalName="nanyx/%(Filename)%(Extension)" />
    <!--
      The packages the compiler ships (the console host) are source directories in packages/ at the repository root.
      They are copied beside the compiler, in every project that uses it and in the published `nanyx`, which finds them
      there (see ShippedPackages.fs).
    -->
    <None Include="..\..\packages\**\*" Link="packages\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests of the checked library read it as the compiler does (see CheckedLibrary.fs). -->
    <InternalsVisibleTo Include="Nanyx.Compiler.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nanyx.Parser\Nanyx.Parser.fsproj" />
    <ProjectReference Include="..\Nanyx.Formatter\Nanyx.Formatter.fsproj" />
  </ItemGroup>

</Project>
