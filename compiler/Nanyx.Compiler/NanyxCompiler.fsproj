<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>0025</WarningsAsErrors>
    <!--
      Unification (Unifier.fs) recurses once per constraint in tail position, so it needs tail calls to
      check a module of any size. Release builds emit them anyway; this keeps Debug builds, and so local
      test runs, from overflowing the stack where Release would not.
    -->
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Diagnostics.fs" />
    <Compile Include="NameSuggestions.fs" />
    <Compile Include="TypedAst.fs" />
    <Compile Include="SizedIntegers.fs" />
    <Compile Include="RecursiveAliases.fs" />
    <Compile Include="TypeEnv.fs" />
    <Compile Include="Constraints.fs" />
    <Compile Include="FunctionContexts.fs" />
    <Compile Include="Unifier.fs" />
    <Compile Include="Lists.fs" />
    <Compile Include="Maps.fs" />
    <Compile Include="Sets.fs" />
    <Compile Include="InferState.fs" />
    <Compile Include="ContextFixes.fs" />
    <Compile Include="WrittenContexts.fs" />
    <Compile Include="ContextVariables.fs" />
    <Compile Include="LambdaContexts.fs" />
    <Compile Include="BranchJoin.fs" />
    <Compile Include="BlockResult.fs" />
    <Compile Include="Visibility.fs" />
    <Compile Include="TypeResolution.fs" />
    <Compile Include="PatternSpace.fs" />
    <Compile Include="Except.fs" />
    <Compile Include="TypeHoles.fs" />
    <Compile Include="ArmUnion.fs" />
    <Compile Include="ScrutineeRests.fs" />
    <Compile Include="InterpolationHoles.fs" />
    <Compile Include="WellKnownContexts.fs" />
    <Compile Include="EqualityOperators.fs" />
    <Compile Include="OrderingOperators.fs" />
    <Compile Include="AttachedOperators.fs" />
    <Compile Include="OperatorContexts.fs" />
    <Compile Include="NumericLiterals.fs" />
    <Compile Include="ArithmeticOperators.fs" />
    <Compile Include="AppendOperator.fs" />
    <Compile Include="CompositionOperators.fs" />
    <Compile Include="CoalesceOperator.fs" />
    <Compile Include="ContextShapes.fs" />
    <Compile Include="ContextInference.fs" />
    <Compile Include="ArithmeticInference.fs" />
    <Compile Include="InlineContexts.fs" />
    <Compile Include="StructuralInstances.fs" />
    <Compile Include="OperatorCalls.fs" />
    <Compile Include="NamedArguments.fs" />
    <Compile Include="LambdaArguments.fs" />
    <Compile Include="UseDischarge.fs" />
    <Compile Include="DuplicateDefinitions.fs" />
    <Compile Include="SyntaxTree.fs" />
    <Compile Include="LocalRecursion.fs" />
    <Compile Include="MatchArmFixes.fs" />
    <Compile Include="MatchExhaustiveness.fs" />
    <Compile Include="DefinitionOrder.fs" />
    <Compile Include="InitialisationCycles.fs" />
    <Compile Include="MemoryCells.fs" />
    <Compile Include="ScopedCalls.fs" />
    <Compile Include="Loops.fs" />
    <Compile Include="RecordSpread.fs" />
    <Compile Include="PipeLookups.fs" />
    <Compile Include="Contexts.fs" />
    <Compile Include="ContextInstances.fs" />
    <Compile Include="WorkflowRests.fs" />
    <Compile Include="DefAnnotations.fs" />
    <Compile Include="Infer.fs" />
    <Compile Include="InferModule.fs" />
    <Compile Include="RequiredContexts.fs" />
    <Compile Include="Builtins.fs" />
    <Compile Include="Attributes.fs" />
    <Compile Include="TailPosition.fs" />
    <Compile Include="Signatures.fs" />
    <Compile Include="Linters.fs" />
    <Compile Include="ImportFixes.fs" />
    <Compile Include="ExpressionRewrites.fs" />
    <Compile Include="BuiltinTypeNames.fs" />
    <Compile Include="TypeNames.fs" />
    <Compile Include="FileImports.fs" />
    <Compile Include="PackageModules.fs" />
    <Compile Include="PartialModules.fs" />
    <Compile Include="WorkflowDesugaring.fs" />
    <Compile Include="DeferredErrors.fs" />
    <Compile Include="CheckedModule.fs" />
    <Compile Include="CompileListener.fs" />
    <Compile Include="ModuleLinking.fs" />
    <Compile Include="Library.fs" />
    <Compile Include="Package.fs" />
    <Compile Include="NewPackage.fs" />
    <Compile Include="Script.fs" />
    <Compile Include="Hover.fs" />
    <Compile Include="Definition.fs" />
    <Compile Include="TypeHints.fs" />
    <Compile Include="Completion.fs" />
    <Compile Include="InfoView.fs" />
    <Compile Include="ContextFlow.fs" />
    <Compile Include="Outline.fs" />
    <Compile Include="Documentation.fs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The standard library (the `nanyx` package) is Nanyx source in stdlib/nanyx at the repository root.
      It is embedded here so the published single-file `nanyx` binary carries it: one resource per
      file, named "nanyx/<file>.nyx". A module is in the file named for it, and may have more files, each
      starting `@partial module <module>` (see StandardLibrary in Builtins.fs).
    -->
    <EmbeddedResource Include="..\..\stdlib\nanyx\*.nyx" LogicalName="nanyx/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nanyx.Parser\Nanyx.Parser.fsproj" />
  </ItemGroup>

</Project>
