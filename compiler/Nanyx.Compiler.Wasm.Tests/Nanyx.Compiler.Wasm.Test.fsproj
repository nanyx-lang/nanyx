<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>0025</WarningsAsErrors>
    <!-- CI runs these tests in a job of their own, and passes this to leave them out of the solution's test run. -->
    <IsTestProject Condition="'$(SkipWasmTests)' == 'true'">false</IsTestProject>
    <!--
      The tests run programs that trap in this process. As for the CLI, the shadow stack would turn Wasmtime's recovery
      from a trap into a fail-fast (bytecodealliance/wasmtime-dotnet#374), so the test host is kept off it.
    -->
    <CetCompat>false</CetCompat>
    <!-- The tests compile in this process, on as many threads as there are processors, and each compile allocates a
         great deal, so under the workstation collector they wait on one another's collections (#1461, as #706 for the
         compiler's tests). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Timing, shared by the test projects that time anything (see TestTiming.fs). -->
    <Compile Include="..\TestTiming.fs" Link="TestTiming.fs" />
