<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="Features\Core\FunctionAndLocalsTests.fs" />
    <Compile Include="Features\Core\AllocatorTests.fs" />
    <Compile Include="Features\Core\CoreIrTests.fs" />
    <Compile Include="Features\ControlFlow\ControlFlowFixtureTests.fs" />
    <Compile Include="Features\Console\RunConsoleTests.fs" />
    <Compile Include="Features\Contexts\RunContextTests.fs" />
    <Compile Include="Features\Dbg\RunDbgTests.fs" />
    <Compile Include="Features\Equality\RunEqualityTests.fs" />
    <Compile Include="Features\Errors\RunErrorTests.fs" />
    <Compile Include="Features\Except\RunExceptTests.fs" />
    <Compile Include="Features\Functions\RunFunctionTests.fs" />
    <Compile Include="Features\Lists\RunListTests.fs" />
    <Compile Include="Features\Loops\RunLoopTests.fs" />
    <Compile Include="Features\Matching\RunMatchingTests.fs" />
    <Compile Include="Features\Matching\RunAndPatternTests.fs" />
    <Compile Include="Features\Memory\DropFunctionTests.fs" />
    <Compile Include="Features\Memory\ReferenceCountingTests.fs" />
    <Compile Include="Features\Memory\ExampleMemoryTests.fs" />
    <Compile Include="Features\Memory\ReuseTests.fs" />
    <Compile Include="Features\Operators\RunOperatorTests.fs" />
    <Compile Include="Features\Packages\PackageCommandTests.fs" />
    <Compile Include="Features\Records\RunRecordTests.fs" />
    <Compile Include="Features\StdLib\RunStdLibTests.fs" />
    <Compile Include="Features\Strings\RunStringTests.fs" />
    <Compile Include="Features\Tags\RunTagTests.fs" />
    <Compile Include="Features\TailCalls\RunTailCallTests.fs" />
    <Compile Include="Features\Workflows\RunWorkflowTests.fs" />
    <Compile Include="E2E\E2ETests.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="E2E\**\*.nyx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="E2E\**\*.wat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FsUnit.xUnit" Version="7.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The execution tests (Features/*/Run*Tests.fs) run the built CLI (nanyx.dll) as a child process. -->
    <ProjectReference Include="..\Nanyx.Compiler.Cli\NanyxCompiler.Cli.csproj" />
    <ProjectReference Include="..\Nanyx.Compiler.Wasm\Nanyx.Compiler.Wasm.fsproj" />
    <ProjectReference Include="..\Nanyx.Parser\Nanyx.Parser.fsproj" />
  </ItemGroup>

</Project>
