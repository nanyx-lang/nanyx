<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>0025</WarningsAsErrors>
    <!-- CI runs these tests in a job of their own, and passes this to leave them out of the solution's test run. -->
    <IsTestProject Condition="'$(SkipWasmTests)' == 'true'">false</IsTestProject>
    <!--
      The tests run programs that trap in this process. As for the CLI, the shadow stack would turn Wasmtime's recovery
      from a trap into a fail-fast (bytecodealliance/wasmtime-dotnet#374), so the test host is kept off it.
    -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="Features\Core\FunctionAndLocalsTests.fs" />
    <Compile Include="Features\Core\AllocatorTests.fs" />
    <Compile Include="Features\Core\CoreIrTests.fs" />
    <Compile Include="Features\Core\RunLexicalTests.fs" />
    <Compile Include="Features\ControlFlow\BoolMatchTests.fs" />
    <Compile Include="Features\ControlFlow\BottomTypeTests.fs" />
    <Compile Include="Features\ControlFlow\ControlFlowFixtureTests.fs" />
    <Compile Include="Features\ControlFlow\DoBlockTests.fs" />
    <Compile Include="Features\Commands\CheckCommandTests.fs" />
    <Compile Include="Features\Console\RunConsoleTests.fs" />
    <Compile Include="Features\Contexts\RunContextTests.fs" />
    <Compile Include="Features\Contexts\RunContextFunctionValueTests.fs" />
    <Compile Include="Features\Contexts\RunCallSiteContextTests.fs" />
    <Compile Include="Features\Contexts\RunOperatorContextTests.fs" />
    <Compile Include="Features\Contexts\RunStructuralInstanceTests.fs" />
    <Compile Include="Features\Contexts\RunContextKeyTests.fs" />
    <Compile Include="Features\Dbg\RunDbgTests.fs" />
    <Compile Include="Features\Equality\RunEqualityTests.fs" />
    <Compile Include="Features\Errors\RunErrorTests.fs" />
    <Compile Include="Features\Examples\RunExampleTests.fs" />
    <Compile Include="Features\Except\RunExceptTests.fs" />
    <Compile Include="Features\Floats\RunFloatTextTests.fs" />
    <Compile Include="Features\Functions\RunDefinitionOrderTests.fs" />
    <Compile Include="Features\Functions\RunFunctionTests.fs" />
    <Compile Include="Features\Functions\RunTupleArgumentTests.fs" />
    <Compile Include="Features\Hashing\RunHashTests.fs" />
    <Compile Include="Features\Lists\RunListTests.fs" />
    <Compile Include="Features\Maps\RunMapTests.fs" />
    <Compile Include="Features\Maps\RunMapEqualityTests.fs" />
    <Compile Include="Features\Loops\RunLoopTests.fs" />
    <Compile Include="Features\Matching\RunMatchingTests.fs" />
    <Compile Include="Features\Matching\RunAndPatternTests.fs" />
    <Compile Include="Features\Matching\RunListPatternTests.fs" />
    <Compile Include="Features\Matching\RunNestedTagPatternTests.fs" />
    <Compile Include="Features\Matching\RunRecordPatternTests.fs" />
    <Compile Include="Features\Memory\DropFunctionTests.fs" />
    <Compile Include="Features\Memory\ReferenceCountingTests.fs" />
    <Compile Include="Features\Memory\ExampleMemoryTests.fs" />
    <Compile Include="Features\Memory\MemoryCheckTests.fs" />
    <Compile Include="Features\Memory\ReuseTests.fs" />
    <Compile Include="Features\Memory\MemoryDeclarationTests.fs" />
    <Compile Include="Features\Memory\CellTests.fs" />
    <Compile Include="Features\Names\RunNameTests.fs" />
    <Compile Include="Features\Nominals\RunNominalTests.fs" />
    <Compile Include="Features\Numbers\RunIntTests.fs" />
    <Compile Include="Features\Numbers\RunSizedIntegerTests.fs" />
    <Compile Include="Features\Operators\RunOperatorTests.fs" />
    <Compile Include="Features\Operators\RunComparisonLiteralTests.fs" />
    <Compile Include="Features\Ordering\RunOrderingTests.fs" />
    <Compile Include="Features\Packages\PackageCommandTests.fs" />
    <Compile Include="Features\Records\RunRecordTests.fs" />
    <Compile Include="Features\Sets\RunSetTests.fs" />
    <Compile Include="Features\StdLib\RunIgnoreTests.fs" />
    <Compile Include="Features\StdLib\RunOptionResultTests.fs" />
    <Compile Include="Features\StdLib\RunStdLibTests.fs" />
    <Compile Include="Features\StdLib\RunStackSafeTests.fs" />
    <Compile Include="Features\StdLib\RunMathExpTests.fs" />
    <Compile Include="Features\Strings\RunStringTests.fs" />
    <Compile Include="Features\Strings\RunInterpolationTests.fs" />
    <Compile Include="Features\Tags\RunTagTests.fs" />
    <Compile Include="Features\Tags\RunRecursiveAliasTests.fs" />
    <Compile Include="Features\TailCalls\RunTailCallTests.fs" />
    <Compile Include="Features\Workflows\RunWorkflowTests.fs" />
    <Compile Include="E2E\E2ETests.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="E2E\**\*.nyx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="E2E\**\*.wat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FsUnit.xUnit" Version="7.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The execution tests (Features/*/Run*Tests.fs) run programs in this process through the CLI's own `run` code; the
      tests of the CLI itself run the built nanyx.dll as a child process.
    -->
    <ProjectReference Include="..\Nanyx.Compiler.Cli\NanyxCompiler.Cli.csproj" />
    <ProjectReference Include="..\Nanyx.Compiler.Wasm\Nanyx.Compiler.Wasm.fsproj" />
    <ProjectReference Include="..\Nanyx.Parser\Nanyx.Parser.fsproj" />
  </ItemGroup>

</Project>
