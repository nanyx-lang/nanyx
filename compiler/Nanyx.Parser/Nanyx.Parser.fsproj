<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Tailcalls>false</Tailcalls>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LargeStack.fs" />
    <Compile Include="Ast.fs" />
    <Compile Include="IsSyntax.fs" />
    <Compile Include="TestRootSyntax.fs" />
    <Compile Include="Keywords.fs" />
    <Compile Include="LineTable.fs" />
    <Compile Include="Operators.fs" />
    <Compile Include="StringEscapes.fs" />
    <Compile Include="ParseState.fs" />
    <Compile Include="ImplicitNames.fs" />
    <Compile Include="ModuleBlocks.fs" />
    <Compile Include="SourceTrivia.fs" />
    <Compile Include="Destructuring.fs" />
    <Compile Include="Directives.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="DescentCursor.fs" />
    <Compile Include="DescentTypes.fs" />
    <Compile Include="DescentLiterals.fs" />
    <Compile Include="DescentPatterns.fs" />
    <Compile Include="DescentExpressions.fs" />
    <Compile Include="DescentBlocks.fs" />
    <Compile Include="DescentControl.fs" />
    <Compile Include="DescentTopLevel.fs" />
    <Compile Include="DocComments.fs" />
    <Compile Include="Confusables.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="DataValues.fs" />
  </ItemGroup>

</Project>
