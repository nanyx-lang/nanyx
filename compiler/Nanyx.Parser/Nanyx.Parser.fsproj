<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LargeStack.fs" />
    <Compile Include="Ast.fs" />
    <Compile Include="LineTable.fs" />
    <Compile Include="Operators.fs" />
    <Compile Include="StringEscapes.fs" />
    <Compile Include="ParseState.fs" />
    <Compile Include="Lexical.fs" />
    <Compile Include="Refs.fs" />
    <Compile Include="Patterns.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="ModuleBlocks.fs" />
    <Compile Include="Mutation.fs" />
    <Compile Include="OperatorTables.fs" />
    <Compile Include="SourceTrivia.fs" />
    <Compile Include="Destructuring.fs" />
    <Compile Include="Directives.fs" />
    <Compile Include="Expressions.fs" />
    <Compile Include="TopLevel.fs" />
    <Compile Include="DocComments.fs" />
    <Compile Include="Api.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

</Project>
