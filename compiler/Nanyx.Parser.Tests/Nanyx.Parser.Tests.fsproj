    <Compile Include="Features\Corpus\DescentBlockTests.fs" />
    <Compile Include="Features\Corpus\DescentControlTests.fs" />
    <Compile Include="Features\Corpus\DescentTopLevelTests.fs" />
    <Compile Include="Features\Corpus\FailedReadingTests.fs" />
    <Compile Include="Features\CustomPatterns\CustomPatternTests.fs" />
