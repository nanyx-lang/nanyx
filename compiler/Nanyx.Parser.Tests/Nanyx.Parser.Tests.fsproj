    <Compile Include="Features\Except\ExceptTests.fs" />
    <Compile Include="Features\FieldAccess\FieldAccessTests.fs" />
    <Compile Include="Features\Functions\FunctionCallTests.fs" />
    <Compile Include="Features\Functions\CallResultTests.fs" />
    <Compile Include="Features\Functions\TrailingLambdaTests.fs" />
    <Compile Include="Features\If\IfTests.fs" />
    <Compile Include="Features\Is\IsTests.fs" />
    <Compile Include="Features\Imports\ImportTests.fs" />
    <Compile Include="Features\Integration\IntegrationTests.fs" />
    <Compile Include="Features\Keywords\GrammarKeywordTests.fs" />
    <Compile Include="Features\Lambdas\LambdaTests.fs" />
    <Compile Include="Features\Layout\LayoutTests.fs" />
    <Compile Include="Features\Lexer\LexerTests.fs" />
    <Compile Include="Features\Literals\LiteralsTests.fs" />
    <Compile Include="Features\Literals\StringEscapeTests.fs" />
    <Compile Include="Features\Loops\WhileLoopTests.fs" />
    <Compile Include="Features\Loops\LoopBodyTests.fs" />
    <Compile Include="Features\Loops\ForLoopArmTests.fs" />
