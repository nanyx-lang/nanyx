    <Compile Include="Features\Matches\AndPatternTests.fs" />
    <Compile Include="Features\Matches\RecordPatternTests.fs" />
    <Compile Include="Features\Misc\MiscTests.fs" />
    <Compile Include="Features\Modules\ModuleBlockTests.fs" />
    <Compile Include="Features\Multiline\MultilineTests.fs" />
    <Compile Include="Features\Names\BacktickedNameTests.fs" />
    <Compile Include="Features\Operators\OperatorTests.fs" />
    <Compile Include="Features\Operators\FloorDivisionTests.fs" />
    <Compile Include="Features\Operators\OperatorNameTests.fs" />
    <Compile Include="Features\Operators\CoalesceTests.fs" />
    <Compile Include="Features\Operators\OperatorSpacingTests.fs" />
    <Compile Include="Features\Phases\PhaseTests.fs" />
