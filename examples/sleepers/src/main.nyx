module main

--| Sleeps for `time`, then says so.
def wakeAfter: [Async, Clock, Console] string, Time(int) -> () = { name, time ->
  sleep(time)
  println("{name} wakes")
}

@entry
def main = {
  def slow = start! wakeAfter("the slow sleeper", 300ms)
  def quick = start! wakeAfter("the quick sleeper", 50ms)
  println("both are asleep")
  await(slow)
  await(quick)
  println("both are awake")
}
