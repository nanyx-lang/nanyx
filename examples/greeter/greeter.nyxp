-- A package: `nanyx run` in this directory runs its @entry, and `nanyx build` checks every source file and writes
-- the program to out/greeter.wat.
(
  package = (name = "greeter", version = "0.1.0", sources = ["src/**/*.nyx"])
  -- The official linter runs only in packages that turn it on. Each rule can be set to #error, #warning, #info,
  -- #hint or #off; leave out its settings to keep every rule at its default.
  linters = [
    (package = "nanyx.lint", version = "0.49.1", settings = (rules = (unusedBindings = #error)))
  ]
  host = (package = "nanyx.cli.host", version = "0.49.1")
  formatter = (lineWidth = 100)
)
