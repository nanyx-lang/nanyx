module whisper.decode

import (
  nanyx/math as math
  nanyx/random as random
)

---
The decoding loop of a speech-recognition model, reduced to its shape: an
options record, option validation with a multi-branch `if`, a greedy decoder
as a pure step function, logit filters as plain functions, and the sampling
loop as a recursive function over immutable state.
---

type Tokens = list(int)
type Logits = list(float) -- one score per vocabulary token
type AudioFeatures = list(list(float))

export type DecodingOptions = (
  task: #transcribe | #translate
  language: #some(string) | #none -- detected when absent
  temperature: float
  sampleLen: #some(int) | #none -- maximum number of tokens to sample
  bestOf: #some(int) | #none -- independent sample trajectories, if temperature > 0
  beamSize: #some(int) | #none -- beams in beam search, if temperature == 0
  patience: #some(float) | #none -- patience in beam search
  lengthPenalty: #some(float) | #none -- "alpha" in Google NMT; length normalisation when absent
  suppressBlank: bool
  withoutTimestamps: bool
)

export def defaultOptions = DecodingOptions(
  task = #transcribe
  language = #none
  temperature = 0.0
  sampleLen = #none
  bestOf = #none
  beamSize = #none
  patience = #none
  lengthPenalty = #none
  suppressBlank = true
  withoutTimestamps = false
)

export type OptionsError =
  | #beamSizeAndBestOf
  | #bestOfWithGreedySampling
  | #patienceWithoutBeamSize
  | #lengthPenaltyOutOfRange

export def verifyOptions: DecodingOptions -> #some(DecodingOptions) | OptionsError = { options ->
  if
    | options.beamSize != #none and options.bestOf != #none -> #beamSizeAndBestOf
    | options.temperature == 0.0 and options.bestOf != #none -> #bestOfWithGreedySampling
    | options.patience != #none and options.beamSize == #none -> #patienceWithoutBeamSize
    | not (options.lengthPenalty \mapSomeOr(true) { p -> p >= 0.0 and p <= 1.0 }) ->
      #lengthPenaltyOutOfRange
    | else -> #some(options)
}

-- The tokenizer and the model are dependencies, so they are contexts
context Tokenizer = (
  eot: int -- end-of-transcript token
  sotSequence: Tokens -- start-of-transcript tokens
  encode: string -> Tokens
  decode: Tokens -> string
)

context Model = (
  -- The next-token scores for every sequence in the batch
  logits: (list(Tokens), AudioFeatures) -> list(Logits)
)

def argmax: list(float) -> int = { xs ->
  def #some(top) = xs \max except #emptyList -> #some(0.0)
  def #some(index) = xs \indexOf(top) except #notFound -> #some(0)
  index
}

def softmax: list(float) -> list(float) = { xs ->
  def exps = xs \map(math.exp)
  def total = exps \sum
  exps \map { / total }
}

-- Pick an index with probability proportional to its weight
def sample: [Random] list(float) -> int = { probabilities ->
  def r = random.fraction()

  rec pick = {
    | [], i, _ -> i - 1
    | [p, ...rest], i, acc -> if acc + p >= r then i else pick(rest, i + 1, acc + p)
  }

  pick(probabilities, 0, 0.0)
}

-- A decoder chooses the next token for a sequence from its logits
type Decoder = (next: [Random] (Tokens, Logits) -> int)

-- Greedy decoding takes the most likely token, or samples when there is a temperature
def greedyDecoder: [Random] float -> Decoder = { temperature ->
  Decoder(
    next = { _, logits ->
      if temperature == 0.0
        then argmax(logits)
        else sample(logits \map { l -> l / temperature } \softmax)
    }
  )
}

-- A logit filter adjusts the scores before a token is chosen
type LogitFilter = (Tokens, Logits) -> Logits

-- Forbid a blank output right at the start of the transcript
def suppressBlank: [Tokenizer] int -> LogitFilter = { sampleBegin ->
  def blank = encode(" ")
  def end = eot

  { tokens, logits ->
    if tokens.length == sampleBegin then
      logits \mapIndexed { i, l -> if blank \contains(i) or i == end then -math.infinity else l }
    else logits
  }
}

-- Extend every sequence by one token until all have ended or the limit is reached
def mainLoop
  : [Model, Tokenizer, Random]
    (list(Tokens), AudioFeatures, Decoder, list(LogitFilter), sampleLen: int) -> list(Tokens)
  = { initial, audio, decoder, filters, sampleLen ->
    rec step = { sequences, i ->
      def completed = sequences \list.all { s -> s \list.last == #some(eot) }

      if completed or i >= sampleLen then sequences else
        def extended = sequences \list.zip(logits(sequences, audio)) \map { (tokens, raw) ->
          def filtered = filters \fold(raw) { l, filter -> filter(tokens, l) }
          [...tokens, decoder.next(tokens, filtered)]
        }

        step(extended, i + 1)
    }

    step(initial, 0)
  }

export def transcribe
  : [Model, Tokenizer, Random] AudioFeatures, DecodingOptions -> #some(string) | OptionsError
  = { audio, options ->
    proc {
      def options = try verifyOptions(options)
      def #some(sampleLen) = options.sampleLen except #none -> #some(448)
      def decoder = greedyDecoder(options.temperature)
      def filters = if options.suppressBlank then [suppressBlank(sotSequence.length)] else []

      def #some(tokens) = mainLoop(
        [sotSequence]
        audio
        decoder
        filters
        sampleLen = sampleLen
      ) \head except #emptyList -> #some([])

      -- Skip the start sequence and drop everything from the end-of-transcript token on
      def text = decode(tokens \skip(sotSequence.length) \takeWhile { != eot })
      return text \trim
    }
  }

---
A toy tokenizer and model to run the decoder with. The model has learned one
sentence: it scores the next word of it highest, but a blank higher still at
the start, which `suppressBlank` rules out.
---

def vocabulary = ["<|endoftext|>", "<|startoftranscript|>", " ", " hello", " from", " nanyx", "!"]
def sentence = [3, 4, 5, 6, 0]

def tokenText: int -> string = { token ->
  def #some(text) = vocabulary \at(token) except #notFound -> #some("")
  text
}

def nextScores: Tokens -> Logits = { tokens ->
  def position = tokens.length - 1
  def #some(next) = sentence \at(position) except #notFound -> #some(0)

  vocabulary \mapIndexed { i, _ ->
    if
      | i == 2 and position == 0 -> 20.0
      | i == next -> 10.0
      | else -> 0.0
  }
}

def describe: (#some(string) | OptionsError) -> string = {
  | #some(text) -> "transcribed: {text}"
  | #beamSizeAndBestOf -> "error: beam size and best-of together"
  | #bestOfWithGreedySampling -> "error: best-of with greedy sampling"
  | #patienceWithoutBeamSize -> "error: patience without a beam size"
  | #lengthPenaltyOutOfRange -> "error: length penalty out of range"
}

@entry
def main = {
  use Tokenizer(
    eot = 0
    sotSequence = [1]
    encode = { text -> vocabulary \indexOf(text) \mapSomeOr([]) { i -> [i] } }
    decode = { tokens -> tokens \map(tokenText) \string.join("") }
  )

  use Model(logits = { sequences, _ -> sequences \map(nextScores) })

  random.seeded(
    7
    {
      def audio = [[0.0]]

      println(describe(transcribe(audio, defaultOptions)))
      println(describe(transcribe(audio, (...defaultOptions, sampleLen = #some(2)))))
      println(describe(transcribe(audio, (...defaultOptions, temperature = 0.5))))

      println(
        describe(
          transcribe(audio, (...defaultOptions, suppressBlank = false, sampleLen = #some(3)))
        )
      )

      println(describe(transcribe(audio, (...defaultOptions, bestOf = #some(5)))))
    }
  )
}
