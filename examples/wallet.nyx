module wallet

import nanyx/text

-- Classifying bitcoin addresses by their prefix, and resolving a wallet's
-- aliases to the addresses they stand for.

export type AddressType =
  | #p2pkh
  | #p2sh
  | #p2wpkh
  | #p2tr
  | #p2pkhTestnet
  | #p2shTestnet
  | #p2wpkhTestnet
  | #p2trTestnet
  | #unknown

export def addressType: string -> AddressType = { address ->
  if
    | address \startsWith("bc1q") -> #p2wpkh
    | address \startsWith("bc1p") -> #p2tr
    | address \startsWith("1") -> #p2pkh
    | address \startsWith("3") -> #p2sh
    | address \startsWith("tb1q") -> #p2wpkhTestnet
    | address \startsWith("tb1p") -> #p2trTestnet
    | address \startsWith("m") -> #p2pkhTestnet
    | address \startsWith("2") -> #p2shTestnet
    | else -> #unknown
}

export def AddressType.isTestnet: AddressType -> bool = {
  | #p2pkhTestnet | #p2shTestnet | #p2wpkhTestnet | #p2trTestnet -> true
  | _ -> false
}

-- Replace the "primary" and "funding" aliases with real addresses from the wallet
type WalletInfo = (primary: string, funding: string, imported: map(string, string))

export def resolveAlias: WalletInfo, string -> string = { wallet, alias ->
  if
    | alias == "primary" -> wallet.primary
    | alias == "funding" -> wallet.funding
    | else ->
      def #some(address) = wallet.imported(alias) except #notFound -> #some(alias)
      address
}

@entry
def main = {
  def wallet = WalletInfo(
    primary = "bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq"
    funding = "3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy"
    imported = ["cold" => "tb1pqqqqp399et2xygdj5xreqhjjvcmzhxw4aywxecjdzew6hylgvsesf3hn0c"]
  )

  for ["primary", "funding", "cold", "1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2", "xyz"] | alias ->
    def address = resolveAlias(wallet, alias)
    def kind = addressType(address)
    def network = if kind \isTestnet then "testnet" else "mainnet"
    println("{alias}: {kind} on {network}")
}
