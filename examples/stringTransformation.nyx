::install nanyx.regex 0.1.1

module casing

import (
  nanyx/text
  nanyx.regex/regex
)

export type Casing = #camel | #pascal | #kebab | #snake | #title | #sentence

-- A word is a run of lower-case letters and digits, after at most one capital,
-- or a run of capitals, so case changes, underscores, dashes and whitespace
-- all separate words
def word = Regex.parse('[A-Z]?[a-z0-9]+|[A-Z]+') \orCrash("bad pattern")

def splitWords: string -> list(string) = { input ->
  input \Regex.findAll(word) \map { m -> m.text } \toList
}

def capitalize: string -> string = { word ->
  match word \chars
    | [] -> ""
    | [first, ...rest] -> char.toString(first) \uppercase ++ string.fromChars(rest) \lowercase
}

export def rejoin: list(string), Casing -> string = { words, casing ->
  match casing
    | #kebab -> words \map { s -> s \lowercase } \string.join("-")
    | #snake -> words \map { s -> s \lowercase } \string.join("_")
    | #pascal -> words \map(capitalize) \string.join("")
    | #title -> words \map(capitalize) \string.join(" ")
    | #camel ->
      match words
        | [] -> ""
        | [first, ...rest] -> first \lowercase ++ rest \map(capitalize) \string.join("")
    | #sentence ->
      match words
        | [] -> ""
        | [first, ...rest] -> capitalize(first) ++ " " ++ rest
          \map { s -> s \lowercase }
          \string.join(" ")
}

export def convert: string, Casing -> string = { input, casing ->
  rejoin(splitWords(input), casing)
}

@entry
def main = {
  def tests = ["oneTwoThree", "one_two_three", "one-two-three", "one two three"]

  for tests | test ->
    for [#camel, #pascal, #kebab, #snake, #title, #sentence] | casing ->
      println("{test} -> {convert(test, casing)}")
}
