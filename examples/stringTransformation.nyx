module casing

import nanyx/text.regex

export type Casing =
  | #camel
  | #pascal
  | #kebab
  | #snake
  | #title
  | #sentence

-- Split on case changes, underscores, dashes and whitespace
def splitWords: string -> list(string) = { input ->
  input \Regex.split('(?=[A-Z])|_|-|\s') \filter { != "" }
}

def capitalize: string -> string = { word ->
  match word \chars
    | [] -> ""
    | [first, ...rest] -> first \toUpper ++ (rest \string.join("") \toLower)
}

export def rejoin: (list(string), Casing) -> string = { words, casing ->
  match casing
    | #kebab -> words \map { .toLower } \string.join("-")
    | #snake -> words \map { .toLower } \string.join("_")
    | #pascal -> words \map(capitalize) \string.join("")
    | #title -> words \map(capitalize) \string.join(" ")
    | #camel ->
      match words
        | [] -> ""
        | [first, ...rest] -> first \toLower ++ (rest \map(capitalize) \string.join(""))
    | #sentence ->
      match words
        | [] -> ""
        | [first, ...rest] -> capitalize(first) ++ " " ++ (rest \map { .toLower } \string.join(" "))
}

export def convert: (string, Casing) -> string = { input, casing ->
  rejoin(splitWords(input), casing)
}

@entry
def main = {
  def tests = ["oneTwoThree", "one_two_three", "one-two-three", "one two three"]

  for tests | test ->
    for [#camel, #pascal, #kebab, #snake, #title, #sentence] | casing ->
      println("{test} -> {convert(test, casing)}")
}
