module sqlUtils

-- Database access through contexts: a function that needs a connection says
-- so in its type, and the caller supplies one with `use`.

type SqlPrimitive = #sqlInt(int) | #sqlString(string)

type SqlError = #duplicateKey | #sqlError(string)

type PreparedStatement = (
  setInt: (int, int) -> ()
  setString: (int, string) -> ()
  executeUpdate: () -> #some(int) | SqlError
)

context Connection = (prepare: string -> PreparedStatement)

-- What a data source opens: a session to prepare statements on. A context is not
-- a type, so the data source gives back a plain record, and `withConnection` loads
-- it as the `Connection` its action needs.
type Session = (prepare: string -> PreparedStatement)

context DataSource = (open: () -> Session)

def PreparedStatement.setArgument: PreparedStatement, int, SqlPrimitive -> () = {
  | statement, position, #sqlInt(value) -> statement.setInt(position, value)
  | statement, position, #sqlString(value) -> statement.setString(position, value)
}

export def executeUpdate
  : [Connection] string, list(SqlPrimitive) -> #some(int) | SqlError
  = { query, args ->
    def statement = prepare(query)
    for args, 1.. | arg, position -> statement \setArgument(position, arg)
    statement.executeUpdate()
  }

-- Callers that treat a duplicate key as "nothing to do" narrow the error with `except`
export def insertIgnoringDuplicates
  : [Connection] string, list(SqlPrimitive) -> #some(int) | #sqlError(string)
  = { query, args ->
    executeUpdate(query, args) except #duplicateKey -> #some(0)
  }

export def withConnection: [DataSource] ([Connection] () -> a) -> a = { action ->
  def session = open()
  use Connection(prepare = session.prepare) in action()
}

export def addUser
  : [DataSource] (id: int, name: string) -> #some(int) | #sqlError(string)
  = { id, name ->
    withConnection {
      insertIgnoringDuplicates(
        "insert into users (id, name) values (?, ?)"
        [#sqlInt(id), #sqlString(name)]
      )
    }
  }
