module csv

import (
  nanyx/math
  nanyx/text
)

type Stock = (
  ticker: string
  name: string
  price: float
  change: float
  pct: float
)

-- A table literal is a list of records with the same shape
def stocks: list(Stock) =
  [| ticker | name            | price  | change | pct     |
   | "GOOG" | "Google Inc."   | 505.24 | 0.47   | 0.09    |
   | "YHOO" | "Yahoo! Inc."   | 27.38  | 0.33   | 1.22    |
   | "CNET" | "CNET Networks" | 8.62   | -0.13  | -1.4901 |]

def quote: string -> string = { s ->
  "\"" ++ s ++ "\""
}

def unquote: string -> string = { s ->
  s \string.removePrefix("\"") \string.removeSuffix("\"")
}

def toCsvLine: Stock -> string = { s ->
  [s.ticker, quote(s.name), "{s.price}", "{s.change}", "{s.pct}"] \string.join(",")
}

def fromCsvLine: string -> #some(Stock) | #malformed = { line ->
  match line \string.split(on = ",")
    | [ticker, name, price, change, pct] ->
      match (float.fromString(price), float.fromString(change), float.fromString(pct))
        | (#some(price), #some(change), #some(pct)) ->
          #some(
            Stock(ticker = ticker, name = unquote(name), price = price, change = change, pct = pct)
          )
        | _ -> #malformed
    | _ -> #malformed
}

def statusLabels = [-1.0 => "down", 0.0 => "unchanged", 1.0 => "up"]

@entry
def main = {
  -- Write the stocks as comma-separated values
  def csv = stocks \map(toCsvLine) \string.join("\n")
  println(csv)

  -- Read them back and print a status line for each
  for csv \string.lines | line ->
    match fromCsvLine(line)
      | #some(stock) ->
        def #some(status) = statusLabels(sign(stock.change)) except #notFound -> #some("unknown")
        println("{stock.name} is {status} {stock.pct}%")
      | #malformed -> println("Skipping malformed line: {line}")
}
