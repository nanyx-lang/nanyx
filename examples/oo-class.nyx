module attestation

import nanyx/clock as (Clock)

---
There are no classes in Nanyx. This example takes a class from another
language, a manager that caches a key attestation and refreshes it when it
expires, and models it the Nanyx way:

  - the object's fields become a record type
  - its methods become definitions attached to that type
  - mutation becomes a function from the old state to the new state
  - its dependencies become contexts
---

-- Times are milliseconds since 1970, as `Clock.now` gives them
type Attestation = (certificateChain: list(string), generatedAt: int)

type Settings = (tokenExpiryMs: int, maxRetryAttempts: int)

export type AttestationCache = (settings: Settings, current: #some(Attestation) | #none)

export def AttestationCache.new: Settings -> AttestationCache = { settings ->
  AttestationCache(settings = settings, current = #none)
}

def AttestationCache.needsRefresh: [Clock] AttestationCache -> bool = { cache ->
  match cache.current
    | #none -> true
    | #some(attestation) -> now() - attestation.generatedAt >= cache.settings.tokenExpiryMs
}

-- The service that produces attestations is a dependency, so it is a context
context Attester = (
  getChallenge: () -> string
  generateCertificateChain: string -> #some(list(string)) | #attestationFailed
)

-- Retry an operation until it succeeds or has been tried `times` times
def retry: [c] int, ([c] () -> #some(a) | r) -> #some(a) | r = { times, operation ->
  rec attempt: [c] int -> #some(a) | r = { n ->
    match operation()
      | #some(value) -> #some(value)
      | e -> if n >= times then e else attempt(n + 1)
  }

  attempt(1)
}

-- Refresh the attestation if it is missing or expired. Returns the new cache;
-- the old one is unchanged.
export def AttestationCache.refresh
  : [Clock, Attester] AttestationCache -> #some(AttestationCache) | #attestationFailed
  = { cache ->
    if not (cache \needsRefresh)
      then #some(cache)
      else proc {
        def chain = try retry(
          cache.settings.maxRetryAttempts
          { generateCertificateChain(getChallenge()) }
        )

        return cache with current = #some(
          Attestation(certificateChain = chain, generatedAt = now())
        )
      }
  }

export def AttestationCache.certificateChain
  : AttestationCache -> #some(list(string)) | #none
  = { cache ->
    cache.current \mapSome { a -> a.certificateChain }
  }

def show: (#some(AttestationCache) | #attestationFailed) -> string = {
  | #some(cache) ->
    match cache.current
      | #some(a) -> "chain {a.certificateChain}, generated at {a.generatedAt}"
      | #none -> "empty"
  | #attestationFailed -> "attestation failed"
}

@entry
def main = {
  def settings = Settings(tokenExpiryMs = 60_000, maxRetryAttempts = 3)
  def empty = AttestationCache.new(settings)

  use Attester(
    getChallenge = { "challenge" }
    generateCertificateChain = { challenge -> #some(["leaf for {challenge}", "root"]) }
  )

  def first = use Clock(now = { 1_000 }, ticks = { 0 }) in empty \refresh
  println(show(first))

  match first
    -- Still fresh a little later, so nothing is generated
    | #some(cache) ->
      println(show(use Clock(now = { 30_000 }, ticks = { 0 }) in cache \refresh))
      -- Expired after a minute, so a new one is generated
      println(show(use Clock(now = { 90_000 }, ticks = { 0 }) in cache \refresh))
    | #attestationFailed -> ()

  use Attester(
    getChallenge = { "challenge" }
    generateCertificateChain = { _ -> #attestationFailed }
  )

  println(show(use Clock(now = { 1_000 }, ticks = { 0 }) in empty \refresh))
}
