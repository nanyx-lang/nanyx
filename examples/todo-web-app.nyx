module todo.server

import nanyx/clock as (Clock)

-- A server for a todo application. The store is a context, so the same
-- implementation runs over a database in production and over an in-memory
-- map in tests.

export type TodoId = int

export type Todo = (
  id: TodoId
  description: string
  completed: bool
  dateAdded: Instant
)

export type TodoError =
  | #todoDoesNotExist
  | #insertNotSuccessful
  | #updateNotSuccessful
  | #deleteNotSuccessful

export type DeleteResult = #deleted | #deleteError(TodoError)
export type UpdateResult = #updated(Todo) | #updateError(TodoError)

-- The protocol between client and server. Every member is a function from a
-- request to its response, and the protocol is a context, so client code
-- that requires it runs against the server implementation or a client proxy,
-- whichever is in scope.
export context TodoProtocol = (
  allTodos: () -> list(Todo)
  addTodo: string -> #some(Todo) | TodoError
  toggleCompleted: TodoId -> UpdateResult
  deleteTodo: TodoId -> DeleteResult
)

-- How routes are generated on the server and mapped from the client
export def routeBuilder
  : (typeName: string, methodName: string) -> string
  = { typeName, methodName ->
    "/api/{typeName}/{methodName}"
  }

context TodoStore = (
  findAll: () -> list(Todo)
  find: TodoId -> #some(Todo) | #notFound
  insert: Todo -> #some(Todo) | #insertNotSuccessful
  update: Todo -> #some(Todo) | #updateNotSuccessful
  delete: TodoId -> #some() | #deleteNotSuccessful
)

-- The store assigns the id
def newTodo: [Clock] string -> Todo = { description ->
  Todo(id = 0, description = description, completed = false, dateAdded = now())
}

def exists: (#some(Todo) | #notFound) -> #some(Todo) | #todoDoesNotExist = {
  | #some(todo) -> #some(todo)
  | #notFound -> #todoDoesNotExist
}

def toggle: [TodoStore] TodoId -> UpdateResult = { id ->
  match proc {
    def existing = try exists(find(id))
    return try update(existing with completed = not existing.completed)
  }
    | #some(todo) -> #updated(todo)
    | #todoDoesNotExist -> #updateError(#todoDoesNotExist)
    | #updateNotSuccessful -> #updateError(#updateNotSuccessful)
}

def remove: [TodoStore] TodoId -> DeleteResult = { id ->
  match proc {
    try exists(find(id))
    try delete(id)
    return ()
  }
    | #some() -> #deleted
    | #todoDoesNotExist -> #deleteError(#todoDoesNotExist)
    | #deleteNotSuccessful -> #deleteError(#deleteNotSuccessful)
}

export def seedInitialData: [TodoStore, Clock] () -> () = {
  for ["Learn Nanyx", "Write a web app", "Ship it"] | description ->
    insert(newTodo(description))
}

def show: Todo -> string = { todo ->
  def mark = if todo.completed then "x" else " "
  "[{mark}] {todo.id}: {todo.description}"
}

-- A client of the protocol, which knows nothing of the store behind it
def client: [TodoProtocol, Console] () -> () = {
  match toggleCompleted(2)
    | #updated(todo) -> println("Toggled {show(todo)}")
    | #updateError(e) -> println("Could not toggle: {e}")

  for [3, 3] | id ->
    println(deleteTodo(id))

  match addTodo("Celebrate")
    | #some(todo) -> println("Added {show(todo)}")
    | e -> println("Could not add: {e}")

  for allTodos() | todo -> println(show(todo))
}

-- The server: seed the store, then answer the client
def serve: [TodoStore, Clock, Console] () -> () = {
  seedInitialData()

  use TodoProtocol(
    allTodos = { findAll() }
    addTodo = { description -> insert(newTodo(description)) }
    toggleCompleted = { id -> toggle(id) }
    deleteTodo = { id -> remove(id) }
  )

  println(routeBuilder(typeName = "TodoProtocol", methodName = "toggleCompleted"))
  client()
}

-- The server over an in-memory store. The mutable cells never leave the
-- `memory` scope; only plain values come out.
@entry
def main = {
  memory {
    mut todos: map(TodoId, Todo) = map.empty
    mut nextId = 1

    use TodoStore(
      findAll = { todos \map.values \sortBy { todo -> todo.id } }
      find = { id -> todos(id) }
      insert = { todo ->
        def saved = todo with id = nextId
        todos := todos \map.insert(saved.id, saved)
        nextId := nextId + 1
        #some(saved)
      }
      update = { todo ->
        todos := todos \map.insert(todo.id, todo)
        #some(todo)
      }
      delete = { id ->
        todos := todos \map.remove(id)
        #some()
      }
    ) in serve()
  }
}
