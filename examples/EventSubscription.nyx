module highstorm

-- A small client for an event-ingestion API, showing optional fields,
-- a record of functions as an "object", and `proc` for error chaining.
-- How a request reaches the server is a context, so `main` can answer it
-- without a network.

type Event = (
  event: string
  time: #some(int) | #none
  content: #some(string) | #none
  metadata: #some(map(string, string)) | #none
)

type Options = (token: string, baseUrl: #some(string) | #none)

type IngestError = #httpError(int) | #badResponse

type Response = (status: int, body: string)

context Transport = (
  -- The URL, the headers and the body
  post: (string, map(string, string), string) -> Response
)

type Client = (
  baseUrl: string
  -- The channel and the event
  ingest: [Transport] (string, Event) -> #some(id: string) | IngestError
)

def checkOk: Response -> #some(Response) | #httpError(int) = { response ->
  if response.status >= 200 and response.status < 300
    then #some(response)
    else #httpError(response.status)
}

-- The server answers with the event's id, `id=<id>`
def readId: string -> #some(id: string) | #badResponse = { body ->
  match body \string.splitOnce(on = "=")
    | #some("id", id) -> #some(id = id)
    | _ -> #badResponse
}

-- The event as JSON, leaving out the fields it doesn't have
def encode: Event -> string = { event ->
  def optional = [
    event.time \mapSome { t -> "\"time\":{t}" }
    event.content \mapSome { c -> "\"content\":\"{c}\"" }
  ]

  def fields = ["\"event\":\"{event.event}\"", ...optional \somes]
  "\{{fields \string.join(",")}\}"
}

export def Client.new: Options -> Client = { options ->
  def #some(baseUrl) = options.baseUrl except #none -> #some("https://highstorm.app")

  Client(
    baseUrl = baseUrl
    ingest = { channel, event -> proc {
        def response = try checkOk(
          post(
            "{baseUrl}/api/v1/events/{channel}"
            ["Content-Type" => "application/json", "Authorization" => "Bearer {options.token}"]
            encode(event)
          )
        )

        return try readId(response.body)
      }
    }
  )
}

def report: (#some(id: string) | IngestError) -> string = {
  | #some(id = id) -> "Ingested event {id}"
  | #httpError(status) -> "HTTP error {status}"
  | #badResponse -> "Could not read the response"
}

@entry
def main: [Console] () -> () = {
  def deploy = Event(
    event = "deploy.finished"
    time = #none
    content = #some("v1.2.0")
    metadata = #none
  )

  -- A server that prints each request and accepts it
  use Transport(
    post = { url, headers, body ->
      println("POST {url} {body}")
      Response(status = 201, body = "id=evt_1")
    }
  )

  def client = Client.new(Options(token = "secret", baseUrl = #none))
  println(report(client.ingest("deploys", deploy)))

  -- The client calls the `Transport` in scope where it is called, so here it
  -- reaches one that turns the token away
  use Transport(post = { url, headers, body -> Response(status = 401, body = "") })
  println(report(client.ingest("deploys", deploy)))
}
