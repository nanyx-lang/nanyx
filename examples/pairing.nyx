module devicePairing

-- Extracting a device-pairing payload from an XML element. The two kinds of
-- registration are told apart by a tag, and `proc` collects the required
-- sub-elements, failing as a whole if any is missing. Binary fields stay as
-- the base64 text the element carries.

-- A sub-element holds text; the element holds sub-elements
type Tag = (name: string, attrs: map(string, string), text: string)
type Element = (name: string, attrs: map(string, string), children: list(Tag))

type Base64 = string

def Element.subtag: Element, string -> #some(Tag) | #notFound = { el, name ->
  el.children \find { tag -> tag.name == name }
}

def Element.subtagText: Element, string -> #some(string) | #notFound = { el, name ->
  el \subtag(name) \mapSome { tag -> tag.text }
}

def Tag.attr: Tag, string -> #some(string) | #notFound = { tag, name ->
  tag.attrs(name)
}

-- A number that is missing or unreadable is not found
def number: string -> #some(int) | #notFound = { text ->
  int.fromString(text) except #invalidInt -> #notFound
}

-- A missing required element is an extraction failure
def required: (#some(a) | #notFound) -> #some(a) | #extractionFailed = {
  | #some(value) -> #some(value)
  | #notFound -> #extractionFailed
}

type CompanionRegistration = (
  pubKey: string
  ref: Base64
  deviceIdentity: #some(string) | #none
  keyIndexList: #some(Base64) | #none
  keyIndexListTs: #some(int) | #none
  refCert: #some(Base64) | #none
)

type TrustCircleOnboarding = (
  appId: int
  authKey: string
  deviceIdentity: string
  famDeviceId: Base64
  keyIndexList: Base64
  keyIndexListTs: int
  ref: Base64
)

export type Payload =
  | #companion(CompanionRegistration)
  | #trustCircle(TrustCircleOnboarding)

export type Context = #companionRegistration | #trustCircleOnboarding

def keyIndexListTs: Element -> #some(int) | #notFound = { el ->
  el \subtag("key_index_list") \bindSome { key -> key \attr("ts") } \bindSome(number)
}

export def extractPairDevicePayload: Element, Context -> #some(Payload) | #extractionFailed = {
  | el, #companionRegistration -> proc {
    def pubKey = try required(el \subtagText("pub_key"))
    def ref = try required(el \subtagText("ref"))

    -- The remaining elements are optional: a missing one becomes `#none`
    def deviceIdentity = el \subtagText("device_identity") except #notFound -> #none
    def keyIndexList = el \subtagText("key_index_list") except #notFound -> #none
    def ts = keyIndexListTs(el) except #notFound -> #none
    def refCert = el \subtagText("ref_cert") except #notFound -> #none

    return #companion(
      CompanionRegistration(
        pubKey = pubKey
        ref = ref
        deviceIdentity = deviceIdentity
        keyIndexList = keyIndexList
        keyIndexListTs = ts
        refCert = refCert
      )
    )
  }
  | el, #trustCircleOnboarding -> proc {
    return #trustCircle(
      TrustCircleOnboarding(
        appId = try required(el \subtagText("app_id") \bindSome(number))
        authKey = try required(el \subtagText("auth_key"))
        deviceIdentity = try required(el \subtagText("device_identity"))
        famDeviceId = try required(el \subtagText("fam_device_id"))
        keyIndexList = try required(el \subtagText("key_index_list"))
        keyIndexListTs = try required(keyIndexListTs(el))
        ref = try required(el \subtagText("ref"))
      )
    )
  }
}

-- Building the reply --------------------------------------------------------

def textTag: string, string -> Tag = { name, text ->
  Tag(name = name, attrs = map.empty, text = text)
}

export def pairSuccessReply: string, Payload -> Element = { deviceId, payload ->
  def device = Tag(name = "device", attrs = ["id" => deviceId], text = "")

  def identity =
    match payload
      | #companion(c) -> c.deviceIdentity \mapSome { id -> textTag("device_identity", id) }
      | #trustCircle(t) -> #some(textTag("device_identity", t.deviceIdentity))

  Element(name = "pair_success", attrs = map.empty, children = [device, ...identity \someToList])
}

-- Trying it out ---------------------------------------------------------------

def describe: (#some(Payload) | #extractionFailed) -> string = {
  | #some(#companion(c)) ->
    "companion {c.pubKey}, identity {c.deviceIdentity}, key index list from {c.keyIndexListTs}"
  | #some(#trustCircle(t)) -> "trust circle app {t.appId}, device {t.famDeviceId}"
  | #extractionFailed -> "extraction failed"
}

@entry
def main = {
  def companion = Element(
    name = "pair-device"
    attrs = map.empty
    children = [
      textTag("pub_key", "pk-1")
      textTag("ref", "cmVm")
      Tag(name = "key_index_list", attrs = ["ts" => "1700000000"], text = "a2V5cw==")
    ]
  )

  def trustCircle = Element(
    name = "pair-device"
    attrs = map.empty
    children = [
      textTag("app_id", "42")
      textTag("auth_key", "ak")
      textTag("device_identity", "phone")
      textTag("fam_device_id", "ZmFt")
      Tag(name = "key_index_list", attrs = ["ts" => "1700000000"], text = "a2V5cw==")
      textTag("ref", "cmVm")
    ]
  )

  println(describe(extractPairDevicePayload(companion, #companionRegistration)))
  println(describe(extractPairDevicePayload(trustCircle, #trustCircleOnboarding)))
  println(describe(extractPairDevicePayload(companion, #trustCircleOnboarding)))

  match extractPairDevicePayload(trustCircle, #trustCircleOnboarding)
    | #some(payload) ->
      def reply = pairSuccessReply("device-7", payload)
      println("{reply.name}: {reply.children \map { t -> t.name } \string.join(", ")}")
    | #extractionFailed -> println("no reply")
}
