module pixelSorting

import nanyx/math as math

-- Pixel sorting: a glitch-art effect where the pixels of each row of an
-- image are reordered by colour.

type Pixel = (r: float, g: float, b: float) -- each channel in 0..1
type Image = list(list(Pixel))

-- Perceived luminance
def Pixel.luminance: Pixel -> float = { p ->
  math.sqrt(0.241 * p.r + 0.691 * p.g + 0.068 * p.b)
}

-- Hue and value, which classify colours better than the raw channels
def Pixel.hsv: Pixel -> (h: float, s: float, v: float) = { p ->
  def high = math.max(p.r, math.max(p.g, p.b))
  def low = math.min(p.r, math.min(p.g, p.b))
  def delta = high - low

  def h =
    if
      | delta == 0.0 -> 0.0
      | high == p.r -> (p.g - p.b) / delta % 6.0 / 6.0
      | high == p.g -> ((p.b - p.r) / delta + 2.0) / 6.0
      | else -> ((p.r - p.g) / delta + 4.0) / 6.0

  (h = h, s = (if high == 0.0 then 0.0 else delta / high), v = high)
}

-- A sort key that groups pixels into `repetitions` hue bands, alternating the
-- direction of the luminance in every other band so the result looks smoother
def stepKey: Pixel, int -> (int, float, int) = { p, repetitions ->
  def (h = h, s = _, v = v) = p \hsv
  def band = math.floor(h * int.toFloat(repetitions))
  def value = math.floor(v * int.toFloat(repetitions))

  if band % 2 == 1
    then (band, int.toFloat(repetitions) - p \luminance, repetitions - value)
    else (band, p \luminance, value)
}

def Pixel.isBlack: Pixel -> bool = { p ->
  p.r == 0.0 and p.g == 0.0 and p.b == 0.0
}

-- A row is sorted only if every pixel has some colour; rows containing black
-- pixels are left alone so that hard edges survive
def sortRow: list(Pixel) -> list(Pixel) = { row ->
  if row \any { p -> p \isBlack } then row else row \sortBy { p -> stepKey(p, 8) }
}

def sortImage: Image -> Image = { image ->
  image \map(sortRow)
}

-- The number of pixels that took part in the sort
def measure: Image -> int = { image ->
  image
    \filter { row -> not (row \any { p -> p \isBlack }) }
    \map { .length }
    \sum
}

def red = Pixel(r = 1.0, g = 0.0, b = 0.0)
def green = Pixel(r = 0.0, g = 1.0, b = 0.0)
def blue = Pixel(r = 0.0, g = 0.0, b = 1.0)
def grey = Pixel(r = 0.5, g = 0.5, b = 0.5)
def black = Pixel(r = 0.0, g = 0.0, b = 0.0)

def Pixel.name: Pixel -> string = { p ->
  if
    | p == red -> "red"
    | p == green -> "green"
    | p == blue -> "blue"
    | p == grey -> "grey"
    | else -> "black"
}

@entry
def main = {
  def image = [[blue, grey, red, green], [green, black, red, blue], [grey, blue, green, red]]

  for sortImage(image) | row -> println(row \map { p -> p \name } \string.join(" "))
  println("{measure(image)} pixels sorted")
}
