module argumentParsing

type Config = (help: bool, verbose: bool, input: string)

type Arguments = list(string)

type ParseError = #helpRequested | #missingArgument(string)

-- The value following a flag, found by walking the argument list two at a time
def requiredArgument
  : Arguments, string -> #some(string) | #missingArgument(string)
  = { args, name ->
    rec loop = {
      | [] | [_] -> #missingArgument(name)
      | [flag, value, ...rest] ->
        if flag == name then #some(value) else loop([value, ...rest])
    }

    loop(args)
  }

def optionalSwitch: Arguments, string -> bool = { args, name ->
  args \contains(name)
}

def checkHelp: Arguments -> #some() | #helpRequested = { args ->
  if optionalSwitch(args, "--help") then #helpRequested else #some()
}

-- `proc` short-circuits on the first failure, so the happy path reads top to bottom
def parseArguments: Arguments -> #some(Config) | ParseError = { args ->
  proc {
    try checkHelp(args)
    def input = try requiredArgument(args, "--input")

    return Config(help = false, verbose = optionalSwitch(args, "--verbose"), input = input)
  }
}

@entry
def main = {
  def args = ["--input", "foo.txt", "--verbose"]

  match parseArguments(args)
    | #some(config) -> println("Processing input '{config.input}' verbose={config.verbose}")
    | #helpRequested -> println("Usage: example [--help] [--verbose] [--input <input file>]")
    | #missingArgument(name) -> println("Error: command line argument {name} is missing")
}
